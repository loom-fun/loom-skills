        %lo_v1_0_pt = vector.splat %loe1_0_pt : vector<16xi32>
        %mlo1_0_pt = vector.cmpi sge, %iota16_pt, %lo_v1_0_pt : vector<16xi32> -> vector<16xi1>
        %m1_0_pt = vector.andi %mhi1_0_pt, %mlo1_0_pt : vector<16xi1>
