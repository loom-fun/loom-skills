    %qk1_6_1 = vector.slice %q1[24] : vector<32xi8> -> vector<4xi8>
    %ac1_6_1 = vector.dot4i<s8s8> %wk1_6, %qk1_6_1, %ac1_5_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk1_7_1 = vector.slice %q1[28] : vector<32xi8> -> vector<4xi8>
    %ac1_7_1 = vector.dot4i<s8s8> %wk1_7, %qk1_7_1, %ac1_6_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %ie1_1 = vector.extract %ac1_7_1[0] : vector<1xi32> -> i32
    %df1_1 = scalar.sitofp %ie1_1 : i32 to f32
    %pd1_1 = scalar.mulf %df1_1, %sc1 : f32
    %pm1_1 = scalar.mulf %xs1, %mn1 : f32
    %pq1_1 = scalar.subf %pd1_1, %pm1_1 : f32
    %pa1_1 = scalar.mulf %pq1_1, %da1 : f32
    %qk2_0_1 = vector.slice %q2[0] : vector<32xi8> -> vector<4xi8>
    %ac2_0_1 = vector.dot4i<s8s8> %wk1_0, %qk2_0_1, %zero1i : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk2_1_1 = vector.slice %q2[4] : vector<32xi8> -> vector<4xi8>
    %ac2_1_1 = vector.dot4i<s8s8> %wk1_1, %qk2_1_1, %ac2_0_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk2_2_1 = vector.slice %q2[8] : vector<32xi8> -> vector<4xi8>
    %ac2_2_1 = vector.dot4i<s8s8> %wk1_2, %qk2_2_1, %ac2_1_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk2_3_1 = vector.slice %q2[12] : vector<32xi8> -> vector<4xi8>
    %ac2_3_1 = vector.dot4i<s8s8> %wk1_3, %qk2_3_1, %ac2_2_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk2_4_1 = vector.slice %q2[16] : vector<32xi8> -> vector<4xi8>
    %ac2_4_1 = vector.dot4i<s8s8> %wk1_4, %qk2_4_1, %ac2_3_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk2_5_1 = vector.slice %q2[20] : vector<32xi8> -> vector<4xi8>
    %ac2_5_1 = vector.dot4i<s8s8> %wk1_5, %qk2_5_1, %ac2_4_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk2_6_1 = vector.slice %q2[24] : vector<32xi8> -> vector<4xi8>
    %ac2_6_1 = vector.dot4i<s8s8> %wk1_6, %qk2_6_1, %ac2_5_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk2_7_1 = vector.slice %q2[28] : vector<32xi8> -> vector<4xi8>
    %ac2_7_1 = vector.dot4i<s8s8> %wk1_7, %qk2_7_1, %ac2_6_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %ie1_2 = vector.extract %ac2_7_1[0] : vector<1xi32> -> i32
    %df1_2 = scalar.sitofp %ie1_2 : i32 to f32
    %pd1_2 = scalar.mulf %df1_2, %sc1 : f32
    %pm1_2 = scalar.mulf %xs2, %mn1 : f32
    %pq1_2 = scalar.subf %pd1_2, %pm1_2 : f32
    %pa1_2 = scalar.mulf %pq1_2, %da2 : f32
    %qk3_0_1 = vector.slice %q3[0] : vector<32xi8> -> vector<4xi8>
    %ac3_0_1 = vector.dot4i<s8s8> %wk1_0, %qk3_0_1, %zero1i : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk3_1_1 = vector.slice %q3[4] : vector<32xi8> -> vector<4xi8>
    %ac3_1_1 = vector.dot4i<s8s8> %wk1_1, %qk3_1_1, %ac3_0_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk3_2_1 = vector.slice %q3[8] : vector<32xi8> -> vector<4xi8>
    %ac3_2_1 = vector.dot4i<s8s8> %wk1_2, %qk3_2_1, %ac3_1_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk3_3_1 = vector.slice %q3[12] : vector<32xi8> -> vector<4xi8>
    %ac3_3_1 = vector.dot4i<s8s8> %wk1_3, %qk3_3_1, %ac3_2_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk3_4_1 = vector.slice %q3[16] : vector<32xi8> -> vector<4xi8>
    %ac3_4_1 = vector.dot4i<s8s8> %wk1_4, %qk3_4_1, %ac3_3_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk3_5_1 = vector.slice %q3[20] : vector<32xi8> -> vector<4xi8>
    %ac3_5_1 = vector.dot4i<s8s8> %wk1_5, %qk3_5_1, %ac3_4_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk3_6_1 = vector.slice %q3[24] : vector<32xi8> -> vector<4xi8>
    %ac3_6_1 = vector.dot4i<s8s8> %wk1_6, %qk3_6_1, %ac3_5_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk3_7_1 = vector.slice %q3[28] : vector<32xi8> -> vector<4xi8>
    %ac3_7_1 = vector.dot4i<s8s8> %wk1_7, %qk3_7_1, %ac3_6_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %ie1_3 = vector.extract %ac3_7_1[0] : vector<1xi32> -> i32
    %df1_3 = scalar.sitofp %ie1_3 : i32 to f32
    %pd1_3 = scalar.mulf %df1_3, %sc1 : f32
    %pm1_3 = scalar.mulf %xs3, %mn1 : f32
    %pq1_3 = scalar.subf %pd1_3, %pm1_3 : f32
    %pa1_3 = scalar.mulf %pq1_3, %da3 : f32
    %b1_16_0s = scf.select %bb16, %pa1_0, %pa1_2 : f32
    %b1_16_0k = scf.select %bb16, %pa1_2, %pa1_0 : f32
    %b1_16_0r, %b1_16_0u = kernel.subgroup.shuffle<xor> %b1_16_0s, %bd16, %bw32 : f32, i32, i32
    %b1_16_0 = scalar.addf %b1_16_0k, %b1_16_0r : f32
    %b1_16_1s = scf.select %bb16, %pa1_1, %pa1_3 : f32
    %b1_16_1k = scf.select %bb16, %pa1_3, %pa1_1 : f32
    %b1_16_1r, %b1_16_1u = kernel.subgroup.shuffle<xor> %b1_16_1s, %bd16, %bw32 : f32, i32, i32
    %b1_16_1 = scalar.addf %b1_16_1k, %b1_16_1r : f32
    %b1_8_0s = scf.select %bb8, %b1_16_0, %b1_16_1 : f32
    %b1_8_0k = scf.select %bb8, %b1_16_1, %b1_16_0 : f32
    %b1_8_0r, %b1_8_0u = kernel.subgroup.shuffle<xor> %b1_8_0s, %bd8, %bw32 : f32, i32, i32
    %b1_8_0 = scalar.addf %b1_8_0k, %b1_8_0r : f32
    %b1_4r, %b1_4u = kernel.subgroup.shuffle<xor> %b1_8_0, %bd4, %bw32 : f32, i32, i32
    %b1_4 = scalar.addf %b1_8_0, %b1_4r : f32
    %b1_2r, %b1_2u = kernel.subgroup.shuffle<xor> %b1_4, %bd2, %bw32 : f32, i32, i32
    %b1_2 = scalar.addf %b1_4, %b1_2r : f32
    %b1_1r, %b1_1u = kernel.subgroup.shuffle<xor> %b1_2, %bd1, %bw32 : f32, i32, i32
    %b1_1 = scalar.addf %b1_2, %b1_1r : f32
    scf.if %bt_st {
      view.store %b1_1, %pv[1, %wave, %rb, %bt_store] : f32, view<2x1x1x4xf32>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %outputs = index.constant 4 : index
  %lanes_step = index.constant 32 : index
  // R*TG outputs may exceed the lane count (one-wave rows): lanes stride over them.
  scf.for %wr0 = [%workitem to %outputs step %lanes_step] {
    %wr = index.assume %wr0 [range(%wr0, 0, 3)] : index
    %rr_v = index.div %wr, %tg : index
    %rr = index.assume %rr_v [range(%rr_v, 0, 0)] : index
    %jj_v = index.rem %wr, %tg : index
    %jj = index.assume %jj_v [range(%jj_v, 0, 3)] : index
    %tok_raw = index.add %token0, %jj : index
    %tok_live = index.cmp ult, %tok_raw, %tokens : index
    scf.if %tok_live {
      %t0 = scf.for %ww = [%c0 to %cW step %c1](%acc = %zero_f : f32) -> (f32) {
        %bw = index.assume %ww [range(%ww, 0, 0)] : index
        %p = view.load %pv[0, %bw, %rr, %jj] : view<2x1x1x4xf32> -> f32
        %nx = scalar.addf %acc, %p : f32
        scf.yield %nx : f32
      }
      %t1 = scf.for %ww = [%c0 to %cW step %c1](%acc = %zero_f : f32) -> (f32) {
        %bw = index.assume %ww [range(%ww, 0, 0)] : index
        %p = view.load %pv[1, %bw, %rr, %jj] : view<2x1x1x4xf32> -> f32
        %nx = scalar.addf %acc, %p : f32
        scf.yield %nx : f32
      }
      %silu = scalar.siluf<afn> %t0 : f32
      %value = scalar.mulf %silu, %t1 : f32
      %out_row = index.add %row_base, %rr : index
      func.call @g_store_row(%y, %tokens, %n, %tok_raw, %out_row, %value, %accumulate) : (buffer, index, index, index, index, f32, i32)
    }
  }
