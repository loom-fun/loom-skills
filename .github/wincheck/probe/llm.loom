    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %m0r0c0_3, %m0r0c1_3, %m0r0c2_3, %m0r0c3_3, %m0r1c0_3, %m0r1c1_3, %m0r1c2_3, %m0r1c3_3, %m0r2c0_3, %m0r2c1_3, %m0r2c2_3, %m0r2c3_3, %m0r3c0_3, %m0r3c1_3, %m0r3c2_3, %m0r3c3_3, %dqan_ql, %dqan_qh, %dqan_sc8, %dqan_dh, %dqbn_ql, %dqbn_qh, %dqbn_sc8, %dqbn_dh, %x_rawn, %x_rawn1 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<4xi32>, vector<4xi32>, i8, f16, vector<4xi32>, vector<4xi32>, i8, f16, vector<32xf16>, vector<32xf16>
  }
  %inv_view = buffer.view %x_stage[%origin] : buffer -> view<256x16xf32>
  %inv_row_value = index.add %row_origin, %workitem : index
  %inv_row = index.assume %inv_row_value [lt(%inv_row_value, %rows)] : index
  %inverse = view.load %s_view[%inv_row, %c1] : view<[%rows]x2xf32> -> f32
  %inverse16 = vector.splat %inverse : vector<16xf32>
  vector.store %inverse16, %inv_view[%workitem, %c0] : vector<16xf32>, view<256x16xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %inv0 = vector.fragment.load<result> %inv_view[%wave_row, %c0] shape [%c16, %c16] : view<256x16xf32> -> vector<8xf32>
  %inv1 = vector.fragment.load<result> %inv_view[%wave_row1, %c0] shape [%c16, %c16] : view<256x16xf32> -> vector<8xf32>
  %inv2 = vector.fragment.load<result> %inv_view[%wave_row2, %c0] shape [%c16, %c16] : view<256x16xf32> -> vector<8xf32>
  %inv3 = vector.fragment.load<result> %inv_view[%wave_row3, %c0] shape [%c16, %c16] : view<256x16xf32> -> vector<8xf32>
  %y_layout = encoding.layout.strided [%n, %c1] : encoding<layout>
  %tile_first = index.madd %row_origin, %n, %out_origin : index
  %tile_offset = index.scale %tile_first, %four : index, offset -> offset
  %y_view = buffer.view %y[%tile_offset] : buffer -> view<256x128xf32, %y_layout>
  %oc00_c = index.constant 0 : index
  %oc00 = index.add %wave_col, %oc00_c : index
  %v00_s = vector.mulf %o0r0c0, %inv0 : vector<8xf32>
  %v00 = vector.addf %v00_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v00, %y_view[%wave_row, %oc00] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc01_c = index.constant 16 : index
  %oc01 = index.add %wave_col, %oc01_c : index
  %v01_s = vector.mulf %o0r0c1, %inv0 : vector<8xf32>
  %v01 = vector.addf %v01_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v01, %y_view[%wave_row, %oc01] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc02_c = index.constant 32 : index
  %oc02 = index.add %wave_col, %oc02_c : index
  %v02_s = vector.mulf %o0r0c2, %inv0 : vector<8xf32>
  %v02 = vector.addf %v02_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v02, %y_view[%wave_row, %oc02] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc03_c = index.constant 48 : index
  %oc03 = index.add %wave_col, %oc03_c : index
  %v03_s = vector.mulf %o0r0c3, %inv0 : vector<8xf32>
  %v03 = vector.addf %v03_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v03, %y_view[%wave_row, %oc03] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc10_c = index.constant 0 : index
  %oc10 = index.add %wave_col, %oc10_c : index
  %v10_s = vector.mulf %o0r1c0, %inv1 : vector<8xf32>
  %v10 = vector.addf %v10_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v10, %y_view[%wave_row1, %oc10] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc11_c = index.constant 16 : index
  %oc11 = index.add %wave_col, %oc11_c : index
  %v11_s = vector.mulf %o0r1c1, %inv1 : vector<8xf32>
  %v11 = vector.addf %v11_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v11, %y_view[%wave_row1, %oc11] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc12_c = index.constant 32 : index
  %oc12 = index.add %wave_col, %oc12_c : index
  %v12_s = vector.mulf %o0r1c2, %inv1 : vector<8xf32>
  %v12 = vector.addf %v12_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v12, %y_view[%wave_row1, %oc12] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc13_c = index.constant 48 : index
  %oc13 = index.add %wave_col, %oc13_c : index
  %v13_s = vector.mulf %o0r1c3, %inv1 : vector<8xf32>
  %v13 = vector.addf %v13_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v13, %y_view[%wave_row1, %oc13] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc20_c = index.constant 0 : index
  %oc20 = index.add %wave_col, %oc20_c : index
  %v20_s = vector.mulf %o0r2c0, %inv2 : vector<8xf32>
  %v20 = vector.addf %v20_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v20, %y_view[%wave_row2, %oc20] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc21_c = index.constant 16 : index
  %oc21 = index.add %wave_col, %oc21_c : index
  %v21_s = vector.mulf %o0r2c1, %inv2 : vector<8xf32>
  %v21 = vector.addf %v21_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v21, %y_view[%wave_row2, %oc21] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc22_c = index.constant 32 : index
  %oc22 = index.add %wave_col, %oc22_c : index
  %v22_s = vector.mulf %o0r2c2, %inv2 : vector<8xf32>
  %v22 = vector.addf %v22_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v22, %y_view[%wave_row2, %oc22] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc23_c = index.constant 48 : index
  %oc23 = index.add %wave_col, %oc23_c : index
  %v23_s = vector.mulf %o0r2c3, %inv2 : vector<8xf32>
  %v23 = vector.addf %v23_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v23, %y_view[%wave_row2, %oc23] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc30_c = index.constant 0 : index
  %oc30 = index.add %wave_col, %oc30_c : index
  %v30_s = vector.mulf %o0r3c0, %inv3 : vector<8xf32>
  %v30 = vector.addf %v30_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v30, %y_view[%wave_row3, %oc30] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc31_c = index.constant 16 : index
  %oc31 = index.add %wave_col, %oc31_c : index
  %v31_s = vector.mulf %o0r3c1, %inv3 : vector<8xf32>
  %v31 = vector.addf %v31_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v31, %y_view[%wave_row3, %oc31] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc32_c = index.constant 32 : index
  %oc32 = index.add %wave_col, %oc32_c : index
  %v32_s = vector.mulf %o0r3c2, %inv3 : vector<8xf32>
  %v32 = vector.addf %v32_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v32, %y_view[%wave_row3, %oc32] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  %oc33_c = index.constant 48 : index
  %oc33 = index.add %wave_col, %oc33_c : index
  %v33_s = vector.mulf %o0r3c3, %inv3 : vector<8xf32>
  %v33 = vector.addf %v33_s, %zero8 : vector<8xf32>
  vector.fragment.store<result> %v33, %y_view[%wave_row3, %oc33] shape [%c16, %c16] : vector<8xf32>, view<256x128xf32, %y_layout>
  }
  kernel.return
}

// Whether a 16-token tile is uniform (live, one row, consecutive positions): flash2 handles those.
func.def inline @g_tile_uniform(%info: buffer, %tokens: index, %first: index) -> (i1, i32, i32) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c0_i32 = scalar.constant 0 : i32
  %true = scalar.constant true : i1
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %bfirst = index.assume %first [lt(%first, %tokens)] : index
  %row0 = view.load %info_view[%bfirst, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%bfirst, %c1] : view<[%tokens]x4xi32> -> i32
  %ok = scf.for %i = [%c0 to %c16 step %c1](%acc = %true : i1) -> (i1) {
    %t_value = index.add %first, %i : index
    %in_range = index.cmp ult, %t_value, %tokens : index
    %t_clamped = scf.select %in_range, %t_value, %bfirst : index
    %t = index.assume %t_clamped [lt(%t_clamped, %tokens)] : index
    %row = view.load %info_view[%t, %c0] : view<[%tokens]x4xi32> -> i32
    %pos = view.load %info_view[%t, %c1] : view<[%tokens]x4xi32> -> i32
    %c2 = index.constant 2 : index
    %live = view.load %info_view[%t, %c2] : view<[%tokens]x4xi32> -> i32
    %i32v = index.cast %i : index to i32
    %expected = scalar.addi %pos0, %i32v : i32
    %same_row = scalar.cmpi eq, %row, %row0 : i32
    %consecutive = scalar.cmpi eq, %pos, %expected : i32
    %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
    %a = scalar.andi %same_row, %consecutive : i1
    %b = scalar.andi %a, %is_live : i1
    %c = scalar.andi %b, %in_range : i1
    %next = scalar.andi %acc, %c : i1
    scf.yield %next : i1
  }
  func.return %ok, %row0, %pos0 : i1, i32, i32
}

// Whether the 16-token tile after (BACK false) or before (BACK true) the uniform tile at FIRST is uniform too and
// continues it: the same row, positions 16 higher / lower.
func.def inline @g_tile_adjacent(%info: buffer, %tokens: index, %first: index, %back: i1) -> (i1) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c16_i32 = scalar.constant 16 : i32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %bfirst = index.assume %first [range(%first, 0, 8191), lt(%first, %tokens)] : index
  %row0 = view.load %info_view[%bfirst, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%bfirst, %c1] : view<[%tokens]x4xi32> -> i32
  %room = index.cmp uge, %first, %c16 : index
  %back_step = scf.select %room, %c16, %c0 : index
  %prev = index.sub %first, %back_step : index
  %next = index.add %first, %c16 : index
  %other = scf.select %back, %prev, %next : index
  %in_range = index.cmp ult, %other, %tokens : index
  %other_clamped = scf.select %in_range, %other, %bfirst : index
  %other_bound = index.assume %other_clamped [range(%other_clamped, 0, 8191), lt(%other_clamped, %tokens)] : index
  %uniform, %row, %pos = func.call @g_tile_uniform(%info, %tokens, %other_bound) : (buffer, index, index) -> (i1, i32, i32)
  %pos_before = scalar.subi %pos0, %c16_i32 : i32
  %pos_after = scalar.addi %pos0, %c16_i32 : i32
  %pos_want = scf.select %back, %pos_before, %pos_after : i32
  %same_row = scalar.cmpi eq, %row, %row0 : i32
  %next_pos = scalar.cmpi eq, %pos, %pos_want : i32
  %a = scalar.andi %uniform, %in_range : i1
  %b = scalar.andi %a, %same_row : i1
  %ok = scalar.andi %b, %next_pos : i1
  func.return %ok : i1
}

// Whether the uniform tile at TOKEN starts at a position multiple of 16 (flash2 computes those; see
// g_attention_fallback_list).
func.def inline @g_tile_starts(%info: buffer, %tokens: index, %token: index) -> (i1) {
  %zero = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c15_i32 = scalar.constant 15 : i32
  %false = scalar.constant false : i1
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %bounded = index.assume %token [range(%token, 0, 8191), lt(%token, %tokens)] : index
  %pos = view.load %info_view[%bounded, %c1] : view<[%tokens]x4xi32> -> i32
  %skew = scalar.andi %pos, %c15_i32 : i32
  %aligned = scalar.cmpi eq, %skew, %c0_i32 : i32
  %starts = scf.if %aligned -> (i1) {
    %uniform, %row, %pos0 = func.call @g_tile_uniform(%info, %tokens, %bounded) : (buffer, index, index) -> (i1, i32, i32)
    scf.yield %uniform : i1
  } else {
    scf.yield %false : i1
  }
  func.return %starts : i1
}

// Whether TOKEN belongs to a run of at least 9 tokens (one row, consecutive positions, live): the tokens of a prefill
// span, however it was cut. Decode and verify spans are at most 8 tokens (draft depth <= 7) and stay on the split-K
// fallback, so a token's attention path depends on its run, never on where the epoch or the scheduler cut it.
func.def inline @g_run_qualifies(%info: buffer, %tokens: index, %token: index) -> (i1) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c9 = index.constant 9 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c9_i32 = scalar.constant 9 : i32
  %true = scalar.constant true : i1
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %btoken = index.assume %token [lt(%token, %tokens)] : index
  %row0 = view.load %info_view[%btoken, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%btoken, %c1] : view<[%tokens]x4xi32> -> i32
  %live0 = view.load %info_view[%btoken, %c2] : view<[%tokens]x4xi32> -> i32
  %is_live0 = scalar.cmpi ne, %live0, %c0_i32 : i32
  %alive_l, %left = scf.for %k = [%c1 to %c9 step %c1](%alive = %is_live0 : i1, %n = %c0_i32 : i32) -> (i1, i32) {
    %room = index.cmp ule, %k, %token : index
    %back = index.sub %token, %k : index
    %at_value = scf.select %room, %back, %btoken : index
    %at = index.assume %at_value [lt(%at_value, %tokens)] : index
    %row = view.load %info_view[%at, %c0] : view<[%tokens]x4xi32> -> i32
    %pos = view.load %info_view[%at, %c1] : view<[%tokens]x4xi32> -> i32
    %live = view.load %info_view[%at, %c2] : view<[%tokens]x4xi32> -> i32
    %k32 = index.cast %k : index to i32
    %want = scalar.subi %pos0, %k32 : i32
    %same_row = scalar.cmpi eq, %row, %row0 : i32
    %at_pos = scalar.cmpi eq, %pos, %want : i32
    %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
    %a = scalar.andi %same_row, %at_pos : i1
    %b = scalar.andi %a, %is_live : i1
    %c = scalar.andi %b, %room : i1
    %next_alive = scalar.andi %alive, %c : i1
    %step = scf.select %next_alive, %c1_i32, %c0_i32 : i32
    %n_next = scalar.addi %n, %step : i32
    scf.yield %next_alive, %n_next : i1, i32
  }
  %alive_r, %right = scf.for %k = [%c1 to %c9 step %c1](%alive = %is_live0 : i1, %n = %c0_i32 : i32) -> (i1, i32) {
    %ahead = index.add %token, %k : index
    %room = index.cmp ult, %ahead, %tokens : index
    %at_value = scf.select %room, %ahead, %btoken : index
    %at = index.assume %at_value [lt(%at_value, %tokens)] : index
    %row = view.load %info_view[%at, %c0] : view<[%tokens]x4xi32> -> i32
    %pos = view.load %info_view[%at, %c1] : view<[%tokens]x4xi32> -> i32
    %live = view.load %info_view[%at, %c2] : view<[%tokens]x4xi32> -> i32
    %k32 = index.cast %k : index to i32
    %want = scalar.addi %pos0, %k32 : i32
    %same_row = scalar.cmpi eq, %row, %row0 : i32
    %at_pos = scalar.cmpi eq, %pos, %want : i32
    %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
    %a = scalar.andi %same_row, %at_pos : i1
    %b = scalar.andi %a, %is_live : i1
    %c = scalar.andi %b, %room : i1
    %next_alive = scalar.andi %alive, %c : i1
    %step = scf.select %next_alive, %c1_i32, %c0_i32 : i32
    %n_next = scalar.addi %n, %step : i32
    scf.yield %next_alive, %n_next : i1, i32
  }
  %lr = scalar.addi %left, %right : i32
  %run = scalar.addi %lr, %c1_i32 : i32
  %long = scalar.cmpi sge, %run, %c9_i32 : i32
  %ok = scalar.andi %long, %is_live0 : i1
  func.return %ok : i1
}

// Whether TOKEN is the first token of its 16-position block within its run: its position is a multiple of 16, or the
// token before it does not continue the run. The partial tiles (blocks the run covers only in part) are listed by it.
func.def inline @g_block_starts(%info: buffer, %tokens: index, %token: index) -> (i1) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c15_i32 = scalar.constant 15 : i32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %btoken = index.assume %token [lt(%token, %tokens)] : index
  %row0 = view.load %info_view[%btoken, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%btoken, %c1] : view<[%tokens]x4xi32> -> i32
  %skew = scalar.andi %pos0, %c15_i32 : i32
  %aligned = scalar.cmpi eq, %skew, %c0_i32 : i32
  %room = index.cmp uge, %token, %c1 : index
  %back = index.sub %token, %c1 : index
  %at_value = scf.select %room, %back, %btoken : index
  %at = index.assume %at_value [lt(%at_value, %tokens)] : index
  %row = view.load %info_view[%at, %c0] : view<[%tokens]x4xi32> -> i32
  %pos = view.load %info_view[%at, %c1] : view<[%tokens]x4xi32> -> i32
  %live = view.load %info_view[%at, %c2] : view<[%tokens]x4xi32> -> i32
  %want = scalar.subi %pos0, %c1_i32 : i32
  %same_row = scalar.cmpi eq, %row, %row0 : i32
  %at_pos = scalar.cmpi eq, %pos, %want : i32
  %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
  %a = scalar.andi %same_row, %at_pos : i1
  %b = scalar.andi %a, %is_live : i1
  %continues = scalar.andi %b, %room : i1
  %true = scalar.constant true : i1
  %starts_run = scalar.xori %continues, %true : i1
  %starts = scalar.ori %aligned, %starts_run : i1
  func.return %starts : i1
}

kernel.def target(@rdna3) export("g_attention_flash2") @g_attention_flash2(%tokens: index) {
  %c1 = index.constant 1 : index
  %ckv = index.constant 8 : index
  %c16 = index.constant 16 : index
  %clanes = index.constant 128 : index
  %tiles_count = index.div %tokens, %c16 : index
  kernel.launch.config workgroups(%tiles_count, %ckv, %c1) workgroup_size(%clanes, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %sliding: i32, %context_arg: index, %pool_arg: index, %q: buffer, %gate: buffer, %info: buffer, %tiles: buffer, %origins: buffer, %arena: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 16, 8192), multiple_of(%tokens_arg, 16)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 27)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 262144)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 1048576)] : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c31 = index.constant 31 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c0_i32 = scalar.constant 0 : i32
  %true_const = scalar.constant true : i1
  %d0 = index.constant 0 : index
  %d1 = index.constant 16 : index
  %d2 = index.constant 32 : index
  %d3 = index.constant 48 : index
  %d4 = index.constant 64 : index
  %d5 = index.constant 80 : index
  %d6 = index.constant 96 : index
  %d7 = index.constant 112 : index
  %d0r = index.constant 0 : index
  %d16r = index.constant 16 : index
  %d32r = index.constant 32 : index
  %d48r = index.constant 48 : index
  %d64r = index.constant 64 : index
  %d80r = index.constant 80 : index
  %d96r = index.constant 96 : index
  %d112r = index.constant 112 : index
  %d0i = index.constant 0 : index
  %d1i = index.constant 1 : index
  %d2i = index.constant 2 : index
  %d3i = index.constant 3 : index
  %d4i = index.constant 4 : index
  %d5i = index.constant 5 : index
  %d6i = index.constant 6 : index
  %d7i = index.constant 7 : index
  %c15_i32m = scalar.constant 15 : i32
  %c1_i32m = scalar.constant 1 : i32
  %far_below = scalar.constant -1000000 : i32
  %kb0_row = index.constant 0 : index
  %kbo0 = scalar.constant 0 : i32
  %kb1_row = index.constant 16 : index
  %kbo1 = scalar.constant 16 : i32
  %tile_count = index.div %tokens, %c16 : index
  %cts = index.constant 2 : index
  %tile_id = kernel.workgroup.id<x> : index
  %tile = index.assume %tile_id [lt(%tile_id, %tile_count)] : index
  %kv_id = kernel.workgroup.id<y> : index
  %kv = index.assume %kv_id [range(%kv_id, 0, 7)] : index
  %tiles_view = buffer.view %tiles[%origin] : buffer -> view<[%tokens]xi32>
  %listed_count32 = view.load %tiles_view[%c0] : view<[%tokens]xi32> -> i32
  %listed_count = index.cast %listed_count32 : i32 to index
  %listed = index.cmp ult, %tile, %listed_count : index
  %entry_slot_value = index.add %tile, %c1 : index
  %entry_slot = index.assume %entry_slot_value [lt(%entry_slot_value, %tokens)] : index
  %entry32 = view.load %tiles_view[%entry_slot] : view<[%tokens]xi32> -> i32
  %entry = index.cast %entry32 : i32 to index
  %anchor = index.assume %entry [range(%entry, 0, 8191), lt(%entry, %tokens)] : index
  %info_view = buffer.view %info[%origin] : buffer -> view<[%tokens]x4xi32>
  %row32 = view.load %info_view[%anchor, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0_32 = view.load %info_view[%anchor, %c1] : view<[%tokens]x4xi32> -> i32
  %workitem_id = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem_id [range(%workitem_id, 0, 127)] : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 3)] : index
  %c16h = index.constant 2 : index
  %sub = index.div %wave, %c16h : index
  %head_in_group = index.rem %wave, %c16h : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %lane_col = index.rem %lane, %c16 : index
  %lane_half = index.div %lane, %c16 : index
  %hi_half = index.cmp ne, %lane_half, %c0 : index
  %padded = index.add %context, %c15 : index
  %blocks = index.div %padded, %c16 : index
  %k_plane = index.mul %layer, %c2 : index
  %v_plane = index.add %k_plane, %c1 : index
  %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
  %window = index.constant 262144 : index
  %window_less = index.constant 262143 : index
  %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
  %row = index.cast %row_bound : i32 to index
  %pos_bound = scalar.assume %pos0_32 [range(%pos0_32, 0, 262128)] : i32
  %pos_a = index.cast %pos_bound : i32 to index
  %pos_tile = index.div %pos_a, %c16 : index
  %group_slot = index.rem %pos_tile, %cts : index
  %first_slot = index.cmp eq, %group_slot, %c0 : index
  %back_true = scalar.constant true : i1
  %back_false = scalar.constant false : i1
  %continued = func.call @g_tile_adjacent(%info, %tokens, %anchor, %back_true) : (buffer, index, index, i1) -> (i1)
  %starts = scalar.xori %continued, %true_const : i1
  %owner = scalar.ori %first_slot, %starts : i1
  %live0 = scalar.andi %listed, %owner : i1
  %cs0 = index.constant 0 : index
  %off0 = index.constant 0 : index
  %first0 = index.add %anchor, %off0 : index
  %firstc0 = scf.select %live0, %first0, %anchor : index
  %posr0 = index.add %pos_a, %off0 : index
  %spos0 = scf.select %live0, %posr0, %pos_a : index
  %hi0 = index.add %spos0, %c15 : index
  %far0 = index.cmp uge, %spos0, %window : index
  %use_window0 = scalar.andi %is_sliding, %far0 : i1
  %window_start0 = index.sub %spos0, %window_less : index
  %lo0 = scf.select %use_window0, %window_start0, %c0 : index
  %lo_u_0 = index.add %lo0, %c0 : index
  %hi_u_0 = index.add %hi0, %c0 : index
  %adj1 = func.call @g_tile_adjacent(%info, %tokens, %firstc0, %back_false) : (buffer, index, index, i1) -> (i1)
  %cmax1 = index.constant 0 : index
  %in_group1 = index.cmp ule, %group_slot, %cmax1 : index
  %cont1 = scalar.andi %live0, %adj1 : i1
  %live1 = scalar.andi %cont1, %in_group1 : i1
  %cs1 = index.constant 1 : index
  %off1 = index.constant 16 : index
  %first1 = index.add %anchor, %off1 : index
  %firstc1 = scf.select %live1, %first1, %anchor : index
  %posr1 = index.add %pos_a, %off1 : index
  %spos1 = scf.select %live1, %posr1, %pos_a : index
  %hi1 = index.add %spos1, %c15 : index
  %far1 = index.cmp uge, %spos1, %window : index
  %use_window1 = scalar.andi %is_sliding, %far1 : i1
  %window_start1 = index.sub %spos1, %window_less : index
  %lo1 = scf.select %use_window1, %window_start1, %c0 : index
  %lo_m1 = index.min %lo_u_0, %lo1 : index
  %lo_u_1 = scf.select %live1, %lo_m1, %lo_u_0 : index
  %hi_m1 = index.max %hi_u_0, %hi1 : index
  %hi_u_1 = scf.select %live1, %hi_m1, %hi_u_0 : index
  %is_sub1 = index.cmp eq, %sub, %cs1 : index
  %mu_1 = scf.select %is_sub1, %live1, %live0 : i1
  %mp_1 = scf.select %is_sub1, %spos1, %spos0 : index
  %mf_1 = scf.select %is_sub1, %firstc1, %anchor : index
  %any_uniform = scalar.andi %live0, %true_const : i1
  %mine = scalar.andi %mu_1, %true_const : i1
  %first_token = index.add %mf_1, %c0 : index
  %pos0 = index.add %mp_1, %c0 : index
  %key_low = index.add %lo_u_1, %c0 : index
  %pos_last = index.add %hi_u_1, %c0 : index
  scf.if %any_uniform {
  %head_value = index.madd %kv, %c16h, %head_in_group : index
  %head = index.assume %head_value [range(%head_value, 0, 15)] : index
  %key_span = index.sub %pos_last, %key_low : index
  %key_count_value = index.add %key_span, %c1 : index
  %key_count = index.assume %key_count_value [range(%key_count_value, 1, 262144)] : index
  %ckt_less = index.constant 31 : index
  %ckt = index.constant 32 : index
  %key_tiles_round = index.add %key_count, %ckt_less : index
  %key_tiles = index.div %key_tiles_round, %ckt : index

  // K [32 keys x 128 dims] and V^T [128 dims x 32 keys] tiles (F16, padded rows).
  %k_bytes = index.constant 8704 : offset
  %k_tile = buffer.alloca<workgroup> align(16) %k_bytes : buffer
  %k_view = buffer.view %k_tile[%origin] : buffer -> view<32x136xf16>
  %vt_bytes = index.constant 10240 : offset
  %vt_tile = buffer.alloca<workgroup> align(16) %vt_bytes : buffer
  %vt_view = buffer.view %vt_tile[%origin] : buffer -> view<128x40xf16>

  // Q^T as MMA rhs: lane column = token lane%16, 16 dims per fragment.
  %q_view = buffer.view %q[%origin] : buffer -> view<[%tokens]x16x8x16xf32>
  %q_token_value = index.add %first_token, %lane_col : index
  %q_token = index.assume %q_token_value [lt(%q_token_value, %tokens)] : index
  %qc0 = index.constant 0 : index
  %qraw0 = vector.load %q_view[%q_token, %head, %qc0, %c0] : view<[%tokens]x16x8x16xf32> -> vector<16xf32>
  %qh0 = vector.fptrunc %qraw0 : vector<16xf32> to vector<16xf16>
  %qf0 = vector.fragment<rhs> %qh0 shape [%c16, %c16] : vector<16xf16>
  %qc1 = index.constant 1 : index
  %qraw1 = vector.load %q_view[%q_token, %head, %qc1, %c0] : view<[%tokens]x16x8x16xf32> -> vector<16xf32>
  %qh1 = vector.fptrunc %qraw1 : vector<16xf32> to vector<16xf16>
  %qf1 = vector.fragment<rhs> %qh1 shape [%c16, %c16] : vector<16xf16>
  %qc2 = index.constant 2 : index
  %qraw2 = vector.load %q_view[%q_token, %head, %qc2, %c0] : view<[%tokens]x16x8x16xf32> -> vector<16xf32>
  %qh2 = vector.fptrunc %qraw2 : vector<16xf32> to vector<16xf16>
  %qf2 = vector.fragment<rhs> %qh2 shape [%c16, %c16] : vector<16xf16>
  %qc3 = index.constant 3 : index
  %qraw3 = vector.load %q_view[%q_token, %head, %qc3, %c0] : view<[%tokens]x16x8x16xf32> -> vector<16xf32>
  %qh3 = vector.fptrunc %qraw3 : vector<16xf32> to vector<16xf16>
  %qf3 = vector.fragment<rhs> %qh3 shape [%c16, %c16] : vector<16xf16>
  %qc4 = index.constant 4 : index
  %qraw4 = vector.load %q_view[%q_token, %head, %qc4, %c0] : view<[%tokens]x16x8x16xf32> -> vector<16xf32>
  %qh4 = vector.fptrunc %qraw4 : vector<16xf32> to vector<16xf16>
  %qf4 = vector.fragment<rhs> %qh4 shape [%c16, %c16] : vector<16xf16>
  %qc5 = index.constant 5 : index
  %qraw5 = vector.load %q_view[%q_token, %head, %qc5, %c0] : view<[%tokens]x16x8x16xf32> -> vector<16xf32>
  %qh5 = vector.fptrunc %qraw5 : vector<16xf32> to vector<16xf16>
  %qf5 = vector.fragment<rhs> %qh5 shape [%c16, %c16] : vector<16xf16>
  %qc6 = index.constant 6 : index
  %qraw6 = vector.load %q_view[%q_token, %head, %qc6, %c0] : view<[%tokens]x16x8x16xf32> -> vector<16xf32>
  %qh6 = vector.fptrunc %qraw6 : vector<16xf32> to vector<16xf16>
  %qf6 = vector.fragment<rhs> %qh6 shape [%c16, %c16] : vector<16xf16>
  %qc7 = index.constant 7 : index
  %qraw7 = vector.load %q_view[%q_token, %head, %qc7, %c0] : view<[%tokens]x16x8x16xf32> -> vector<16xf32>
  %qh7 = vector.fptrunc %qraw7 : vector<16xf32> to vector<16xf16>
  %qf7 = vector.fragment<rhs> %qh7 shape [%c16, %c16] : vector<16xf16>
  %zero8 = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zero8 shape [%c16, %c16] : vector<8xf32>
  %zero_f = scalar.constant 0.0 : f32
  %neg_big = scalar.constant -3.0e38 : f32
  %scale = scalar.constant 0.08838834764831845 : f32
  %scale_v = vector.splat %scale : vector<8xf32>
  %neg_v = vector.splat %neg_big : vector<8xf32>
  %zero_v8 = vector.constant 0.0 : vector<8xf32>
  %exchange = scalar.constant 16 : i32
  %width = scalar.constant 32 : i32
  %one_i32 = scalar.constant 1 : i32
  %two_i32 = scalar.constant 2 : i32
  %c2047_i32 = scalar.constant 262143 : i32
  %not_sliding = scalar.xori %is_sliding, %true_const : i1
  %ns_v = vector.splat %not_sliding : vector<8xi1>
  // This lane's query position and its keys' row offsets within a 16-key block.
  %query_pos = index.add %pos0, %lane_col : index
  %qp32 = index.cast %query_pos : index to i32
  %qp_v = vector.splat %qp32 : vector<8xi32>
  %low32 = scalar.subi %qp32, %c2047_i32 : i32
  %low_v = vector.splat %low32 : vector<8xi32>
  %half32 = index.cast %lane_half : index to i32
  %row_off = vector.iota %half32 step %two_i32 : vector<8xi32>

  // Staging: thread t loads key t/4, dims (t%4)*32.
  %ctpk = index.constant 4 : index
  %cdpt = index.constant 32 : index
  %st_key_value = index.div %workitem, %ctpk : index
  %st_key = index.assume %st_key_value [range(%st_key_value, 0, 31)] : index
  %st_seg = index.rem %workitem, %ctpk : index
  %st_dim_value = index.mul %st_seg, %cdpt : index
  %st_dim = index.assume %st_dim_value [range(%st_dim_value, 0, 96)] : index
  %kz = vector.constant 0.0 : vector<32xf16>

  %kt_hot = index.sub %key_tiles, %c1 : index
  %m_hot, %l_hot, %o0_hot, %o1_hot, %o2_hot, %o3_hot, %o4_hot, %o5_hot, %o6_hot, %o7_hot = scf.for %kt = [%c0 to %kt_hot step %c1](%m = %neg_big : f32, %l = %zero_f : f32, %a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>, %a4 = %init : vector<8xf32>, %a5 = %init : vector<8xf32>, %a6 = %init : vector<8xf32>, %a7 = %init : vector<8xf32>) -> (f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %tile_first = index.madd %kt, %ckt, %key_low : index

    %spo0 = index.constant 0 : index
    %st_key0 = index.add %st_key, %spo0 : index
    %key_pos0 = index.add %tile_first, %st_key0 : index
    %key_valid0 = index.cmp ule, %key_pos0, %pos_last : index
    %kvals0, %vvals0 = scf.if %key_valid0 -> (vector<32xf16>, vector<32xf16>) {
      %kp0 = index.assume %key_pos0 [range(%key_pos0, 0, 262143)] : index
      %k_offset0 = func.call @g_kv_offset(%origins, %row, %kp0, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %v_offset0 = func.call @g_kv_offset(%origins, %row, %kp0, %blocks, %v_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %k_cache0 = buffer.view %arena[%k_offset0] : buffer -> view<8x128xf16>
      %v_cache0 = buffer.view %arena[%v_offset0] : buffer -> view<8x128xf16>
      %kh0 = vector.load %k_cache0[%kv, %st_dim] : view<8x128xf16> -> vector<32xf16>
      %vh0 = vector.load %v_cache0[%kv, %st_dim] : view<8x128xf16> -> vector<32xf16>
      scf.yield %kh0, %vh0 : vector<32xf16>, vector<32xf16>
    } else {
      scf.yield %kz, %kz : vector<32xf16>, vector<32xf16>
    }
    vector.store %kvals0, %k_view[%st_key0, %st_dim] : vector<32xf16>, view<32x136xf16>
    scf.for %j0 = [%c0 to %cdpt step %c1] unroll {
      %vj0 = vector.extract %vvals0[%j0] : vector<32xf16> -> f16
      %vt_row0_value = index.add %st_dim, %j0 : index
      %vt_row0 = index.assume %vt_row0_value [range(%vt_row0_value, 0, 127)] : index
      view.store %vj0, %vt_view[%vt_row0, %st_key0] : f16, view<128x40xf16>
    }

    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %tf32 = index.cast %tile_first : index to i32
    %kl0_0 = vector.fragment.load<lhs> %k_view[%kb0_row, %d0] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_0 = vector.mma %kl0_0, %qf0, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_1 = vector.fragment.load<lhs> %k_view[%kb0_row, %d1] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_1 = vector.mma %kl0_1, %qf1, %s0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_2 = vector.fragment.load<lhs> %k_view[%kb0_row, %d2] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_2 = vector.mma %kl0_2, %qf2, %s0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_3 = vector.fragment.load<lhs> %k_view[%kb0_row, %d3] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_3 = vector.mma %kl0_3, %qf3, %s0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_4 = vector.fragment.load<lhs> %k_view[%kb0_row, %d4] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_4 = vector.mma %kl0_4, %qf4, %s0_3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_5 = vector.fragment.load<lhs> %k_view[%kb0_row, %d5] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_5 = vector.mma %kl0_5, %qf5, %s0_4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_6 = vector.fragment.load<lhs> %k_view[%kb0_row, %d6] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_6 = vector.mma %kl0_6, %qf6, %s0_5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_7 = vector.fragment.load<lhs> %k_view[%kb0_row, %d7] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_7 = vector.mma %kl0_7, %qf7, %s0_6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %sc0 = vector.mulf %s0_7, %scale_v : vector<8xf32>
    %base0 = scalar.addi %tf32, %kbo0 : i32
    %base0_v = vector.splat %base0 : vector<8xi32>
    %kpos0 = vector.addi %base0_v, %row_off : vector<8xi32>
    %causal0 = vector.cmpi sle, %kpos0, %qp_v : vector<8xi32> -> vector<8xi1>
    %inwin0 = vector.cmpi sge, %kpos0, %low_v : vector<8xi32> -> vector<8xi1>
    %winok0 = vector.ori %inwin0, %ns_v : vector<8xi1>
    %valid0 = vector.andi %causal0, %winok0 : vector<8xi1>
    %masked0 = vector.select %valid0, %sc0, %neg_v : vector<8xf32>
    %lmax0 = vector.reduce<maxnumf> %masked0, %neg_big : vector<8xf32>, f32
    %kl1_0 = vector.fragment.load<lhs> %k_view[%kb1_row, %d0] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_0 = vector.mma %kl1_0, %qf0, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_1 = vector.fragment.load<lhs> %k_view[%kb1_row, %d1] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_1 = vector.mma %kl1_1, %qf1, %s1_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_2 = vector.fragment.load<lhs> %k_view[%kb1_row, %d2] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_2 = vector.mma %kl1_2, %qf2, %s1_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_3 = vector.fragment.load<lhs> %k_view[%kb1_row, %d3] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_3 = vector.mma %kl1_3, %qf3, %s1_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_4 = vector.fragment.load<lhs> %k_view[%kb1_row, %d4] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_4 = vector.mma %kl1_4, %qf4, %s1_3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_5 = vector.fragment.load<lhs> %k_view[%kb1_row, %d5] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_5 = vector.mma %kl1_5, %qf5, %s1_4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_6 = vector.fragment.load<lhs> %k_view[%kb1_row, %d6] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_6 = vector.mma %kl1_6, %qf6, %s1_5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl1_7 = vector.fragment.load<lhs> %k_view[%kb1_row, %d7] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s1_7 = vector.mma %kl1_7, %qf7, %s1_6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %sc1 = vector.mulf %s1_7, %scale_v : vector<8xf32>
    %base1 = scalar.addi %tf32, %kbo1 : i32
    %base1_v = vector.splat %base1 : vector<8xi32>
    %kpos1 = vector.addi %base1_v, %row_off : vector<8xi32>
