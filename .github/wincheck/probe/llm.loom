      %ar8_1s = scf.select %ab8, %ar16_1, %ar16_5 : f32
      %ar8_1k = scf.select %ab8, %ar16_5, %ar16_1 : f32
      %ar8_1r, %ar8_1u = kernel.subgroup.shuffle<xor> %ar8_1s, %ad8, %aw32 : f32, i32, i32
      %ar8_1 = scalar.addf %ar8_1k, %ar8_1r : f32
      %ar8_2s = scf.select %ab8, %ar16_2, %ar16_6 : f32
      %ar8_2k = scf.select %ab8, %ar16_6, %ar16_2 : f32
      %ar8_2r, %ar8_2u = kernel.subgroup.shuffle<xor> %ar8_2s, %ad8, %aw32 : f32, i32, i32
      %ar8_2 = scalar.addf %ar8_2k, %ar8_2r : f32
      %ar8_3s = scf.select %ab8, %ar16_3, %ar16_7 : f32
      %ar8_3k = scf.select %ab8, %ar16_7, %ar16_3 : f32
      %ar8_3r, %ar8_3u = kernel.subgroup.shuffle<xor> %ar8_3s, %ad8, %aw32 : f32, i32, i32
      %ar8_3 = scalar.addf %ar8_3k, %ar8_3r : f32
      %ar4_0s = scf.select %ab4, %ar8_0, %ar8_2 : f32
