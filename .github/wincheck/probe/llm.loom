      %ac0_0_pt = scf.for %mc_0_0_pt = [%c0 to %c16 step %c1](%acc0_0_pt = %os0_pt : vector<8xf32>) -> (vector<8xf32>) {
        %mci0_0_pt = index.cast %mc_0_0_pt : index to i32
