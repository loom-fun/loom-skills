      %ar8_0s = scf.select %ab8, %ar16_0, %ar16_4 : f32
      %ar8_0k = scf.select %ab8, %ar16_4, %ar16_0 : f32
      %ar8_0r, %ar8_0u = kernel.subgroup.shuffle<xor> %ar8_0s, %ad8, %aw32 : f32, i32, i32
