    %hb_16_6r, %hb_16_6u = kernel.subgroup.shuffle<xor> %pa14, %bd16, %bw32 : f32, i32, i32
    %hb_16_6 = scalar.addf %pa6, %hb_16_6r : f32
    %hb_16_7r, %hb_16_7u = kernel.subgroup.shuffle<xor> %pa15, %bd16, %bw32 : f32, i32, i32
    %hb_16_7 = scalar.addf %pa7, %hb_16_7r : f32
    %hb_8_0r, %hb_8_0u = kernel.subgroup.shuffle<xor> %hb_16_4, %bd8, %bw32 : f32, i32, i32
    %hb_8_0 = scalar.addf %hb_16_0, %hb_8_0r : f32
    %hb_8_1r, %hb_8_1u = kernel.subgroup.shuffle<xor> %hb_16_5, %bd8, %bw32 : f32, i32, i32
    %hb_8_1 = scalar.addf %hb_16_1, %hb_8_1r : f32
    %hb_8_2r, %hb_8_2u = kernel.subgroup.shuffle<xor> %hb_16_6, %bd8, %bw32 : f32, i32, i32
    %hb_8_2 = scalar.addf %hb_16_2, %hb_8_2r : f32
    %hb_8_3r, %hb_8_3u = kernel.subgroup.shuffle<xor> %hb_16_7, %bd8, %bw32 : f32, i32, i32
    %hb_8_3 = scalar.addf %hb_16_3, %hb_8_3r : f32
    %hb_4_0r, %hb_4_0u = kernel.subgroup.shuffle<xor> %hb_8_2, %bd4, %bw32 : f32, i32, i32
    %hb_4_0 = scalar.addf %hb_8_0, %hb_4_0r : f32
    %hb_4_1r, %hb_4_1u = kernel.subgroup.shuffle<xor> %hb_8_3, %bd4, %bw32 : f32, i32, i32
    %hb_4_1 = scalar.addf %hb_8_1, %hb_4_1r : f32
    %hb_2_0r, %hb_2_0u = kernel.subgroup.shuffle<xor> %hb_4_1, %bd2, %bw32 : f32, i32, i32
    %hb_2_0 = scalar.addf %hb_4_0, %hb_2_0r : f32
    %hb_1r, %hb_1u = kernel.subgroup.shuffle<xor> %hb_2_0, %bd1, %bw32 : f32, i32, i32
    %hb_1 = scalar.addf %hb_2_0, %hb_1r : f32
    scf.if %bt_st {
      view.store %hb_1, %pv[%wave, %rb, %bt_idx] : f32, view<1x32x16xf32>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %nbv, %nbi = scf.if %my_live -> (f32, i32) {
    %ls = index.assume %my_span [lt(%my_span, %spans)] : index
    %bv2, %bi2 = scf.for %r = [%c0 to %rbk step %c1](%bv = %cbv : f32, %bi = %cbi : i32) -> (f32, i32) {
      %rb = index.assume %r [range(%r, 0, 31)] : index
      %total = scf.for %ww = [%c0 to %cW step %c1](%acc = %zero_f : f32) -> (f32) {
        %bw = index.assume %ww [range(%ww, 0, 0)] : index
        %p = view.load %pv[%bw, %rb, %my_tok] : view<1x32x16xf32> -> f32
        %nx = scalar.addf %acc, %p : f32
        scf.yield %nx : f32
      }
      %row_value = index.add %blk_row, %r : index
      %in_vocab = index.cmp ult, %row_value, %vocab : index
      %lrow = index.assume %row_value [range(%row_value, 0, 151935)] : index
      %stored = scf.select %in_vocab, %total, %neg_inf : f32
      view.store %stored, %logit_view[%ls, %lrow] : f32, view<[%spans]x151936xf32>
      %greater = scalar.cmpf ogt, %total, %bv : f32
      %better = scalar.andi %greater, %in_vocab : i1
      %row32 = index.cast %row_value : index to i32
      %v = scf.select %better, %total, %bv : f32
      %i = scf.select %better, %row32, %bi : i32
      scf.yield %v, %i : f32, i32
    }
    scf.yield %bv2, %bi2 : f32, i32
  } else {
    scf.yield %cbv, %cbi : f32, i32
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.yield %nbv, %nbi : f32, i32
  }
  scf.if %my_live {
    %ss = index.assume %my_span [lt(%my_span, %spans)] : index
    %bits_value = scalar.bitcast %best : f32 to i32
    view.store %bits_value, %partial_view[%ss, %chunk, %c0] : i32, view<[%spans]x1187x2xi32>
    view.store %best_id, %partial_view[%ss, %chunk, %c1] : i32, view<[%spans]x1187x2xi32>
  }
  kernel.return
}


// Per-row power-of-two scale (as g_row_scale) plus the scaled row as F16, the
// GEMM A operand: x16[r] = f16(x[r] * scale[r]).
kernel.def export("g_row_scale_f16_live") @g_row_scale_f16_live(%rows: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%rows_arg: index, %info: buffer, %k_arg: index, %x: buffer, %scales: buffer, %x16: buffer) {
  %rows = index.assume %rows_arg [range(%rows_arg, 1, 2097152)] : index
  %k = index.assume %k_arg [range(%k_arg, 256, 65536), multiple_of(%k_arg, 256)] : index
  %row_id = kernel.workgroup.id<x> : index
  %row = index.assume %row_id [lt(%row_id, %rows)] : index
  %lane = kernel.workitem.id<x> : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %zero_f = scalar.constant 0.0 : f32
  // vector<4> steps (k is a multiple of 256): each step of a scalar loop waits for its load (and in pass 2
  // for the previous step's store), so 4x fewer steps is ~4x less exposed latency.
  %c4 = index.constant 4 : index
  %k4 = index.div %k, %c4 : index
  %x4_view = buffer.view %x[%zero] : buffer -> view<[%rows]x[%k4]x4xf32>
  %live_view = buffer.view %info[%zero] : buffer -> view<[%rows]x4xi32>
  %live_word = view.load %live_view[%row, 2] : view<[%rows]x4xi32> -> i32
  %dead_zero = scalar.constant 0 : i32
  %row_live = scalar.cmpi ne, %live_word, %dead_zero : i32
  %zero4 = vector.splat %zero_f : vector<4xf32>
  %h4_view = buffer.view %x16[%zero] : buffer -> view<[%rows]x[%k4]x4xf16>
  %local = scf.for %c = [%lane to %k4 step %c256](%m = %zero_f : f32) -> (f32) {
    %bc = index.assume %c [lt(%c, %k4)] : index
    %v_raw = vector.load %x4_view[%row, %bc, %c0] : view<[%rows]x[%k4]x4xf32> -> vector<4xf32>
    %v = scf.select %row_live, %v_raw, %zero4 : vector<4xf32>
    %a = vector.absf %v : vector<4xf32>
    %n = vector.reduce<maxnumf> %a, %m : vector<4xf32>, f32
    scf.yield %n : f32
  }
  %maximum = kernel.workgroup.reduce<maxnumf> %local : f32
  %bits = scalar.bitcast %maximum : f32 to i32
  %c23 = scalar.constant 23 : i32
  %c255 = scalar.constant 255 : i32
  %shifted = scalar.shrui %bits, %c23 : i32
  %biased = scalar.andi %shifted, %c255 : i32
  %c127 = scalar.constant 127 : i32
  %c13 = scalar.constant 13 : i32
  %c0_i32 = scalar.constant 0 : i32
  %c100 = scalar.constant 100 : i32
  %unbiased = scalar.subi %biased, %c127 : i32
  %raw_e = scalar.subi %unbiased, %c13 : i32
  %positive = scalar.maxsi %raw_e, %c0_i32 : i32
  %e = scalar.minsi %positive, %c100 : i32
  %scale_exp = scalar.subi %c127, %e : i32
  %inverse_exp = scalar.addi %c127, %e : i32
  %scale_bits = scalar.shli %scale_exp, %c23 : i32
  %inverse_bits = scalar.shli %inverse_exp, %c23 : i32
  %scale_l = scalar.bitcast %scale_bits : i32 to f32
  %inverse_l = scalar.bitcast %inverse_bits : i32 to f32
  %scale = scf.select %row_live, %scale_l, %zero_f : f32
  %inverse = scf.select %row_live, %inverse_l, %zero_f : f32
  %scale4 = vector.splat %scale : vector<4xf32>
  scf.for %c = [%lane to %k4 step %c256] {
    %bc = index.assume %c [lt(%c, %k4)] : index
    %v_raw2 = vector.load %x4_view[%row, %bc, %c0] : view<[%rows]x[%k4]x4xf32> -> vector<4xf32>
    %v = scf.select %row_live, %v_raw2, %zero4 : vector<4xf32>
    %sv = vector.mulf %v, %scale4 : vector<4xf32>
    %hv = vector.fptrunc %sv : vector<4xf32> to vector<4xf16>
    vector.store %hv, %h4_view[%row, %bc, %c0] : vector<4xf16>, view<[%rows]x[%k4]x4xf16>
  }
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    %s_view = buffer.view %scales[%zero] : buffer -> view<[%rows]x2xf32>
    view.store %scale, %s_view[%row, %c0] : f32, view<[%rows]x2xf32>
    view.store %inverse, %s_view[%row, %c1] : f32, view<[%rows]x2xf32>
  }
  kernel.return
}

kernel.def export("g_post_add_norm_rs_live") @g_post_add_norm_rs_live(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %info: buffer, %y: buffer, %w_post: buffer, %x: buffer, %w_next: buffer, %h: buffer, %scales: buffer, %h16: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %groups = index.constant 32 : index
  %zero_f = scalar.constant 0.0 : f32
  %zero32 = vector.constant 0.0 : vector<32xf32>
  %count = scalar.constant 1024.0 : f32
  %active = index.cmp ult, %lane, %groups : index
  %bl_raw = index.min %lane, %groups : index
  %y_view = buffer.view %y[%zero] : buffer -> view<[%tokens]x32x32xf32>
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x32x32xf32>
  %yv, %xv = scf.if %active -> (vector<32xf32>, vector<32xf32>) {
    %bl = index.assume %lane [range(%lane, 0, 31)] : index
    %a = vector.load %y_view[%token, %bl, %c0] : view<[%tokens]x32x32xf32> -> vector<32xf32>
    %b = vector.load %x_view[%token, %bl, %c0] : view<[%tokens]x32x32xf32> -> vector<32xf32>
    scf.yield %a, %b : vector<32xf32>, vector<32xf32>
  } else {
    scf.yield %zero32, %zero32 : vector<32xf32>, vector<32xf32>
  }
  %ysq = vector.mulf %yv, %yv : vector<32xf32>
  %ylocal = vector.reduce<addf> %ysq, %zero_f : vector<32xf32>, f32
  %ysum = kernel.workgroup.reduce<addf> %ylocal : f32
  %ymean = scalar.divf %ysum, %count : f32
  %post_eps = scalar.constant 1e-08 : f32
  %ystable = scalar.addf %ymean, %post_eps : f32
  %yinv = scalar.rsqrtf %ystable : f32
  %yinvs = vector.splat %yinv : vector<32xf32>
  %w_post_view = buffer.view %w_post[%zero] : buffer -> view<32x32xf32>
  %w_next_view = buffer.view %w_next[%zero] : buffer -> view<32x32xf32>
  %xn = scf.if %active -> (vector<32xf32>) {
    %bl = index.assume %lane [range(%lane, 0, 31)] : index
    %wp = vector.load %w_post_view[%bl, %c0] : view<32x32xf32> -> vector<32xf32>
    %yn = vector.addf %yv, %zero32 : vector<32xf32>
    %r = vector.addf %yn, %zero32 : vector<32xf32>
    %sum = vector.addf %xv, %r : vector<32xf32>
    vector.store %sum, %x_view[%token, %bl, %c0] : vector<32xf32>, view<[%tokens]x32x32xf32>
    scf.yield %sum : vector<32xf32>
  } else {
    scf.yield %zero32 : vector<32xf32>
  }
  %xsq = vector.mulf %xn, %xn : vector<32xf32>
  %xlocal = vector.reduce<addf> %xsq, %zero_f : vector<32xf32>, f32
  %xsum = kernel.workgroup.reduce<addf> %xlocal : f32
  %xmean = scalar.divf %xsum, %count : f32
  %eps = scalar.constant 9.999999974752427e-07 : f32
  %xstable = scalar.addf %xmean, %eps : f32
  %xinv = scalar.rsqrtf %xstable : f32
  %xinvs = vector.splat %xinv : vector<32xf32>
  %hfin = scf.if %active -> (vector<32xf32>) {
    %bl = index.assume %lane [range(%lane, 0, 31)] : index
    %wn = vector.load %w_next_view[%bl, %c0] : view<32x32xf32> -> vector<32xf32>
    %xnn = vector.mulf %xn, %xinvs : vector<32xf32>
    %hv = vector.mulf %xnn, %wn : vector<32xf32>
    %h_view = buffer.view %h[%zero] : buffer -> view<[%tokens]x32x32xf32>
    vector.store %hv, %h_view[%token, %bl, %c0] : vector<32xf32>, view<[%tokens]x32x32xf32>
    scf.yield %hv : vector<32xf32>
  } else {
    scf.yield %zero32 : vector<32xf32>
  }
  %live_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %live_word = view.load %live_view[%token, 2] : view<[%tokens]x4xi32> -> i32
  %dead_zero = scalar.constant 0 : i32
  %row_live = scalar.cmpi ne, %live_word, %dead_zero : i32
  %hsel = scf.select %row_live, %hfin, %zero32 : vector<32xf32>
  %habs = vector.absf %hsel : vector<32xf32>
  %hlocal = vector.reduce<maxnumf> %habs, %zero_f : vector<32xf32>, f32
  %maximum = kernel.workgroup.reduce<maxnumf> %hlocal : f32
  %bits = scalar.bitcast %maximum : f32 to i32
  %c23 = scalar.constant 23 : i32
  %c255 = scalar.constant 255 : i32
  %shifted = scalar.shrui %bits, %c23 : i32
  %biased = scalar.andi %shifted, %c255 : i32
  %c127 = scalar.constant 127 : i32
  %c13 = scalar.constant 13 : i32
  %c0_i32 = scalar.constant 0 : i32
  %c100 = scalar.constant 100 : i32
  %unbiased = scalar.subi %biased, %c127 : i32
  %raw_e = scalar.subi %unbiased, %c13 : i32
  %positive = scalar.maxsi %raw_e, %c0_i32 : i32
  %e = scalar.minsi %positive, %c100 : i32
  %scale_exp = scalar.subi %c127, %e : i32
  %inverse_exp = scalar.addi %c127, %e : i32
  %scale_bits = scalar.shli %scale_exp, %c23 : i32
  %inverse_bits = scalar.shli %inverse_exp, %c23 : i32
  %scale_l = scalar.bitcast %scale_bits : i32 to f32
  %inverse_l = scalar.bitcast %inverse_bits : i32 to f32
  %scale = scf.select %row_live, %scale_l, %zero_f : f32
  %inverse = scf.select %row_live, %inverse_l, %zero_f : f32
  %scale32 = vector.splat %scale : vector<32xf32>
  scf.if %active {
    %bl16 = index.assume %lane [range(%lane, 0, 31)] : index
    %hsv = vector.mulf %hsel, %scale32 : vector<32xf32>
    %h16v = vector.fptrunc %hsv : vector<32xf32> to vector<32xf16>
    %h16_view = buffer.view %h16[%zero] : buffer -> view<[%tokens]x32x32xf16>
    vector.store %h16v, %h16_view[%token, %bl16, %c0] : vector<32xf16>, view<[%tokens]x32x32xf16>
  }
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    %c1s = index.constant 1 : index
    %s_view = buffer.view %scales[%zero] : buffer -> view<[%tokens]x2xf32>
    view.store %scale, %s_view[%token, %c0] : f32, view<[%tokens]x2xf32>
    view.store %inverse, %s_view[%token, %c1s] : f32, view<[%tokens]x2xf32>
  }
  kernel.return
}


kernel.def export("g_token_info") @g_token_info(%tokens: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%tokens_arg: index, %spans_arg: index, %metadata: buffer, %info: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %spans = index.assume %spans_arg [range(%spans_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %zero = index.constant 0 : offset
  %c16 = index.constant 16 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %header = buffer.view %metadata[%zero] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count_bound = scalar.assume %count32 [range(%count32, 0, 8192)] : i32
  %count_value = index.cast %count_bound : i32 to index
  %fewer = index.cmp ult, %count_value, %spans : index
  %count = scf.select %fewer, %count_value, %spans : index
  %packets = buffer.view %metadata[%c16] : buffer -> view<[%spans]x9xi32>
  %token32 = index.cast %token : index to i32
  %minus_one = scalar.constant -1 : i32
  %row, %position, %live, %span = scf.for %s = [%c0 to %count step %c1](%r = %minus_one : i32, %p = %c0_i32 : i32, %l = %c0_i32 : i32, %found = %minus_one : i32) -> (i32, i32, i32, i32) {
    %bounded_s = index.assume %s [lt(%s, %spans)] : index
    %length32 = view.load %packets[%bounded_s, 0] : view<[%spans]x9xi32> -> i32
    %position32 = view.load %packets[%bounded_s, 1] : view<[%spans]x9xi32> -> i32
    %row32 = view.load %packets[%bounded_s, 3] : view<[%spans]x9xi32> -> i32
    %input32 = view.load %packets[%bounded_s, 4] : view<[%spans]x9xi32> -> i32
    %end32 = scalar.addi %input32, %length32 : i32
    %after_begin = scalar.cmpi sge, %token32, %input32 : i32
    %before_end = scalar.cmpi slt, %token32, %end32 : i32
    %inside = scalar.andi %after_begin, %before_end : i1
    %relative = scalar.subi %token32, %input32 : i32
    %absolute = scalar.addi %position32, %relative : i32
    %s32 = index.cast %bounded_s : index to i32
    %next_r = scf.select %inside, %row32, %r : i32
    %next_p = scf.select %inside, %absolute, %p : i32
    %next_l = scf.select %inside, %c1_i32, %l : i32
    %next_s = scf.select %inside, %s32, %found : i32
    scf.yield %next_r, %next_p, %next_l, %next_s : i32, i32, i32, i32
  }
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  view.store %row, %info_view[%token, 0] : i32, view<[%tokens]x4xi32>
  view.store %position, %info_view[%token, 1] : i32, view<[%tokens]x4xi32>
  view.store %live, %info_view[%token, 2] : i32, view<[%tokens]x4xi32>
  view.store %span, %info_view[%token, 3] : i32, view<[%tokens]x4xi32>
  kernel.return
}

// x[t] = embedding[id] (optionally rmsnorm'd / scaled), h[t] = rmsnorm(x[t]) * w.
// 256 lanes; lane g < 32 dequantizes q6_k group g of the row.
kernel.def export("g_embed") @g_embed(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %ids: buffer, %table: buffer, %w: buffer, %x: buffer, %h: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c8 = index.constant 8 : index
  %groups = index.constant 32 : index
  %zero_f = scalar.constant 0.0 : f32
  %ids_view = buffer.view %ids[%zero] : buffer -> view<[%tokens]xi32>
  %raw = view.load %ids_view[%token] : view<[%tokens]xi32> -> i32
  %c0_i32 = scalar.constant 0 : i32
  %vocab_last = scalar.constant 151935 : i32
  %low = scalar.maxsi %raw, %c0_i32 : i32
  %clamped = scalar.minsi %low, %vocab_last : i32
  %bounded = scalar.assume %clamped [range(%clamped, 0, 151935)] : i32
  %id = index.cast %bounded : i32 to index
  %row_bytes = index.constant 840 : offset
  %block_bytes = index.constant 210 : offset
  %row_origin = index.scale %id, %row_bytes : index, offset -> offset
  %active = index.cmp ult, %lane, %groups : index
  %zero32 = vector.constant 0.0 : vector<32xf32>
  %values = scf.if %active -> (vector<32xf32>) {
    %block = index.div %lane, %c8 : index
    %within = index.rem %lane, %c8 : index
    %block_add = index.scale %block, %block_bytes : index, offset -> offset
    %origin = index.add %row_origin, %block_add : offset
    %v = func.call @g_q6_k_values(%table, %origin, %within) : (buffer, offset, index) -> (vector<32xf32>)
    scf.yield %v : vector<32xf32>
  } else {
    scf.yield %zero32 : vector<32xf32>
  }
  %normalized = vector.addf %values, %zero32 : vector<32xf32>
  %count = scalar.constant 1024.0 : f32
  %eps = scalar.constant 9.999999974752427e-07 : f32
  %squares2 = vector.mulf %normalized, %normalized : vector<32xf32>
  %local2 = vector.reduce<addf> %squares2, %zero_f : vector<32xf32>, f32
  %sum2 = kernel.workgroup.reduce<addf> %local2 : f32
  %mean2 = scalar.divf %sum2, %count : f32
  %stable2 = scalar.addf %mean2, %eps : f32
  %inverse2 = scalar.rsqrtf %stable2 : f32
  %inverses2 = vector.splat %inverse2 : vector<32xf32>
  scf.if %active {
    %bl = index.assume %lane [range(%lane, 0, 31)] : index
    %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x32x32xf32>
    %h_view = buffer.view %h[%zero] : buffer -> view<[%tokens]x32x32xf32>
    %w_view = buffer.view %w[%zero] : buffer -> view<32x32xf32>
    vector.store %normalized, %x_view[%token, %bl, %c0] : vector<32xf32>, view<[%tokens]x32x32xf32>
    %weights = vector.load %w_view[%bl, %c0] : view<32x32xf32> -> vector<32xf32>
    %n2 = vector.mulf %normalized, %inverses2 : vector<32xf32>
    %hv = vector.mulf %n2, %weights : vector<32xf32>
    vector.store %hv, %h_view[%token, %bl, %c0] : vector<32xf32>, view<[%tokens]x32x32xf32>
  }
  kernel.return
}

// x[t] += y[t]; h[t] = rmsnorm(x[t]) * w_next.
kernel.def export("g_post_add_norm") @g_post_add_norm(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %y: buffer, %w_post: buffer, %x: buffer, %w_next: buffer, %h: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %groups = index.constant 32 : index
  %zero_f = scalar.constant 0.0 : f32
  %zero32 = vector.constant 0.0 : vector<32xf32>
  %count = scalar.constant 1024.0 : f32
  %active = index.cmp ult, %lane, %groups : index
  %bl_raw = index.min %lane, %groups : index
  %y_view = buffer.view %y[%zero] : buffer -> view<[%tokens]x32x32xf32>
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x32x32xf32>
  %yv, %xv = scf.if %active -> (vector<32xf32>, vector<32xf32>) {
    %bl = index.assume %lane [range(%lane, 0, 31)] : index
    %a = vector.load %y_view[%token, %bl, %c0] : view<[%tokens]x32x32xf32> -> vector<32xf32>
    %b = vector.load %x_view[%token, %bl, %c0] : view<[%tokens]x32x32xf32> -> vector<32xf32>
    scf.yield %a, %b : vector<32xf32>, vector<32xf32>
  } else {
    scf.yield %zero32, %zero32 : vector<32xf32>, vector<32xf32>
  }
  %ysq = vector.mulf %yv, %yv : vector<32xf32>
  %ylocal = vector.reduce<addf> %ysq, %zero_f : vector<32xf32>, f32
  %ysum = kernel.workgroup.reduce<addf> %ylocal : f32
  %ymean = scalar.divf %ysum, %count : f32
  %post_eps = scalar.constant 1e-08 : f32
  %ystable = scalar.addf %ymean, %post_eps : f32
  %yinv = scalar.rsqrtf %ystable : f32
  %yinvs = vector.splat %yinv : vector<32xf32>
  %w_post_view = buffer.view %w_post[%zero] : buffer -> view<32x32xf32>
  %w_next_view = buffer.view %w_next[%zero] : buffer -> view<32x32xf32>
  %xn = scf.if %active -> (vector<32xf32>) {
    %bl = index.assume %lane [range(%lane, 0, 31)] : index
    %wp = vector.load %w_post_view[%bl, %c0] : view<32x32xf32> -> vector<32xf32>
    %yn = vector.addf %yv, %zero32 : vector<32xf32>
    %r = vector.addf %yn, %zero32 : vector<32xf32>
    %sum = vector.addf %xv, %r : vector<32xf32>
    vector.store %sum, %x_view[%token, %bl, %c0] : vector<32xf32>, view<[%tokens]x32x32xf32>
    scf.yield %sum : vector<32xf32>
  } else {
    scf.yield %zero32 : vector<32xf32>
  }
  %xsq = vector.mulf %xn, %xn : vector<32xf32>
  %xlocal = vector.reduce<addf> %xsq, %zero_f : vector<32xf32>, f32
  %xsum = kernel.workgroup.reduce<addf> %xlocal : f32
  %xmean = scalar.divf %xsum, %count : f32
  %eps = scalar.constant 9.999999974752427e-07 : f32
  %xstable = scalar.addf %xmean, %eps : f32
  %xinv = scalar.rsqrtf %xstable : f32
  %xinvs = vector.splat %xinv : vector<32xf32>
  scf.if %active {
    %bl = index.assume %lane [range(%lane, 0, 31)] : index
    %wn = vector.load %w_next_view[%bl, %c0] : view<32x32xf32> -> vector<32xf32>
    %xnn = vector.mulf %xn, %xinvs : vector<32xf32>
    %hv = vector.mulf %xnn, %wn : vector<32xf32>
    %h_view = buffer.view %h[%zero] : buffer -> view<[%tokens]x32x32xf32>
    vector.store %hv, %h_view[%token, %bl, %c0] : vector<32xf32>, view<[%tokens]x32x32xf32>
  }
  kernel.return
}



// Per-row power-of-two scale (as g_row_scale) plus the scaled row as F16, the
// GEMM A operand: x16[r] = f16(x[r] * scale[r]).
kernel.def export("g_row_scale_f16") @g_row_scale_f16(%rows: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%rows_arg: index, %k_arg: index, %x: buffer, %scales: buffer, %x16: buffer) {
  %rows = index.assume %rows_arg [range(%rows_arg, 1, 2097152)] : index
  %k = index.assume %k_arg [range(%k_arg, 256, 65536), multiple_of(%k_arg, 256)] : index
  %row_id = kernel.workgroup.id<x> : index
  %row = index.assume %row_id [lt(%row_id, %rows)] : index
  %lane = kernel.workitem.id<x> : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %zero_f = scalar.constant 0.0 : f32
  // vector<4> steps (k is a multiple of 256): each step of a scalar loop waits for its load (and in pass 2
  // for the previous step's store), so 4x fewer steps is ~4x less exposed latency.
  %c4 = index.constant 4 : index
  %k4 = index.div %k, %c4 : index
  %x4_view = buffer.view %x[%zero] : buffer -> view<[%rows]x[%k4]x4xf32>
  %h4_view = buffer.view %x16[%zero] : buffer -> view<[%rows]x[%k4]x4xf16>
  %local = scf.for %c = [%lane to %k4 step %c256](%m = %zero_f : f32) -> (f32) {
    %bc = index.assume %c [lt(%c, %k4)] : index
    %v = vector.load %x4_view[%row, %bc, %c0] : view<[%rows]x[%k4]x4xf32> -> vector<4xf32>
    %a = vector.absf %v : vector<4xf32>
    %n = vector.reduce<maxnumf> %a, %m : vector<4xf32>, f32
    scf.yield %n : f32
  }
  %maximum = kernel.workgroup.reduce<maxnumf> %local : f32
  %bits = scalar.bitcast %maximum : f32 to i32
  %c23 = scalar.constant 23 : i32
  %c255 = scalar.constant 255 : i32
  %shifted = scalar.shrui %bits, %c23 : i32
  %biased = scalar.andi %shifted, %c255 : i32
  %c127 = scalar.constant 127 : i32
  %c13 = scalar.constant 13 : i32
  %c0_i32 = scalar.constant 0 : i32
  %c100 = scalar.constant 100 : i32
  %unbiased = scalar.subi %biased, %c127 : i32
  %raw_e = scalar.subi %unbiased, %c13 : i32
  %positive = scalar.maxsi %raw_e, %c0_i32 : i32
  %e = scalar.minsi %positive, %c100 : i32
  %scale_exp = scalar.subi %c127, %e : i32
  %inverse_exp = scalar.addi %c127, %e : i32
  %scale_bits = scalar.shli %scale_exp, %c23 : i32
  %inverse_bits = scalar.shli %inverse_exp, %c23 : i32
  %scale = scalar.bitcast %scale_bits : i32 to f32
  %inverse = scalar.bitcast %inverse_bits : i32 to f32
  %scale4 = vector.splat %scale : vector<4xf32>
  scf.for %c = [%lane to %k4 step %c256] {
    %bc = index.assume %c [lt(%c, %k4)] : index
    %v = vector.load %x4_view[%row, %bc, %c0] : view<[%rows]x[%k4]x4xf32> -> vector<4xf32>
    %sv = vector.mulf %v, %scale4 : vector<4xf32>
    %hv = vector.fptrunc %sv : vector<4xf32> to vector<4xf16>
    vector.store %hv, %h4_view[%row, %bc, %c0] : vector<4xf16>, view<[%rows]x[%k4]x4xf16>
  }
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    %s_view = buffer.view %scales[%zero] : buffer -> view<[%rows]x2xf32>
    view.store %scale, %s_view[%row, %c0] : f32, view<[%rows]x2xf32>
    view.store %inverse, %s_view[%row, %c1] : f32, view<[%rows]x2xf32>
  }
  kernel.return
}


kernel.def export("g_qk_rope_store") @g_qk_rope_store(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %rope: i32, %context_arg: index, %pool_arg: index, %q: buffer, %k: buffer, %v: buffer, %q_norm: buffer, %k_norm: buffer, %info: buffer, %origins: buffer, %arena: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 27)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 262144)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 1048576)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 7)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %cqh = index.constant 16 : index
  %call = index.constant 24 : index
  %c0_i32 = scalar.constant 0 : i32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %row32 = view.load %info_view[%token, 0] : view<[%tokens]x4xi32> -> i32
  %position32 = view.load %info_view[%token, 1] : view<[%tokens]x4xi32> -> i32
  %live32 = view.load %info_view[%token, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  %position_low = scalar.maxsi %position32, %c0_i32 : i32
  %d1c = index.constant 32 : index
  %d1 = index.add %lane, %d1c : index
  %d2c = index.constant 64 : index
  %d2 = index.add %lane, %d2c : index
  %d3c = index.constant 96 : index
  %d3 = index.add %lane, %d3c : index
  %apply_rope = scalar.cmpi ne, %rope, %c0_i32 : i32
  %position_f = scalar.sitofp %position_low : i32 to f32
  %ln_scale = scalar.constant 0.21586735246819178 : f32
  %neg = scalar.constant -1.0 : f32
  %inv_two_pi = scalar.constant 0.15915494309189535 : f32
  %two_pi = scalar.constant 6.283185307179586 : f32
  %half = scalar.constant 0.5 : f32
  %one_f = scalar.constant 1.0 : f32
  %zero_f = scalar.constant 0.0 : f32

  // angle = position * theta^(-2i/RD) = position * exp(-i * 2 ln(theta) / RD)
  %li0 = index.cast %lane : index to i32
  %lf0 = scalar.sitofp %li0 : i32 to f32
  %ex0a = scalar.mulf %lf0, %ln_scale : f32
  %ex0b = scalar.mulf %ex0a, %neg : f32
  %if0 = scalar.expf<afn> %ex0b : f32
  %ra0 = scalar.mulf %position_f, %if0 : f32
  %tr0 = scalar.mulf %ra0, %inv_two_pi : f32
  %ts0 = scalar.addf %tr0, %half : f32
  %ti0 = scalar.fptosi %ts0 : f32 to i32
  %tf0 = scalar.sitofp %ti0 : i32 to f32
  %wr0 = scalar.mulf %tf0, %two_pi : f32
  %an0 = scalar.subf %ra0, %wr0 : f32
  %cr0 = scalar.cosf<afn> %an0 : f32
  %sr0 = scalar.sinf<afn> %an0 : f32
  %cos0 = scf.select %apply_rope, %cr0, %one_f : f32
  %sin0 = scf.select %apply_rope, %sr0, %zero_f : f32
  // angle = position * theta^(-2i/RD) = position * exp(-i * 2 ln(theta) / RD)
  %li1 = index.cast %d1 : index to i32
  %lf1 = scalar.sitofp %li1 : i32 to f32
  %ex1a = scalar.mulf %lf1, %ln_scale : f32
  %ex1b = scalar.mulf %ex1a, %neg : f32
  %if1 = scalar.expf<afn> %ex1b : f32
  %ra1 = scalar.mulf %position_f, %if1 : f32
  %tr1 = scalar.mulf %ra1, %inv_two_pi : f32
  %ts1 = scalar.addf %tr1, %half : f32
  %ti1 = scalar.fptosi %ts1 : f32 to i32
  %tf1 = scalar.sitofp %ti1 : i32 to f32
  %wr1 = scalar.mulf %tf1, %two_pi : f32
  %an1 = scalar.subf %ra1, %wr1 : f32
  %cr1 = scalar.cosf<afn> %an1 : f32
  %sr1 = scalar.sinf<afn> %an1 : f32
  %cos1 = scf.select %apply_rope, %cr1, %one_f : f32
  %sin1 = scf.select %apply_rope, %sr1, %zero_f : f32
  %q_view = buffer.view %q[%zero] : buffer -> view<[%tokens]x16x128xf32>
  %k_view = buffer.view %k[%zero] : buffer -> view<[%tokens]x8x128xf32>
  %v_view = buffer.view %v[%zero] : buffer -> view<[%tokens]x8x128xf32>
  %qn_view = buffer.view %q_norm[%zero] : buffer -> view<128xf32>
  %kn_view = buffer.view %k_norm[%zero] : buffer -> view<128xf32>
  %w0q = view.load %qn_view[%lane] : view<128xf32> -> f32
  %w0k = view.load %kn_view[%lane] : view<128xf32> -> f32
  %w1q = view.load %qn_view[%d1] : view<128xf32> -> f32
  %w1k = view.load %kn_view[%d1] : view<128xf32> -> f32
  %w2q = view.load %qn_view[%d2] : view<128xf32> -> f32
  %w2k = view.load %kn_view[%d2] : view<128xf32> -> f32
  %w3q = view.load %qn_view[%d3] : view<128xf32> -> f32
  %w3k = view.load %kn_view[%d3] : view<128xf32> -> f32
  %dims = scalar.constant 128.0 : f32
  %eps = scalar.constant 9.999999974752427e-07 : f32
  scf.for %head = [%wave to %call step %c8] {
    %bh = index.assume %head [range(%head, 0, 23)] : index
    %is_query = index.cmp ult, %bh, %cqh : index
    %kvh_value = index.sub %bh, %cqh : index
    %a0, %a1, %a2, %a3 = scf.if %is_query -> (f32, f32, f32, f32) {
      %qh = index.assume %bh [range(%bh, 0, 15)] : index
      %x0 = view.load %q_view[%token, %qh, %lane] : view<[%tokens]x16x128xf32> -> f32
      %x1 = view.load %q_view[%token, %qh, %d1] : view<[%tokens]x16x128xf32> -> f32
      %x2 = view.load %q_view[%token, %qh, %d2] : view<[%tokens]x16x128xf32> -> f32
      %x3 = view.load %q_view[%token, %qh, %d3] : view<[%tokens]x16x128xf32> -> f32
      scf.yield %x0, %x1, %x2, %x3 : f32, f32, f32, f32
    } else {
      %kh = index.assume %kvh_value [range(%kvh_value, 0, 7)] : index
      %x0 = view.load %k_view[%token, %kh, %lane] : view<[%tokens]x8x128xf32> -> f32
      %x1 = view.load %k_view[%token, %kh, %d1] : view<[%tokens]x8x128xf32> -> f32
      %x2 = view.load %k_view[%token, %kh, %d2] : view<[%tokens]x8x128xf32> -> f32
      %x3 = view.load %k_view[%token, %kh, %d3] : view<[%tokens]x8x128xf32> -> f32
      scf.yield %x0, %x1, %x2, %x3 : f32, f32, f32, f32
    }
    %s0 = scalar.mulf %a0, %a0 : f32
    %s1 = scalar.fmaf %a1, %a1, %s0 : f32
    %s2 = scalar.fmaf %a2, %a2, %s1 : f32
    %s3 = scalar.fmaf %a3, %a3, %s2 : f32
    %sum = kernel.subgroup.reduce<addf> %s3 : f32
    %mean = scalar.divf %sum, %dims : f32
    %stable = scalar.addf %mean, %eps : f32
    %inverse = scalar.rsqrtf %stable : f32
    %w0 = scf.select %is_query, %w0q, %w0k : f32
    %n0a = scalar.mulf %a0, %inverse : f32
    %n0 = scalar.mulf %n0a, %w0 : f32
    %w1 = scf.select %is_query, %w1q, %w1k : f32
    %n1a = scalar.mulf %a1, %inverse : f32
    %n1 = scalar.mulf %n1a, %w1 : f32
    %w2 = scf.select %is_query, %w2q, %w2k : f32
    %n2a = scalar.mulf %a2, %inverse : f32
    %n2 = scalar.mulf %n2a, %w2 : f32
    %w3 = scf.select %is_query, %w3q, %w3k : f32
    %n3a = scalar.mulf %a3, %inverse : f32
    %n3 = scalar.mulf %n3a, %w3 : f32
    %rc0 = scalar.mulf %n0, %cos0 : f32
    %rs2 = scalar.mulf %n2, %sin0 : f32
    %r0 = scalar.subf %rc0, %rs2 : f32
    %rc2 = scalar.mulf %n2, %cos0 : f32
    %rs0 = scalar.mulf %n0, %sin0 : f32
    %r2 = scalar.addf %rc2, %rs0 : f32
    %rc1 = scalar.mulf %n1, %cos1 : f32
    %rs3 = scalar.mulf %n3, %sin1 : f32
    %r1 = scalar.subf %rc1, %rs3 : f32
    %rc3 = scalar.mulf %n3, %cos1 : f32
    %rs1 = scalar.mulf %n1, %sin1 : f32
    %r3 = scalar.addf %rc3, %rs1 : f32
    scf.if %is_query {
      %qh = index.assume %bh [range(%bh, 0, 15)] : index
      view.store %r0, %q_view[%token, %qh, %lane] : f32, view<[%tokens]x16x128xf32>
      view.store %r1, %q_view[%token, %qh, %d1] : f32, view<[%tokens]x16x128xf32>
      view.store %r2, %q_view[%token, %qh, %d2] : f32, view<[%tokens]x16x128xf32>
      view.store %r3, %q_view[%token, %qh, %d3] : f32, view<[%tokens]x16x128xf32>
    } else {
      scf.if %live {
        %kh = index.assume %kvh_value [range(%kvh_value, 0, 7)] : index
        %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
        %row = index.cast %row_bound : i32 to index
        %position_bound = scalar.assume %position_low [range(%position_low, 0, 262143)] : i32
        %position = index.cast %position_bound : i32 to index
        %padded = index.add %context, %c15 : index
        %blocks = index.div %padded, %c16 : index
        %k_plane = index.mul %layer, %c2 : index
        %k_offset = func.call @g_kv_offset(%origins, %row, %position, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
        %position_bytes_v = index.constant 2048 : offset
        %plane_stride = index.scale %pool, %position_bytes_v : index, offset -> offset
        %v_offset = index.add %k_offset, %plane_stride : offset
        %k_cache = buffer.view %arena[%k_offset] : buffer -> view<8x128xf16>
        %v_cache = buffer.view %arena[%v_offset] : buffer -> view<8x128xf16>
        %h0 = scalar.fptrunc %r0 : f32 to f16
        view.store %h0, %k_cache[%kh, %lane] : f16, view<8x128xf16>
        %vv0 = view.load %v_view[%token, %kh, %lane] : view<[%tokens]x8x128xf32> -> f32
        %vh0 = scalar.fptrunc %vv0 : f32 to f16
        view.store %vh0, %v_cache[%kh, %lane] : f16, view<8x128xf16>
        %h1 = scalar.fptrunc %r1 : f32 to f16
        view.store %h1, %k_cache[%kh, %d1] : f16, view<8x128xf16>
        %vv1 = view.load %v_view[%token, %kh, %d1] : view<[%tokens]x8x128xf32> -> f32
        %vh1 = scalar.fptrunc %vv1 : f32 to f16
        view.store %vh1, %v_cache[%kh, %d1] : f16, view<8x128xf16>
        %h2 = scalar.fptrunc %r2 : f32 to f16
        view.store %h2, %k_cache[%kh, %d2] : f16, view<8x128xf16>
        %vv2 = view.load %v_view[%token, %kh, %d2] : view<[%tokens]x8x128xf32> -> f32
        %vh2 = scalar.fptrunc %vv2 : f32 to f16
        view.store %vh2, %v_cache[%kh, %d2] : f16, view<8x128xf16>
        %h3 = scalar.fptrunc %r3 : f32 to f16
        view.store %h3, %k_cache[%kh, %d3] : f16, view<8x128xf16>
        %vv3 = view.load %v_view[%token, %kh, %d3] : view<[%tokens]x8x128xf32> -> f32
        %vh3 = scalar.fptrunc %vv3 : f32 to f16
        view.store %vh3, %v_cache[%kh, %d3] : f16, view<8x128xf16>
      }
    }
  }
  kernel.return
}


// Splits for `visible` keys: about 32 keys each, at most 64.
func.def inline @g_split_count(%visible: index) -> (index) {
  %c1 = index.constant 1 : index
  %c127 = index.constant 31 : index
  %c128 = index.constant 32 : index
  %cmax = index.constant 64 : index
  %padded = index.add %visible, %c127 : index
  %target = index.div %padded, %c128 : index
  %capped = index.min %target, %cmax : index
  %count_value = index.max %capped, %c1 : index
  %count = index.assume %count_value [range(%count_value, 1, 64)] : index
  func.return %count : index
}

