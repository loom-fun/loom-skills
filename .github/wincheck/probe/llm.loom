    %b0_2 = scalar.addf %b0_4, %b0_2r : f32
    %b0_1r, %b0_1u = kernel.subgroup.shuffle<xor> %b0_2, %bd1, %bw32 : f32, i32, i32
    %b0_1 = scalar.addf %b0_2, %b0_1r : f32
    scf.if %bt_st {
      view.store %b0_1, %pv[0, %wave, %rb, %bt_store] : f32, view<2x1x1x4xf32>
