    %wk0_1 = vector.slice %wq0[4] : vector<32xi8> -> vector<4xi8>
    %wk0_2 = vector.slice %wq0[8] : vector<32xi8> -> vector<4xi8>
    %wk0_3 = vector.slice %wq0[12] : vector<32xi8> -> vector<4xi8>
    %wk0_4 = vector.slice %wq0[16] : vector<32xi8> -> vector<4xi8>
    %wk0_5 = vector.slice %wq0[20] : vector<32xi8> -> vector<4xi8>
    %wk0_6 = vector.slice %wq0[24] : vector<32xi8> -> vector<4xi8>
    %wk0_7 = vector.slice %wq0[28] : vector<32xi8> -> vector<4xi8>
    %qk0_0_0 = vector.slice %q0[0] : vector<32xi8> -> vector<4xi8>
    %ac0_0_0 = vector.dot4i<s8s8> %wk0_0, %qk0_0_0, %zero1i : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_1_0 = vector.slice %q0[4] : vector<32xi8> -> vector<4xi8>
    %ac0_1_0 = vector.dot4i<s8s8> %wk0_1, %qk0_1_0, %ac0_0_0 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_2_0 = vector.slice %q0[8] : vector<32xi8> -> vector<4xi8>
    %ac0_2_0 = vector.dot4i<s8s8> %wk0_2, %qk0_2_0, %ac0_1_0 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_3_0 = vector.slice %q0[12] : vector<32xi8> -> vector<4xi8>
    %ac0_3_0 = vector.dot4i<s8s8> %wk0_3, %qk0_3_0, %ac0_2_0 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_4_0 = vector.slice %q0[16] : vector<32xi8> -> vector<4xi8>
    %ac0_4_0 = vector.dot4i<s8s8> %wk0_4, %qk0_4_0, %ac0_3_0 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_5_0 = vector.slice %q0[20] : vector<32xi8> -> vector<4xi8>
    %ac0_5_0 = vector.dot4i<s8s8> %wk0_5, %qk0_5_0, %ac0_4_0 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_6_0 = vector.slice %q0[24] : vector<32xi8> -> vector<4xi8>
    %ac0_6_0 = vector.dot4i<s8s8> %wk0_6, %qk0_6_0, %ac0_5_0 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_7_0 = vector.slice %q0[28] : vector<32xi8> -> vector<4xi8>
    %ac0_7_0 = vector.dot4i<s8s8> %wk0_7, %qk0_7_0, %ac0_6_0 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %ie0_0 = vector.extract %ac0_7_0[0] : vector<1xi32> -> i32
    %df0_0 = scalar.sitofp %ie0_0 : i32 to f32
    %pd0_0 = scalar.mulf %df0_0, %sc0 : f32
    %pm0_0 = scalar.mulf %xs0, %mn0 : f32
    %pq0_0 = scalar.subf %pd0_0, %pm0_0 : f32
    %pa0_0 = scalar.mulf %pq0_0, %da0 : f32
    %b0_16r, %b0_16u = kernel.subgroup.shuffle<xor> %pa0_0, %bd16, %bw32 : f32, i32, i32
    %b0_16 = scalar.addf %pa0_0, %b0_16r : f32
    %b0_8r, %b0_8u = kernel.subgroup.shuffle<xor> %b0_16, %bd8, %bw32 : f32, i32, i32
    %b0_8 = scalar.addf %b0_16, %b0_8r : f32
    %b0_4r, %b0_4u = kernel.subgroup.shuffle<xor> %b0_8, %bd4, %bw32 : f32, i32, i32
    %b0_4 = scalar.addf %b0_8, %b0_4r : f32
    %b0_2r, %b0_2u = kernel.subgroup.shuffle<xor> %b0_4, %bd2, %bw32 : f32, i32, i32
    %b0_2 = scalar.addf %b0_4, %b0_2r : f32
    %b0_1r, %b0_1u = kernel.subgroup.shuffle<xor> %b0_2, %bd1, %bw32 : f32, i32, i32
    %b0_1 = scalar.addf %b0_2, %b0_1r : f32
    scf.if %bt_st {
      view.store %b0_1, %pv[0, %wave, %rb, %bt_store] : f32, view<1x1x1x1xf32>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %outputs = index.constant 1 : index
  %lanes_step = index.constant 32 : index
  // R*TG outputs may exceed the lane count (one-wave rows): lanes stride over them.
  scf.for %wr0 = [%workitem to %outputs step %lanes_step] {
