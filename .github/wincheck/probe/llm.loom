  %xm_off = index.scale %tokens, %xm_k : index, offset -> offset
  %xm_view = buffer.view %x[%xm_off] : buffer -> view<[%tokens]x32x2xf32>
  %row_base = index.mul %group_id, %rows_per : index
  %token0 = index.mul %tgroup_id, %tg : index
  %ok = index.cmp ult, %workitem, %groups : index
  %g_last = index.constant 31 : index
  %g_c = index.min %workitem, %g_last : index
  %g = index.assume %g_c [range(%g_c, 0, 31)] : index
  %cgpb = index.constant 8 : index
  %blk = index.div %g, %cgpb : index
  %within = index.rem %g, %cgpb : index
  %ba = index.scale %blk, %block_bytes : index, offset -> offset
  %zero_i = scalar.constant 0 : i32
  %zero8i = vector.constant 0 : vector<8xi32>
  %zero32i8 = vector.constant 0 : vector<32xi8>
  %zero1i = vector.constant 0 : vector<1xi32>
  %bw32 = scalar.constant 32 : i32
  %bc2 = index.constant 2 : index
  %bd16 = scalar.constant 16 : i32
  %bdi16 = index.constant 16 : index
  %bq16 = index.div %lane, %bdi16 : index
  %br16 = index.rem %bq16, %bc2 : index
  %bb16 = index.cmp ne, %br16, %c0 : index
  %bd8 = scalar.constant 8 : i32
  %bdi8 = index.constant 8 : index
  %bq8 = index.div %lane, %bdi8 : index
  %br8 = index.rem %bq8, %bc2 : index
  %bb8 = index.cmp ne, %br8, %c0 : index
  %bd4 = scalar.constant 4 : i32
  %bdi4 = index.constant 4 : index
  %bq4 = index.div %lane, %bdi4 : index
  %br4 = index.rem %bq4, %bc2 : index
  %bb4 = index.cmp ne, %br4, %c0 : index
  %bd2 = scalar.constant 2 : i32
  %bdi2 = index.constant 2 : index
  %bq2 = index.div %lane, %bdi2 : index
  %br2 = index.rem %bq2, %bc2 : index
  %bb2 = index.cmp ne, %br2, %c0 : index
  %bd1 = scalar.constant 1 : i32
  %bdi1 = index.constant 1 : index
  %bq1 = index.div %lane, %bdi1 : index
  %br1 = index.rem %bq1, %bc2 : index
  %bb1 = index.cmp ne, %br1, %c0 : index
  %bt_idx_v = index.add %c0, %c0 : index
  %bt_idx = index.assume %bt_idx_v [range(%bt_idx_v, 0, 0)] : index
  %bt_true = scalar.constant true : i1
  %bn0 = scalar.xori %bb16, %bt_true : i1
  %bs0 = scalar.andi %bt_true, %bn0 : i1
  %bn1 = scalar.xori %bb8, %bt_true : i1
  %bs1 = scalar.andi %bs0, %bn1 : i1
  %bn2 = scalar.xori %bb4, %bt_true : i1
  %bs2 = scalar.andi %bs1, %bn2 : i1
  %bn3 = scalar.xori %bb2, %bt_true : i1
  %bs3 = scalar.andi %bs2, %bn3 : i1
  %bn4 = scalar.xori %bb1, %bt_true : i1
  %bs4 = scalar.andi %bs3, %bn4 : i1
  %bt_st = scalar.andi %bs4, %bt_true : i1
  %chb = index.constant 0 : index
  %chbase = index.add %token0, %chb : index
  %tj0_off = index.constant 0 : index
  %tok0_raw = index.add %token0, %tj0_off : index
  %live0 = index.cmp ult, %tok0_raw, %tokens : index
  %use0 = scalar.andi %live0, %ok : i1
  %q0, %da0, %xs0 = scf.if %use0 -> (vector<32xi8>, f32, f32) {
    %tk0 = index.assume %tok0_raw [lt(%tok0_raw, %tokens)] : index
    %cw = vector.load %xq_view[%tk0, %g, %c0] : view<[%tokens]x32x8xi32> -> vector<8xi32>
    %cb = vector.bitcast %cw : vector<8xi32> to vector<32xi8>
    %mt = vector.load %xm_view[%tk0, %g, %c0] : view<[%tokens]x32x2xf32> -> vector<2xf32>
    %m0 = vector.extract %mt[0] : vector<2xf32> -> f32
    %m1 = vector.extract %mt[1] : vector<2xf32> -> f32
    scf.yield %cb, %m0, %m1 : vector<32xi8>, f32, f32
  } else {
    scf.yield %zero32i8, %zero_f, %zero_f : vector<32xi8>, f32, f32
  }
  %part_bytes = index.constant 4 : offset
  %parts = buffer.alloca<workgroup> align(16) %part_bytes : buffer
  %pv = buffer.view %parts[%zero] : buffer -> view<1x1x1x1xf32>
  %first = index.cmp eq, %lane, %c0 : index
  %bt_sv = index.add %bt_idx, %chb : index
  %bt_store = index.assume %bt_sv [range(%bt_sv, 0, 0)] : index
  scf.for %r = [%c0 to %rows_per step %c1] {
