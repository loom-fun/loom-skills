      %ac1_0_pt = scf.for %mc_1_0_pt = [%c0 to %c16 step %c1](%acc1_0_pt = %os1_pt : vector<8xf32>) -> (vector<8xf32>) {
        %mci1_0_pt = index.cast %mc_1_0_pt : index to i32
