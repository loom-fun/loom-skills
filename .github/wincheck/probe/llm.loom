        %vl0_0_pt = vector.fragment.load<lhs> %vt_view[%d0r, %kb0_row] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
        %vs0_0_pt = vector.select %m0_0_pt, %vl0_0_pt, %zero16h_pt : vector<16xf16>
        %vm0_0_pt = vector.fragment<lhs> %vs0_0_pt shape [%c16, %c16] : vector<16xf16>
        %rm0_0_pt = vector.mma %vm0_0_pt, %pt0_pt, %os0_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
