    %po1_0_pt, %pu1_0_pt = kernel.subgroup.shuffle<xor> %pi1_0_pt, %exchange, %width : f32, i32, i32
    %pi1_1_pt = vector.extract %p1_pt[%d1i] : vector<8xf32> -> f32
    %po1_1_pt, %pu1_1_pt = kernel.subgroup.shuffle<xor> %pi1_1_pt, %exchange, %width : f32, i32, i32
