      %arg4_0r, %arg4_0u = kernel.subgroup.shuffle<xor> %arg2_0l, %ad4, %aw32 : f32, i32, i32
      %arg4_0l = scf.select %ab4, %arg4_0r, %arg2_0l : f32
      %arg4_0h = scf.select %ab4, %arg2_0l, %arg4_0r : f32
      %arg4_1r, %arg4_1u = kernel.subgroup.shuffle<xor> %arg2_0h, %ad4, %aw32 : f32, i32, i32
