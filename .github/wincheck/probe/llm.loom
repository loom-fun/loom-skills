      %ar4_1 = scalar.addf %ar4_1k, %ar4_1r : f32
      %ar2_0s = scf.select %ab2, %ar4_0, %ar4_1 : f32
      %ar2_0k = scf.select %ab2, %ar4_1, %ar4_0 : f32
      %ar2_0r, %ar2_0u = kernel.subgroup.shuffle<xor> %ar2_0s, %ad2, %aw32 : f32, i32, i32
