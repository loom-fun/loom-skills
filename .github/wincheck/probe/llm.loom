    %os3_pt = vector.mulf %o3_hot, %alpha_v_pt : vector<8xf32>
    %os4_pt = vector.mulf %o4_hot, %alpha_v_pt : vector<8xf32>
    %os5_pt = vector.mulf %o5_hot, %alpha_v_pt : vector<8xf32>
    %os6_pt = vector.mulf %o6_hot, %alpha_v_pt : vector<8xf32>
    %os7_pt = vector.mulf %o7_hot, %alpha_v_pt : vector<8xf32>
