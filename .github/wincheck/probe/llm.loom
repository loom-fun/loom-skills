    %lane_col32m_pt = index.cast %lane_col : index to i32
    %win_lo15_pt = scalar.subi %pos15_i32_pt, %c2047_i32 : i32
    %zero16h_pt = vector.constant 0.0 : vector<16xf16>
    %iota16_pt = vector.iota %c0_i32 step %c1_i32m : vector<16xi32>
    %nb_last0_pt = scalar.addi %base0_pt, %c15_i32m : i32
    %nb_diag0_pt = scalar.cmpi sgt, %nb_last0_pt, %pos0_i32_pt : i32
    %nb_win0_pt = scalar.cmpi slt, %base0_pt, %win_lo15_pt : i32
    %nb_wins0_pt = scalar.andi %nb_win0_pt, %is_sliding : i1
    %nb_dead0_pt = scalar.cmpi sgt, %base0_pt, %pos15_i32_pt : i32
    %nb_live0_pt = scalar.xori %nb_dead0_pt, %true_const : i1
    %nb_diag_live0_pt = scalar.andi %nb_diag0_pt, %nb_live0_pt : i1
    %nb_edge0_pt = scalar.andi %nb_wins0_pt, %nb_live0_pt : i1
    %need0_pt = scalar.andi %nb_diag_live0_pt, %nb_live0_pt : i1
    %on0_0_pt, %on1_0_pt, %on2_0_pt, %on3_0_pt, %on4_0_pt, %on5_0_pt, %on6_0_pt, %on7_0_pt = scf.if %need0_pt -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
      %ac0_0_pt = scf.for %mc_0_0_pt = [%c0 to %c16 step %c1](%acc0_0_pt = %os0_pt : vector<8xf32>) -> (vector<8xf32>) {
        %mci0_0_pt = index.cast %mc_0_0_pt : index to i32
        %qc0_0_pt = scalar.addi %pos0_i32_pt, %mci0_0_pt : i32
