    %wk1_6 = vector.slice %wq1[24] : vector<32xi8> -> vector<4xi8>
    %wk1_7 = vector.slice %wq1[28] : vector<32xi8> -> vector<4xi8>
    %qk0_0_1 = vector.slice %q0[0] : vector<32xi8> -> vector<4xi8>
    %ac0_0_1 = vector.dot4i<s8s8> %wk1_0, %qk0_0_1, %zero1i : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_1_1 = vector.slice %q0[4] : vector<32xi8> -> vector<4xi8>
    %ac0_1_1 = vector.dot4i<s8s8> %wk1_1, %qk0_1_1, %ac0_0_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_2_1 = vector.slice %q0[8] : vector<32xi8> -> vector<4xi8>
    %ac0_2_1 = vector.dot4i<s8s8> %wk1_2, %qk0_2_1, %ac0_1_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_3_1 = vector.slice %q0[12] : vector<32xi8> -> vector<4xi8>
    %ac0_3_1 = vector.dot4i<s8s8> %wk1_3, %qk0_3_1, %ac0_2_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_4_1 = vector.slice %q0[16] : vector<32xi8> -> vector<4xi8>
    %ac0_4_1 = vector.dot4i<s8s8> %wk1_4, %qk0_4_1, %ac0_3_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_5_1 = vector.slice %q0[20] : vector<32xi8> -> vector<4xi8>
    %ac0_5_1 = vector.dot4i<s8s8> %wk1_5, %qk0_5_1, %ac0_4_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_6_1 = vector.slice %q0[24] : vector<32xi8> -> vector<4xi8>
    %ac0_6_1 = vector.dot4i<s8s8> %wk1_6, %qk0_6_1, %ac0_5_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk0_7_1 = vector.slice %q0[28] : vector<32xi8> -> vector<4xi8>
    %ac0_7_1 = vector.dot4i<s8s8> %wk1_7, %qk0_7_1, %ac0_6_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %ie1_0 = vector.extract %ac0_7_1[0] : vector<1xi32> -> i32
    %df1_0 = scalar.sitofp %ie1_0 : i32 to f32
    %pd1_0 = scalar.mulf %df1_0, %sc1 : f32
    %pm1_0 = scalar.mulf %xs0, %mn1 : f32
    %pq1_0 = scalar.subf %pd1_0, %pm1_0 : f32
    %pa1_0 = scalar.mulf %pq1_0, %da0 : f32
    %qk1_0_1 = vector.slice %q1[0] : vector<32xi8> -> vector<4xi8>
    %ac1_0_1 = vector.dot4i<s8s8> %wk1_0, %qk1_0_1, %zero1i : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk1_1_1 = vector.slice %q1[4] : vector<32xi8> -> vector<4xi8>
    %ac1_1_1 = vector.dot4i<s8s8> %wk1_1, %qk1_1_1, %ac1_0_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk1_2_1 = vector.slice %q1[8] : vector<32xi8> -> vector<4xi8>
    %ac1_2_1 = vector.dot4i<s8s8> %wk1_2, %qk1_2_1, %ac1_1_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
    %qk1_3_1 = vector.slice %q1[12] : vector<32xi8> -> vector<4xi8>
    %ac1_3_1 = vector.dot4i<s8s8> %wk1_3, %qk1_3_1, %ac1_2_1 : vector<4xi8>, vector<4xi8>, vector<1xi32>
