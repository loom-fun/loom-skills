        %vl1_0_pt = vector.fragment.load<lhs> %vt_view[%d16r, %kb0_row] shape [%c16, %c16] : view<128x40xf16> -> vector<16xf16>
        %vs1_0_pt = vector.select %m1_0_pt, %vl1_0_pt, %zero16h_pt : vector<16xf16>
        %vm1_0_pt = vector.fragment<lhs> %vs1_0_pt shape [%c16, %c16] : vector<16xf16>
