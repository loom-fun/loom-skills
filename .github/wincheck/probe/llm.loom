      %arg8_3h = scf.select %ab8, %arg4_1h, %arg8_3r : f32
      %arg16_0r, %arg16_0u = kernel.subgroup.shuffle<xor> %arg8_0l, %ad16, %aw32 : f32, i32, i32
      %arg16_0l = scf.select %ab16, %arg16_0r, %arg8_0l : f32
      %arg16_0h = scf.select %ab16, %arg8_0l, %arg16_0r : f32
      %arg16_1r, %arg16_1u = kernel.subgroup.shuffle<xor> %arg8_1l, %ad16, %aw32 : f32, i32, i32
      %arg16_1l = scf.select %ab16, %arg16_1r, %arg8_1l : f32
      %arg16_1h = scf.select %ab16, %arg8_1l, %arg16_1r : f32
      %arg16_2r, %arg16_2u = kernel.subgroup.shuffle<xor> %arg8_2l, %ad16, %aw32 : f32, i32, i32
      %arg16_2l = scf.select %ab16, %arg16_2r, %arg8_2l : f32
      %arg16_2h = scf.select %ab16, %arg8_2l, %arg16_2r : f32
      %arg16_3r, %arg16_3u = kernel.subgroup.shuffle<xor> %arg8_3l, %ad16, %aw32 : f32, i32, i32
      %arg16_3l = scf.select %ab16, %arg16_3r, %arg8_3l : f32
      %arg16_3h = scf.select %ab16, %arg8_3l, %arg16_3r : f32
      %arg16_4r, %arg16_4u = kernel.subgroup.shuffle<xor> %arg8_0h, %ad16, %aw32 : f32, i32, i32
      %arg16_4l = scf.select %ab16, %arg16_4r, %arg8_0h : f32
      %arg16_4h = scf.select %ab16, %arg8_0h, %arg16_4r : f32
      %arg16_5r, %arg16_5u = kernel.subgroup.shuffle<xor> %arg8_1h, %ad16, %aw32 : f32, i32, i32
      %arg16_5l = scf.select %ab16, %arg16_5r, %arg8_1h : f32
      %arg16_5h = scf.select %ab16, %arg8_1h, %arg16_5r : f32
      %arg16_6r, %arg16_6u = kernel.subgroup.shuffle<xor> %arg8_2h, %ad16, %aw32 : f32, i32, i32
      %arg16_6l = scf.select %ab16, %arg16_6r, %arg8_2h : f32
      %arg16_6h = scf.select %ab16, %arg8_2h, %arg16_6r : f32
      %arg16_7r, %arg16_7u = kernel.subgroup.shuffle<xor> %arg8_3h, %ad16, %aw32 : f32, i32, i32
      %arg16_7l = scf.select %ab16, %arg16_7r, %arg8_3h : f32
      %arg16_7h = scf.select %ab16, %arg8_3h, %arg16_7r : f32
      %sr0 = scalar.addf %arg16_0l, %zero_f : f32
      %sr1 = scalar.addf %arg16_1l, %zero_f : f32
      %sr2 = scalar.addf %arg16_2l, %zero_f : f32
      %sr3 = scalar.addf %arg16_3l, %zero_f : f32
      %sr4 = scalar.addf %arg16_4l, %zero_f : f32
      %sr5 = scalar.addf %arg16_5l, %zero_f : f32
      %sr6 = scalar.addf %arg16_6l, %zero_f : f32
      %sr7 = scalar.addf %arg16_7l, %zero_f : f32
      %sr8 = scalar.addf %arg16_0h, %zero_f : f32
      %sr9 = scalar.addf %arg16_1h, %zero_f : f32
      %sr10 = scalar.addf %arg16_2h, %zero_f : f32
      %sr11 = scalar.addf %arg16_3h, %zero_f : f32
      %sr12 = scalar.addf %arg16_4h, %zero_f : f32
      %sr13 = scalar.addf %arg16_5h, %zero_f : f32
      %sr14 = scalar.addf %arg16_6h, %zero_f : f32
      %sr15 = scalar.addf %arg16_7h, %zero_f : f32
      %s0 = scf.select %ok0, %sr0, %neg_big : f32
      %s1 = scf.select %ok1, %sr1, %neg_big : f32
      %s2 = scf.select %ok2, %sr2, %neg_big : f32
      %s3 = scf.select %ok3, %sr3, %neg_big : f32
      %s4 = scf.select %ok4, %sr4, %neg_big : f32
      %s5 = scf.select %ok5, %sr5, %neg_big : f32
      %s6 = scf.select %ok6, %sr6, %neg_big : f32
      %s7 = scf.select %ok7, %sr7, %neg_big : f32
      %s8 = scf.select %ok8, %sr8, %neg_big : f32
      %s9 = scf.select %ok9, %sr9, %neg_big : f32
      %s10 = scf.select %ok10, %sr10, %neg_big : f32
      %s11 = scf.select %ok11, %sr11, %neg_big : f32
      %s12 = scf.select %ok12, %sr12, %neg_big : f32
      %s13 = scf.select %ok13, %sr13, %neg_big : f32
      %s14 = scf.select %ok14, %sr14, %neg_big : f32
      %s15 = scf.select %ok15, %sr15, %neg_big : f32
      %mx0 = scalar.maxnumf %m, %s0 : f32
      %mx1 = scalar.maxnumf %mx0, %s1 : f32
      %mx2 = scalar.maxnumf %mx1, %s2 : f32
      %mx3 = scalar.maxnumf %mx2, %s3 : f32
      %mx4 = scalar.maxnumf %mx3, %s4 : f32
      %mx5 = scalar.maxnumf %mx4, %s5 : f32
      %mx6 = scalar.maxnumf %mx5, %s6 : f32
      %mx7 = scalar.maxnumf %mx6, %s7 : f32
      %mx8 = scalar.maxnumf %mx7, %s8 : f32
      %mx9 = scalar.maxnumf %mx8, %s9 : f32
      %mx10 = scalar.maxnumf %mx9, %s10 : f32
      %mx11 = scalar.maxnumf %mx10, %s11 : f32
      %mx12 = scalar.maxnumf %mx11, %s12 : f32
      %mx13 = scalar.maxnumf %mx12, %s13 : f32
      %mx14 = scalar.maxnumf %mx13, %s14 : f32
      %mx15 = scalar.maxnumf %mx14, %s15 : f32
      %m_shift = scalar.subf %m, %mx15 : f32
      %alpha = scalar.expf<afn> %m_shift : f32
      %l_scaled = scalar.mulf %l, %alpha : f32
      %alpha_v = vector.splat %alpha : vector<4xf32>
      %acc_s = vector.mulf %acc, %alpha_v : vector<4xf32>
      %d0 = scalar.subf %s0, %mx15 : f32
      %p0 = scalar.expf<afn> %d0 : f32
      %la0 = scalar.addf %l_scaled, %p0 : f32
      %pv0 = vector.splat %p0 : vector<4xf32>
      %aa0 = vector.fmaf %pv0, %v0, %acc_s : vector<4xf32>
      %d1 = scalar.subf %s1, %mx15 : f32
      %p1 = scalar.expf<afn> %d1 : f32
      %la1 = scalar.addf %la0, %p1 : f32
      %pv1 = vector.splat %p1 : vector<4xf32>
      %aa1 = vector.fmaf %pv1, %v1, %aa0 : vector<4xf32>
      %d2 = scalar.subf %s2, %mx15 : f32
      %p2 = scalar.expf<afn> %d2 : f32
      %la2 = scalar.addf %la1, %p2 : f32
      %pv2 = vector.splat %p2 : vector<4xf32>
      %aa2 = vector.fmaf %pv2, %v2, %aa1 : vector<4xf32>
      %d3 = scalar.subf %s3, %mx15 : f32
      %p3 = scalar.expf<afn> %d3 : f32
      %la3 = scalar.addf %la2, %p3 : f32
      %pv3 = vector.splat %p3 : vector<4xf32>
      %aa3 = vector.fmaf %pv3, %v3, %aa2 : vector<4xf32>
      %d4 = scalar.subf %s4, %mx15 : f32
      %p4 = scalar.expf<afn> %d4 : f32
      %la4 = scalar.addf %la3, %p4 : f32
      %pv4 = vector.splat %p4 : vector<4xf32>
      %aa4 = vector.fmaf %pv4, %v4, %aa3 : vector<4xf32>
      %d5 = scalar.subf %s5, %mx15 : f32
      %p5 = scalar.expf<afn> %d5 : f32
      %la5 = scalar.addf %la4, %p5 : f32
      %pv5 = vector.splat %p5 : vector<4xf32>
      %aa5 = vector.fmaf %pv5, %v5, %aa4 : vector<4xf32>
      %d6 = scalar.subf %s6, %mx15 : f32
      %p6 = scalar.expf<afn> %d6 : f32
      %la6 = scalar.addf %la5, %p6 : f32
      %pv6 = vector.splat %p6 : vector<4xf32>
      %aa6 = vector.fmaf %pv6, %v6, %aa5 : vector<4xf32>
      %d7 = scalar.subf %s7, %mx15 : f32
      %p7 = scalar.expf<afn> %d7 : f32
      %la7 = scalar.addf %la6, %p7 : f32
      %pv7 = vector.splat %p7 : vector<4xf32>
      %aa7 = vector.fmaf %pv7, %v7, %aa6 : vector<4xf32>
      %d8 = scalar.subf %s8, %mx15 : f32
      %p8 = scalar.expf<afn> %d8 : f32
      %la8 = scalar.addf %la7, %p8 : f32
      %pv8 = vector.splat %p8 : vector<4xf32>
      %aa8 = vector.fmaf %pv8, %v8, %aa7 : vector<4xf32>
      %d9 = scalar.subf %s9, %mx15 : f32
      %p9 = scalar.expf<afn> %d9 : f32
      %la9 = scalar.addf %la8, %p9 : f32
      %pv9 = vector.splat %p9 : vector<4xf32>
      %aa9 = vector.fmaf %pv9, %v9, %aa8 : vector<4xf32>
      %d10 = scalar.subf %s10, %mx15 : f32
      %p10 = scalar.expf<afn> %d10 : f32
      %la10 = scalar.addf %la9, %p10 : f32
      %pv10 = vector.splat %p10 : vector<4xf32>
      %aa10 = vector.fmaf %pv10, %v10, %aa9 : vector<4xf32>
      %d11 = scalar.subf %s11, %mx15 : f32
      %p11 = scalar.expf<afn> %d11 : f32
      %la11 = scalar.addf %la10, %p11 : f32
      %pv11 = vector.splat %p11 : vector<4xf32>
      %aa11 = vector.fmaf %pv11, %v11, %aa10 : vector<4xf32>
      %d12 = scalar.subf %s12, %mx15 : f32
      %p12 = scalar.expf<afn> %d12 : f32
      %la12 = scalar.addf %la11, %p12 : f32
      %pv12 = vector.splat %p12 : vector<4xf32>
      %aa12 = vector.fmaf %pv12, %v12, %aa11 : vector<4xf32>
      %d13 = scalar.subf %s13, %mx15 : f32
      %p13 = scalar.expf<afn> %d13 : f32
      %la13 = scalar.addf %la12, %p13 : f32
      %pv13 = vector.splat %p13 : vector<4xf32>
      %aa13 = vector.fmaf %pv13, %v13, %aa12 : vector<4xf32>
      %d14 = scalar.subf %s14, %mx15 : f32
      %p14 = scalar.expf<afn> %d14 : f32
      %la14 = scalar.addf %la13, %p14 : f32
      %pv14 = vector.splat %p14 : vector<4xf32>
      %aa14 = vector.fmaf %pv14, %v14, %aa13 : vector<4xf32>
      %d15 = scalar.subf %s15, %mx15 : f32
      %p15 = scalar.expf<afn> %d15 : f32
      %la15 = scalar.addf %la14, %p15 : f32
      %pv15 = vector.splat %p15 : vector<4xf32>
      %aa15 = vector.fmaf %pv15, %v15, %aa14 : vector<4xf32>
      scf.yield %mx15, %la15, %aa15 : f32, f32, vector<4xf32>
    }

    %acc_view = buffer.view %part_acc[%zero] : buffer -> view<[%tokens]x16x64x32x4xf32>
    vector.store %acc_final, %acc_view[%token, %bounded_head, %split, %lane, %c0] : vector<4xf32>, view<[%tokens]x16x64x32x4xf32>
    %first = index.cmp eq, %lane, %c0 : index
    scf.if %first {
      %ml_view = buffer.view %part_ml[%zero] : buffer -> view<[%tokens]x16x64x2xf32>
      view.store %m_final, %ml_view[%token, %bounded_head, %split, 0] : f32, view<[%tokens]x16x64x2xf32>
      view.store %l_final, %ml_view[%token, %bounded_head, %split, 1] : f32, view<[%tokens]x16x64x2xf32>
    }
    }
    }
  }
  kernel.return
}

// o[t, head] = (sum_s e^(m_s - M) acc_s / sum_s e^(m_s - M) l_s) * sigmoid(gate[t, head]).
kernel.def export("g_attention_combine") @g_attention_combine(%tokens: index) {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %cqh = index.constant 16 : index
  kernel.launch.config workgroups(%tokens, %cqh, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%tokens_arg: index, %sliding: i32, %info: buffer, %part_acc: buffer, %part_ml: buffer, %gate: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %head_id = kernel.workgroup.id<y> : index
  %head = index.assume %head_id [range(%head_id, 0, 15)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %cSc = index.constant 64 : index
  %c0_i32 = scalar.constant 0 : i32
  %zero_f = scalar.constant 0.0 : f32
  %neg_big = scalar.constant -3.0e38 : f32
  %zero4 = vector.splat %zero_f : vector<4xf32>
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %live32 = view.load %info_view[%token, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  %needed = scalar.constant true : i1
  %out_view = buffer.view %out[%zero] : buffer -> view<[%tokens]x16x32x4xf32>
  scf.if %needed {
  scf.if %live {
    %position32 = view.load %info_view[%token, 1] : view<[%tokens]x4xi32> -> i32
    %position_bound = scalar.assume %position32 [range(%position32, 0, 262143)] : i32
    %position = index.cast %position_bound : i32 to index
    %window = index.constant 262144 : index
    %window_less = index.constant 262143 : index
    %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
    %far = index.cmp uge, %position, %window : index
    %use_window = scalar.andi %is_sliding, %far : i1
    %window_start = index.sub %position, %window_less : index
    %window_low = scf.select %use_window, %window_start, %c0 : index
    %end = index.add %position, %c1 : index
    %visible_value = index.sub %end, %window_low : index
    %visible = index.assume %visible_value [range(%visible_value, 1, 262144)] : index
    %s_eff = func.call @g_split_count(%visible) : (index) -> (index)
    %ml_view = buffer.view %part_ml[%zero] : buffer -> view<[%tokens]x16x64x2xf32>
    %acc_view = buffer.view %part_acc[%zero] : buffer -> view<[%tokens]x16x64x32x4xf32>
    %maximum = scf.for %s = [%c0 to %s_eff step %c1](%mx = %neg_big : f32) -> (f32) {
      %bs = index.assume %s [range(%s, 0, 63)] : index
      %ms = view.load %ml_view[%token, %head, %bs, 0] : view<[%tokens]x16x64x2xf32> -> f32
      %next = scalar.maxnumf %mx, %ms : f32
      scf.yield %next : f32
    }
    %den, %total = scf.for %s = [%c0 to %s_eff step %c1](%d = %zero_f : f32, %acc = %zero4 : vector<4xf32>) -> (f32, vector<4xf32>) {
      %bs = index.assume %s [range(%s, 0, 63)] : index
      %ms = view.load %ml_view[%token, %head, %bs, 0] : view<[%tokens]x16x64x2xf32> -> f32
      %ls = view.load %ml_view[%token, %head, %bs, 1] : view<[%tokens]x16x64x2xf32> -> f32
      %shift = scalar.subf %ms, %maximum : f32
      %w = scalar.expf<afn> %shift : f32
      %wl = scalar.mulf %w, %ls : f32
      %d_next = scalar.addf %d, %wl : f32
      %part = vector.load %acc_view[%token, %head, %bs, %lane, %c0] : view<[%tokens]x16x64x32x4xf32> -> vector<4xf32>
      %w_v = vector.splat %w : vector<4xf32>
      %acc_next = vector.fmaf %w_v, %part, %acc : vector<4xf32>
      scf.yield %d_next, %acc_next : f32, vector<4xf32>
    }
    %one = scalar.constant 1.0 : f32
    %inv = scalar.divf %one, %den : f32
    %inv_v = vector.splat %inv : vector<4xf32>
    %attended = vector.mulf %total, %inv_v : vector<4xf32>
    %result = vector.addf %attended, %zero4 : vector<4xf32>
    vector.store %result, %out_view[%token, %head, %lane, %c0] : vector<4xf32>, view<[%tokens]x16x32x4xf32>
  } else {
    vector.store %zero4, %out_view[%token, %head, %lane, %c0] : vector<4xf32>, view<[%tokens]x16x32x4xf32>
  }
  }
  kernel.return
}

// Splits for `visible` keys: about 32 keys each, at most 16.
func.def inline @g16_split_count(%visible: index) -> (index) {
  %c1 = index.constant 1 : index
  %c127 = index.constant 31 : index
  %c128 = index.constant 32 : index
  %cmax = index.constant 16 : index
  %padded = index.add %visible, %c127 : index
  %target = index.div %padded, %c128 : index
  %capped = index.min %target, %cmax : index
  %count_value = index.max %capped, %c1 : index
  %count = index.assume %count_value [range(%count_value, 1, 16)] : index
  func.return %count : index
}

kernel.def export("g16_attention_split_listed") @g16_attention_split_listed(%count_buffer: buffer) {
  %origin_c = index.constant 0 : offset
  %counts = buffer.view %count_buffer[%origin_c] : buffer -> view<1xi32>
  %word = view.load %counts[0] : view<1xi32> -> i32
  %bounded = scalar.assume %word [range(%word, 0, 8192)] : i32
  %count = index.cast %bounded : i32 to index
  %c1 = index.constant 1 : index
  %ckvh = index.constant 8 : index
  %cS = index.constant 16 : index
  %clanes = index.constant 64 : index
  kernel.launch.config workgroups(%count, %ckvh, %cS) workgroup_size(%clanes, %c1, %c1) : index
} launch(%tokens_arg: index, %list: buffer, %layer_arg: index, %sliding: i32, %context_arg: index, %pool_arg: index, %q: buffer, %info: buffer, %origins: buffer, %arena: buffer, %part_acc: buffer, %part_ml: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
