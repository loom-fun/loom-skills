    %nb_diag_live0_pt = scalar.andi %nb_diag0_pt, %nb_live0_pt : i1
    %nb_edge0_pt = scalar.andi %nb_wins0_pt, %nb_live0_pt : i1
    %need0_pt = scalar.andi %nb_diag_live0_pt, %nb_live0_pt : i1
