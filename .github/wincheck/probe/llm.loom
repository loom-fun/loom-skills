    %po0_7_pt, %pu0_7_pt = kernel.subgroup.shuffle<xor> %pi0_7_pt, %exchange, %width : f32, i32, i32
    %partner0_pt = vector.from_elements %po0_0_pt, %po0_1_pt, %po0_2_pt, %po0_3_pt, %po0_4_pt, %po0_5_pt, %po0_6_pt, %po0_7_pt : vector<8xf32>
    %even0_pt = scf.select %hi_half, %partner0_pt, %p0_pt : vector<8xf32>
    %odd0_pt = scf.select %hi_half, %p0_pt, %partner0_pt : vector<8xf32>
