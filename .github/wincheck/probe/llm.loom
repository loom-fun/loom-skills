      %arg8_0l = scf.select %ab8, %arg8_0r, %arg4_0l : f32
      %arg8_0h = scf.select %ab8, %arg4_0l, %arg8_0r : f32
      %arg8_1r, %arg8_1u = kernel.subgroup.shuffle<xor> %arg4_1l, %ad8, %aw32 : f32, i32, i32
      %arg8_1l = scf.select %ab8, %arg8_1r, %arg4_1l : f32
      %arg8_1h = scf.select %ab8, %arg4_1l, %arg8_1r : f32
