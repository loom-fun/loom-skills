        %mh1_1g4 = vector.cmpi sle, %iota_odd, %thr_v_1g4 : vector<8xi32> -> vector<8xi1>
        %ml1_1g4 = vector.cmpi sge, %iota_odd, %lo_v_1g4 : vector<8xi32> -> vector<8xi1>
        %m1_1g4 = vector.andi %mh1_1g4, %ml1_1g4 : vector<8xi1>
        %w0_1g4 = vector.select %m0_1g4, %word_lo, %zero_w : vector<8xi32>
        %w1_1g4 = vector.select %m1_1g4, %word_hi, %zero_w : vector<8xi32>
        %mw_1g4 = vector.ori %w0_1g4, %w1_1g4 : vector<8xi32>
        %isc_1g4 = scalar.cmpi eq, %lane_col32m, %mci_1g4 : i32
        %vl4_1g4 = vector.fragment.load<lhs> %vt_view[%vr4, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
        %vw4_1g4 = vector.bitcast %vl4_1g4 : vector<16xf16> to vector<8xi32>
        %vx4_1g4 = vector.andi %vw4_1g4, %mw_1g4 : vector<8xi32>
        %vs4_1g4 = vector.bitcast %vx4_1g4 : vector<8xi32> to vector<16xf16>
        %vm4_1g4 = vector.fragment<lhs> %vs4_1g4 shape [%c16, %c16] : vector<16xf16>
        %rm4_1g4 = vector.mma %vm4_1g4, %pt1, %on4_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %acn4_1g4 = scf.select %isc_1g4, %rm4_1g4, %acc4_1g4 : vector<8xf32>
        %vl5_1g4 = vector.fragment.load<lhs> %vt_view[%vr5, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
        %vw5_1g4 = vector.bitcast %vl5_1g4 : vector<16xf16> to vector<8xi32>
        %vx5_1g4 = vector.andi %vw5_1g4, %mw_1g4 : vector<8xi32>
        %vs5_1g4 = vector.bitcast %vx5_1g4 : vector<8xi32> to vector<16xf16>
        %vm5_1g4 = vector.fragment<lhs> %vs5_1g4 shape [%c16, %c16] : vector<16xf16>
        %rm5_1g4 = vector.mma %vm5_1g4, %pt1, %on5_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %acn5_1g4 = scf.select %isc_1g4, %rm5_1g4, %acc5_1g4 : vector<8xf32>
        scf.yield %acn4_1g4, %acn5_1g4 : vector<8xf32>, vector<8xf32>
      }
      %ac6_1g6, %ac7_1g6 = scf.for %mc_1g6 = [%c0 to %c16 step %c1](%acc6_1g6 = %on6_0 : vector<8xf32>, %acc7_1g6 = %on7_0 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
        %mci_1g6 = index.cast %mc_1g6 : index to i32
        %qc_1g6 = scalar.addi %pos0_i32, %mci_1g6 : i32
        %thr_1g6 = scalar.subi %qc_1g6, %base1 : i32
        %thr_v_1g6 = vector.splat %thr_1g6 : vector<8xi32>
        %lo_1g6 = scalar.subi %thr_1g6, %cwin_i32 : i32
        %loe_1g6 = scf.select %is_sliding, %lo_1g6, %far_below : i32
        %lo_v_1g6 = vector.splat %loe_1g6 : vector<8xi32>
        %mh0_1g6 = vector.cmpi sle, %iota_even, %thr_v_1g6 : vector<8xi32> -> vector<8xi1>
        %ml0_1g6 = vector.cmpi sge, %iota_even, %lo_v_1g6 : vector<8xi32> -> vector<8xi1>
        %m0_1g6 = vector.andi %mh0_1g6, %ml0_1g6 : vector<8xi1>
        %mh1_1g6 = vector.cmpi sle, %iota_odd, %thr_v_1g6 : vector<8xi32> -> vector<8xi1>
        %ml1_1g6 = vector.cmpi sge, %iota_odd, %lo_v_1g6 : vector<8xi32> -> vector<8xi1>
        %m1_1g6 = vector.andi %mh1_1g6, %ml1_1g6 : vector<8xi1>
        %w0_1g6 = vector.select %m0_1g6, %word_lo, %zero_w : vector<8xi32>
        %w1_1g6 = vector.select %m1_1g6, %word_hi, %zero_w : vector<8xi32>
        %mw_1g6 = vector.ori %w0_1g6, %w1_1g6 : vector<8xi32>
        %isc_1g6 = scalar.cmpi eq, %lane_col32m, %mci_1g6 : i32
        %vl6_1g6 = vector.fragment.load<lhs> %vt_view[%vr6, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
        %vw6_1g6 = vector.bitcast %vl6_1g6 : vector<16xf16> to vector<8xi32>
        %vx6_1g6 = vector.andi %vw6_1g6, %mw_1g6 : vector<8xi32>
        %vs6_1g6 = vector.bitcast %vx6_1g6 : vector<8xi32> to vector<16xf16>
        %vm6_1g6 = vector.fragment<lhs> %vs6_1g6 shape [%c16, %c16] : vector<16xf16>
        %rm6_1g6 = vector.mma %vm6_1g6, %pt1, %on6_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %acn6_1g6 = scf.select %isc_1g6, %rm6_1g6, %acc6_1g6 : vector<8xf32>
        %vl7_1g6 = vector.fragment.load<lhs> %vt_view[%vr7, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
        %vw7_1g6 = vector.bitcast %vl7_1g6 : vector<16xf16> to vector<8xi32>
        %vx7_1g6 = vector.andi %vw7_1g6, %mw_1g6 : vector<8xi32>
        %vs7_1g6 = vector.bitcast %vx7_1g6 : vector<8xi32> to vector<16xf16>
        %vm7_1g6 = vector.fragment<lhs> %vs7_1g6 shape [%c16, %c16] : vector<16xf16>
        %rm7_1g6 = vector.mma %vm7_1g6, %pt1, %on7_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %acn7_1g6 = scf.select %isc_1g6, %rm7_1g6, %acc7_1g6 : vector<8xf32>
        scf.yield %acn6_1g6, %acn7_1g6 : vector<8xf32>, vector<8xf32>
      }
      scf.yield %ac0_1g0, %ac1_1g0, %ac2_1g2, %ac3_1g2, %ac4_1g4, %ac5_1g4, %ac6_1g6, %ac7_1g6 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    } else {
      %vl0_1 = vector.fragment.load<lhs> %vt_view[%vr0, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
      %pl0_1 = vector.mma %vl0_1, %pt1, %on0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl1_1 = vector.fragment.load<lhs> %vt_view[%vr1, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
      %pl1_1 = vector.mma %vl1_1, %pt1, %on1_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl2_1 = vector.fragment.load<lhs> %vt_view[%vr2, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
      %pl2_1 = vector.mma %vl2_1, %pt1, %on2_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl3_1 = vector.fragment.load<lhs> %vt_view[%vr3, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
      %pl3_1 = vector.mma %vl3_1, %pt1, %on3_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl4_1 = vector.fragment.load<lhs> %vt_view[%vr4, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
      %pl4_1 = vector.mma %vl4_1, %pt1, %on4_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl5_1 = vector.fragment.load<lhs> %vt_view[%vr5, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
      %pl5_1 = vector.mma %vl5_1, %pt1, %on5_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl6_1 = vector.fragment.load<lhs> %vt_view[%vr6, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
      %pl6_1 = vector.mma %vl6_1, %pt1, %on6_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl7_1 = vector.fragment.load<lhs> %vt_view[%vr7, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
      %pl7_1 = vector.mma %vl7_1, %pt1, %on7_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      scf.yield %pl0_1, %pl1_1, %pl2_1, %pl3_1, %pl4_1, %pl5_1, %pl6_1, %pl7_1 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %m_new, %l_new, %on0, %on1, %on2, %on3, %on4, %on5, %on6, %on7 : f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  // O^T / l, gate, store through a transposed strided view: (dim row, token col) -> out[token, head*D + dim].
  %one_f = scalar.constant 1.0 : f32
  %inv_l = scalar.divf %one_f, %l_final : f32
  %inv_v = vector.splat %inv_l : vector<8xf32>
  %cqd = index.constant 4096 : index
  %out_layout = encoding.layout.strided [%c1, %cqd] : encoding<layout>
  %out_first_a = index.mul %first_token, %cqd : index
  %cdim = index.constant 256 : index
  %head_col = index.mul %head, %cdim : index
  %head_half = index.add %head_col, %dim_base : index
  %out_first = index.add %out_first_a, %head_half : index
  %four = index.constant 4 : offset
  %out_offset = index.scale %out_first, %four : index, offset -> offset
  %out_view = buffer.view %out[%out_offset] : buffer -> view<128x16xf32, %out_layout>
  %gate_view = buffer.view %gate[%out_offset] : buffer -> view<128x16xf32, %out_layout>
  %ou0 = vector.mulf %o0, %inv_v : vector<8xf32>
  %gf0 = vector.fragment.load<result> %gate_view[%qd0_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs0 = vector.logisticf<afn> %gf0 : vector<8xf32>
  %of0 = vector.mulf %ou0, %gs0 : vector<8xf32>
  vector.fragment.store<result> %of0, %out_view[%qd0_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou1 = vector.mulf %o1, %inv_v : vector<8xf32>
  %gf1 = vector.fragment.load<result> %gate_view[%qd1_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs1 = vector.logisticf<afn> %gf1 : vector<8xf32>
  %of1 = vector.mulf %ou1, %gs1 : vector<8xf32>
  vector.fragment.store<result> %of1, %out_view[%qd1_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou2 = vector.mulf %o2, %inv_v : vector<8xf32>
  %gf2 = vector.fragment.load<result> %gate_view[%qd2_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs2 = vector.logisticf<afn> %gf2 : vector<8xf32>
  %of2 = vector.mulf %ou2, %gs2 : vector<8xf32>
  vector.fragment.store<result> %of2, %out_view[%qd2_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou3 = vector.mulf %o3, %inv_v : vector<8xf32>
  %gf3 = vector.fragment.load<result> %gate_view[%qd3_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs3 = vector.logisticf<afn> %gf3 : vector<8xf32>
  %of3 = vector.mulf %ou3, %gs3 : vector<8xf32>
  vector.fragment.store<result> %of3, %out_view[%qd3_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou4 = vector.mulf %o4, %inv_v : vector<8xf32>
  %gf4 = vector.fragment.load<result> %gate_view[%qd4_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs4 = vector.logisticf<afn> %gf4 : vector<8xf32>
  %of4 = vector.mulf %ou4, %gs4 : vector<8xf32>
  vector.fragment.store<result> %of4, %out_view[%qd4_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou5 = vector.mulf %o5, %inv_v : vector<8xf32>
  %gf5 = vector.fragment.load<result> %gate_view[%qd5_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs5 = vector.logisticf<afn> %gf5 : vector<8xf32>
  %of5 = vector.mulf %ou5, %gs5 : vector<8xf32>
  vector.fragment.store<result> %of5, %out_view[%qd5_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou6 = vector.mulf %o6, %inv_v : vector<8xf32>
  %gf6 = vector.fragment.load<result> %gate_view[%qd6_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs6 = vector.logisticf<afn> %gf6 : vector<8xf32>
  %of6 = vector.mulf %ou6, %gs6 : vector<8xf32>
  vector.fragment.store<result> %of6, %out_view[%qd6_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou7 = vector.mulf %o7, %inv_v : vector<8xf32>
  %gf7 = vector.fragment.load<result> %gate_view[%qd7_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs7 = vector.logisticf<afn> %gf7 : vector<8xf32>
  %of7 = vector.mulf %ou7, %gs7 : vector<8xf32>
  vector.fragment.store<result> %of7, %out_view[%qd7_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  }
  kernel.return
}

kernel.def export("k_flash2_partial") @k_flash2_partial(%tokens: index) {
  %c1 = index.constant 1 : index
  %ckv = index.constant 4 : index
  %c16 = index.constant 16 : index
  %clanes = index.constant 256 : index
  %tiles = index.div %tokens, %c16 : index
  %c4 = index.constant 4 : index
  %tiles4 = index.mul %tiles, %c4 : index
  kernel.launch.config workgroups(%tiles4, %ckv, %c1) workgroup_size(%clanes, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %sliding: i32, %context_arg: index, %pool_arg: index, %q: buffer, %gate: buffer, %info: buffer, %tiles: buffer, %origins: buffer, %arena: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 16, 8192), multiple_of(%tokens_arg, 16)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 35)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 262144)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 1048576)] : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c0_i32 = scalar.constant 0 : i32
  %e0 = index.constant 0 : index
  %e1 = index.constant 1 : index
  %e2 = index.constant 2 : index
  %e3 = index.constant 3 : index
  %e4 = index.constant 4 : index
  %e5 = index.constant 5 : index
  %e6 = index.constant 6 : index
  %e7 = index.constant 7 : index
  %kb0_row = index.constant 0 : index
  %kb1_row = index.constant 16 : index
  %kbo0 = scalar.constant 0 : i32
  %kbo1 = scalar.constant 16 : i32
  %c15_i32m = scalar.constant 15 : i32
  %c1_i32m = scalar.constant 1 : i32
  %far_below = scalar.constant -1000000 : i32
  %tile_count = index.div %tokens, %c16 : index
  %c4t = index.constant 4 : index
  %tile_count4 = index.mul %tile_count, %c4t : index
  %tile_id = kernel.workgroup.id<x> : index
  %tile = index.assume %tile_id [lt(%tile_id, %tile_count4)] : index
  %kv_id = kernel.workgroup.id<y> : index
  %kv = index.assume %kv_id [range(%kv_id, 0, 3)] : index
  %c2h = index.constant 2 : index
  %half = index.div %tokens, %c2h : index
  %half_bound = index.assume %half [lt(%half, %tokens)] : index
  %tiles_view = buffer.view %tiles[%origin] : buffer -> view<[%tokens]xi32>
  %listed_count32 = view.load %tiles_view[%half_bound] : view<[%tokens]xi32> -> i32
  %listed_count = index.cast %listed_count32 : i32 to index
  %listed = index.cmp ult, %tile, %listed_count : index
  %entry_base = index.add %half, %c1 : index
  %entry_slot_value = index.add %entry_base, %tile : index
  %last_slot = index.sub %tokens, %c1 : index
  %entry_slot_clamped = index.min %entry_slot_value, %last_slot : index
  %entry_slot = index.assume %entry_slot_clamped [lt(%entry_slot_clamped, %tokens)] : index
  %entry32 = view.load %tiles_view[%entry_slot] : view<[%tokens]xi32> -> i32
  %entry_raw = index.cast %entry32 : i32 to index
  // entries past the count are not initialized: a workgroup without a tile reads token 0
  %entry = scf.select %listed, %entry_raw, %c0 : index
  %first_token = index.assume %entry [range(%entry, 0, 8191), lt(%entry, %tokens)] : index
  %info_view = buffer.view %info[%origin] : buffer -> view<[%tokens]x4xi32>
  %row32 = view.load %info_view[%first_token, %c0] : view<[%tokens]x4xi32> -> i32
  %posf_32 = view.load %info_view[%first_token, %c1] : view<[%tokens]x4xi32> -> i32
  %c15_i32 = scalar.constant 15 : i32
  %off32 = scalar.andi %posf_32, %c15_i32 : i32
  %pos0_32 = scalar.subi %posf_32, %off32 : i32
  %off = index.cast %off32 : i32 to index
  scf.if %listed {
  %workitem_id = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem_id [range(%workitem_id, 0, 255)] : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 7)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %lane_col = index.rem %lane, %c16 : index
  %lane_half = index.div %lane, %c16 : index
  %hi_half = index.cmp ne, %lane_half, %c0 : index
  %head_in_group = index.div %wave, %c2 : index
  %dim_half = index.rem %wave, %c2 : index
  %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
  %row = index.cast %row_bound : i32 to index
  %pos0_bound = scalar.assume %pos0_32 [range(%pos0_32, 0, 262128)] : i32
  %pos0 = index.cast %pos0_bound : i32 to index
  %pos_last = index.add %pos0, %c15 : index
  // The last live position of the block: keys past it are not written yet (stale memory, possibly NaN), so they are
  // staged as zeros, which the causal mask already gives zero weight.
  %hi_c16_i32 = scalar.constant 16 : i32
  %hi_true = scalar.constant true : i1
  %hi_one_i32 = scalar.constant 1 : i32
  %hi_block_end = scalar.addi %pos0_32, %hi_c16_i32 : i32
  %hi_alive, %hi_cnt = scf.for %k = [%c1 to %c16 step %c1](%alive = %hi_true : i1, %n = %c0_i32 : i32) -> (i1, i32) {
    %ahead = index.add %first_token, %k : index
    %room = index.cmp ult, %ahead, %tokens : index
    %at_value = scf.select %room, %ahead, %first_token : index
    %at = index.assume %at_value [lt(%at_value, %tokens)] : index
    %m_row = view.load %info_view[%at, %c0] : view<[%tokens]x4xi32> -> i32
    %m_pos = view.load %info_view[%at, %c1] : view<[%tokens]x4xi32> -> i32
    %m_live = view.load %info_view[%at, %c2] : view<[%tokens]x4xi32> -> i32
    %k32 = index.cast %k : index to i32
    %m_want = scalar.addi %posf_32, %k32 : i32
    %m_same_row = scalar.cmpi eq, %m_row, %row32 : i32
    %m_at_pos = scalar.cmpi eq, %m_pos, %m_want : i32
    %m_is_live = scalar.cmpi ne, %m_live, %c0_i32 : i32
    %m_in_block = scalar.cmpi slt, %m_want, %hi_block_end : i32
    %m_a = scalar.andi %m_same_row, %m_at_pos : i1
    %m_b = scalar.andi %m_a, %m_is_live : i1
    %m_c = scalar.andi %m_b, %m_in_block : i1
    %m_d = scalar.andi %m_c, %room : i1
    %next_alive = scalar.andi %alive, %m_d : i1
    %step = scf.select %next_alive, %hi_one_i32, %c0_i32 : i32
    %n_next = scalar.addi %n, %step : i32
    scf.yield %next_alive, %n_next : i1, i32
  }
  %pos_hi_i32 = scalar.addi %posf_32, %hi_cnt : i32
  %pos_hi = index.cast %pos_hi_i32 : i32 to index
  %padded = index.add %context, %c15 : index
  %blocks = index.div %padded, %c16 : index
  %k_plane = index.mul %layer, %c2 : index
  %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
  %window = index.constant 512 : index
  %window_less = index.constant 511 : index
  %far = index.cmp uge, %pos0, %window : index
  %use_window = scalar.andi %is_sliding, %far : i1
  %window_start = index.sub %pos0, %window_less : index
  %key_low_raw = scf.select %use_window, %window_start, %c0 : index
  // Key tiles start on a 16-key page boundary (one page lookup covers 16 consecutive keys).
  %key_low_page = index.div %key_low_raw, %c16 : index
  %key_low = index.mul %key_low_page, %c16 : index
  %key_span = index.sub %pos_last, %key_low : index
  %key_count_value = index.add %key_span, %c1 : index
  %key_count = index.assume %key_count_value [range(%key_count_value, 1, 262144)] : index
  %ckt_less = index.constant 31 : index
  %ckt = index.constant 32 : index
  %key_tiles_round = index.add %key_count, %ckt_less : index
  %key_tiles = index.div %key_tiles_round, %ckt : index
  %cg = index.constant 4 : index
  %head_value = index.madd %kv, %cg, %head_in_group : index
  %head = index.assume %head_value [range(%head_value, 0, 15)] : index
  %chalf = index.constant 128 : index
  %dim_base = index.mul %dim_half, %chalf : index

  %k_bytes = index.constant 16896 : offset
  %k_tile = buffer.alloca<workgroup> align(16) %k_bytes : buffer
  %k_view = buffer.view %k_tile[%origin] : buffer -> view<32x264xf16>
  %vt_bytes = index.constant 20480 : offset
  %vt_tile = buffer.alloca<workgroup> align(16) %vt_bytes : buffer
  %vt_view = buffer.view %vt_tile[%origin] : buffer -> view<256x40xf16>
  // S^T partials: [wave][key block][16 keys x 16 tokens] f32.
  %s_bytes = index.constant 16384 : offset
  %s_tile = buffer.alloca<workgroup> align(16) %s_bytes : buffer
  %s_view = buffer.view %s_tile[%origin] : buffer -> view<256x16xf32>

  // This wave's half of Q^T as MMA rhs, held for the whole key loop: lane column = token, 16 dims each.
  %q_view = buffer.view %q[%origin] : buffer -> view<[%tokens]x16x256xf32>
  %col_ge = index.cmp uge, %lane_col, %off : index
  %col_rel = index.sub %lane_col, %off : index
  %col_rel_c = scf.select %col_ge, %col_rel, %c0 : index
  %q_tok_raw = index.add %first_token, %col_rel_c : index
  %q_in = index.cmp ult, %q_tok_raw, %tokens : index
  %q_tok_c = scf.select %q_in, %q_tok_raw, %first_token : index
  %q_token = index.assume %q_tok_c [lt(%q_tok_c, %tokens)] : index
  %slot_row = view.load %info_view[%q_token, %c0] : view<[%tokens]x4xi32> -> i32
  %slot_pos = view.load %info_view[%q_token, %c1] : view<[%tokens]x4xi32> -> i32
  %slot_live = view.load %info_view[%q_token, %c2] : view<[%tokens]x4xi32> -> i32
  %lane_col32 = index.cast %lane_col : index to i32
  %slot_want = scalar.addi %pos0_32, %lane_col32 : i32
  %slot_same_row = scalar.cmpi eq, %slot_row, %row32 : i32
  %slot_at_pos = scalar.cmpi eq, %slot_pos, %slot_want : i32
  %slot_is_live = scalar.cmpi ne, %slot_live, %c0_i32 : i32
  %slot_a = scalar.andi %slot_same_row, %slot_at_pos : i1
  %slot_b = scalar.andi %slot_a, %slot_is_live : i1
  %slot_c = scalar.andi %slot_b, %q_in : i1
  %slot_ok = scalar.andi %slot_c, %col_ge : i1
  %qd0_o = index.constant 0 : index
  %qd0_v = index.add %dim_base, %qd0_o : index
  %qd0 = index.assume %qd0_v [range(%qd0_v, 0, 240)] : index
  %qraw0 = vector.load %q_view[%q_token, %head, %qd0] : view<[%tokens]x16x256xf32> -> vector<16xf32>
  %qh0 = vector.fptrunc %qraw0 : vector<16xf32> to vector<16xf16>
  %qf0 = vector.fragment<rhs> %qh0 shape [%c16, %c16] : vector<16xf16>
  %qd1_o = index.constant 16 : index
  %qd1_v = index.add %dim_base, %qd1_o : index
  %qd1 = index.assume %qd1_v [range(%qd1_v, 0, 240)] : index
  %qraw1 = vector.load %q_view[%q_token, %head, %qd1] : view<[%tokens]x16x256xf32> -> vector<16xf32>
  %qh1 = vector.fptrunc %qraw1 : vector<16xf32> to vector<16xf16>
  %qf1 = vector.fragment<rhs> %qh1 shape [%c16, %c16] : vector<16xf16>
  %qd2_o = index.constant 32 : index
  %qd2_v = index.add %dim_base, %qd2_o : index
  %qd2 = index.assume %qd2_v [range(%qd2_v, 0, 240)] : index
  %qraw2 = vector.load %q_view[%q_token, %head, %qd2] : view<[%tokens]x16x256xf32> -> vector<16xf32>
  %qh2 = vector.fptrunc %qraw2 : vector<16xf32> to vector<16xf16>
  %qf2 = vector.fragment<rhs> %qh2 shape [%c16, %c16] : vector<16xf16>
  %qd3_o = index.constant 48 : index
  %qd3_v = index.add %dim_base, %qd3_o : index
  %qd3 = index.assume %qd3_v [range(%qd3_v, 0, 240)] : index
  %qraw3 = vector.load %q_view[%q_token, %head, %qd3] : view<[%tokens]x16x256xf32> -> vector<16xf32>
  %qh3 = vector.fptrunc %qraw3 : vector<16xf32> to vector<16xf16>
  %qf3 = vector.fragment<rhs> %qh3 shape [%c16, %c16] : vector<16xf16>
  %qd4_o = index.constant 64 : index
  %qd4_v = index.add %dim_base, %qd4_o : index
  %qd4 = index.assume %qd4_v [range(%qd4_v, 0, 240)] : index
  %qraw4 = vector.load %q_view[%q_token, %head, %qd4] : view<[%tokens]x16x256xf32> -> vector<16xf32>
  %qh4 = vector.fptrunc %qraw4 : vector<16xf32> to vector<16xf16>
  %qf4 = vector.fragment<rhs> %qh4 shape [%c16, %c16] : vector<16xf16>
  %qd5_o = index.constant 80 : index
  %qd5_v = index.add %dim_base, %qd5_o : index
  %qd5 = index.assume %qd5_v [range(%qd5_v, 0, 240)] : index
  %qraw5 = vector.load %q_view[%q_token, %head, %qd5] : view<[%tokens]x16x256xf32> -> vector<16xf32>
  %qh5 = vector.fptrunc %qraw5 : vector<16xf32> to vector<16xf16>
  %qf5 = vector.fragment<rhs> %qh5 shape [%c16, %c16] : vector<16xf16>
  %qd6_o = index.constant 96 : index
  %qd6_v = index.add %dim_base, %qd6_o : index
  %qd6 = index.assume %qd6_v [range(%qd6_v, 0, 240)] : index
  %qraw6 = vector.load %q_view[%q_token, %head, %qd6] : view<[%tokens]x16x256xf32> -> vector<16xf32>
  %qh6 = vector.fptrunc %qraw6 : vector<16xf32> to vector<16xf16>
  %qf6 = vector.fragment<rhs> %qh6 shape [%c16, %c16] : vector<16xf16>
  %qd7_o = index.constant 112 : index
  %qd7_v = index.add %dim_base, %qd7_o : index
  %qd7 = index.assume %qd7_v [range(%qd7_v, 0, 240)] : index
  %qraw7 = vector.load %q_view[%q_token, %head, %qd7] : view<[%tokens]x16x256xf32> -> vector<16xf32>
  %qh7 = vector.fptrunc %qraw7 : vector<16xf32> to vector<16xf16>
  %qf7 = vector.fragment<rhs> %qh7 shape [%c16, %c16] : vector<16xf16>
  %zero8 = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zero8 shape [%c16, %c16] : vector<8xf32>
  %zero_f = scalar.constant 0.0 : f32
  %neg_big = scalar.constant -3.0e38 : f32
  %scale = scalar.constant 0.0625 : f32
  %scale_v = vector.splat %scale : vector<8xf32>
  %neg_v = vector.splat %neg_big : vector<8xf32>
  %exchange = scalar.constant 16 : i32
  %width = scalar.constant 32 : i32
  %two_i32 = scalar.constant 2 : i32
  %cwin_i32 = scalar.constant 511 : i32
  %true_const = scalar.constant true : i1
  %not_sliding = scalar.xori %is_sliding, %true_const : i1
  %ns_v = vector.splat %not_sliding : vector<8xi1>
  %query_pos = index.add %pos0, %lane_col : index
  %qp32 = index.cast %query_pos : index to i32
  %qp_v = vector.splat %qp32 : vector<8xi32>
  %low32 = scalar.subi %qp32, %cwin_i32 : i32
  %low_v = vector.splat %low32 : vector<8xi32>
  %half32 = index.cast %lane_half : index to i32
  %row_off = vector.iota %half32 step %two_i32 : vector<8xi32>

  // Staging slots: key = workitem % 32, dim segment = workitem / 32 (8 segments of 32 dims).
  %st_key = index.rem %workitem, %c32 : index
  %st_seg_value = index.div %workitem, %c32 : index
  %cseg_n = index.constant 8 : index
  %st_live = index.cmp ult, %st_seg_value, %cseg_n : index
  %cseg_last = index.constant 7 : index
  %st_seg = index.min %st_seg_value, %cseg_last : index
  %cseg_w = index.constant 32 : index
  %st_dim_value = index.mul %st_seg, %cseg_w : index
  %st_dim = index.assume %st_dim_value [range(%st_dim_value, 0, 224)] : index
  %kz = vector.constant 0.0 : vector<32xf16>
  %plane_bytes_i = index.mul %pool, %c1 : index
  %pos_bytes = index.constant 2048 : offset
  %v_plane_delta = index.scale %plane_bytes_i, %pos_bytes : index, offset -> offset
  // S exchange slots: mine and my partner's (wave ^ 1).
  %my_s = index.mul %wave, %c32 : index
  %partner_odd = index.cmp eq, %dim_half, %c0 : index
  %partner_add = scf.select %partner_odd, %c1, %c0 : index
  %partner_id_value = index.madd %head_in_group, %c2, %partner_add : index
  %partner_id = index.assume %partner_id_value [range(%partner_id_value, 0, 7)] : index
  %their_s = index.mul %partner_id, %c32 : index
  %kb1 = index.constant 16 : index
  %my_s1 = index.add %my_s, %kb1 : index
  %their_s1 = index.add %their_s, %kb1 : index

  %m_final, %l_final, %o0, %o1, %o2, %o3, %o4, %o5, %o6, %o7 = scf.for %kt = [%c0 to %key_tiles step %c1](%m = %neg_big : f32, %l = %zero_f : f32, %a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>, %a4 = %init : vector<8xf32>, %a5 = %init : vector<8xf32>, %a6 = %init : vector<8xf32>, %a7 = %init : vector<8xf32>) -> (f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %tile_first = index.madd %kt, %ckt, %key_low : index
    scf.if %st_live {
      %key_pos = index.add %tile_first, %st_key : index
      %key_valid = index.cmp ule, %key_pos, %pos_hi : index
      %kvals, %vvals = scf.if %key_valid -> (vector<32xf16>, vector<32xf16>) {
        %kp = index.assume %key_pos [range(%key_pos, 0, 262143)] : index
        %k_offset = func.call @g_kv_offset(%origins, %row, %kp, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
        %v_offset = index.add %k_offset, %v_plane_delta : offset
        %k_cache = buffer.view %arena[%k_offset] : buffer -> view<4x256xf16>
        %v_cache = buffer.view %arena[%v_offset] : buffer -> view<4x256xf16>
        %kh = vector.load %k_cache[%kv, %st_dim] : view<4x256xf16> -> vector<32xf16>
        %vh = vector.load %v_cache[%kv, %st_dim] : view<4x256xf16> -> vector<32xf16>
        scf.yield %kh, %vh : vector<32xf16>, vector<32xf16>
      } else {
        scf.yield %kz, %kz : vector<32xf16>, vector<32xf16>
      }
      vector.store %kvals, %k_view[%st_key, %st_dim] : vector<32xf16>, view<32x264xf16>
      scf.for %j = [%c0 to %cseg_w step %c1] unroll {
        %vj = vector.extract %vvals[%j] : vector<32xf16> -> f16
        %vt_row_value = index.add %st_dim, %j : index
        %vt_row = index.assume %vt_row_value [range(%vt_row_value, 0, 255)] : index
        view.store %vj, %vt_view[%vt_row, %st_key] : f16, view<256x40xf16>
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %tf32 = index.cast %tile_first : index to i32
    %kc0_0 = index.add %dim_base, %qd0_o : index
    %kl0_0 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_0] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s0_0 = vector.mma %kl0_0, %qf0, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_1 = index.add %dim_base, %qd1_o : index
    %kl0_1 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_1] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s0_1 = vector.mma %kl0_1, %qf1, %s0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_2 = index.add %dim_base, %qd2_o : index
    %kl0_2 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_2] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s0_2 = vector.mma %kl0_2, %qf2, %s0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_3 = index.add %dim_base, %qd3_o : index
    %kl0_3 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_3] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s0_3 = vector.mma %kl0_3, %qf3, %s0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_4 = index.add %dim_base, %qd4_o : index
    %kl0_4 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_4] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s0_4 = vector.mma %kl0_4, %qf4, %s0_3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_5 = index.add %dim_base, %qd5_o : index
    %kl0_5 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_5] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s0_5 = vector.mma %kl0_5, %qf5, %s0_4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_6 = index.add %dim_base, %qd6_o : index
    %kl0_6 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_6] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s0_6 = vector.mma %kl0_6, %qf6, %s0_5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_7 = index.add %dim_base, %qd7_o : index
    %kl0_7 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_7] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s0_7 = vector.mma %kl0_7, %qf7, %s0_6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    vector.fragment.store<result> %s0_7, %s_view[%my_s, %c0] shape [%c16, %c16] : vector<8xf32>, view<256x16xf32>
    %kc1_0 = index.add %dim_base, %qd0_o : index
    %kl1_0 = vector.fragment.load<lhs> %k_view[%kb1_row, %kc1_0] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s1_0 = vector.mma %kl1_0, %qf0, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc1_1 = index.add %dim_base, %qd1_o : index
    %kl1_1 = vector.fragment.load<lhs> %k_view[%kb1_row, %kc1_1] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s1_1 = vector.mma %kl1_1, %qf1, %s1_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc1_2 = index.add %dim_base, %qd2_o : index
    %kl1_2 = vector.fragment.load<lhs> %k_view[%kb1_row, %kc1_2] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s1_2 = vector.mma %kl1_2, %qf2, %s1_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc1_3 = index.add %dim_base, %qd3_o : index
    %kl1_3 = vector.fragment.load<lhs> %k_view[%kb1_row, %kc1_3] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s1_3 = vector.mma %kl1_3, %qf3, %s1_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc1_4 = index.add %dim_base, %qd4_o : index
    %kl1_4 = vector.fragment.load<lhs> %k_view[%kb1_row, %kc1_4] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s1_4 = vector.mma %kl1_4, %qf4, %s1_3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc1_5 = index.add %dim_base, %qd5_o : index
    %kl1_5 = vector.fragment.load<lhs> %k_view[%kb1_row, %kc1_5] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s1_5 = vector.mma %kl1_5, %qf5, %s1_4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc1_6 = index.add %dim_base, %qd6_o : index
    %kl1_6 = vector.fragment.load<lhs> %k_view[%kb1_row, %kc1_6] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s1_6 = vector.mma %kl1_6, %qf6, %s1_5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc1_7 = index.add %dim_base, %qd7_o : index
    %kl1_7 = vector.fragment.load<lhs> %k_view[%kb1_row, %kc1_7] shape [%c16, %c16] : view<32x264xf16> -> vector<16xf16>
    %s1_7 = vector.mma %kl1_7, %qf7, %s1_6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    vector.fragment.store<result> %s1_7, %s_view[%my_s1, %c0] shape [%c16, %c16] : vector<8xf32>, view<256x16xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %sp0 = vector.fragment.load<result> %s_view[%their_s, %c0] shape [%c16, %c16] : view<256x16xf32> -> vector<8xf32>
    %st0 = vector.addf %s0_7, %sp0 : vector<8xf32>
    %sc0 = vector.mulf %st0, %scale_v : vector<8xf32>
    %base0 = scalar.addi %tf32, %kbo0 : i32
    %base0_v = vector.splat %base0 : vector<8xi32>
    %kpos0 = vector.addi %base0_v, %row_off : vector<8xi32>
    %causal0 = vector.cmpi sle, %kpos0, %qp_v : vector<8xi32> -> vector<8xi1>
    %inwin0 = vector.cmpi sge, %kpos0, %low_v : vector<8xi32> -> vector<8xi1>
    %winok0 = vector.ori %inwin0, %ns_v : vector<8xi1>
    %valid0 = vector.andi %causal0, %winok0 : vector<8xi1>
    %masked0 = vector.select %valid0, %sc0, %neg_v : vector<8xf32>
    %lmax0 = vector.reduce<maxnumf> %masked0, %neg_big : vector<8xf32>, f32
    %sp1 = vector.fragment.load<result> %s_view[%their_s1, %c0] shape [%c16, %c16] : view<256x16xf32> -> vector<8xf32>
    %st1 = vector.addf %s1_7, %sp1 : vector<8xf32>
    %sc1 = vector.mulf %st1, %scale_v : vector<8xf32>
    %base1 = scalar.addi %tf32, %kbo1 : i32
    %base1_v = vector.splat %base1 : vector<8xi32>
    %kpos1 = vector.addi %base1_v, %row_off : vector<8xi32>
    %causal1 = vector.cmpi sle, %kpos1, %qp_v : vector<8xi32> -> vector<8xi1>
    %inwin1 = vector.cmpi sge, %kpos1, %low_v : vector<8xi32> -> vector<8xi1>
    %winok1 = vector.ori %inwin1, %ns_v : vector<8xi1>
    %valid1 = vector.andi %causal1, %winok1 : vector<8xi1>
    %masked1 = vector.select %valid1, %sc1, %neg_v : vector<8xf32>
    %lmax1 = vector.reduce<maxnumf> %masked1, %neg_big : vector<8xf32>, f32
    %lmax = scalar.maxnumf %lmax0, %lmax1 : f32
    %omax, %omax_u = kernel.subgroup.shuffle<xor> %lmax, %exchange, %width : f32, i32, i32
    %tmax = scalar.maxnumf %lmax, %omax : f32
    %m_new = scalar.maxnumf %m, %tmax : f32
    %m_shift = scalar.subf %m, %m_new : f32
    %alpha = scalar.expf<afn> %m_shift : f32
    %m_new_v = vector.splat %m_new : vector<8xf32>
    %sh0 = vector.subf %masked0, %m_new_v : vector<8xf32>
    %pe0 = vector.expf<afn> %sh0 : vector<8xf32>
    %p0 = vector.select %valid0, %pe0, %zero8 : vector<8xf32>
    %ls0 = vector.reduce<addf> %p0, %zero_f : vector<8xf32>, f32
