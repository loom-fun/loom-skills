    %vr5 = index.add %dim_base, %qd5_o : index
    %vl5_0 = vector.fragment.load<lhs> %vt_view[%vr5, %kb0_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
    %on5_0 = vector.mma %vl5_0, %pt0, %os5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vl5_1 = vector.fragment.load<lhs> %vt_view[%vr5, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
    %on5 = vector.mma %vl5_1, %pt1, %on5_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %os6 = vector.mulf %a6, %alpha_v : vector<8xf32>
    %vr6 = index.add %dim_base, %qd6_o : index
    %vl6_0 = vector.fragment.load<lhs> %vt_view[%vr6, %kb0_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
    %on6_0 = vector.mma %vl6_0, %pt0, %os6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vl6_1 = vector.fragment.load<lhs> %vt_view[%vr6, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
    %on6 = vector.mma %vl6_1, %pt1, %on6_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %os7 = vector.mulf %a7, %alpha_v : vector<8xf32>
    %vr7 = index.add %dim_base, %qd7_o : index
    %vl7_0 = vector.fragment.load<lhs> %vt_view[%vr7, %kb0_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
    %on7_0 = vector.mma %vl7_0, %pt0, %os7 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vl7_1 = vector.fragment.load<lhs> %vt_view[%vr7, %kb1_row] shape [%c16, %c16] : view<256x40xf16> -> vector<16xf16>
    %on7 = vector.mma %vl7_1, %pt1, %on7_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %m_new, %l_new, %on0, %on1, %on2, %on3, %on4, %on5, %on6, %on7 : f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  // O^T / l, gate, store through a transposed strided view: (dim row, token col) -> out[token, head*D + dim].
  %one_f = scalar.constant 1.0 : f32
  %inv_l = scalar.divf %one_f, %l_final : f32
  %inv_v = vector.splat %inv_l : vector<8xf32>
  %cqd = index.constant 4096 : index
  %out_layout = encoding.layout.strided [%c1, %cqd] : encoding<layout>
  %out_first_a = index.mul %first_token, %cqd : index
  %cdim = index.constant 256 : index
  %head_col = index.mul %head, %cdim : index
  %head_half = index.add %head_col, %dim_base : index
  %out_first = index.add %out_first_a, %head_half : index
  %four = index.constant 4 : offset
  %out_offset = index.scale %out_first, %four : index, offset -> offset
  %out_view = buffer.view %out[%out_offset] : buffer -> view<128x16xf32, %out_layout>
  %gate_view = buffer.view %gate[%out_offset] : buffer -> view<128x16xf32, %out_layout>
  %ou0 = vector.mulf %o0, %inv_v : vector<8xf32>
  %gf0 = vector.fragment.load<result> %gate_view[%qd0_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs0 = vector.logisticf<afn> %gf0 : vector<8xf32>
  %of0 = vector.mulf %ou0, %gs0 : vector<8xf32>
  vector.fragment.store<result> %of0, %out_view[%qd0_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou1 = vector.mulf %o1, %inv_v : vector<8xf32>
  %gf1 = vector.fragment.load<result> %gate_view[%qd1_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs1 = vector.logisticf<afn> %gf1 : vector<8xf32>
  %of1 = vector.mulf %ou1, %gs1 : vector<8xf32>
  vector.fragment.store<result> %of1, %out_view[%qd1_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou2 = vector.mulf %o2, %inv_v : vector<8xf32>
  %gf2 = vector.fragment.load<result> %gate_view[%qd2_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs2 = vector.logisticf<afn> %gf2 : vector<8xf32>
  %of2 = vector.mulf %ou2, %gs2 : vector<8xf32>
  vector.fragment.store<result> %of2, %out_view[%qd2_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou3 = vector.mulf %o3, %inv_v : vector<8xf32>
  %gf3 = vector.fragment.load<result> %gate_view[%qd3_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs3 = vector.logisticf<afn> %gf3 : vector<8xf32>
  %of3 = vector.mulf %ou3, %gs3 : vector<8xf32>
  vector.fragment.store<result> %of3, %out_view[%qd3_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou4 = vector.mulf %o4, %inv_v : vector<8xf32>
  %gf4 = vector.fragment.load<result> %gate_view[%qd4_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs4 = vector.logisticf<afn> %gf4 : vector<8xf32>
  %of4 = vector.mulf %ou4, %gs4 : vector<8xf32>
  vector.fragment.store<result> %of4, %out_view[%qd4_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou5 = vector.mulf %o5, %inv_v : vector<8xf32>
  %gf5 = vector.fragment.load<result> %gate_view[%qd5_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs5 = vector.logisticf<afn> %gf5 : vector<8xf32>
  %of5 = vector.mulf %ou5, %gs5 : vector<8xf32>
  vector.fragment.store<result> %of5, %out_view[%qd5_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou6 = vector.mulf %o6, %inv_v : vector<8xf32>
  %gf6 = vector.fragment.load<result> %gate_view[%qd6_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs6 = vector.logisticf<afn> %gf6 : vector<8xf32>
  %of6 = vector.mulf %ou6, %gs6 : vector<8xf32>
  vector.fragment.store<result> %of6, %out_view[%qd6_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou7 = vector.mulf %o7, %inv_v : vector<8xf32>
  %gf7 = vector.fragment.load<result> %gate_view[%qd7_o, %c0] shape [%c16, %c16] : view<128x16xf32, %out_layout> -> vector<8xf32>
  %gs7 = vector.logisticf<afn> %gf7 : vector<8xf32>
  %of7 = vector.mulf %ou7, %gs7 : vector<8xf32>
  vector.fragment.store<result> %of7, %out_view[%qd7_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  }
  kernel.return
}

check.case public @pf {
  %t = check.literal value(1024) : index
  %layer = check.literal value(0) : index
