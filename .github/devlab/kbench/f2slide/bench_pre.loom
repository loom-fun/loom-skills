    %po1_2, %pu1_2 = kernel.subgroup.shuffle<xor> %pi1_2, %exchange, %width : f32, i32, i32
    %pi1_3 = vector.extract %p1[%e3] : vector<8xf32> -> f32
    %po1_3, %pu1_3 = kernel.subgroup.shuffle<xor> %pi1_3, %exchange, %width : f32, i32, i32
