      %okl13 = index.cmp uge, %key13_raw, %lo_abs : index
      %okh13 = index.cmp ult, %key13_raw, %hi_abs : index
      %ok13 = scalar.andi %okl13, %okh13 : i1
      %kd13 = index.constant 13312 : offset
      %ko13 = index.add %kb_off, %kd13 : offset
      %kc13 = buffer.view %arena[%ko13] : buffer -> view<2x32x8xf16>
      %kh13 = vector.load %kc13[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %k13 = vector.extf %kh13 : vector<8xf16> to vector<8xf32>
      %vo13 = index.add %ko13, %plane_stride : offset
