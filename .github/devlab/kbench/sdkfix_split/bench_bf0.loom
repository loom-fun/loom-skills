      %vh13 = vector.load %vc13[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %v13 = vector.extf %vh13 : vector<8xf16> to vector<8xf32>
      %key14_raw = index.add %j, %c14u : index
      %okl14 = index.cmp uge, %key14_raw, %lo_abs : index
      %okh14 = index.cmp ult, %key14_raw, %hi_abs : index
      %ok14 = scalar.andi %okl14, %okh14 : i1
      %kd14 = index.constant 14336 : offset
      %ko14 = index.add %kb_off, %kd14 : offset
      %kc14 = buffer.view %arena[%ko14] : buffer -> view<2x32x8xf16>
      %kh14 = vector.load %kc14[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %k14 = vector.extf %kh14 : vector<8xf16> to vector<8xf32>
      %vo14 = index.add %ko14, %plane_stride : offset
      %vc14 = buffer.view %arena[%vo14] : buffer -> view<2x32x8xf16>
      %vh14 = vector.load %vc14[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %v14 = vector.extf %vh14 : vector<8xf16> to vector<8xf32>
      %key15_raw = index.add %j, %c15u : index
      %okl15 = index.cmp uge, %key15_raw, %lo_abs : index
      %okh15 = index.cmp ult, %key15_raw, %hi_abs : index
      %ok15 = scalar.andi %okl15, %okh15 : i1
      %kd15 = index.constant 15360 : offset
      %ko15 = index.add %kb_off, %kd15 : offset
      %kc15 = buffer.view %arena[%ko15] : buffer -> view<2x32x8xf16>
      %kh15 = vector.load %kc15[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %k15 = vector.extf %kh15 : vector<8xf16> to vector<8xf32>
      %vo15 = index.add %ko15, %plane_stride : offset
      %vc15 = buffer.view %arena[%vo15] : buffer -> view<2x32x8xf16>
      %vh15 = vector.load %vc15[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %v15 = vector.extf %vh15 : vector<8xf16> to vector<8xf32>
      %prod0 = vector.mulf %q4, %k0 : vector<8xf32>
      %part0 = vector.reduce<addf> %prod0, %zero_f : vector<8xf32>, f32
      %sr0 = kernel.subgroup.reduce<addf> %part0 : f32
      %prod1 = vector.mulf %q4, %k1 : vector<8xf32>
      %part1 = vector.reduce<addf> %prod1, %zero_f : vector<8xf32>, f32
      %sr1 = kernel.subgroup.reduce<addf> %part1 : f32
      %prod2 = vector.mulf %q4, %k2 : vector<8xf32>
      %part2 = vector.reduce<addf> %prod2, %zero_f : vector<8xf32>, f32
      %sr2 = kernel.subgroup.reduce<addf> %part2 : f32
      %prod3 = vector.mulf %q4, %k3 : vector<8xf32>
      %part3 = vector.reduce<addf> %prod3, %zero_f : vector<8xf32>, f32
      %sr3 = kernel.subgroup.reduce<addf> %part3 : f32
      %prod4 = vector.mulf %q4, %k4 : vector<8xf32>
      %part4 = vector.reduce<addf> %prod4, %zero_f : vector<8xf32>, f32
      %sr4 = kernel.subgroup.reduce<addf> %part4 : f32
      %prod5 = vector.mulf %q4, %k5 : vector<8xf32>
      %part5 = vector.reduce<addf> %prod5, %zero_f : vector<8xf32>, f32
      %sr5 = kernel.subgroup.reduce<addf> %part5 : f32
      %prod6 = vector.mulf %q4, %k6 : vector<8xf32>
      %part6 = vector.reduce<addf> %prod6, %zero_f : vector<8xf32>, f32
      %sr6 = kernel.subgroup.reduce<addf> %part6 : f32
      %prod7 = vector.mulf %q4, %k7 : vector<8xf32>
      %part7 = vector.reduce<addf> %prod7, %zero_f : vector<8xf32>, f32
      %sr7 = kernel.subgroup.reduce<addf> %part7 : f32
      %prod8 = vector.mulf %q4, %k8 : vector<8xf32>
      %part8 = vector.reduce<addf> %prod8, %zero_f : vector<8xf32>, f32
      %sr8 = kernel.subgroup.reduce<addf> %part8 : f32
      %prod9 = vector.mulf %q4, %k9 : vector<8xf32>
      %part9 = vector.reduce<addf> %prod9, %zero_f : vector<8xf32>, f32
      %sr9 = kernel.subgroup.reduce<addf> %part9 : f32
      %prod10 = vector.mulf %q4, %k10 : vector<8xf32>
      %part10 = vector.reduce<addf> %prod10, %zero_f : vector<8xf32>, f32
      %sr10 = kernel.subgroup.reduce<addf> %part10 : f32
      %prod11 = vector.mulf %q4, %k11 : vector<8xf32>
      %part11 = vector.reduce<addf> %prod11, %zero_f : vector<8xf32>, f32
      %sr11 = kernel.subgroup.reduce<addf> %part11 : f32
      %prod12 = vector.mulf %q4, %k12 : vector<8xf32>
      %part12 = vector.reduce<addf> %prod12, %zero_f : vector<8xf32>, f32
      %sr12 = kernel.subgroup.reduce<addf> %part12 : f32
      %prod13 = vector.mulf %q4, %k13 : vector<8xf32>
      %part13 = vector.reduce<addf> %prod13, %zero_f : vector<8xf32>, f32
      %sr13 = kernel.subgroup.reduce<addf> %part13 : f32
      %prod14 = vector.mulf %q4, %k14 : vector<8xf32>
      %part14 = vector.reduce<addf> %prod14, %zero_f : vector<8xf32>, f32
      %sr14 = kernel.subgroup.reduce<addf> %part14 : f32
      %prod15 = vector.mulf %q4, %k15 : vector<8xf32>
      %part15 = vector.reduce<addf> %prod15, %zero_f : vector<8xf32>, f32
      %sr15 = kernel.subgroup.reduce<addf> %part15 : f32
      %s0 = scf.select %ok0, %sr0, %neg_big : f32
      %s1 = scf.select %ok1, %sr1, %neg_big : f32
      %s2 = scf.select %ok2, %sr2, %neg_big : f32
      %s3 = scf.select %ok3, %sr3, %neg_big : f32
      %s4 = scf.select %ok4, %sr4, %neg_big : f32
      %s5 = scf.select %ok5, %sr5, %neg_big : f32
      %s6 = scf.select %ok6, %sr6, %neg_big : f32
      %s7 = scf.select %ok7, %sr7, %neg_big : f32
      %s8 = scf.select %ok8, %sr8, %neg_big : f32
      %s9 = scf.select %ok9, %sr9, %neg_big : f32
      %s10 = scf.select %ok10, %sr10, %neg_big : f32
      %s11 = scf.select %ok11, %sr11, %neg_big : f32
      %s12 = scf.select %ok12, %sr12, %neg_big : f32
      %s13 = scf.select %ok13, %sr13, %neg_big : f32
      %s14 = scf.select %ok14, %sr14, %neg_big : f32
      %s15 = scf.select %ok15, %sr15, %neg_big : f32
      %mx0 = scalar.maxnumf %m, %s0 : f32
      %mx1 = scalar.maxnumf %mx0, %s1 : f32
      %mx2 = scalar.maxnumf %mx1, %s2 : f32
      %mx3 = scalar.maxnumf %mx2, %s3 : f32
      %mx4 = scalar.maxnumf %mx3, %s4 : f32
      %mx5 = scalar.maxnumf %mx4, %s5 : f32
      %mx6 = scalar.maxnumf %mx5, %s6 : f32
      %mx7 = scalar.maxnumf %mx6, %s7 : f32
      %mx8 = scalar.maxnumf %mx7, %s8 : f32
      %mx9 = scalar.maxnumf %mx8, %s9 : f32
      %mx10 = scalar.maxnumf %mx9, %s10 : f32
      %mx11 = scalar.maxnumf %mx10, %s11 : f32
      %mx12 = scalar.maxnumf %mx11, %s12 : f32
      %mx13 = scalar.maxnumf %mx12, %s13 : f32
      %mx14 = scalar.maxnumf %mx13, %s14 : f32
      %mx15 = scalar.maxnumf %mx14, %s15 : f32
      %m_shift = scalar.subf %m, %mx15 : f32
      %alpha = scalar.expf<afn> %m_shift : f32
      %l_scaled = scalar.mulf %l, %alpha : f32
      %alpha_v = vector.splat %alpha : vector<8xf32>
      %acc_s = vector.mulf %acc, %alpha_v : vector<8xf32>
      %d0 = scalar.subf %s0, %mx15 : f32
      %p0 = scalar.expf<afn> %d0 : f32
      %la0 = scalar.addf %l_scaled, %p0 : f32
      %pv0 = vector.splat %p0 : vector<8xf32>
      %aa0 = vector.fmaf %pv0, %v0, %acc_s : vector<8xf32>
      %d1 = scalar.subf %s1, %mx15 : f32
      %p1 = scalar.expf<afn> %d1 : f32
      %la1 = scalar.addf %la0, %p1 : f32
      %pv1 = vector.splat %p1 : vector<8xf32>
      %aa1 = vector.fmaf %pv1, %v1, %aa0 : vector<8xf32>
      %d2 = scalar.subf %s2, %mx15 : f32
      %p2 = scalar.expf<afn> %d2 : f32
      %la2 = scalar.addf %la1, %p2 : f32
      %pv2 = vector.splat %p2 : vector<8xf32>
      %aa2 = vector.fmaf %pv2, %v2, %aa1 : vector<8xf32>
      %d3 = scalar.subf %s3, %mx15 : f32
      %p3 = scalar.expf<afn> %d3 : f32
      %la3 = scalar.addf %la2, %p3 : f32
      %pv3 = vector.splat %p3 : vector<8xf32>
      %aa3 = vector.fmaf %pv3, %v3, %aa2 : vector<8xf32>
      %d4 = scalar.subf %s4, %mx15 : f32
      %p4 = scalar.expf<afn> %d4 : f32
      %la4 = scalar.addf %la3, %p4 : f32
      %pv4 = vector.splat %p4 : vector<8xf32>
      %aa4 = vector.fmaf %pv4, %v4, %aa3 : vector<8xf32>
      %d5 = scalar.subf %s5, %mx15 : f32
      %p5 = scalar.expf<afn> %d5 : f32
      %la5 = scalar.addf %la4, %p5 : f32
      %pv5 = vector.splat %p5 : vector<8xf32>
      %aa5 = vector.fmaf %pv5, %v5, %aa4 : vector<8xf32>
      %d6 = scalar.subf %s6, %mx15 : f32
      %p6 = scalar.expf<afn> %d6 : f32
      %la6 = scalar.addf %la5, %p6 : f32
      %pv6 = vector.splat %p6 : vector<8xf32>
      %aa6 = vector.fmaf %pv6, %v6, %aa5 : vector<8xf32>
      %d7 = scalar.subf %s7, %mx15 : f32
      %p7 = scalar.expf<afn> %d7 : f32
      %la7 = scalar.addf %la6, %p7 : f32
      %pv7 = vector.splat %p7 : vector<8xf32>
      %aa7 = vector.fmaf %pv7, %v7, %aa6 : vector<8xf32>
      %d8 = scalar.subf %s8, %mx15 : f32
      %p8 = scalar.expf<afn> %d8 : f32
      %la8 = scalar.addf %la7, %p8 : f32
      %pv8 = vector.splat %p8 : vector<8xf32>
      %aa8 = vector.fmaf %pv8, %v8, %aa7 : vector<8xf32>
      %d9 = scalar.subf %s9, %mx15 : f32
      %p9 = scalar.expf<afn> %d9 : f32
      %la9 = scalar.addf %la8, %p9 : f32
      %pv9 = vector.splat %p9 : vector<8xf32>
      %aa9 = vector.fmaf %pv9, %v9, %aa8 : vector<8xf32>
      %d10 = scalar.subf %s10, %mx15 : f32
      %p10 = scalar.expf<afn> %d10 : f32
      %la10 = scalar.addf %la9, %p10 : f32
      %pv10 = vector.splat %p10 : vector<8xf32>
      %aa10 = vector.fmaf %pv10, %v10, %aa9 : vector<8xf32>
      %d11 = scalar.subf %s11, %mx15 : f32
      %p11 = scalar.expf<afn> %d11 : f32
      %la11 = scalar.addf %la10, %p11 : f32
      %pv11 = vector.splat %p11 : vector<8xf32>
      %aa11 = vector.fmaf %pv11, %v11, %aa10 : vector<8xf32>
      %d12 = scalar.subf %s12, %mx15 : f32
      %p12 = scalar.expf<afn> %d12 : f32
      %la12 = scalar.addf %la11, %p12 : f32
      %pv12 = vector.splat %p12 : vector<8xf32>
      %aa12 = vector.fmaf %pv12, %v12, %aa11 : vector<8xf32>
      %d13 = scalar.subf %s13, %mx15 : f32
      %p13 = scalar.expf<afn> %d13 : f32
      %la13 = scalar.addf %la12, %p13 : f32
      %pv13 = vector.splat %p13 : vector<8xf32>
      %aa13 = vector.fmaf %pv13, %v13, %aa12 : vector<8xf32>
      %d14 = scalar.subf %s14, %mx15 : f32
      %p14 = scalar.expf<afn> %d14 : f32
      %la14 = scalar.addf %la13, %p14 : f32
      %pv14 = vector.splat %p14 : vector<8xf32>
      %aa14 = vector.fmaf %pv14, %v14, %aa13 : vector<8xf32>
      %d15 = scalar.subf %s15, %mx15 : f32
      %p15 = scalar.expf<afn> %d15 : f32
      %la15 = scalar.addf %la14, %p15 : f32
      %pv15 = vector.splat %p15 : vector<8xf32>
      %aa15 = vector.fmaf %pv15, %v15, %aa14 : vector<8xf32>
      scf.yield %mx15, %la15, %aa15 : f32, f32, vector<8xf32>
    }

    %acc_view = buffer.view %part_acc[%zero] : buffer -> view<[%tokens]x16x64x32x8xf32>
    vector.store %acc_final, %acc_view[%token, %bounded_head, %split, %lane, %c0] : vector<8xf32>, view<[%tokens]x16x64x32x8xf32>
    %first = index.cmp eq, %lane, %c0 : index
    scf.if %first {
      %ml_view = buffer.view %part_ml[%zero] : buffer -> view<[%tokens]x16x64x2xf32>
      view.store %m_final, %ml_view[%token, %bounded_head, %split, 0] : f32, view<[%tokens]x16x64x2xf32>
      view.store %l_final, %ml_view[%token, %bounded_head, %split, 1] : f32, view<[%tokens]x16x64x2xf32>
    }
    }
  }
  kernel.return
}

check.case public @k_split32k_case {
  %t = check.literal value(1) : index
  %layer = check.literal value(0) : index
  %sliding = check.literal value(0) : i32
  %ctx = check.literal value(32768) : index
  %pool = check.literal value(32768) : index
  %q = check.generate.fill value(0.02) : tensor<1x4096xf32>
  %info = check.file.read.npy path("s32k_info.npy") : tensor<1x4xi32>
  %orig = check.file.read.npy path("s32k_orig.npy") : tensor<2058xi32>
  %arena = check.generate.fill value(0.01) : tensor<33554432xf16>
  %pacc = check.generate.fill value(0.0) : tensor<262144xf32>
  %pml = check.generate.fill value(0.0) : tensor<2048xf32>
  kernel.launch @k_split32k[%t](%t, %layer, %sliding, %ctx, %pool, %q, %info, %orig, %arena, %pacc, %pml) : [index](index, index, i32, index, index, tensor<1x4096xf32>, tensor<1x4xi32>, tensor<2058xi32>, tensor<33554432xf16>, tensor<262144xf32>, tensor<2048xf32>)
  check.return
}
check.benchmark<@k_split32k_case> @k_split32k_bm

kernel.def export("k_split8k") @k_split8k(%tokens: index) {
  %c1 = index.constant 1 : index
  %ckvh = index.constant 2 : index
  %cS = index.constant 64 : index
  %clanes = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %ckvh, %cS) workgroup_size(%clanes, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %sliding: i32, %context_arg: index, %pool_arg: index, %q: buffer, %info: buffer, %origins: buffer, %arena: buffer, %part_acc: buffer, %part_ml: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 51)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 262144)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 2147483584)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %kv_id = kernel.workgroup.id<y> : index
  %kv_head = index.assume %kv_id [range(%kv_id, 0, 1)] : index
  %split_id = kernel.workgroup.id<z> : index
  %split = index.assume %split_id [range(%split_id, 0, 63)] : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 7)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %window = index.constant 262144 : index
  %window_less = index.constant 262143 : index
  %c0_i32 = scalar.constant 0 : i32
  %cU = index.constant 16 : index
  %c0u = index.constant 0 : index
  %c1u = index.constant 1 : index
  %c2u = index.constant 2 : index
  %c3u = index.constant 3 : index
  %c4u = index.constant 4 : index
  %c5u = index.constant 5 : index
  %c6u = index.constant 6 : index
  %c7u = index.constant 7 : index
  %c8u = index.constant 8 : index
  %c9u = index.constant 9 : index
  %c10u = index.constant 10 : index
  %c11u = index.constant 11 : index
  %c12u = index.constant 12 : index
  %c13u = index.constant 13 : index
  %c14u = index.constant 14 : index
  %c15u = index.constant 15 : index
  %ad16 = scalar.constant 16 : i32
  %adi16 = index.constant 16 : index
  %aq16 = index.div %lane, %adi16 : index
  %ar16_2 = index.constant 2 : index
  %arm16 = index.rem %aq16, %ar16_2 : index
  %ab16 = index.cmp ne, %arm16, %c0 : index
  %ad8 = scalar.constant 8 : i32
  %adi8 = index.constant 8 : index
  %aq8 = index.div %lane, %adi8 : index
  %ar8_2 = index.constant 2 : index
  %arm8 = index.rem %aq8, %ar8_2 : index
  %ab8 = index.cmp ne, %arm8, %c0 : index
  %ad4 = scalar.constant 4 : i32
  %adi4 = index.constant 4 : index
  %aq4 = index.div %lane, %adi4 : index
  %ar4_2 = index.constant 2 : index
  %arm4 = index.rem %aq4, %ar4_2 : index
  %ab4 = index.cmp ne, %arm4, %c0 : index
  %ad2 = scalar.constant 2 : i32
  %adi2 = index.constant 2 : index
  %aq2 = index.div %lane, %adi2 : index
  %ar2_2 = index.constant 2 : index
  %arm2 = index.rem %aq2, %ar2_2 : index
  %ab2 = index.cmp ne, %arm2, %c0 : index
  %ad1 = scalar.constant 1 : i32
  %adi1 = index.constant 1 : index
  %aq1 = index.div %lane, %adi1 : index
  %ar1_2 = index.constant 2 : index
  %arm1 = index.rem %aq1, %ar1_2 : index
  %ab1 = index.cmp ne, %arm1, %c0 : index
  %aw32 = scalar.constant 32 : i32
  %zero_f = scalar.constant 0.0 : f32
  %neg_big = scalar.constant -3.0e38 : f32
  %cg = index.constant 8 : index
  %head = index.madd %kv_head, %cg, %wave : index
  %bounded_head = index.assume %head [range(%head, 0, 15)] : index
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %row32 = view.load %info_view[%token, 0] : view<[%tokens]x4xi32> -> i32
  %position32 = view.load %info_view[%token, 1] : view<[%tokens]x4xi32> -> i32
  %live32 = view.load %info_view[%token, 2] : view<[%tokens]x4xi32> -> i32
  %needed = scalar.constant true : i1
  %live_token = scalar.cmpi ne, %live32, %c0_i32 : i32
  %live = scalar.andi %live_token, %needed : i1
  scf.if %live {
    %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
    %row = index.cast %row_bound : i32 to index
    %position_bound = scalar.assume %position32 [range(%position32, 0, 262143)] : i32
    %position = index.cast %position_bound : i32 to index
    %padded = index.add %context, %c15 : index
    %blocks = index.div %padded, %c16 : index
    %k_plane = index.mul %layer, %c2 : index
    %v_plane = index.add %k_plane, %c1 : index
    // V of a position sits one plane (pool positions x 512 bytes) after its K.
    %position_bytes_v = index.constant 1024 : offset
    %plane_stride = index.scale %pool, %position_bytes_v : index, offset -> offset
    %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
    %far = index.cmp uge, %position, %window : index
    %use_window = scalar.andi %is_sliding, %far : i1
    %window_start = index.sub %position, %window_less : index
    %window_low = scf.select %use_window, %window_start, %c0 : index
    %end = index.add %position, %c1 : index
    %visible_value = index.sub %end, %window_low : index
    %visible = index.assume %visible_value [range(%visible_value, 1, 262144)] : index
    %s_eff = func.call @g_split_count(%visible) : (index) -> (index)
    %active_split = index.cmp ult, %split, %s_eff : index
    scf.if %active_split {
    %s_less = index.sub %s_eff, %c1 : index
    %per_padded = index.add %visible, %s_less : index
    %per = index.div %per_padded, %s_eff : index
    %start_raw = index.mul %split, %per : index
    %start = index.min %start_raw, %visible : index
    %stop_raw = index.add %start_raw, %per : index
