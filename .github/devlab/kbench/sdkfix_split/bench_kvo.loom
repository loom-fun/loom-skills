  %orig = check.file.read.npy path("s8k_orig.npy") : tensor<522xi32>
  %arena = check.generate.fill value(0.01) : tensor<8388608xf16>
  %pacc = check.generate.fill value(0.0) : tensor<262144xf32>
  %pml = check.generate.fill value(0.0) : tensor<2048xf32>
  kernel.launch @k_split8k[%t](%t, %layer, %sliding, %ctx, %pool, %q, %info, %orig, %arena, %pacc, %pml) : [index](index, index, i32, index, index, tensor<1x4096xf32>, tensor<1x4xi32>, tensor<522xi32>, tensor<8388608xf16>, tensor<262144xf32>, tensor<2048xf32>)
  check.return
}
