    %s_less = index.sub %s_eff, %c1 : index
    %per_padded = index.add %visible, %s_less : index
    %per = index.div %per_padded, %s_eff : index
    %start_raw = index.mul %split, %per : index
    %start = index.min %start_raw, %visible : index
    %stop_raw = index.add %start_raw, %per : index
    %stop = index.min %stop_raw, %visible : index
    %q_view = buffer.view %q[%zero] : buffer -> view<[%tokens]x16x32x8xf32>
    %q_raw = vector.load %q_view[%token, %bounded_head, %lane, %c0] : view<[%tokens]x16x32x8xf32> -> vector<8xf32>
    %scale = scalar.constant 0.0625 : f32
    %scale_v = vector.splat %scale : vector<8xf32>
    %q4 = vector.mulf %q_raw, %scale_v : vector<8xf32>
    %zero4 = vector.splat %zero_f : vector<8xf32>
    %lo_abs = index.add %window_low, %start : index
    %hi_abs = index.add %window_low, %stop : index
    %lo_q = index.div %lo_abs, %cU : index
    %lo_al = index.mul %lo_q, %cU : index
    %m_final, %l_final, %acc_final = scf.for %j = [%lo_al to %hi_abs step %cU](%m = %neg_big : f32, %l = %zero_f : f32, %acc = %zero4 : vector<8xf32>) -> (f32, f32, vector<8xf32>) {
      %kb_off = func.call @g_kv_offset(%origins, %row, %j, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %key0_raw = index.add %j, %c0u : index
      %okl0 = index.cmp uge, %key0_raw, %lo_abs : index
      %okh0 = index.cmp ult, %key0_raw, %hi_abs : index
      %ok0 = scalar.andi %okl0, %okh0 : i1
      %kd0 = index.constant 0 : offset
      %ko0 = index.add %kb_off, %kd0 : offset
      %kc0 = buffer.view %arena[%ko0] : buffer -> view<2x32x8xf16>
