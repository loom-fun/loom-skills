  %adi1 = index.constant 1 : index
  %aq1 = index.div %lane, %adi1 : index
  %ar1_2 = index.constant 2 : index
  %arm1 = index.rem %aq1, %ar1_2 : index
  %ab1 = index.cmp ne, %arm1, %c0 : index
  %aw32 = scalar.constant 32 : i32
  %zero_f = scalar.constant 0.0 : f32
  %neg_big = scalar.constant -3.0e38 : f32
