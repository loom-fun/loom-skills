      %kd2 = index.constant 2048 : offset
      %ko2 = index.add %kb_off, %kd2 : offset
      %kc2 = buffer.view %arena[%ko2] : buffer -> view<2x32x8xf16>
      %kh2 = vector.load %kc2[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %k2 = vector.extf %kh2 : vector<8xf16> to vector<8xf32>
      %vo2 = index.add %ko2, %plane_stride : offset
      %vc2 = buffer.view %arena[%vo2] : buffer -> view<2x32x8xf16>
      %vh2 = vector.load %vc2[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %v2 = vector.extf %vh2 : vector<8xf16> to vector<8xf32>
      %key3_raw = index.add %j, %c3u : index
      %okl3 = index.cmp uge, %key3_raw, %lo_abs : index
      %okh3 = index.cmp ult, %key3_raw, %hi_abs : index
      %ok3 = scalar.andi %okl3, %okh3 : i1
      %kd3 = index.constant 3072 : offset
      %ko3 = index.add %kb_off, %kd3 : offset
      %kc3 = buffer.view %arena[%ko3] : buffer -> view<2x32x8xf16>
      %kh3 = vector.load %kc3[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %k3 = vector.extf %kh3 : vector<8xf16> to vector<8xf32>
      %vo3 = index.add %ko3, %plane_stride : offset
      %vc3 = buffer.view %arena[%vo3] : buffer -> view<2x32x8xf16>
      %vh3 = vector.load %vc3[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %v3 = vector.extf %vh3 : vector<8xf16> to vector<8xf32>
