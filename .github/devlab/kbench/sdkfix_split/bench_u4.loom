      %ar16_0k = scf.select %ab16, %part2, %part0 : f32
      %ar16_0r, %ar16_0u = kernel.subgroup.shuffle<xor> %ar16_0s, %ad16, %aw32 : f32, i32, i32
      %ar16_0 = scalar.addf %ar16_0k, %ar16_0r : f32
      %ar16_1s = scf.select %ab16, %part1, %part3 : f32
      %ar16_1k = scf.select %ab16, %part3, %part1 : f32
      %ar16_1r, %ar16_1u = kernel.subgroup.shuffle<xor> %ar16_1s, %ad16, %aw32 : f32, i32, i32
      %ar16_1 = scalar.addf %ar16_1k, %ar16_1r : f32
      %ar8_0s = scf.select %ab8, %ar16_0, %ar16_1 : f32
      %ar8_0k = scf.select %ab8, %ar16_1, %ar16_0 : f32
      %ar8_0r, %ar8_0u = kernel.subgroup.shuffle<xor> %ar8_0s, %ad8, %aw32 : f32, i32, i32
      %ar8_0 = scalar.addf %ar8_0k, %ar8_0r : f32
