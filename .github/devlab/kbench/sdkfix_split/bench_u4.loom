      %vc1 = buffer.view %arena[%vo1] : buffer -> view<2x32x8xf16>
      %vh1 = vector.load %vc1[%kv_head, %lane, %c0] : view<2x32x8xf16> -> vector<8xf16>
      %v1 = vector.extf %vh1 : vector<8xf16> to vector<8xf32>
