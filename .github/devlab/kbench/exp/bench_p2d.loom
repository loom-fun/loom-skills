check.case public @gate_q4k {
  %seed = check.literal value(5) : i64
  %seed2 = check.literal value(6) : i64
  %enabled = check.literal value(true) : i1
  %rows = check.literal value(128) : index
  %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<2048x2560xbf16>
  %ids = check.generate.random.uniform seed(%seed2) range(0 to 511) : tensor<20480xi32>
  %epoch = check.generate.fill value(1838) : tensor<3xi32>
  %ranks = check.generate.fill value(0) : tensor<20480xi32>
  %tasks = check.generate.fill value(0) : tensor<87361xi32>
  %weight = check.file.read.npy path("w/gate10.npy") : tensor<471859200xi8>
  %up_weight = check.file.read.npy path("w/up10.npy") : tensor<471859200xi8>
  %output = check.generate.fill value(0.0) : tensor<20480x640xbf16>
  kernel.launch @expert_routes[%enabled](%rows, %epoch, %ids, %ranks, %tasks) : [i1](index, tensor<3xi32>, tensor<20480xi32>, tensor<20480xi32>, tensor<87361xi32>)
  %opnd = check.generate.fill value(0.0) : tensor<2048x2560xf16>
  kernel.launch @expert_input_half[%enabled](%input, %epoch, %opnd) : [i1](tensor<2048x2560xbf16>, tensor<3xi32>, tensor<2048x2560xf16>)
  kernel.launch @k_gate_q4k(%opnd, %tasks, %weight, %up_weight, %output) : (tensor<2048x2560xf16>, tensor<87361xi32>, tensor<471859200xi8>, tensor<471859200xi8>, tensor<20480x640xbf16>)
  check.return
}

