func.def public inline @ggml_iq4_nl_block(%input: buffer, %block_origin: offset) -> (vector<32xi8>, f32) {
  %payload_delta = index.constant 2 : offset
  %payload_origin = index.add %block_origin, %payload_delta : offset
  %scale_view = buffer.view %input[%block_origin] : buffer -> view<1xf16>
  %payload_view = buffer.view %input[%payload_origin] : buffer -> view<16xi8>
  %scale_half = view.load %scale_view[0] : view<1xf16> -> f16
  %scale = scalar.extf %scale_half : f16 to f32
  %payload = vector.load %payload_view[0] : view<16xi8> -> vector<16xi8>
  %nibble_mask = vector.splati 15 : vector<16xi8>
  %nibble_shift = vector.splati 4 : vector<16xi8>
  %lower = vector.andi %payload, %nibble_mask : vector<16xi8>
  %upper = vector.shrui %payload, %nibble_shift : vector<16xi8>
  %indices = vector.concat<0> %lower, %upper : vector<16xi8>, vector<16xi8> -> vector<32xi8>
  %codebook = vector.constanti [-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113] : vector<16xi8>
  %codes = vector.table.lookup %codebook[%indices] : vector<16xi8>, vector<32xi8> -> vector<32xi8>
  func.return %codes, %scale : vector<32xi8>, f32
}

// Selects one nibble plane from four consecutive packed-code bytes. `nibble` is
// zero for the low plane and one for the high plane.
func.def public inline @ggml_q4_k_unpack_codes4(%packed_codes: vector<1xi32>, %nibble: index) -> (vector<4xi8>) {
  %bounded_nibble = index.assume %nibble [range(%nibble, 0, 1)] : index
  %c4 = index.constant 4 : index
  %nibble_mask = vector.splati 252645135 : vector<1xi32>
  %shift_index = index.mul %bounded_nibble, %c4 : index
  %shift_i32 = index.cast %shift_index : index to i32
  %shift = vector.splat %shift_i32 : vector<1xi32>
  %shifted_codes = vector.shrui %packed_codes, %shift : vector<1xi32>
  %masked_codes = vector.andi %shifted_codes, %nibble_mask : vector<1xi32>
  %codes = vector.bitcast %masked_codes : vector<1xi32> to vector<4xi8>
  func.return %codes : vector<4xi8>
}

// Applies the same four-code carrier interpretation to four retained words.
func.def public inline @ggml_q4_k_unpack_codes16(%packed_codes: vector<4xi32>, %nibble: index) -> (vector<16xi8>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %words = index.constant 4 : index
  %initial = vector.splati 0 : vector<4xi32>
  %unpacked = scf.for %word = [%begin to %words step %step](%current = %initial : vector<4xi32>) -> (vector<4xi32>) unroll {
    %low = vector.slice %packed_codes[%word] : vector<4xi32> -> vector<1xi32>
    %codes = func.call @ggml_q4_k_unpack_codes4(%low, %nibble) : (vector<1xi32>, index) -> (vector<4xi8>)
    %packed = vector.bitcast %codes : vector<4xi8> to vector<1xi32>
    %value = vector.extract %packed[0] : vector<1xi32> -> i32
    %next = vector.insert %value into %current[%word] : i32, vector<4xi32>
    scf.yield %next : vector<4xi32>
  }
  %codes = vector.bitcast %unpacked : vector<4xi32> to vector<16xi8>
  func.return %codes : vector<16xi8>
}

// Recovers one scale/minimum pair from the packed 12-byte metadata carrier.
// Group ordinals 0-3 use the low six bits of direct bytes. Groups 4-7 join
// low nibbles from the final four bytes with high bits from the first eight.
func.def public inline @ggml_q4_k_unpack_scale_minimum(%packed_scales: vector<3xi32>, %group: index) -> (i32, i32) {
  %bounded_group = index.assume %group [range(%group, 0, 7)] : index
  %scale0 = vector.extract %packed_scales[0] : vector<3xi32> -> i32
  %scale1 = vector.extract %packed_scales[1] : vector<3xi32> -> i32
  %scale2 = vector.extract %packed_scales[2] : vector<3xi32> -> i32
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c15_i32 = scalar.constant 15 : i32
  %c48_i32 = scalar.constant 48 : i32
  %is_low_group = index.cmp ult, %bounded_group, %c4 : index
  %lane = index.rem %bounded_group, %c4 : index
  %shift_index = index.mul %lane, %c8 : index
  %shift = index.cast %shift_index : index to i32
  %high_shift = scalar.addi %shift, %c2_i32 : i32
  %minimum_shift = scalar.addi %shift, %c4_i32 : i32
  %scale_low_source = scf.select %is_low_group, %scale0, %scale2 : i32
  %minimum_low_source = scf.select %is_low_group, %scale1, %scale2 : i32
  %scale_high_shift = scf.select %is_low_group, %shift, %high_shift : i32
  %minimum_low_shift = scf.select %is_low_group, %shift, %minimum_shift : i32
  %scale_low_shifted = scalar.shrui %scale_low_source, %shift : i32
  %scale_low = scalar.andi %scale_low_shifted, %c15_i32 : i32
  %scale_high_shifted = scalar.shrui %scale0, %scale_high_shift : i32
  %scale_high = scalar.andi %scale_high_shifted, %c48_i32 : i32
  %scale = scalar.ori %scale_low, %scale_high : i32
  %minimum_low_shifted = scalar.shrui %minimum_low_source, %minimum_low_shift : i32
  %minimum_low = scalar.andi %minimum_low_shifted, %c15_i32 : i32
  %minimum_high_shifted = scalar.shrui %scale1, %scale_high_shift : i32
  %minimum_high = scalar.andi %minimum_high_shifted, %c48_i32 : i32
  %minimum = scalar.ori %minimum_low, %minimum_high : i32
  func.return %scale, %minimum : i32, i32
}

// Materializes the affine coefficients of one 32-value group from a retained
// 16-byte Q4_K or Q5_K header. The first word holds F16 (d, dmin); the other
// three words are the shared packed metadata carrier. A value is d*scale*code
// minus dmin*minimum. Callers may reuse one loaded header across many groups.
func.def public inline @ggml_q4_k_scaled_metadata(%header: vector<4xi32>, %group: index) -> (f32, f32) {
  %halves = vector.bitcast %header : vector<4xi32> to vector<8xf16>
  %d_half = vector.extract %halves[0] : vector<8xf16> -> f16
  %minimum_half = vector.extract %halves[1] : vector<8xf16> -> f16
  %d = scalar.extf %d_half : f16 to f32
  %dmin = scalar.extf %minimum_half : f16 to f32
  %first = vector.extract %header[1] : vector<4xi32> -> i32
  %second = vector.extract %header[2] : vector<4xi32> -> i32
  %third = vector.extract %header[3] : vector<4xi32> -> i32
  %packed = vector.from_elements %first, %second, %third : vector<3xi32>
  %scale, %minimum = func.call @ggml_q4_k_unpack_scale_minimum(%packed, %group) : (vector<3xi32>, index) -> (i32, i32)
  %scale_float = scalar.uitofp %scale : i32 to f32
  %minimum_float = scalar.uitofp %minimum : i32 to f32
  %scaled = scalar.mulf %d, %scale_float : f32
  %minimum_scaled = scalar.mulf %dmin, %minimum_float : f32
  func.return %scaled, %minimum_scaled : f32, f32
}

// Loads exactly the shared 16-byte metadata header at a block's byte origin.
// Group is in [0, 7]; the caller provides a readable, naturally aligned header.
func.def public inline @ggml_q4_k_load_scale_minimum(%weight: buffer, %block_origin: offset, %group: index) -> (f32, f32) {
  %header_view = buffer.view %weight[%block_origin] : buffer -> view<4xi32>
  %header = vector.load %header_view[0] : view<4xi32> -> vector<4xi32>
  %scale, %minimum = func.call @ggml_q4_k_scaled_metadata(%header, %group) : (vector<4xi32>, index) -> (f32, f32)
  func.return %scale, %minimum : f32, f32
}

// Loads four unsigned codes as F32, leaving affine scaling to the caller.
// Row origin is in bytes; block selects a complete 144-byte record in that
// row. Group and packet are both in [0, 7]. Only one four-byte payload word
// is read, so adjacent matrix lanes can retain their own packets independently.
func.def public inline @ggml_q4_k_load_codes4(%weight: buffer, %row_origin: offset, %block: index, %group_value: index, %packet_value: index) -> (vector<4xf32>) {
  %group = index.assume %group_value [range(%group_value, 0, 7)] : index
  %packet = index.assume %packet_value [range(%packet_value, 0, 7)] : index
  %groups_per_page = index.constant 2 : index
  %words_per_page = index.constant 8 : index
  %block_bytes = index.constant 144 : offset
  %header_bytes = index.constant 16 : offset
  %block_add = index.scale %block, %block_bytes : index, offset -> offset
  %block_origin = index.add %row_origin, %block_add : offset
  %payload_origin = index.add %block_origin, %header_bytes : offset
  %page = index.div %group, %groups_per_page : index
  %word = index.madd %page, %words_per_page, %packet : index
  %nibble = index.rem %group, %groups_per_page : index
  %words = buffer.view %weight[%payload_origin] : buffer -> view<32xi32>
  %packed = vector.load %words[%word] : view<32xi32> -> vector<1xi32>
  %bytes = func.call @ggml_q4_k_unpack_codes4(%packed, %nibble) : (vector<1xi32>, index) -> (vector<4xi8>)
  %values = vector.uitofp %bytes : vector<4xi8> to vector<4xf32>
  func.return %values : vector<4xf32>
}

// Loads one 16-value half-group and its affine coefficients. Row origin is
// in bytes; block selects a complete 144-byte record. Group is in [0, 7] and
// half in [0, 1]. The code packet and header each require one 16-byte load.
func.def public inline @ggml_q4_k_load_chunk16(%weight: buffer, %row_origin: offset, %block: index, %group_value: index, %half_value: index) -> (vector<16xi8>, f32, f32) {
  %group = index.assume %group_value [range(%group_value, 0, 7)] : index
  %half = index.assume %half_value [range(%half_value, 0, 1)] : index
  %groups_per_page = index.constant 2 : index
  %words_per_half = index.constant 4 : index
  %words_per_page = index.constant 8 : index
  %block_bytes = index.constant 144 : offset
  %header_bytes = index.constant 16 : offset
  %block_add = index.scale %block, %block_bytes : index, offset -> offset
  %block_origin = index.add %row_origin, %block_add : offset
  %payload_origin = index.add %block_origin, %header_bytes : offset
  %page = index.div %group, %groups_per_page : index
  %within = index.mul %half, %words_per_half : index
  %word = index.madd %page, %words_per_page, %within : index
  %nibble = index.rem %group, %groups_per_page : index
  %words = buffer.view %weight[%payload_origin] : buffer -> view<32xi32>
  %packed = vector.load %words[%word] : view<32xi32> -> vector<4xi32>
  %codes = func.call @ggml_q4_k_unpack_codes16(%packed, %nibble) : (vector<4xi32>, index) -> (vector<16xi8>)
  %scale, %minimum = func.call @ggml_q4_k_load_scale_minimum(%weight, %block_origin, %group) : (buffer, offset, index) -> (f32, f32)
  func.return %codes, %scale, %minimum : vector<16xi8>, f32, f32
}

// Loads the complete header and payload once for reuse across both halves.
func.def public inline @ggml_q5_1_load_block(%weight: buffer, %block_origin: offset) -> (vector<16xi8>, i32, f32, f32) {
  %high_add = index.constant 4 : offset
  %code_add = index.constant 8 : offset
  %high_origin = index.add %block_origin, %high_add : offset
  %code_origin = index.add %block_origin, %code_add : offset
  %header = buffer.view %weight[%block_origin] : buffer -> view<2xf16>
  %high_view = buffer.view %weight[%high_origin] : buffer -> view<1xi32>
  %code_view = buffer.view %weight[%code_origin] : buffer -> view<16xi8>
  %scale_half = view.load %header[0] : view<2xf16> -> f16
  %minimum_half = view.load %header[1] : view<2xf16> -> f16
  %scale = scalar.extf %scale_half : f16 to f32
  %minimum = scalar.extf %minimum_half : f16 to f32
  %high_word = view.load %high_view[0] : view<1xi32> -> i32
  %packed = vector.load %code_view[0] : view<16xi8> -> vector<16xi8>
  func.return %packed, %high_word, %scale, %minimum : vector<16xi8>, i32, f32, f32
}

// Expands half 0 or 1 to its 16 unsigned codes. A constant selector specializes
// the shifts; retained carriers remain reusable across either selection.
func.def public inline @ggml_q5_1_unpack_codes16(%packed: vector<16xi8>, %packed_high: i32, %half_value: index) -> (vector<16xi8>) {
  %half = index.assume %half_value [range(%half_value, 0, 1)] : index
  %high_words = vector.splat %packed_high : vector<4xi32>
  %nibble_bits = scalar.constant 4 : i32
  %half_width = scalar.constant 16 : i32
  %nibble_mask = vector.splati 15 : vector<16xi8>
  %high_mask = vector.splati 15 : vector<4xi32>
  %spread_factor = vector.splati 2113665 : vector<4xi32>
  %low_bits_in_bytes = vector.splati 16843009 : vector<4xi32>
  %high_bit_shift = vector.splati 4 : vector<4xi32>
  %half_i32 = index.cast %half : index to i32
  %nibble_shift = scalar.muli %half_i32, %nibble_bits : i32
  %nibble_shift_i8 = scalar.trunci %nibble_shift : i32 to i8
  %nibble_shifts = vector.splat %nibble_shift_i8 : vector<16xi8>
  %shifted = vector.shrui %packed, %nibble_shifts : vector<16xi8>
  %low_codes = vector.andi %shifted, %nibble_mask : vector<16xi8>
  %first_bit = scalar.muli %half_i32, %half_width : i32
  // Multiplication by 0x00204081 places four copies of each nibble seven
  // bits apart without overlap. Masking with 0x01010101 selects one bit
  // per byte; shifting by four places each original high bit over its
  // low nibble. The four words bitcast directly to sixteen code bytes.
  %bit_positions = vector.iota %first_bit step %nibble_bits : vector<4xi32>
  %high_shifted = vector.shrui %high_words, %bit_positions : vector<4xi32>
  %high_nibbles = vector.andi %high_shifted, %high_mask : vector<4xi32>
  %spread_bits = vector.muli %high_nibbles, %spread_factor : vector<4xi32>
  %high_bits = vector.andi %spread_bits, %low_bits_in_bytes : vector<4xi32>
  %high_values = vector.shli %high_bits, %high_bit_shift : vector<4xi32>
  %high_codes = vector.bitcast %high_values : vector<4xi32> to vector<16xi8>
  %codes = vector.ori %low_codes, %high_codes : vector<16xi8>
  func.return %codes : vector<16xi8>
}

// Recovers four consecutive unsigned codes from selected low/high carrier
// packets. `group` selects both the low nibble and the corresponding high bit
// for one of the eight 32-value groups in a Q5_K block.
func.def public inline @ggml_q5_k_unpack_codes4(%packed_codes: vector<1xi32>, %packed_high: vector<1xi32>, %group: index) -> (vector<4xi8>) {
  %bounded_group = index.assume %group [range(%group, 0, 7)] : index
  %c2 = index.constant 2 : index
  %c4_i32v = vector.splati 4 : vector<1xi32>
  %one_byte_mask = vector.splati 16843009 : vector<1xi32>
  %nibble = index.rem %bounded_group, %c2 : index
  %low_codes = func.call @ggml_q4_k_unpack_codes4(%packed_codes, %nibble) : (vector<1xi32>, index) -> (vector<4xi8>)
  %low_words = vector.bitcast %low_codes : vector<4xi8> to vector<1xi32>
  %group_i32 = index.cast %bounded_group : index to i32
  %high_shift = vector.splat %group_i32 : vector<1xi32>
  %shifted_high = vector.shrui %packed_high, %high_shift : vector<1xi32>
  %high_bit = vector.andi %shifted_high, %one_byte_mask : vector<1xi32>
  %high_codes = vector.shli %high_bit, %c4_i32v : vector<1xi32>
  %codes_words = vector.ori %low_words, %high_codes : vector<1xi32>
  %codes = vector.bitcast %codes_words : vector<1xi32> to vector<4xi8>
  func.return %codes : vector<4xi8>
}

// Applies the same four-code carrier interpretation to four retained words.
func.def public inline @ggml_q5_k_unpack_codes16(%packed_codes: vector<4xi32>, %packed_high: vector<4xi32>, %group: index) -> (vector<16xi8>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %words = index.constant 4 : index
  %initial = vector.splati 0 : vector<4xi32>
  %unpacked = scf.for %word = [%begin to %words step %step](%current = %initial : vector<4xi32>) -> (vector<4xi32>) unroll {
    %low = vector.slice %packed_codes[%word] : vector<4xi32> -> vector<1xi32>
    %high = vector.slice %packed_high[%word] : vector<4xi32> -> vector<1xi32>
    %codes = func.call @ggml_q5_k_unpack_codes4(%low, %high, %group) : (vector<1xi32>, vector<1xi32>, index) -> (vector<4xi8>)
    %packed = vector.bitcast %codes : vector<4xi8> to vector<1xi32>
    %value = vector.extract %packed[0] : vector<1xi32> -> i32
    %next = vector.insert %value into %current[%word] : i32, vector<4xi32>
    scf.yield %next : vector<4xi32>
  }
  %codes = vector.bitcast %unpacked : vector<4xi32> to vector<16xi8>
  func.return %codes : vector<16xi8>
}

// Loads one 16-value half-group and its affine coefficients. Row origin is
// in bytes; block selects a complete 176-byte record. Group is in [0, 7] and
// half in [0, 1]. Low codes, high bits, and metadata each use one 16-byte load.
// The same shared metadata decoder serves Q4_K and Q5_K buffer consumers.
func.def public inline @ggml_q5_k_load_chunk16(%weight: buffer, %row_origin: offset, %block: index, %group_value: index, %half_value: index) -> (vector<16xi8>, f32, f32) {
  %group = index.assume %group_value [range(%group_value, 0, 7)] : index
  %half = index.assume %half_value [range(%half_value, 0, 1)] : index
  %groups_per_page = index.constant 2 : index
  %words_per_half = index.constant 4 : index
  %words_per_page = index.constant 8 : index
  %block_bytes = index.constant 176 : offset
  %header_bytes = index.constant 16 : offset
  %low_displacement = index.constant 48 : offset
  %block_add = index.scale %block, %block_bytes : index, offset -> offset
  %block_origin = index.add %row_origin, %block_add : offset
  %high_origin = index.add %block_origin, %header_bytes : offset
  %low_origin = index.add %block_origin, %low_displacement : offset
  %page = index.div %group, %groups_per_page : index
  %within = index.mul %half, %words_per_half : index
  %word = index.madd %page, %words_per_page, %within : index
  %low_view = buffer.view %weight[%low_origin] : buffer -> view<32xi32>
  %high_view = buffer.view %weight[%high_origin] : buffer -> view<8xi32>
  %low = vector.load %low_view[%word] : view<32xi32> -> vector<4xi32>
  %high = vector.load %high_view[%within] : view<8xi32> -> vector<4xi32>
  %codes = func.call @ggml_q5_k_unpack_codes16(%low, %high, %group) : (vector<4xi32>, vector<4xi32>, index) -> (vector<16xi8>)
  %scale, %minimum = func.call @ggml_q4_k_load_scale_minimum(%weight, %block_origin, %group) : (buffer, offset, index) -> (f32, f32)
  func.return %codes, %scale, %minimum : vector<16xi8>, f32, f32
}

// Retains one complete block for reuse across activation rows. No consumer
// format or arithmetic is imposed on the exact signed integer codes.
func.def public inline @ggml_q8_0_load_block(%input: buffer, %scale_origin: offset, %code_origin: offset) -> (vector<32xi8>, f32) {
  %scale_view = buffer.view %input[%scale_origin] : buffer -> view<1xf16>
  %code_view = buffer.view %input[%code_origin] : buffer -> view<32xi8>
  %scale_half = view.load %scale_view[0] : view<1xf16> -> f16
  %scale = scalar.extf %scale_half : f16 to f32
  %codes = vector.load %code_view[0] : view<32xi8> -> vector<32xi8>
  func.return %codes, %scale : vector<32xi8>, f32
}

// Loads only the selected 16-code packet. The caller chooses its code origin
// independently of the block scale, including a lane-owned half-block.
func.def public inline @ggml_q8_0_load_chunk16(%input: buffer, %scale_origin: offset, %code_origin: offset) -> (vector<16xi8>, f32) {
  %scale_view = buffer.view %input[%scale_origin] : buffer -> view<1xf16>
  %code_view = buffer.view %input[%code_origin] : buffer -> view<16xi8>
  %scale_half = view.load %scale_view[0] : view<1xf16> -> f16
  %scale = scalar.extf %scale_half : f16 to f32
  %codes = vector.load %code_view[0] : view<16xi8> -> vector<16xi8>
  func.return %codes, %scale : vector<16xi8>, f32
}

func.def public inline @ggml_q8_0_word(%input: buffer, %row_byte_base: offset, %block: index, %word_in_block: index) -> (vector<4xi8>, f32) {
  %word = index.assume %word_in_block [range(%word_in_block, 0, 7)] : index
  %block_bytes = index.constant 34 : offset
  %payload_byte_add = index.constant 2 : offset
  %word_bytes = index.constant 4 : offset
  %block_byte_add = index.scale %block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %payload_byte_base = index.add %block_byte_base, %payload_byte_add : offset
  %word_byte_add = index.scale %word, %word_bytes : index, offset -> offset
  %word_byte_base = index.add %payload_byte_base, %word_byte_add : offset
  %scale_view = buffer.view %input[%block_byte_base] : buffer -> view<1xf16>
  %word_view = buffer.view %input[%word_byte_base] : buffer -> view<1xi32>
  %scale_half = view.load %scale_view[0] : view<1xf16> -> f16
  %packed = vector.load %word_view[0] : view<1xi32> -> vector<1xi32>
  %codes = vector.bitcast %packed : vector<1xi32> to vector<4xi8>
  %scale = scalar.extf %scale_half : f16 to f32
  func.return %codes, %scale : vector<4xi8>, f32
}

template.decl @ggml.q8_0_bf16.contract(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>)

template.def<@ggml.q8_0_bf16.contract> device @ggml_q8_0_bf16_contract(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>) {
  %origin = index.constant 0 : offset
  %workitem = kernel.workitem.id<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c64 = index.constant 64 : index
  %waves = index.mul %wave_rows, %wave_columns : index
  %threads = index.mul %waves, %c32 : index
  %per_wave_rows = index.div %tile_rows, %wave_rows : index
  %per_wave_columns = index.div %tile_columns, %wave_columns : index
  %column_fragments = index.div %per_wave_columns, %c16 : index
  %thread_rounding = index.sub %threads, %c1 : index
  %weight_packets = index.mul %tile_columns, %c8 : index
  %input_packets = index.mul %tile_rows, %c8 : index
  %weight_padded = index.add %weight_packets, %thread_rounding : index
  %input_padded = index.add %input_packets, %thread_rounding : index
  %weight_rounds = index.div %weight_padded, %threads : index
  %input_rounds = index.div %input_padded, %threads : index
  %wave_column_group = index.rem %wave, %wave_columns : index
  %wave_row_group = index.div %wave, %wave_columns : index
  %wave_channel = index.mul %wave_column_group, %per_wave_columns : index
  %wave_token = index.mul %wave_row_group, %per_wave_rows : index
  %blocks = index.div %inputs, %c32 : index
  %block_bytes = index.constant 34 : offset
  %scale_bytes = index.constant 2 : offset
  %stage_row_bytes = index.constant 80 : offset
  %metadata_row_bytes = index.constant 4 : offset
  %weight_stage_bytes = index.scale %tile_columns, %stage_row_bytes : index, offset -> offset
  %input_stage_bytes = index.scale %tile_rows, %stage_row_bytes : index, offset -> offset
  %metadata_bytes = index.scale %tile_columns, %metadata_row_bytes : index, offset -> offset
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %input_stage = buffer.alloca<workgroup> align(16) %input_stage_bytes : buffer
  %metadata = buffer.alloca<workgroup> align(16) %metadata_bytes : buffer
  %weight_view = buffer.view %weight_stage[%origin] : buffer -> view<[%tile_columns]x40xbf16>
  %input_stage_view = buffer.view %input_stage[%origin] : buffer -> view<[%tile_rows]x40xbf16>
  %weight_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %weight_fragment = buffer.view %weight_stage[%origin] : buffer -> view<32x[%tile_columns]xbf16, %weight_layout>
  %metadata_view = buffer.view %metadata[%origin] : buffer -> view<[%tile_columns]xf32>
  %input_view = buffer.view %input[%origin] : buffer -> view<[%capacity]x[%inputs]xbf16>
  %inactive_values = vector.splatf 0.0 : vector<4xbf16>
  %accumulator_zero = vector.splatf 0.0 : vector<8xf32>
  %initial = vector.fragment<init> %accumulator_zero shape [%c16, %c16] : vector<8xf32>
  %initial_tile = vector.splatf 0.0 : vector<[%fragment_count]x8xf32>
  %result_tile = scf.for %block = [%c0 to %blocks step %c1](%accumulators = %initial_tile : vector<[%fragment_count]x8xf32>) -> (vector<[%fragment_count]x8xf32>) pipeline(%pipeline_depth) {
    %input_k = index.mul %block, %c32 : index
    %block_delta = index.scale %block, %block_bytes : index, offset -> offset
    // The 40-element pitch and packet permutation distribute each half-wave
    // store across distinct LDS banks. The final round may use fewer lanes.
    scf.for %round = [%c0 to %weight_rounds step %c1] unroll schedule(linear) {
      %task = index.madd %round, %threads, %workitem : index
      %owns_packet = index.cmp ult, %task, %weight_packets : index
      scf.if %owns_packet {
        %row_group = index.div %task, %c64 : index
        %within_row_group = index.rem %task, %c8 : index
        %local_channel = index.madd %row_group, %c8, %within_row_group : index
        %packet_group = index.div %task, %c8 : index
        %packet = index.rem %packet_group, %c8 : index
        %local_k = index.mul %packet, %c4 : index
        %dense = index.cmp eq, %streams, %c1 : index
        %channel, %valid_channel = scf.if %dense -> (index, i1) {
          %channel = index.add %channel_base, %local_channel : index
          %valid = index.cmp ult, %channel, %outputs : index
          scf.yield %channel, %valid : index, i1
        } else {
          // Stage every stream for a feature panel in the same wave. Its
          // consumer can combine F32 fragments before any global publication.
          %stream_columns = index.div %per_wave_columns, %streams : index
          %wave_column = index.div %local_channel, %per_wave_columns : index
          %within_wave = index.rem %local_channel, %per_wave_columns : index
          %stream = index.div %within_wave, %stream_columns : index
          %within_stream = index.rem %within_wave, %stream_columns : index
          %local_feature = index.madd %wave_column, %stream_columns, %within_stream : index
          %feature = index.add %channel_base, %local_feature : index
          %channel = index.madd %stream, %outputs, %feature : index
          %valid = index.cmp ult, %feature, %outputs : index
          scf.yield %channel, %valid : index, i1
        }
        %safe_channel = scf.select %valid_channel, %channel, %c0 : index
        %block_origin, %payload = scf.if %split_scales -> (offset, offset) {
          %channel_group = index.div %safe_channel, %c4 : index
          %within_group = index.rem %safe_channel, %c4 : index
          %group_scale_bytes = index.constant 8 : offset
          %code_row_bytes = index.constant 32 : offset
          %group_bytes = index.scale %c4, %row_bytes : index, offset -> offset
          %code_plane_bytes = index.scale %blocks, %group_scale_bytes : index, offset -> offset
          %group_delta = index.scale %channel_group, %group_bytes : index, offset -> offset
          %group_origin = index.add %weight_origin, %group_delta : offset
          %code_plane = index.add %group_origin, %code_plane_bytes : offset
          %block_row = index.madd %block, %c4, %within_group : index
          %scale_delta = index.scale %block_row, %scale_bytes : index, offset -> offset
          %scale_origin = index.add %group_origin, %scale_delta : offset
          %code_delta = index.scale %block_row, %code_row_bytes : index, offset -> offset
          %code_origin = index.add %code_plane, %code_delta : offset
          scf.yield %scale_origin, %code_origin : offset, offset
        } else {
          %row_delta = index.scale %safe_channel, %row_bytes : index, offset -> offset
          %row_origin = index.add %weight_origin, %row_delta : offset
          %scale_origin = index.add %row_origin, %block_delta : offset
          %code_origin = index.add %scale_origin, %scale_bytes : offset
          scf.yield %scale_origin, %code_origin : offset, offset
        }
        %codes_view = buffer.view %weight[%payload] : buffer -> view<32xi8>
        %codes = vector.load %codes_view[%local_k] : view<32xi8> -> vector<4xi8>
        %wide = vector.sitofp %codes : vector<4xi8> to vector<4xf32>
        %values = vector.fptrunc %wide : vector<4xf32> to vector<4xbf16>
        vector.store %values, %weight_view[%local_channel, %local_k] : vector<4xbf16>, view<[%tile_columns]x40xbf16>
        %leader = index.cmp eq, %packet, %c0 : index
        %overlapped = index.cmp ugt, %pipeline_depth, %c1 : index
        // A uniform scale read keeps its value in the read-ahead stage;
        // only the owner publishes it. Lanes sharing a channel request the
        // same address, so this adds no distinct weight bytes.
        scf.if %overlapped {
          %scale_view = buffer.view %weight[%block_origin] : buffer -> view<1xf16>
          %half_scale = view.load %scale_view[%c0] : view<1xf16> -> f16
          %scale = scalar.extf %half_scale : f16 to f32
          scf.if %leader {
            view.store %scale, %metadata_view[%local_channel] : f32, view<[%tile_columns]xf32>
          }
        } else {
          scf.if %leader {
            %scale_view = buffer.view %weight[%block_origin] : buffer -> view<1xf16>
            %half_scale = view.load %scale_view[%c0] : view<1xf16> -> f16
            %scale = scalar.extf %half_scale : f16 to f32
            view.store %scale, %metadata_view[%local_channel] : f32, view<[%tile_columns]xf32>
          }
        }
      }
    }
    scf.for %round = [%c0 to %input_rounds step %c1] unroll schedule(linear) {
      %task = index.madd %round, %threads, %workitem : index
      %owns_packet = index.cmp ult, %task, %input_packets : index
      scf.if %owns_packet {
        %row_group = index.div %task, %c64 : index
        %within_row_group = index.rem %task, %c8 : index
        %local_token = index.madd %row_group, %c8, %within_row_group : index
        %packet_group = index.div %task, %c8 : index
        %packet = index.rem %packet_group, %c8 : index
        %local_k = index.mul %packet, %c4 : index
        %token = index.add %first, %local_token : index
        %live = index.cmp ult, %token, %end : index
        %safe_token = scf.select %live, %token, %c0 : index
        %k = index.add %input_k, %local_k : index
        %loaded = vector.load %input_view[%safe_token, %k] : view<[%capacity]x[%inputs]xbf16> -> vector<4xbf16>
        %mask = vector.splat %live : vector<4xi1>
        %values = vector.select %mask, %loaded, %inactive_values : vector<4xbf16>
        vector.store %values, %input_stage_view[%local_token, %local_k] : vector<4xbf16>, view<[%tile_rows]x40xbf16>
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %scale_column = index.rem %lane, %c16 : index
    %next_tile = scf.for %ordinal = [%c0 to %fragment_count step %c1](%partial_tile = %accumulators : vector<[%fragment_count]x8xf32>) -> (vector<[%fragment_count]x8xf32>) unroll schedule(linear) {
      %row_fragment = index.div %ordinal, %column_fragments : index
      %column_fragment = index.rem %ordinal, %column_fragments : index
      %fragment_row = index.madd %row_fragment, %c16, %wave_token : index
      %fragment_column = index.madd %column_fragment, %c16, %wave_channel : index
      %scale_index = index.add %fragment_column, %scale_column : index
      %scale_value = view.load %metadata_view[%scale_index] : view<[%tile_columns]xf32> -> f32
      %scale = vector.splat %scale_value : vector<8xf32>
      %rhs0 = vector.fragment.load<rhs> %weight_fragment[%c0, %fragment_column] shape [%c16, %c16] : view<32x[%tile_columns]xbf16, %weight_layout> -> vector<16xbf16>
      %rhs1 = vector.fragment.load<rhs> %weight_fragment[%c16, %fragment_column] shape [%c16, %c16] : view<32x[%tile_columns]xbf16, %weight_layout> -> vector<16xbf16>
      %lhs0 = vector.fragment.load<lhs> %input_stage_view[%fragment_row, %c0] shape [%c16, %c16] : view<[%tile_rows]x40xbf16> -> vector<16xbf16>
      %lhs1 = vector.fragment.load<lhs> %input_stage_view[%fragment_row, %c16] shape [%c16, %c16] : view<[%tile_rows]x40xbf16> -> vector<16xbf16>
      %half = vector.mma %lhs0, %rhs0, %initial : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %dot = vector.mma %lhs1, %rhs1, %half : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %accumulator = vector.extract %partial_tile[%ordinal] : vector<[%fragment_count]x8xf32> -> vector<8xf32>
      %next = vector.fmaf %dot, %scale, %accumulator : vector<8xf32>
      %updated = vector.insert %next into %partial_tile[%ordinal] : vector<8xf32>, vector<[%fragment_count]x8xf32>
      scf.yield %updated : vector<[%fragment_count]x8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next_tile : vector<[%fragment_count]x8xf32>
  }
  template.return %result_tile : vector<[%fragment_count]x8xf32>
}

template.decl @ggml.q8_0_f16.contract(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>)

template.def<@ggml.q8_0_f16.contract> device @ggml_q8_0_f16_contract(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>) {
  %origin = index.constant 0 : offset
  %workitem = kernel.workitem.id<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c64 = index.constant 64 : index
  %waves = index.mul %wave_rows, %wave_columns : index
  %threads = index.mul %waves, %c32 : index
  %per_wave_rows = index.div %tile_rows, %wave_rows : index
  %per_wave_columns = index.div %tile_columns, %wave_columns : index
  %column_fragments = index.div %per_wave_columns, %c16 : index
  %thread_rounding = index.sub %threads, %c1 : index
  %weight_packets = index.mul %tile_columns, %c8 : index
  %input_packets = index.mul %tile_rows, %c8 : index
  %weight_padded = index.add %weight_packets, %thread_rounding : index
  %input_padded = index.add %input_packets, %thread_rounding : index
  %weight_rounds = index.div %weight_padded, %threads : index
  %input_rounds = index.div %input_padded, %threads : index
  %wave_column_group = index.rem %wave, %wave_columns : index
  %wave_row_group = index.div %wave, %wave_columns : index
  %wave_channel = index.mul %wave_column_group, %per_wave_columns : index
  %wave_token = index.mul %wave_row_group, %per_wave_rows : index
  %blocks = index.div %inputs, %c32 : index
  %block_bytes = index.constant 34 : offset
  %scale_bytes = index.constant 2 : offset
  %stage_row_bytes = index.constant 80 : offset
  %weight_stage_bytes = index.scale %tile_columns, %stage_row_bytes : index, offset -> offset
  %input_stage_bytes = index.scale %tile_rows, %stage_row_bytes : index, offset -> offset
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %input_stage = buffer.alloca<workgroup> align(16) %input_stage_bytes : buffer
  %weight_view = buffer.view %weight_stage[%origin] : buffer -> view<[%tile_columns]x40xf16>
  %input_stage_view = buffer.view %input_stage[%origin] : buffer -> view<[%tile_rows]x40xf16>
  %weight_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %weight_fragment = buffer.view %weight_stage[%origin] : buffer -> view<32x[%tile_columns]xf16, %weight_layout>
  %input_view = buffer.view %input[%origin] : buffer -> view<[%capacity]x[%inputs]xbf16>
  %inactive_values = vector.splatf 0.0 : vector<4xbf16>
  %accumulator_zero = vector.splatf 0.0 : vector<8xf32>
  %initial = vector.fragment<init> %accumulator_zero shape [%c16, %c16] : vector<8xf32>
  %initial_tile = vector.splatf 0.0 : vector<[%fragment_count]x8xf32>
  %result_tile = scf.for %block = [%c0 to %blocks step %c1](%accumulators = %initial_tile : vector<[%fragment_count]x8xf32>) -> (vector<[%fragment_count]x8xf32>) pipeline(%pipeline_depth) {
    %input_k = index.mul %block, %c32 : index
    %block_delta = index.scale %block, %block_bytes : index, offset -> offset
    // The 40-element pitch and packet permutation distribute each half-wave
    // store across distinct LDS banks. The final round may use fewer lanes.
    scf.for %round = [%c0 to %weight_rounds step %c1] unroll schedule(linear) {
      %task = index.madd %round, %threads, %workitem : index
      %owns_packet = index.cmp ult, %task, %weight_packets : index
      scf.if %owns_packet {
        %row_group = index.div %task, %c64 : index
        %within_row_group = index.rem %task, %c8 : index
        %local_channel = index.madd %row_group, %c8, %within_row_group : index
        %packet_group = index.div %task, %c8 : index
        %packet = index.rem %packet_group, %c8 : index
        %local_k = index.mul %packet, %c4 : index
        %dense = index.cmp eq, %streams, %c1 : index
        %channel, %valid_channel = scf.if %dense -> (index, i1) {
          %channel = index.add %channel_base, %local_channel : index
          %valid = index.cmp ult, %channel, %outputs : index
          scf.yield %channel, %valid : index, i1
        } else {
          // Stage every stream for a feature panel in the same wave. Its
          // consumer can combine F32 fragments before any global publication.
          %stream_columns = index.div %per_wave_columns, %streams : index
          %wave_column = index.div %local_channel, %per_wave_columns : index
          %within_wave = index.rem %local_channel, %per_wave_columns : index
          %stream = index.div %within_wave, %stream_columns : index
          %within_stream = index.rem %within_wave, %stream_columns : index
          %local_feature = index.madd %wave_column, %stream_columns, %within_stream : index
          %feature = index.add %channel_base, %local_feature : index
          %channel = index.madd %stream, %outputs, %feature : index
          %valid = index.cmp ult, %feature, %outputs : index
          scf.yield %channel, %valid : index, i1
        }
        %safe_channel = scf.select %valid_channel, %channel, %c0 : index
        %block_origin, %payload = scf.if %split_scales -> (offset, offset) {
          %channel_group = index.div %safe_channel, %c4 : index
          %within_group = index.rem %safe_channel, %c4 : index
          %group_scale_bytes = index.constant 8 : offset
          %code_row_bytes = index.constant 32 : offset
          %group_bytes = index.scale %c4, %row_bytes : index, offset -> offset
          %code_plane_bytes = index.scale %blocks, %group_scale_bytes : index, offset -> offset
          %group_delta = index.scale %channel_group, %group_bytes : index, offset -> offset
          %group_origin = index.add %weight_origin, %group_delta : offset
          %code_plane = index.add %group_origin, %code_plane_bytes : offset
          %block_row = index.madd %block, %c4, %within_group : index
          %scale_delta = index.scale %block_row, %scale_bytes : index, offset -> offset
          %scale_origin = index.add %group_origin, %scale_delta : offset
          %code_delta = index.scale %block_row, %code_row_bytes : index, offset -> offset
          %code_origin = index.add %code_plane, %code_delta : offset
          scf.yield %scale_origin, %code_origin : offset, offset
        } else {
          %row_delta = index.scale %safe_channel, %row_bytes : index, offset -> offset
          %row_origin = index.add %weight_origin, %row_delta : offset
          %scale_origin = index.add %row_origin, %block_delta : offset
          %code_origin = index.add %scale_origin, %scale_bytes : offset
          scf.yield %scale_origin, %code_origin : offset, offset
        }
        %codes_view = buffer.view %weight[%payload] : buffer -> view<32xi8>
        %codes = vector.load %codes_view[%local_k] : view<32xi8> -> vector<4xi8>
        %wide = vector.sitofp %codes : vector<4xi8> to vector<4xf32>
        %half_codes = vector.fptrunc %wide : vector<4xf32> to vector<4xf16>
        %scale_view = buffer.view %weight[%block_origin] : buffer -> view<1xf16>
        %half_scale = view.load %scale_view[%c0] : view<1xf16> -> f16
        %scales = vector.splat %half_scale : vector<4xf16>
        %values = vector.mulf %half_codes, %scales : vector<4xf16>
        vector.store %values, %weight_view[%local_channel, %local_k] : vector<4xf16>, view<[%tile_columns]x40xf16>
      }
    }
    scf.for %round = [%c0 to %input_rounds step %c1] unroll schedule(linear) {
      %task = index.madd %round, %threads, %workitem : index
      %owns_packet = index.cmp ult, %task, %input_packets : index
      scf.if %owns_packet {
        %row_group = index.div %task, %c64 : index
        %within_row_group = index.rem %task, %c8 : index
        %local_token = index.madd %row_group, %c8, %within_row_group : index
        %packet_group = index.div %task, %c8 : index
        %packet = index.rem %packet_group, %c8 : index
        %local_k = index.mul %packet, %c4 : index
        %token = index.add %first, %local_token : index
        %live = index.cmp ult, %token, %end : index
        %safe_token = scf.select %live, %token, %c0 : index
        %k = index.add %input_k, %local_k : index
        %loaded = vector.load %input_view[%safe_token, %k] : view<[%capacity]x[%inputs]xbf16> -> vector<4xbf16>
        %mask = vector.splat %live : vector<4xi1>
        %selected = vector.select %mask, %loaded, %inactive_values : vector<4xbf16>
        %wide = vector.extf %selected : vector<4xbf16> to vector<4xf32>
        %values = vector.fptrunc %wide : vector<4xf32> to vector<4xf16>
        vector.store %values, %input_stage_view[%local_token, %local_k] : vector<4xf16>, view<[%tile_rows]x40xf16>
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %next_tile = scf.for %ordinal = [%c0 to %fragment_count step %c1](%partial_tile = %accumulators : vector<[%fragment_count]x8xf32>) -> (vector<[%fragment_count]x8xf32>) unroll schedule(linear) {
      %row_fragment = index.div %ordinal, %column_fragments : index
      %column_fragment = index.rem %ordinal, %column_fragments : index
      %fragment_row = index.madd %row_fragment, %c16, %wave_token : index
      %fragment_column = index.madd %column_fragment, %c16, %wave_channel : index
      %rhs0 = vector.fragment.load<rhs> %weight_fragment[%c0, %fragment_column] shape [%c16, %c16] : view<32x[%tile_columns]xf16, %weight_layout> -> vector<16xf16>
      %rhs1 = vector.fragment.load<rhs> %weight_fragment[%c16, %fragment_column] shape [%c16, %c16] : view<32x[%tile_columns]xf16, %weight_layout> -> vector<16xf16>
      %lhs0 = vector.fragment.load<lhs> %input_stage_view[%fragment_row, %c0] shape [%c16, %c16] : view<[%tile_rows]x40xf16> -> vector<16xf16>
      %lhs1 = vector.fragment.load<lhs> %input_stage_view[%fragment_row, %c16] shape [%c16, %c16] : view<[%tile_rows]x40xf16> -> vector<16xf16>
      %accumulator = vector.extract %partial_tile[%ordinal] : vector<[%fragment_count]x8xf32> -> vector<8xf32>
      %fragment = vector.fragment<init> %accumulator shape [%c16, %c16] : vector<8xf32>
      %half = vector.mma %lhs0, %rhs0, %fragment : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %next = vector.mma %lhs1, %rhs1, %half : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %updated = vector.insert %next into %partial_tile[%ordinal] : vector<8xf32>, vector<[%fragment_count]x8xf32>
      scf.yield %updated : vector<[%fragment_count]x8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next_tile : vector<[%fragment_count]x8xf32>
  }
  template.return %result_tile : vector<[%fragment_count]x8xf32>
}

// Cooperatively stage two original Q8 blocks per K64 panel. Each producer
// owns a complete block and its scale. Coefficients round to F16, matrix
// accumulators remain F32, and global input storage remains BF16.
// BF16 inputs convert to F16 in the panel, with its narrower exponent range.
template.decl @ggml.q8_0_f16.contract_k64(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>)

template.def<@ggml.q8_0_f16.contract_k64> device @ggml_q8_0_f16_contract_k64(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>) {
  %origin = index.constant 0 : offset
  %workitem = kernel.workitem.id<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c72 = index.constant 72 : index
  %c64 = index.constant 64 : index
  %waves = index.mul %wave_rows, %wave_columns : index
  %threads = index.mul %waves, %c32 : index
  %per_wave_rows = index.div %tile_rows, %wave_rows : index
  %per_wave_columns = index.div %tile_columns, %wave_columns : index
  %column_fragments = index.div %per_wave_columns, %c16 : index
  %thread_rounding = index.sub %threads, %c1 : index
  %weight_packets = index.mul %tile_columns, %c2 : index
  %input_packets = index.mul %tile_rows, %c2 : index
  %weight_padded = index.add %weight_packets, %thread_rounding : index
  %input_padded = index.add %input_packets, %thread_rounding : index
  %weight_rounds = index.div %weight_padded, %threads : index
  %input_rounds = index.div %input_padded, %threads : index
  %wave_column_group = index.rem %wave, %wave_columns : index
  %wave_row_group = index.div %wave, %wave_columns : index
  %wave_channel = index.mul %wave_column_group, %per_wave_columns : index
  %wave_token = index.mul %wave_row_group, %per_wave_rows : index
  %blocks = index.div %inputs, %c32 : index
  %padded_blocks = index.add %blocks, %c1 : index
  %stage_count = index.div %padded_blocks, %c2 : index
  %block_bytes = index.constant 34 : offset
  %scale_bytes = index.constant 2 : offset
  %stage_row_bytes = index.constant 144 : offset
  %weight_stage_bytes = index.scale %tile_columns, %stage_row_bytes : index, offset -> offset
  %input_stage_bytes = index.scale %tile_rows, %stage_row_bytes : index, offset -> offset
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %input_stage = buffer.alloca<workgroup> align(16) %input_stage_bytes : buffer
  %weight_view = buffer.view %weight_stage[%origin] : buffer -> view<[%tile_columns]x72xf16>
  %input_stage_view = buffer.view %input_stage[%origin] : buffer -> view<[%tile_rows]x72xf16>
  %weight_layout = encoding.layout.strided [1, %c72] : encoding<layout>
  %weight_fragment = buffer.view %weight_stage[%origin] : buffer -> view<64x[%tile_columns]xf16, %weight_layout>
  %input_view = buffer.view %input[%origin] : buffer -> view<[%capacity]x[%inputs]xbf16>
  %inactive_values = vector.splatf 0.0 : vector<32xbf16>
  %accumulator_zero = vector.splatf 0.0 : vector<8xf32>
  %initial = vector.fragment<init> %accumulator_zero shape [%c16, %c16] : vector<8xf32>
  %initial_tile = vector.splatf 0.0 : vector<[%fragment_count]x8xf32>
  %result_tile = scf.for %stage = [%c0 to %stage_count step %c1](%accumulators = %initial_tile : vector<[%fragment_count]x8xf32>) -> (vector<[%fragment_count]x8xf32>) pipeline(%pipeline_depth) {
    %stage_block = index.mul %stage, %c2 : index
    // Whole-block producers retain one scale and address per row.
    // A K64 stage uses a padded 72-half row pitch.
    scf.for %round = [%c0 to %weight_rounds step %c1] unroll schedule(linear) {
      %task = index.madd %round, %threads, %workitem : index
      %owns_packet = index.cmp ult, %task, %weight_packets : index
      scf.if %owns_packet {
        // One producer owns an entire original K32 block.
        %local_channel = index.div %task, %c2 : index
        %within_stage = index.rem %task, %c2 : index
        %local_k = index.mul %within_stage, %c32 : index
        %candidate_block = index.add %stage_block, %within_stage : index
        %valid_block = index.cmp ult, %candidate_block, %blocks : index
        %block = scf.select %valid_block, %candidate_block, %c0 : index
        %dense = index.cmp eq, %streams, %c1 : index
        %channel, %valid_channel = scf.if %dense -> (index, i1) {
          %channel = index.add %channel_base, %local_channel : index
          %valid = index.cmp ult, %channel, %outputs : index
          scf.yield %channel, %valid : index, i1
        } else {
          // Stage every stream for a feature panel in the same wave. Its
          // consumer can combine F32 fragments before any global publication.
          %stream_columns = index.div %per_wave_columns, %streams : index
          %wave_column = index.div %local_channel, %per_wave_columns : index
          %within_wave = index.rem %local_channel, %per_wave_columns : index
          %stream = index.div %within_wave, %stream_columns : index
          %within_stream = index.rem %within_wave, %stream_columns : index
          %local_feature = index.madd %wave_column, %stream_columns, %within_stream : index
          %feature = index.add %channel_base, %local_feature : index
          %channel = index.madd %stream, %outputs, %feature : index
          %valid = index.cmp ult, %feature, %outputs : index
          scf.yield %channel, %valid : index, i1
        }
        %safe_channel = scf.select %valid_channel, %channel, %c0 : index
        %block_delta = index.scale %block, %block_bytes : index, offset -> offset
        %block_origin, %payload = scf.if %split_scales -> (offset, offset) {
          %channel_group = index.div %safe_channel, %c4 : index
          %within_group = index.rem %safe_channel, %c4 : index
          %group_scale_bytes = index.constant 8 : offset
          %code_row_bytes = index.constant 32 : offset
          %group_bytes = index.scale %c4, %row_bytes : index, offset -> offset
          %code_plane_bytes = index.scale %blocks, %group_scale_bytes : index, offset -> offset
          %group_delta = index.scale %channel_group, %group_bytes : index, offset -> offset
          %group_origin = index.add %weight_origin, %group_delta : offset
          %code_plane = index.add %group_origin, %code_plane_bytes : offset
          %block_row = index.madd %block, %c4, %within_group : index
          %scale_delta = index.scale %block_row, %scale_bytes : index, offset -> offset
          %scale_origin = index.add %group_origin, %scale_delta : offset
          %code_delta = index.scale %block_row, %code_row_bytes : index, offset -> offset
          %code_origin = index.add %code_plane, %code_delta : offset
          scf.yield %scale_origin, %code_origin : offset, offset
        } else {
          %row_delta = index.scale %safe_channel, %row_bytes : index, offset -> offset
          %row_origin = index.add %weight_origin, %row_delta : offset
          %scale_origin = index.add %row_origin, %block_delta : offset
          %code_origin = index.add %scale_origin, %scale_bytes : offset
          scf.yield %scale_origin, %code_origin : offset, offset
        }
        %codes_view = buffer.view %weight[%payload] : buffer -> view<32xi8>
        %codes = vector.load %codes_view[%c0] : view<32xi8> -> vector<32xi8>
        // Every signed byte is exactly representable before block scaling.
        %half_codes = vector.sitofp %codes : vector<32xi8> to vector<32xf16>
        %scale_view = buffer.view %weight[%block_origin] : buffer -> view<1xf16>
        %loaded_scale = view.load %scale_view[%c0] : view<1xf16> -> f16
        %zero_scale = scalar.constant 0.0 : f16
        %half_scale = scf.select %valid_block, %loaded_scale, %zero_scale : f16
        %scales = vector.splat %half_scale : vector<32xf16>
        %values = vector.mulf %half_codes, %scales : vector<32xf16>
        vector.store %values, %weight_view[%local_channel, %local_k] : vector<32xf16>, view<[%tile_columns]x72xf16>
      }
    }
    scf.for %round = [%c0 to %input_rounds step %c1] unroll schedule(linear) {
      %task = index.madd %round, %threads, %workitem : index
      %owns_packet = index.cmp ult, %task, %input_packets : index
      scf.if %owns_packet {
        // One producer owns an entire original K32 block.
        %local_token = index.div %task, %c2 : index
        %within_stage = index.rem %task, %c2 : index
        %local_k = index.mul %within_stage, %c32 : index
        %candidate_block = index.add %stage_block, %within_stage : index
        %valid_block = index.cmp ult, %candidate_block, %blocks : index
        %block = scf.select %valid_block, %candidate_block, %c0 : index
        %token = index.add %first, %local_token : index
        %live_token = index.cmp ult, %token, %end : index
        %live = scalar.andi %live_token, %valid_block : i1
        %safe_token = scf.select %live, %token, %c0 : index
        // The producer owns one selected K32 block. Its row and block
        // are both live or zero; keep the complete byte offset full-width.
        %element_bytes = index.constant 2 : offset
        %input_block_bytes = index.constant 64 : offset
        %input_row_bytes = index.scale %inputs, %element_bytes : index, offset -> offset
        %input_row_origin = index.scale %safe_token, %input_row_bytes : index, offset -> offset
        %input_block_origin = index.scale %block, %input_block_bytes : index, offset -> offset
        %input_position = index.add %input_row_origin, %input_block_origin : offset
        %packet_view = buffer.view %input[%input_position] : buffer -> view<32xbf16>
        %loaded = vector.load %packet_view[%c0] : view<32xbf16> -> vector<32xbf16>
        %mask = vector.splat %live : vector<32xi1>
        %selected = vector.select %mask, %loaded, %inactive_values : vector<32xbf16>
        %wide = vector.extf %selected : vector<32xbf16> to vector<32xf32>
        %values = vector.fptrunc %wide : vector<32xf32> to vector<32xf16>
        vector.store %values, %input_stage_view[%local_token, %local_k] : vector<32xf16>, view<[%tile_rows]x72xf16>
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %stage_result = scf.for %within = [%c0 to %c2 step %c1](%stage_accumulators = %accumulators : vector<[%fragment_count]x8xf32>) -> (vector<[%fragment_count]x8xf32>) unroll schedule(linear) {
      %first_k = index.mul %within, %c32 : index
      %second_k = index.add %first_k, %c16 : index
      %next_tile = scf.for %ordinal = [%c0 to %fragment_count step %c1](%partial_tile = %stage_accumulators : vector<[%fragment_count]x8xf32>) -> (vector<[%fragment_count]x8xf32>) unroll schedule(linear) {
        %row_fragment = index.div %ordinal, %column_fragments : index
        %column_fragment = index.rem %ordinal, %column_fragments : index
        %fragment_row = index.madd %row_fragment, %c16, %wave_token : index
        %fragment_column = index.madd %column_fragment, %c16, %wave_channel : index
        %rhs0 = vector.fragment.load<rhs> %weight_fragment[%first_k, %fragment_column] shape [%c16, %c16] : view<64x[%tile_columns]xf16, %weight_layout> -> vector<16xf16>
        %rhs1 = vector.fragment.load<rhs> %weight_fragment[%second_k, %fragment_column] shape [%c16, %c16] : view<64x[%tile_columns]xf16, %weight_layout> -> vector<16xf16>
        %lhs0 = vector.fragment.load<lhs> %input_stage_view[%fragment_row, %first_k] shape [%c16, %c16] : view<[%tile_rows]x72xf16> -> vector<16xf16>
        %lhs1 = vector.fragment.load<lhs> %input_stage_view[%fragment_row, %second_k] shape [%c16, %c16] : view<[%tile_rows]x72xf16> -> vector<16xf16>
        %accumulator = vector.extract %partial_tile[%ordinal] : vector<[%fragment_count]x8xf32> -> vector<8xf32>
        %fragment = vector.fragment<init> %accumulator shape [%c16, %c16] : vector<8xf32>
        %half = vector.mma %lhs0, %rhs0, %fragment : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %next = vector.mma %lhs1, %rhs1, %half : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %updated = vector.insert %next into %partial_tile[%ordinal] : vector<8xf32>, vector<[%fragment_count]x8xf32>
        scf.yield %updated : vector<[%fragment_count]x8xf32>
      }
      scf.yield %next_tile : vector<[%fragment_count]x8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %stage_result : vector<[%fragment_count]x8xf32>
  }
  template.return %result_tile : vector<[%fragment_count]x8xf32>
}

// Publish a native 16x16 F32 accumulator fragment to a bounded BF16 matrix.
//
// store_bf16_wave32 receives the eight F32 accumulator elements owned by each
// lane of a complete RDNA wave32. The caller supplies a disjoint output tile
// and a view relative to its full-width byte origin. Rows and columns outside
// that view remain untouched, including a tile wholly beyond either extent.
// Full fragments use the native fragment store; partial fragments publish
// individual live elements. Both paths round once from F32 to BF16.
//
// The caller owns the concrete target and fragment layout, workgroup grid,
// storage allocation, and synchronization. This operation allocates no memory
// and inserts no barrier. It does not implement a wave64 or CDNA layout.
template.decl @tensor.matrix.store_bf16_wave32(%remaining_rows: index, %outputs: index, %fragment_row: index, %result_column: index, %result: vector<8xf32>, %output_view: view<[%remaining_rows]x[%outputs]xbf16>)

template.def<@tensor.matrix.store_bf16_wave32> device @tensor_matrix_store_bf16_wave32(%remaining_rows: index, %outputs: index, %fragment_row: index, %result_column: index, %result: vector<8xf32>, %output_view: view<[%remaining_rows]x[%outputs]xbf16>) {
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %lane_column = index.rem %lane, %c16 : index
  %lane_row = index.div %lane, %c16 : index
  %row_limit = index.add %fragment_row, %c16 : index
  %column_limit = index.add %result_column, %c16 : index
  %full_rows = index.cmp ule, %row_limit, %remaining_rows : index
  %full_columns = index.cmp ule, %column_limit, %outputs : index
  %full_fragment = scalar.andi %full_rows, %full_columns : i1
  scf.if %full_fragment {
    %maximum_row = index.sub %remaining_rows, %c16 : index
    %maximum_column = index.sub %outputs, %c16 : index
    %checked_row = index.assume %fragment_row [ge(%fragment_row, 0), le(%fragment_row, %maximum_row)] : index
    %checked_column = index.assume %result_column [ge(%result_column, 0), le(%result_column, %maximum_column)] : index
    %fragment = vector.fragment<result> %result shape [%c16, %c16] : vector<8xf32>
    vector.fragment.store<result> %fragment, %output_view[%checked_row, %checked_column] shape [%c16, %c16] : vector<8xf32>, view<[%remaining_rows]x[%outputs]xbf16>
  } else {
    %column = index.add %result_column, %lane_column : index
    %live_column = index.cmp ult, %column, %outputs : index
    %packed = vector.fptrunc %result : vector<8xf32> to vector<8xbf16>
    scf.for %element = [%c0 to %c8 step %c1] unroll schedule(linear) {
      %within_row = index.madd %element, %c2, %lane_row : index
      %token = index.add %fragment_row, %within_row : index
      %live_row = index.cmp ult, %token, %remaining_rows : index
      %live = scalar.andi %live_row, %live_column : i1
      scf.if %live {
        %value = vector.extract %packed[%element] : vector<8xbf16> -> bf16
        view.store %value, %output_view[%token, %column] : bf16, view<[%remaining_rows]x[%outputs]xbf16>
      }
    }
  }
  template.return
}

template.decl @random.philox4x32(%counter0: i32, %counter1: i32, %counter2: i32, %counter3: i32, %seed0: i32, %seed1: i32) -> (i32, i32, i32, i32)

template.decl @random.normal_pair(%radius_word: i32, %angle_word: i32) -> (f32, f32)

// Stateless Philox4x32-10. Counter and key words are bit patterns; arithmetic
// wraps modulo 2^32. Callers choose the counter partition, independently of
// launch shape, workgroup order, or device.
template.def<@random.philox4x32> @random_philox4x32(%counter0: i32, %counter1: i32, %counter2: i32, %counter3: i32, %seed0: i32, %seed1: i32) -> (i32, i32, i32, i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c10 = index.constant 10 : index
  %left_multiplier = scalar.constant 3528531795 : i64
  %right_multiplier = scalar.constant 3449720151 : i64
  %shift = scalar.constant 32 : i64
  %key_step0 = scalar.constant -1640531527 : i32
  %key_step1 = scalar.constant -1150833019 : i32
  %a, %b, %c, %d, %key0, %key1 = scf.for %round = [%c0 to %c10 step %c1](%a = %counter0 : i32, %b = %counter1 : i32, %c = %counter2 : i32, %d = %counter3 : i32, %key0 = %seed0 : i32, %key1 = %seed1 : i32) -> (i32, i32, i32, i32, i32, i32) {
    %wide_a = scalar.extui %a : i32 to i64
    %wide_c = scalar.extui %c : i32 to i64
    %left = scalar.muli %wide_a, %left_multiplier : i64
    %right = scalar.muli %wide_c, %right_multiplier : i64
    %left_high = scalar.shrui %left, %shift : i64
    %right_high = scalar.shrui %right, %shift : i64
    %left_high32 = scalar.trunci %left_high : i64 to i32
    %right_high32 = scalar.trunci %right_high : i64 to i32
    %left_low = scalar.trunci %left : i64 to i32
    %right_low = scalar.trunci %right : i64 to i32
    %mixed_a = scalar.xori %right_high32, %b : i32
    %next_a = scalar.xori %mixed_a, %key0 : i32
    %mixed_c = scalar.xori %left_high32, %d : i32
    %next_c = scalar.xori %mixed_c, %key1 : i32
    %next_key0 = scalar.addi %key0, %key_step0 : i32
    %next_key1 = scalar.addi %key1, %key_step1 : i32
    scf.yield %next_a, %right_low, %next_c, %left_low, %next_key0, %next_key1 : i32, i32, i32, i32, i32, i32
  }
  template.return %a, %b, %c, %d : i32, i32, i32, i32
}

// Box-Muller in F32. Radial uniforms are clamped to the nearest finite open
// endpoint after conversion; zero words retain the half-bin offset. Angular
// uniforms use turns directly, avoiding a multiply/divide by 2*pi.
template.def<@random.normal_pair> @random_normal_pair(%radius_word: i32, %angle_word: i32) -> (f32, f32) {
  %scale = scalar.constant 2.3283064365386963e-10 : f32
  %half = scalar.constant 0.5 : f32
  %upper = scalar.constant 0.99999994039535522 : f32
  %cn2_0 = scalar.constant -2.0 : f32
  %radial = scalar.uitofp %radius_word : i32 to f32
  %angular = scalar.uitofp %angle_word : i32 to f32
  %radial_offset = scalar.addf %radial, %half : f32
  %angular_offset = scalar.addf %angular, %half : f32
  %radial_unit = scalar.mulf %radial_offset, %scale : f32
  %angle = scalar.mulf %angular_offset, %scale : f32
  %uniform = scalar.minnumf %radial_unit, %upper : f32
  %logarithm = scalar.logf<afn> %uniform : f32
  %squared = scalar.mulf %logarithm, %cn2_0 : f32
  %radius = scalar.sqrtf %squared : f32
  %cosine = scalar.costurnsf<afn> %angle : f32
  %sine = scalar.sinturnsf<afn> %angle : f32
  %a = scalar.mulf %radius, %cosine : f32
  %b = scalar.mulf %radius, %sine : f32
  template.return %a, %b : f32, f32
}

template.decl @sampling.cutoff_f32(%columns: index, %logits: buffer, %logits_origin: offset, %excluded_id: i32, %minimum: i64, %maximum: i64, %target: f32, %weighted: i1, %maximum_logit: f32, %temperature: f32) -> (i64)

template.decl @sampling.categorical_f32(%columns: index, %logits: buffer, %logits_origin: offset, %temperature: f32, %top_p: f32, %top_k: i32, %seed: i64, %position: i64) -> (i32)

template.decl @sampling.categorical_excluding_f32(%columns: index, %logits: buffer, %logits_origin: offset, %excluded_id: i32, %temperature: f32, %top_p: f32, %top_k: i32, %seed: i64, %position: i64) -> (i32)

template.decl @sampling.reduce_key(%key: i64, %minimum: i1) -> (i64)

// Unsigned greater keys select larger finite F32 logits, then smaller
// nonnegative I32 vocabulary IDs. Both signed zeros compare equally. The low
// 32 bits contain the complemented ID; zero is below every valid key and can
// represent an empty candidate. Zero classification uses the representation
// so native floating-point modes cannot turn subnormal logits into ties.
// Target and draft selection share this order.
func.def public @sampling_key(%value: f32, %id: i32) -> (i64) {
  %value_bits = scalar.bitcast %value : f32 to i32
  %zero32 = scalar.constant 0 : i32
  %magnitude_mask = scalar.constant 2147483647 : i32
  %magnitude = scalar.andi %value_bits, %magnitude_mask : i32
  %is_zero = scalar.cmpi eq, %magnitude, %zero32 : i32
  %bits = scf.select %is_zero, %zero32, %value_bits : i32
  %sign = scalar.constant -2147483648 : i32
  %all_bits = scalar.constant -1 : i32
  %negative = scalar.cmpi slt, %bits, %zero32 : i32
  %mask = scf.select %negative, %all_bits, %sign : i32
  %ordered = scalar.xori %bits, %mask : i32
  %inverse = scalar.xori %id, %all_bits : i32
  %high = scalar.extui %ordered : i32 to i64
  %low = scalar.extui %inverse : i32 to i64
  %shift = scalar.constant 32 : i64
  %shifted = scalar.shli %high, %shift : i64
  %key = scalar.ori %shifted, %low : i64
  func.return %key : i64
}

// Independent per-token exponential races implement a categorical draw.
// Request seed, absolute target position and token ID fully determine the
// counter. Packed rows, dispatch shape and speculative depth are absent.
func.def @sampling_race(%logit: f32, %maximum: f32, %temperature: f32, %seed: i64, %position: i64, %id: i32) -> (f32) {
  %shift64 = scalar.constant 32 : i64
  %seed_high = scalar.shrui %seed, %shift64 : i64
  %position_high = scalar.shrui %position, %shift64 : i64
  %key0 = scalar.trunci %seed : i64 to i32
  %key1 = scalar.trunci %seed_high : i64 to i32
  %counter1 = scalar.trunci %position : i64 to i32
  %counter2 = scalar.trunci %position_high : i64 to i32
  %domain = scalar.constant 0 : i32
  %word, %unused1, %unused2, %unused3 = template.apply<@random.philox4x32>(%id, %counter1, %counter2, %domain, %key0, %key1) : (i32, i32, i32, i32, i32, i32) -> (i32, i32, i32, i32)
  %shift = scalar.constant 8 : i32
  %mantissa = scalar.shrui %word, %shift : i32
  %number = scalar.uitofp %mantissa : i32 to f32
  %half = scalar.constant 0.5 : f32
  %scale = scalar.constant 5.9604644775390625e-08 : f32
  %upper = scalar.constant 0.99999994039535522 : f32
  %offset = scalar.addf %number, %half : f32
  %unit = scalar.mulf %offset, %scale : f32
  %uniform = scalar.minnumf %unit, %upper : f32
  %log_uniform = scalar.logf<afn> %uniform : f32
  %exponential = scalar.negf %log_uniform : f32
  %noise = scalar.logf<afn> %exponential : f32
  %centered = scalar.subf %logit, %maximum : f32
  %scaled = scalar.divf<arcp> %centered, %temperature : f32
  %race = scalar.subf %scaled, %noise : f32
  func.return %race : f32
}

// Lexicographic pair reduction using the native 32-bit collective payload.
template.def<@sampling.reduce_key> device @sampling_reduce_key(%key: i64, %minimum: i1) -> (i64) {
  %shift = scalar.constant 32 : i64
  %high64 = scalar.shrui %key, %shift : i64
  %high = scalar.trunci %high64 : i64 to i32
  %low = scalar.trunci %key : i64 to i32
  %c0 = scalar.constant 0 : i32
  %all_bits = scalar.constant -1 : i32
  %result_high, %result_low = scf.if %minimum -> (i32, i32) {
    %best_high = kernel.workgroup.reduce<minui> %high : i32
    %matches = scalar.cmpi eq, %high, %best_high : i32
    %candidate = scf.select %matches, %low, %all_bits : i32
    %best_low = kernel.workgroup.reduce<minui> %candidate : i32
    scf.yield %best_high, %best_low : i32, i32
  } else {
    %best_high = kernel.workgroup.reduce<maxui> %high : i32
    %matches = scalar.cmpi eq, %high, %best_high : i32
    %candidate = scf.select %matches, %low, %c0 : i32
    %best_low = kernel.workgroup.reduce<maxui> %candidate : i32
    scf.yield %best_high, %best_low : i32, i32
  }
  %upper = scalar.extui %result_high : i32 to i64
  %lower = scalar.extui %result_low : i32 to i64
  %shifted = scalar.shli %upper, %shift : i64
  %result = scalar.ori %shifted, %lower : i64
  template.return %result : i64
}

// Exact support selection over a total order, without a candidate-count cap.
// Each iteration partitions the remaining key interval and keeps the side
// containing the requested rank or cumulative probability. Retaining actual
// extrema skips empty key ranges; strict progress bounds the loop by 64 bits.
// One 256-thread workgroup owns a row. All threads receive the same result.
template.def<@sampling.cutoff_f32> device @sampling_cutoff_f32(%columns_value: index, %logits: buffer, %logits_origin: offset, %excluded_id: i32, %minimum: i64, %maximum: i64, %target: f32, %weighted: i1, %maximum_logit: f32, %temperature: f32) -> (i64) {
  %columns = index.assume %columns_value [range(%columns_value, 1, 16777216)] : index
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %last = index.sub %columns, %c1_index : index
  %thread = kernel.workitem.id<x> : index
  %threads = index.constant 256 : index
  %zero64 = scalar.constant 0 : i64
  %ones64 = scalar.constant -1 : i64
  %one64 = scalar.constant 1 : i64
  %c0 = scalar.constant 0.0 : f32
  %c1 = scalar.constant 1.0 : f32
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %input = buffer.view %logits[%logits_origin] : buffer -> view<[%columns]xf32>
  %cutoff, %last_high, %last_target = scf.while(%low = %minimum : i64, %high = %maximum : i64, %remaining = %target : f32) -> (i64, i64, f32) {
    %more = scalar.cmpi ult, %low, %high : i64
    scf.condition %more, %low, %high, %remaining : i1, i64, i64, f32
  } do(%low: i64, %high: i64, %remaining: f32) {
    %distance = scalar.subi %high, %low : i64
    %half = scalar.shrui %distance, %one64 : i64
    %pivot = scalar.addi %low, %half : i64
    %upper_mass, %upper_min, %upper_max, %lower_min, %lower_max = scf.for %base = [%begin to %columns step %threads](%mass = %c0 : f32, %umin = %ones64 : i64, %umax = %zero64 : i64, %lmin = %ones64 : i64, %lmax = %zero64 : i64) -> (f32, i64, i64, i64, i64) {
      %candidate = index.add %base, %thread : index
      %live = index.cmp ult, %candidate, %columns : index
      %clamped = index.min %candidate, %last : index
      %column = index.assume %clamped [ge(%clamped, 0), lt(%clamped, %columns)] : index
      %value = view.load %input[%column] : view<[%columns]xf32> -> f32
      %id = index.cast %column : index to i32
      %key = func.call @sampling_key(%value, %id) : (f32, i32) -> (i64)
      %after = scalar.cmpi uge, %key, %low : i64
      %before = scalar.cmpi ule, %key, %high : i64
      %bounded = scalar.andi %after, %before : i1
      %permitted = scalar.cmpi ne, %id, %excluded_id : i32
      %present = scalar.andi %live, %permitted : i1
      %inside = scalar.andi %bounded, %present : i1
      %above = scalar.cmpi ugt, %key, %pivot : i64
      %below = scalar.cmpi ule, %key, %pivot : i64
      %upper = scalar.andi %inside, %above : i1
      %lower = scalar.andi %inside, %below : i1
      %contribution = scf.if %upper -> (f32) {
        %weight = scf.if %weighted -> (f32) {
          %difference = scalar.subf %value, %maximum_logit : f32
          %scaled = scalar.divf<arcp> %difference, %temperature : f32
          %weight = scalar.expf<afn> %scaled : f32
          scf.yield %weight : f32
        } else {
          scf.yield %c1 : f32
        }
        scf.yield %weight : f32
      } else {
        scf.yield %c0 : f32
      }
      %u_low = scf.select %upper, %key, %ones64 : i64
      %u_high = scf.select %upper, %key, %zero64 : i64
      %l_low = scf.select %lower, %key, %ones64 : i64
      %l_high = scf.select %lower, %key, %zero64 : i64
      %next_mass = scalar.addf %mass, %contribution : f32
      %next_umin = scalar.minui %umin, %u_low : i64
      %next_umax = scalar.maxui %umax, %u_high : i64
      %next_lmin = scalar.minui %lmin, %l_low : i64
      %next_lmax = scalar.maxui %lmax, %l_high : i64
      scf.yield %next_mass, %next_umin, %next_umax, %next_lmin, %next_lmax : f32, i64, i64, i64, i64
    }
    %mass = kernel.workgroup.reduce<addf> %upper_mass : f32
    %umin = template.apply<@sampling.reduce_key>(%upper_min, %true) : (i64, i1) -> (i64)
    %umax = template.apply<@sampling.reduce_key>(%upper_max, %false) : (i64, i1) -> (i64)
    %lmin = template.apply<@sampling.reduce_key>(%lower_min, %true) : (i64, i1) -> (i64)
    %lmax = template.apply<@sampling.reduce_key>(%lower_max, %false) : (i64, i1) -> (i64)
    %take_upper = scalar.cmpf oge, %mass, %remaining : f32
    %next_low = scf.select %take_upper, %umin, %lmin : i64
    %next_high = scf.select %take_upper, %umax, %lmax : i64
    %rest = scalar.subf %remaining, %mass : f32
    %next_target = scf.select %take_upper, %remaining, %rest : f32
    scf.yield %next_low, %next_high, %next_target : i64, i64, f32
  }
  template.return %cutoff : i64
}

// Temperature -> top-k -> nucleus -> categorical selection. top_k=0 keeps
// the vocabulary; top_p=1 keeps all top-k candidates. Temperature zero is
// greedy with the same stable lowest-ID tie rule. No scratch allocation or
// host-visible probability state is required. Callers validate parameters.
// Vocabulary size is 1..2^24, keeping integer rank sums exact in F32. Every
// thread in the owning 256-thread workgroup participates with identical policy.
template.def<@sampling.categorical_f32> device @sampling_categorical_f32(%columns: index, %logits: buffer, %logits_origin: offset, %temperature: f32, %top_p: f32, %top_k: i32, %seed: i64, %position: i64) -> (i32) {
  %none = scalar.constant -1 : i32
  %selected = template.apply<@sampling.categorical_excluding_f32>(%columns, %logits, %logits_origin, %none, %temperature, %top_p, %top_k, %seed, %position) : (index, buffer, offset, i32, f32, f32, i32, i64, i64) -> (i32)
  template.return %selected : i32
}

// A turn may exclude one vocabulary ID before any support or winner selection.
// -1 excludes nothing; callers guarantee at least one permitted finite logit.
// The immutable logit storage and counter-based random draws remain unchanged.
template.def<@sampling.categorical_excluding_f32> device @sampling_categorical_excluding_f32(%columns_value: index, %logits: buffer, %logits_origin: offset, %excluded_id: i32, %temperature: f32, %top_p: f32, %top_k: i32, %seed: i64, %position: i64) -> (i32) {
  %columns = index.assume %columns_value [range(%columns_value, 1, 16777216)] : index
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %last = index.sub %columns, %c1_index : index
  %thread = kernel.workitem.id<x> : index
  %threads = index.constant 256 : index
  %zero64 = scalar.constant 0 : i64
  %ones64 = scalar.constant -1 : i64
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %largest = scalar.constant 2147483647 : i32
  %c0 = scalar.constant 0.0 : f32
  %c1 = scalar.constant 1.0 : f32
  %negative = scalar.constant -inf : f32
  %input = buffer.view %logits[%logits_origin] : buffer -> view<[%columns]xf32>
  %local_min, %local_max, %local_logit = scf.for %base = [%begin to %columns step %threads](%minimum = %ones64 : i64, %maximum = %zero64 : i64, %greatest = %negative : f32) -> (i64, i64, f32) {
    %candidate = index.add %base, %thread : index
    %live = index.cmp ult, %candidate, %columns : index
    %clamped = index.min %candidate, %last : index
    %column = index.assume %clamped [ge(%clamped, 0), lt(%clamped, %columns)] : index
    %value = view.load %input[%column] : view<[%columns]xf32> -> f32
    %id = index.cast %column : index to i32
    %key = func.call @sampling_key(%value, %id) : (f32, i32) -> (i64)
    %permitted = scalar.cmpi ne, %id, %excluded_id : i32
    %present = scalar.andi %live, %permitted : i1
    %low = scf.select %present, %key, %ones64 : i64
    %high = scf.select %present, %key, %zero64 : i64
    %next_min = scalar.minui %minimum, %low : i64
    %next_max = scalar.maxui %maximum, %high : i64
    %eligible_value = scf.select %present, %value, %negative : f32
    %next_logit = scalar.maxnumf %greatest, %eligible_value : f32
    scf.yield %next_min, %next_max, %next_logit : i64, i64, f32
  }
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %minimum = template.apply<@sampling.reduce_key>(%local_min, %true) : (i64, i1) -> (i64)
  %maximum = template.apply<@sampling.reduce_key>(%local_max, %false) : (i64, i1) -> (i64)
  %maximum_logit = kernel.workgroup.reduce<maxnumf> %local_logit : f32
  %greedy = scalar.cmpf oeq, %temperature, %c0 : f32
  %single = scalar.cmpi eq, %top_k, %one32 : i32
  %deterministic = scalar.ori %greedy, %single : i1
  %selected = scf.if %deterministic -> (i32) {
    %inverse = scalar.trunci %maximum : i64 to i32
    %all_bits = scalar.constant -1 : i32
    %id = scalar.xori %inverse, %all_bits : i32
    scf.yield %id : i32
  } else {
    %bounded = scalar.cmpi ne, %top_k, %zero32 : i32
    %vocabulary = index.cast %columns : index to i32
    %has_exclusion = scalar.cmpi ult, %excluded_id, %vocabulary : i32
    %excluded_count = scalar.extui %has_exclusion : i1 to i32
    %eligible_count = scalar.subi %vocabulary, %excluded_count : i32
    %effective_k = scalar.minui %top_k, %eligible_count : i32
    %rank = scalar.uitofp %effective_k : i32 to f32
    %topk_cutoff = scf.if %bounded -> (i64) {
      %cutoff = template.apply<@sampling.cutoff_f32>(%columns, %logits, %logits_origin, %excluded_id, %minimum, %maximum, %rank, %false, %maximum_logit, %temperature) : (index, buffer, offset, i32, i64, i64, f32, i1, f32, f32) -> (i64)
      scf.yield %cutoff : i64
    } else {
      scf.yield %minimum : i64
    }
    %nucleus = scalar.cmpf olt, %top_p, %c1 : f32
    %cutoff = scf.if %nucleus -> (i64) {
      %local_mass = scf.for %base = [%begin to %columns step %threads](%mass = %c0 : f32) -> (f32) {
        %candidate = index.add %base, %thread : index
        %live = index.cmp ult, %candidate, %columns : index
        %clamped = index.min %candidate, %last : index
        %column = index.assume %clamped [ge(%clamped, 0), lt(%clamped, %columns)] : index
        %value = view.load %input[%column] : view<[%columns]xf32> -> f32
        %id = index.cast %column : index to i32
        %key = func.call @sampling_key(%value, %id) : (f32, i32) -> (i64)
        %included = scalar.cmpi uge, %key, %topk_cutoff : i64
        %permitted = scalar.cmpi ne, %id, %excluded_id : i32
        %present = scalar.andi %live, %permitted : i1
        %eligible = scalar.andi %included, %present : i1
        %difference = scalar.subf %value, %maximum_logit : f32
        %scaled = scalar.divf<arcp> %difference, %temperature : f32
        %weight = scalar.expf<afn> %scaled : f32
        %contribution = scf.select %eligible, %weight, %c0 : f32
        %next = scalar.addf %mass, %contribution : f32
        scf.yield %next : f32
      }
      %mass = kernel.workgroup.reduce<addf> %local_mass : f32
      %target = scalar.mulf %mass, %top_p : f32
      %cutoff = template.apply<@sampling.cutoff_f32>(%columns, %logits, %logits_origin, %excluded_id, %topk_cutoff, %maximum, %target, %true, %maximum_logit, %temperature) : (index, buffer, offset, i32, i64, i64, f32, i1, f32, f32) -> (i64)
      scf.yield %cutoff : i64
    } else {
      scf.yield %topk_cutoff : i64
    }
    %local_race, %local_id = scf.for %base = [%begin to %columns step %threads](%best = %negative : f32, %best_id = %largest : i32) -> (f32, i32) {
      %candidate = index.add %base, %thread : index
      %live = index.cmp ult, %candidate, %columns : index
      %clamped = index.min %candidate, %last : index
      %column = index.assume %clamped [ge(%clamped, 0), lt(%clamped, %columns)] : index
      %value = view.load %input[%column] : view<[%columns]xf32> -> f32
      %id = index.cast %column : index to i32
      %key = func.call @sampling_key(%value, %id) : (f32, i32) -> (i64)
      %included = scalar.cmpi uge, %key, %cutoff : i64
      %permitted = scalar.cmpi ne, %id, %excluded_id : i32
      %present = scalar.andi %live, %permitted : i1
      %eligible = scalar.andi %included, %present : i1
      %race = scf.if %eligible -> (f32) {
        %score = func.call @sampling_race(%value, %maximum_logit, %temperature, %seed, %position, %id) : (f32, f32, f32, i64, i64, i32) -> (f32)
        scf.yield %score : f32
      } else {
        scf.yield %negative : f32
      }
      %greater = scalar.cmpf ogt, %race, %best : f32
      %tie = scalar.cmpf oeq, %race, %best : f32
      %earlier = scalar.cmpi slt, %id, %best_id : i32
      %earlier_tie = scalar.andi %tie, %earlier : i1
      %better = scalar.ori %greater, %earlier_tie : i1
      %take = scalar.andi %eligible, %better : i1
      %next = scf.select %take, %race, %best : f32
      %next_id = scf.select %take, %id, %best_id : i32
      scf.yield %next, %next_id : f32, i32
    }
    %winning = kernel.workgroup.reduce<maxnumf> %local_race : f32
    %owns = scalar.cmpf oeq, %local_race, %winning : f32
    %candidate = scf.select %owns, %local_id, %largest : i32
    %id = kernel.workgroup.reduce<minsi> %candidate : i32
    scf.yield %id : i32
  }
  template.return %selected : i32
}

func.def public inline @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index) {
  %origin = index.constant 0 : offset
  %view = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %word = view.load %view[0] : view<3xi32> -> i32
  %value = index.cast %word : i32 to index
  %count = index.assume %value [range(%value, 0, %capacity)] : index
  func.return %count : index
}

func.def public inline @flash_next_span_count(%epoch: buffer) -> (index) {
  %origin = index.constant 0 : offset
  %view = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %word = view.load %view[1] : view<3xi32> -> i32
  %value = index.cast %word : i32 to index
  %count = index.assume %value [range(%value, 0, 2147483647)] : index
  func.return %count : index
}

func.def public inline @flash_next_span_active(%epoch: buffer, %span: index) -> (i1) {
  %count = func.call @flash_next_span_count(%epoch) : (buffer) -> (index)
  %active = index.cmp ult, %span, %count : index
  func.return %active : i1
}

// Each head/channel tile has a bounded set of span workers. Their grid-stride
// traversal covers the live header count without launching one workgroup per
// capacity slot when a large stage contains only a few spans.
func.def public pure inline @flash_next_span_workers(%capacity: index) -> (index) {
  %parallel_spans = index.constant 16 : index
  %workers = index.min %capacity, %parallel_spans : index
  func.return %workers : index
}

// A fresh span has no readable history. Otherwise the fork frontier selects
// the immutable anchor once; subsequent spans read their own advancing writer.
// Origins are byte offsets in one retained arena, independent of token packing.
func.def public inline @flash_next_span_state(%epoch: buffer, %rows: buffer, %span: index, %layer_origin: offset, %capacity: index) -> (index, index, i1, offset, offset) {
  %header_bytes = index.constant 12 : offset
  %record_bytes = index.constant 24 : offset
  %relative_origin = index.scale %span, %record_bytes : index, offset -> offset
  %origin = index.add %header_bytes, %relative_origin : offset
  %record = buffer.view %epoch[%origin] : buffer -> view<6xi32>
  %length_word = view.load %record[0] : view<6xi32> -> i32
  %position_word = view.load %record[1] : view<6xi32> -> i32
  %begin_word = view.load %record[2] : view<6xi32> -> i32
  %row_word = view.load %record[3] : view<6xi32> -> i32
  %length_value = index.cast %length_word : i32 to index
  %length = index.assume %length_value [range(%length_value, 1, %capacity)] : index
  %begin_value = index.cast %begin_word : i32 to index
  %begin = index.assume %begin_value [range(%begin_value, 0, %capacity)] : index
  %end_value = index.add %begin, %length : index
  %end = index.assume %end_value [range(%end_value, 1, %capacity)] : index
  %row_value = index.cast %row_word : i32 to index
  %row = index.assume %row_value [range(%row_value, 0, 2147483647)] : index
  %row_bytes = index.constant 40 : offset
  %row_origin = index.scale %row, %row_bytes : index, offset -> offset
  %entry = buffer.view %rows[%row_origin] : buffer -> view<5xi64>
  %anchor_word = view.load %entry[0] : view<5xi64> -> i64
  %writer_word = view.load %entry[1] : view<5xi64> -> i64
  %frontier = view.load %entry[3] : view<5xi64> -> i64
  %position = scalar.extui %position_word : i32 to i64
  %first = scalar.cmpi eq, %position, %frontier : i64
  %reader_word = scf.select %first, %anchor_word, %writer_word : i64
  %reader_value = scalar.assume %reader_word [range(%reader_word, 0, 9223372036854775807)] : i64
  %writer_value = scalar.assume %writer_word [range(%writer_word, 0, 9223372036854775807)] : i64
  %reader_base = index.cast %reader_value : i64 to offset
  %writer_base = index.cast %writer_value : i64 to offset
  %reader = index.add %reader_base, %layer_origin : offset
  %writer = index.add %writer_base, %layer_origin : offset
  %c0 = scalar.constant 0 : i64
  %fresh = scalar.cmpi eq, %position, %c0 : i64
  func.return %begin, %end, %fresh, %reader, %writer : index, index, i1, offset, offset
}

config.decl @flash_next.span_capacity : %value: index where [range(%value, 1, 2147483647)]

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768), range(%value, 1, 32768), range(%value, 1, 32768), range(%value, 1, 32768), range(%value, 1, 32768), range(%value, 1, 32768)]

config.decl @flash_next.verification_width : %value: index where [range(%value, 0, 8)]

func.def public pure inline @flash_next_output_capacity() -> (index) {
  %spans = config.get @flash_next.span_capacity : index
  %width = config.get @flash_next.verification_width : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %ordinary = index.cmp eq, %width, %c0 : index
  %outputs = scf.select %ordinary, %c1, %width : index
  %count = index.mul %spans, %outputs : index
  // Each selected output belongs to a distinct packed input. Small scheduler
  // buckets can hold fewer inputs than span_capacity * verification_width.
  %tokens = config.get @flash_next.token_count : index
  %smaller = index.cmp ult, %count, %tokens : index
  %capacity = scf.select %smaller, %count, %tokens : index
  func.return %capacity : index
}

// Final attention retains up to four original query rows per selected span.
func.def public pure inline @flash_next_finish_capacity() -> (index) {
  %spans = config.get @flash_next.span_capacity : index
  %tokens = config.get @flash_next.token_count : index
  %queries = index.constant 4 : index
  %rows = index.mul %spans, %queries : index
  %capacity = index.min %rows, %tokens : index
  func.return %capacity : index
}

// One flag per four-query cohort precedes one flag per draft token.
func.def public pure inline @flash_next_draft_cohorts(%capacity: index) -> (index) {
  %rounding = index.constant 3 : index
  %width = index.constant 4 : index
  %rounded = index.add %capacity, %rounding : index
  %count = index.div %rounded, %width : index
  func.return %count : index
}

func.def public pure inline @flash_next_draft_mode_origin(%capacity: index) -> (offset) {
  %cohorts = func.call pure @flash_next_draft_cohorts(%capacity) : (index) -> (index)
  %word_bytes = index.constant 4 : offset
  %origin = index.scale %cohorts, %word_bytes : index, offset -> offset
  func.return %origin : offset
}

// Unsigned code expansion is independent of the activation row. Consumers can
// retain these exact BF16 values while contracting several rows with one chunk.
func.def inline @flash_next_affine_codes(%codes: vector<16xi8>) -> (vector<16xbf16>) {
  %code_values = vector.uitofp %codes : vector<16xi8> to vector<16xf32>
  %exact_codes = vector.fptrunc %code_values : vector<16xf32> to vector<16xbf16>
  func.return %exact_codes : vector<16xbf16>
}

// Apply the affine scale and signed minimum after the complete chunk dot.
// Sharing this tree keeps row grouping independent of numerical semantics.
func.def inline @flash_next_affine_dot16(%exact_codes: vector<16xbf16>, %values: vector<16xbf16>, %scale: f32, %minimum: f32) -> (f32) {
  %c0 = scalar.constant 0.0 : f32
  %c0v = vector.splatf 0.0 : vector<8xf32>
  %pairs = vector.dot2f %exact_codes, %values, %c0v : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %dot = vector.reduce<addf> %pairs, %c0 : vector<8xf32>, f32
  %expanded = vector.extf %values : vector<16xbf16> to vector<16xf32>
  %sum = vector.reduce<addf> %expanded, %c0 : vector<16xf32>, f32
  %correction = scalar.mulf %sum, %minimum : f32
  %result = scalar.fmaf %dot, %scale, %correction : f32
  func.return %result : f32
}

// QK formats subtract their stored minimum magnitude. The selected decoder
// supplies exact integer codes; the returned minimum already carries its sign.
func.def inline @flash_next_qk_codes(%q5_encoding: i1, %weight: buffer, %origin: offset, %block: index, %group: index, %half: index) -> (vector<16xbf16>, f32, f32) {
  %codes, %scale, %minimum_magnitude = scf.if %q5_encoding -> (vector<16xi8>, f32, f32) {
    %codes, %scale, %minimum = func.call @ggml_q5_k_load_chunk16(%weight, %origin, %block, %group, %half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
    scf.yield %codes, %scale, %minimum : vector<16xi8>, f32, f32
  } else {
    %codes, %scale, %minimum = func.call @ggml_q4_k_load_chunk16(%weight, %origin, %block, %group, %half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
    scf.yield %codes, %scale, %minimum : vector<16xi8>, f32, f32
  }
  %exact_codes = func.call @flash_next_affine_codes(%codes) : (vector<16xi8>) -> (vector<16xbf16>)
  %minimum = scalar.negf %minimum_magnitude : f32
  func.return %exact_codes, %scale, %minimum : vector<16xbf16>, f32, f32
}

// Gate and up share the activation load and affine input sum while retaining
// independent chunk accumulators. Each projection keeps its original dot tree
// and lane ownership, so pairing does not change the final BF16 result.
// Q4_K and Q5_K share this geometry; the caller's constant format choice keeps
// only the selected physical decoder in each kernel.
func.def public inline @flash_next_qk_pair_partial(%q5_encoding: i1, %width: index, %token: index, %row: index, %lane: index, %stride: index, %input: buffer, %gate_weight: buffer, %up_weight: buffer) -> (f32, f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %q4_bytes = index.constant 144 : offset
  %q5_bytes = index.constant 176 : offset
  %element_bytes = index.constant 2 : offset
  %block_bytes = scf.select %q5_encoding, %q5_bytes, %q4_bytes : offset
  %block_count = index.div %width, %c256 : index
  %chunks = index.div %width, %c16 : index
  %row_bytes = index.scale %block_count, %block_bytes : index, offset -> offset
  %weight_origin = index.scale %row, %row_bytes : index, offset -> offset
  %input_row_bytes = index.scale %width, %element_bytes : index, offset -> offset
  %input_origin = index.scale %token, %input_row_bytes : index, offset -> offset
  %input_view = buffer.view %input[%input_origin] : buffer -> view<[%chunks]x16xbf16>
  %initial_sums = vector.splatf 0.0 : vector<2xf32>
  %result = scf.for %chunk = [%lane to %chunks step %stride](%sums = %initial_sums : vector<2xf32>) -> (vector<2xf32>) {
    %block = index.div %chunk, %c16 : index
    %group_index = index.div %chunk, %c2 : index
    %group = index.rem %group_index, %c8 : index
    %half = index.rem %chunk, %c2 : index
    %values = vector.load %input_view[%chunk, 0] : view<[%chunks]x16xbf16> -> vector<16xbf16>
    %next_sums = scf.for %projection = [%c0 to %c2 step %c1](%current = %sums : vector<2xf32>) -> (vector<2xf32>) unroll schedule(linear) {
      %is_gate = index.cmp eq, %projection, %c0 : index
      %weight = scf.select %is_gate, %gate_weight, %up_weight : buffer
      %codes, %scale, %minimum = func.call @flash_next_qk_codes(%q5_encoding, %weight, %weight_origin, %block, %group, %half) : (i1, buffer, offset, index, index, index) -> (vector<16xbf16>, f32, f32)
      %contribution = func.call @flash_next_affine_dot16(%codes, %values, %scale, %minimum) : (vector<16xbf16>, vector<16xbf16>, f32, f32) -> (f32)
      %prior = vector.extract %current[%projection] : vector<2xf32> -> f32
      %sum = scalar.addf %prior, %contribution : f32
      %next = vector.insert %sum into %current[%projection] : f32, vector<2xf32>
      scf.yield %next : vector<2xf32>
    }
    scf.yield %next_sums : vector<2xf32>
  }
  %gate = vector.extract %result[0] : vector<2xf32> -> f32
  %up = vector.extract %result[1] : vector<2xf32> -> f32
  func.return %gate, %up : f32, f32
}

// Q5_1 stores two half scales, one high-bit word, and sixteen nibble pairs per
// 32-element block. Each lane retains that header while visiting both halves.
// Specializing the two halves makes nibble and high-bit shifts constant while
// preserving their sequential accumulation and the original block ownership.
func.def public inline @flash_next_q51_partial(%width: index, %token: index, %row: index, %lane: index, %stride: index, %input: buffer, %weight: buffer) -> (f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %block_bytes = index.constant 24 : offset
  %element_bytes = index.constant 2 : offset
  %block_count = index.div %width, %c32 : index
  %row_bytes = index.scale %block_count, %block_bytes : index, offset -> offset
  %weight_origin = index.scale %row, %row_bytes : index, offset -> offset
  %input_row_bytes = index.scale %width, %element_bytes : index, offset -> offset
  %input_origin = index.scale %token, %input_row_bytes : index, offset -> offset
  %input_view = buffer.view %input[%input_origin] : buffer -> view<[%block_count]x32xbf16>
  %c0_f32 = scalar.constant 0.0 : f32
  %result = scf.for %block = [%lane to %block_count step %stride](%accumulator = %c0_f32 : f32) -> (f32) {
    %block_add = index.scale %block, %block_bytes : index, offset -> offset
    %block_origin = index.add %weight_origin, %block_add : offset
    %packed, %high_word, %scale, %minimum = func.call @ggml_q5_1_load_block(%weight, %block_origin) : (buffer, offset) -> (vector<16xi8>, i32, f32, f32)
    %next = scf.for %half = [%c0 to %c2 step %c1](%partial = %accumulator : f32) -> (f32) unroll schedule(linear) {
      %codes = func.call @ggml_q5_1_unpack_codes16(%packed, %high_word, %half) : (vector<16xi8>, i32, index) -> (vector<16xi8>)
      %begin = index.mul %half, %c16 : index
      %values = vector.load %input_view[%block, %begin] : view<[%block_count]x32xbf16> -> vector<16xbf16>
      %exact_codes = func.call @flash_next_affine_codes(%codes) : (vector<16xi8>) -> (vector<16xbf16>)
      %contribution = func.call @flash_next_affine_dot16(%exact_codes, %values, %scale, %minimum) : (vector<16xbf16>, vector<16xbf16>, f32, f32) -> (f32)
      %sum = scalar.addf %partial, %contribution : f32
      scf.yield %sum : f32
    }
    scf.yield %next : f32
  }
  func.return %result : f32
}

// Up to four routed activation rows share each paired QK weight chunk. Only
// the live prefix is read; each result retains the single-row reduction tree.
func.def public inline @flash_next_qk_pair_rows_partial(%q5: i1, %width: index, %rows: vector<4xi32>, %live: index, %row: index, %lane: index, %stride: index, %input: buffer, %gate_weight: buffer, %up_weight: buffer) -> (vector<4xf32>, vector<4xf32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %block_width = index.constant 256 : index
  %q4_bytes = index.constant 144 : offset
  %q5_bytes = index.constant 176 : offset
  %element_bytes = index.constant 2 : offset
  %block_bytes = scf.select %q5, %q5_bytes, %q4_bytes : offset
  %blocks = index.div %width, %block_width : index
  %chunks = index.div %width, %c16 : index
  %row_bytes = index.scale %blocks, %block_bytes : index, offset -> offset
  %weight_origin = index.scale %row, %row_bytes : index, offset -> offset
  %input_row_bytes = index.scale %width, %element_bytes : index, offset -> offset
  %initial = vector.splatf 0.0 : vector<4xf32>
  %gate, %up = scf.for %chunk = [%lane to %chunks step %stride](%gate_sums = %initial : vector<4xf32>, %up_sums = %initial : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
    %block = index.div %chunk, %c16 : index
    %group_index = index.div %chunk, %c2 : index
    %group = index.rem %group_index, %c8 : index
    %half = index.rem %chunk, %c2 : index
    %gate_codes, %gate_scale, %gate_minimum = func.call @flash_next_qk_codes(%q5, %gate_weight, %weight_origin, %block, %group, %half) : (i1, buffer, offset, index, index, index) -> (vector<16xbf16>, f32, f32)
    %up_codes, %up_scale, %up_minimum = func.call @flash_next_qk_codes(%q5, %up_weight, %weight_origin, %block, %group, %half) : (i1, buffer, offset, index, index, index) -> (vector<16xbf16>, f32, f32)
    %next_gate, %next_up = scf.for %ordinal = [%c0 to %c4 step %c1](%current_gate = %gate_sums : vector<4xf32>, %current_up = %up_sums : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) unroll schedule(linear) {
      %active = index.cmp ult, %ordinal, %live : index
      %updated_gate, %updated_up = scf.if %active -> (vector<4xf32>, vector<4xf32>) {
        %row_word = vector.extract %rows[%ordinal] : vector<4xi32> -> i32
        %row_value = index.cast %row_word : i32 to index
        %input_row = index.assume %row_value [range(%row_value, 0, 327679)] : index
        %input_origin = index.scale %input_row, %input_row_bytes : index, offset -> offset
        %input_view = buffer.view %input[%input_origin] : buffer -> view<[%chunks]x16xbf16>
        %values = vector.load %input_view[%chunk, 0] : view<[%chunks]x16xbf16> -> vector<16xbf16>
        %gate_dot = func.call @flash_next_affine_dot16(%gate_codes, %values, %gate_scale, %gate_minimum) : (vector<16xbf16>, vector<16xbf16>, f32, f32) -> (f32)
        %up_dot = func.call @flash_next_affine_dot16(%up_codes, %values, %up_scale, %up_minimum) : (vector<16xbf16>, vector<16xbf16>, f32, f32) -> (f32)
        %prior_gate = vector.extract %current_gate[%ordinal] : vector<4xf32> -> f32
        %prior_up = vector.extract %current_up[%ordinal] : vector<4xf32> -> f32
        %gate_sum = scalar.addf %prior_gate, %gate_dot : f32
        %up_sum = scalar.addf %prior_up, %up_dot : f32
        %new_gate = vector.insert %gate_sum into %current_gate[%ordinal] : f32, vector<4xf32>
        %new_up = vector.insert %up_sum into %current_up[%ordinal] : f32, vector<4xf32>
        scf.yield %new_gate, %new_up : vector<4xf32>, vector<4xf32>
      } else {
        scf.yield %current_gate, %current_up : vector<4xf32>, vector<4xf32>
      }
      scf.yield %updated_gate, %updated_up : vector<4xf32>, vector<4xf32>
    }
    scf.yield %next_gate, %next_up : vector<4xf32>, vector<4xf32>
  }
  func.return %gate, %up : vector<4xf32>, vector<4xf32>
}

// Four routed input rows share each decoded Q5_1 weight block. Two adjacent
// output features share activation chunks and their affine input sums. Each
// output accumulates the two K16 halves in order before the caller's wave sum.
func.def public inline @flash_next_q51_output_pair_partial(%width: index, %rows: vector<4xi32>, %live: index, %row: index, %lane: index, %stride: index, %input: buffer, %weight: buffer) -> (vector<4xf32>, vector<4xf32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %block_bytes = index.constant 24 : offset
  %element_bytes = index.constant 2 : offset
  %block_count = index.div %width, %c32 : index
  %row_bytes = index.scale %block_count, %block_bytes : index, offset -> offset
  %weight_origin = index.scale %row, %row_bytes : index, offset -> offset
  %input_row_bytes = index.scale %width, %element_bytes : index, offset -> offset
  %c0_4xf32 = vector.splatf 0.0 : vector<4xf32>
  %result0, %result1 = scf.for %block = [%lane to %block_count step %stride](%accumulator0 = %c0_4xf32 : vector<4xf32>, %accumulator1 = %c0_4xf32 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
    %block_add = index.scale %block, %block_bytes : index, offset -> offset
    %origin0 = index.add %weight_origin, %block_add : offset
    %origin1 = index.add %origin0, %row_bytes : offset
    %packed0, %high0, %scale0, %minimum0 = func.call @ggml_q5_1_load_block(%weight, %origin0) : (buffer, offset) -> (vector<16xi8>, i32, f32, f32)
    %packed1, %high1, %scale1, %minimum1 = func.call @ggml_q5_1_load_block(%weight, %origin1) : (buffer, offset) -> (vector<16xi8>, i32, f32, f32)
    %next0, %next1 = scf.for %half = [%c0 to %c2 step %c1](%partial0 = %accumulator0 : vector<4xf32>, %partial1 = %accumulator1 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) unroll schedule(linear) {
      %codes0 = func.call @ggml_q5_1_unpack_codes16(%packed0, %high0, %half) : (vector<16xi8>, i32, index) -> (vector<16xi8>)
      %codes1 = func.call @ggml_q5_1_unpack_codes16(%packed1, %high1, %half) : (vector<16xi8>, i32, index) -> (vector<16xi8>)
      %exact0 = func.call @flash_next_affine_codes(%codes0) : (vector<16xi8>) -> (vector<16xbf16>)
      %exact1 = func.call @flash_next_affine_codes(%codes1) : (vector<16xi8>) -> (vector<16xbf16>)
      %begin = index.mul %half, %c16 : index
      %sums0, %sums1 = scf.for %ordinal = [%c0 to %c4 step %c1](%current0 = %partial0 : vector<4xf32>, %current1 = %partial1 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) unroll schedule(linear) {
        %active = index.cmp ult, %ordinal, %live : index
        %updated0, %updated1 = scf.if %active -> (vector<4xf32>, vector<4xf32>) {
          %row_word = vector.extract %rows[%ordinal] : vector<4xi32> -> i32
          %input_value = index.cast %row_word : i32 to index
          %input_row = index.assume %input_value [range(%input_value, 0, 327679)] : index
          %input_origin = index.scale %input_row, %input_row_bytes : index, offset -> offset
          %input_view = buffer.view %input[%input_origin] : buffer -> view<[%block_count]x32xbf16>
          %values = vector.load %input_view[%block, %begin] : view<[%block_count]x32xbf16> -> vector<16xbf16>
          %dot0 = func.call @flash_next_affine_dot16(%exact0, %values, %scale0, %minimum0) : (vector<16xbf16>, vector<16xbf16>, f32, f32) -> (f32)
          %dot1 = func.call @flash_next_affine_dot16(%exact1, %values, %scale1, %minimum1) : (vector<16xbf16>, vector<16xbf16>, f32, f32) -> (f32)
          %prior0 = vector.extract %current0[%ordinal] : vector<4xf32> -> f32
          %prior1 = vector.extract %current1[%ordinal] : vector<4xf32> -> f32
          %sum0 = scalar.addf %prior0, %dot0 : f32
          %sum1 = scalar.addf %prior1, %dot1 : f32
          %next0 = vector.insert %sum0 into %current0[%ordinal] : f32, vector<4xf32>
          %next1 = vector.insert %sum1 into %current1[%ordinal] : f32, vector<4xf32>
          scf.yield %next0, %next1 : vector<4xf32>, vector<4xf32>
        } else {
          scf.yield %current0, %current1 : vector<4xf32>, vector<4xf32>
        }
        scf.yield %updated0, %updated1 : vector<4xf32>, vector<4xf32>
      }
      scf.yield %sums0, %sums1 : vector<4xf32>, vector<4xf32>
    }
    scf.yield %next0, %next1 : vector<4xf32>, vector<4xf32>
  }
  func.return %result0, %result1 : vector<4xf32>, vector<4xf32>
}

// A table has at most one record per route and at most one partial record
// per expert in addition to floor(routes/rows) complete records. This bound
// keeps large tiles compact even when expert populations are highly skewed.
// Allocation, production, and consumption share the same logical extent.
func.def public pure inline @expert_record_extent(%capacity: index, %record_rows: index) -> (index, index, offset) {
  %routes_per_token = index.constant 10 : index
  %header_fields = index.constant 2 : index
  %experts = index.constant 512 : index
  %word_bytes = index.constant 4 : offset
  %routes = index.mul %capacity, %routes_per_token : index
  %full_records = index.div %routes, %record_rows : index
  %population_bound = index.add %full_records, %experts : index
  %route_bound_is_smaller = index.cmp ult, %routes, %population_bound : index
  %records = scf.select %route_bound_is_smaller, %routes, %population_bound : index
  %fields = index.add %record_rows, %header_fields : index
  %record_bytes = index.scale %fields, %word_bytes : index, offset -> offset
  %table_bytes = index.scale %records, %record_bytes : index, offset -> offset
  %bytes = index.add %table_bytes, %word_bytes : offset
  func.return %records, %fields, %bytes : index, index, offset
}

// Exchange half-wave register payloads to replicate both halves of a native
// wave32 RHS fragment. The packed gate/up and down schedules share this map.
func.def public inline @expert_fragment_pair(%own: vector<8xi32>, %second_half: i1) -> (vector<8xi32>, vector<8xi32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %xor_half = scalar.constant 16 : i32
  %width = scalar.constant 32 : i32
  %seed = vector.splati 0 : vector<8xi32>
  %peer = scf.for %element = [%c0 to %c8 step %c1](%values = %seed : vector<8xi32>) -> (vector<8xi32>) unroll schedule(linear) {
    %word = vector.extract %own[%element] : vector<8xi32> -> i32
    %exchanged, %valid = kernel.subgroup.shuffle<xor> %word, %xor_half, %width : i32, i32, i32
    %next = vector.insert %exchanged into %values[%element] : i32, vector<8xi32>
    scf.yield %next : vector<8xi32>
  }
  %mask = vector.splat %second_half : vector<8xi1>
  %first = vector.select %mask, %peer, %own : vector<8xi32>
  %second = vector.select %mask, %own, %peer : vector<8xi32>
  func.return %first, %second : vector<8xi32>, vector<8xi32>
}

func.def inline @expert_block_input(%input: buffer, %ids: vector<2xi32>, %live: vector<2xi1>, %group: index, %thread: index, %enabled: i1) -> (vector<2x8xi16>) {
  %capacity = config.get @flash_next.token_count : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c64 = index.constant 64 : index
  %origin = index.constant 0 : offset
  %packet = index.rem %thread, %c8 : index
  %local_k = index.mul %packet, %c8 : index
  %bounded_group = index.assume %group [range(%group, 0, 39)] : index
  %k = index.madd %bounded_group, %c64, %local_k : index
  %view = buffer.view %input[%origin] : buffer -> view<[%capacity]x2560xi16>
  %c2 = index.constant 2 : index
  %seed = vector.splati 0 : vector<2x8xi16>
  %empty = vector.splati 0 : vector<8xi16>
  %values = scf.for %round = [%c0 to %c2 step %c1](%bank = %seed : vector<2x8xi16>) -> (vector<2x8xi16>) unroll schedule(linear) {
    %row_active = vector.extract %live[%round] : vector<2xi1> -> i1
    %active = scalar.andi %row_active, %enabled : i1
    %word = vector.extract %ids[%round] : vector<2xi32> -> i32
    %value = index.cast %word : i32 to index
    %row = index.assume %value [ge(%value, 0), lt(%value, %capacity)] : index
    %mask = vector.splat %active : vector<8xi1>
    %packet_values = vector.load.mask %view[%row, %k], %mask, %empty : view<[%capacity]x2560xi16>, vector<8xi1>, vector<8xi16>
    %next = vector.insert %packet_values into %bank[%round] : vector<8xi16>, vector<2x8xi16>
    scf.yield %next : vector<2x8xi16>
  }
  func.return %values : vector<2x8xi16>
}

// A padded 129-row pitch stages F16 activations. The prepacked choice is
// resolved during specialization and has no runtime branch or metadata.
func.def inline @expert_block_publish_input(%prepacked: i1, %arena: buffer, %thread: index, %values: vector<2x8xi16>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %origin = index.constant 0 : offset
  %chunk = index.rem %thread, %c8 : index
  %row_base = index.div %thread, %c8 : index
  %view = buffer.view %arena[%origin] : buffer -> view<8x65x8xf16>
  scf.for %round = [%c0 to %c2 step %c1] unroll schedule(linear) {
    %row = index.madd %round, %c32, %row_base : index
    %bits = vector.extract %values[%round] : vector<2x8xi16> -> vector<8xi16>
    %converted = scf.if %prepacked -> (vector<8xf16>) {
      %values = vector.bitcast %bits : vector<8xi16> to vector<8xf16>
      scf.yield %values : vector<8xf16>
    } else {
      %packet = vector.bitcast %bits : vector<8xi16> to vector<8xbf16>
      %wide = vector.extf %packet : vector<8xbf16> to vector<8xf32>
      %values = vector.fptrunc %wide : vector<8xf32> to vector<8xf16>
      scf.yield %values : vector<8xf16>
    }
    vector.store %converted, %view[%chunk, %row, 0] : vector<8xf16>, view<8x65x8xf16>
  }
  func.return
}

// The QK bank retains four packed K64 halves plus one common header and
// optional high-bit plane. Q8 uses the four packet slots for its K32
// halves and the four header slots for F32 scales. Format specialization
// removes unused slots before allocation; no decoded global bank is created.
func.def inline @expert_block_load(%q8: i1, %q5: i1, %weight: buffer, %row_origin: offset, %block: index, %half: index) -> (vector<4xi32>, vector<4xi32>, vector<4x4xi32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %empty_header = vector.splati 0 : vector<4xi32>
  %empty_codes = vector.splati 0 : vector<4x4xi32>
  %header, %high, %codes = scf.if %q8 -> (vector<4xi32>, vector<4xi32>, vector<4x4xi32>) {
    %block_bytes = index.constant 34 : offset
    %header_bytes = index.constant 2 : offset
    %half_bytes = index.constant 16 : offset
    %first = index.mul %block, %c4 : index
    %half_relative = index.scale %half, %half_bytes : index, offset -> offset
    %header_values, %code_values = scf.for %part = [%c0 to %c4 step %c1](%metadata = %empty_header : vector<4xi32>, %packets = %empty_codes : vector<4x4xi32>) -> (vector<4xi32>, vector<4x4xi32>) unroll schedule(linear) {
      %ordinal = index.add %first, %part : index
      %relative = index.scale %ordinal, %block_bytes : index, offset -> offset
      %block_origin = index.add %row_origin, %relative : offset
      %payload = index.add %block_origin, %header_bytes : offset
      %code_origin = index.add %payload, %half_relative : offset
      %scale_view = buffer.view %weight[%block_origin] : buffer -> view<1xf16>
      %code_view = buffer.view %weight[%code_origin] : buffer -> view<16xi8>
      %scale_half = view.load %scale_view[0] : view<1xf16> -> f16
      %scale = scalar.extf %scale_half : f16 to f32
      %scale_bits = scalar.bitcast %scale : f32 to i32
      %packet = vector.load %code_view[0] : view<16xi8> -> vector<16xi8>
      %words = vector.bitcast %packet : vector<16xi8> to vector<4xi32>
      %next_header = vector.insert %scale_bits into %metadata[%part] : i32, vector<4xi32>
      %next_codes = vector.insert %words into %packets[%part] : vector<4xi32>, vector<4x4xi32>
      scf.yield %next_header, %next_codes : vector<4xi32>, vector<4x4xi32>
    }
    scf.yield %header_values, %empty_header, %code_values : vector<4xi32>, vector<4xi32>, vector<4x4xi32>
  } else {
    %q4_bytes = index.constant 144 : offset
    %q5_bytes = index.constant 176 : offset
    %header_bytes = index.constant 16 : offset
    %q5_code_bytes = index.constant 48 : offset
    %block_bytes = scf.select %q5, %q5_bytes, %q4_bytes : offset
    %code_bytes = scf.select %q5, %q5_code_bytes, %header_bytes : offset
    %block_relative = index.scale %block, %block_bytes : index, offset -> offset
    %block_origin = index.add %row_origin, %block_relative : offset
    %code_origin = index.add %block_origin, %code_bytes : offset
    %weight_header = buffer.view %weight[%block_origin] : buffer -> view<4xi32>
    %weight_codes = buffer.view %weight[%code_origin] : buffer -> view<32xi32>
    %metadata = vector.load %weight_header[0] : view<4xi32> -> vector<4xi32>
    %half_offset = index.mul %half, %c4 : index
    %high_values = scf.if %q5 -> (vector<4xi32>) {
      %high_origin = index.add %block_origin, %header_bytes : offset
      %high_view = buffer.view %weight[%high_origin] : buffer -> view<8xi32>
      %packed = vector.load %high_view[%half_offset] : view<8xi32> -> vector<4xi32>
      scf.yield %packed : vector<4xi32>
    } else {
      scf.yield %empty_header : vector<4xi32>
    }
    %code_values = scf.for %group = [%c0 to %c4 step %c1](%packets = %empty_codes : vector<4x4xi32>) -> (vector<4x4xi32>) unroll schedule(linear) {
      %code_index = index.madd %group, %c8, %half_offset : index
      %packed = vector.load %weight_codes[%code_index] : view<32xi32> -> vector<4xi32>
      %next = vector.insert %packed into %packets[%group] : vector<4xi32>, vector<4x4xi32>
      scf.yield %next : vector<4x4xi32>
    }
    scf.yield %metadata, %high_values, %code_values : vector<4xi32>, vector<4xi32>, vector<4x4xi32>
  }
  func.return %header, %high, %codes : vector<4xi32>, vector<4xi32>, vector<4x4xi32>
}

// Decode one K32 half from the retained original bytes. QK nibbles share
// one packet across adjacent scale groups; Q5's high plane supplies bit four.
func.def inline @expert_block_coefficients(%q8: i1, %q5: i1, %header: vector<4xi32>, %high: vector<4xi32>, %packets: vector<4x4xi32>, %stage: index, %part: index) -> (vector<16xf16>) {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %codes, %scale, %bias = scf.if %q8 -> (vector<16xf32>, f32, f32) {
    %slot = index.madd %stage, %c2, %part : index
    %scale_bits = vector.extract %header[%slot] : vector<4xi32> -> i32
    %scale_value = scalar.bitcast %scale_bits : i32 to f32
    %words = vector.extract %packets[%slot] : vector<4x4xi32> -> vector<4xi32>
    %bytes = vector.bitcast %words : vector<4xi32> to vector<16xi8>
    %values = vector.sitofp %bytes : vector<16xi8> to vector<16xf32>
    scf.yield %values, %scale_value, %c0_f32 : vector<16xf32>, f32, f32
  } else {
    %group = index.madd %stage, %c2, %part : index
    %scale_value, %minimum = func.call @ggml_q4_k_scaled_metadata(%header, %group) : (vector<4xi32>, index) -> (f32, f32)
    %bias_value = scalar.negf %minimum : f32
    %packed = vector.extract %packets[%stage] : vector<4x4xi32> -> vector<4xi32>
    %shift_index = index.mul %part, %c4 : index
    %shift_word = index.cast %shift_index : index to i32
    %shift = vector.splat %shift_word : vector<4xi32>
    %nibble_mask = vector.splati 252645135 : vector<4xi32>
    %shifted = vector.shrui %packed, %shift : vector<4xi32>
    %low_words = vector.andi %shifted, %nibble_mask : vector<4xi32>
    %words = scf.if %q5 -> (vector<4xi32>) {
      %one_bit_mask = vector.splati 16843009 : vector<4xi32>
      %high_bit_shift = vector.splati 4 : vector<4xi32>
      %group_word = index.cast %group : index to i32
      %group_shift = vector.splat %group_word : vector<4xi32>
      %shifted_high = vector.shrui %high, %group_shift : vector<4xi32>
      %bits = vector.andi %shifted_high, %one_bit_mask : vector<4xi32>
      %high_words = vector.shli %bits, %high_bit_shift : vector<4xi32>
      %combined = vector.ori %low_words, %high_words : vector<4xi32>
      scf.yield %combined : vector<4xi32>
    } else {
      scf.yield %low_words : vector<4xi32>
    }
    %bytes = vector.bitcast %words : vector<4xi32> to vector<16xi8>
    %values = vector.uitofp %bytes : vector<16xi8> to vector<16xf32>
    scf.yield %values, %scale_value, %bias_value : vector<16xf32>, f32, f32
  }
  %scale_half = scalar.fptrunc %scale : f32 to f16
  %bias_half = scalar.fptrunc %bias : f32 to f16
  %scales_half = vector.splat %scale_half : vector<16xf16>
  %biases_half = vector.splat %bias_half : vector<16xf16>
  %codes_half = vector.fptrunc %codes : vector<16xf32> to vector<16xf16>
  %coefficients = vector.fmaf %codes_half, %scales_half, %biases_half : vector<16xf16>
  func.return %coefficients : vector<16xf16>
}

// Each half-wave supplies one K16 packet; lane exchange constructs the
// replicated RHS fragments. A subgroup owns eight gate and eight up channels
// and visits eight token fragments, retaining only one operand fragment at a
// time. Empty token fragments skip arithmetic without changing barrier counts.
func.def inline @expert_block_compute(%q8: i1, %q5: i1, %arena: buffer, %header: vector<4xi32>, %high: vector<4xi32>, %packets: vector<4x4xi32>, %stage: index, %live: index, %accumulator: vector<4x8xf32>) -> (vector<4x8xf32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %origin = index.constant 0 : offset
  %lane = kernel.subgroup.lane.id : index
  %lane_row = index.rem %lane, %c16 : index
  %half = index.div %lane, %c16 : index
  %second_half = index.cmp ne, %half, %c0 : index
  %operand_view = buffer.view %arena[%origin] : buffer -> view<8x65x8xf16>
  %result = scf.for %block32 = [%c0 to %c2 step %c1](%accumulators = %accumulator : vector<4x8xf32>) -> (vector<4x8xf32>) unroll schedule(linear) {
    %narrow = func.call @expert_block_coefficients(%q8, %q5, %header, %high, %packets, %stage, %block32) : (i1, i1, vector<4xi32>, vector<4xi32>, vector<4x4xi32>, index, index) -> (vector<16xf16>)
    %first_chunk = index.mul %block32, %c4 : index
    %chunk1 = index.add %first_chunk, %c1 : index
    %chunk2 = index.add %first_chunk, %c2 : index
    %chunk3 = index.add %chunk2, %c1 : index
    %packed_codes = vector.bitcast %narrow : vector<16xf16> to vector<8xi32>
    %w0, %w1 = func.call @expert_fragment_pair(%packed_codes, %second_half) : (vector<8xi32>, i1) -> (vector<8xi32>, vector<8xi32>)
    %codes0 = vector.bitcast %w0 : vector<8xi32> to vector<16xf16>
    %codes1 = vector.bitcast %w1 : vector<8xi32> to vector<16xf16>
    %rhs0 = vector.fragment<rhs> %codes0 shape [%c16, %c16] : vector<16xf16>
    %rhs1 = vector.fragment<rhs> %codes1 shape [%c16, %c16] : vector<16xf16>
    %next = scf.for %fragment = [%c0 to %c4 step %c1](%tile = %accumulators : vector<4x8xf32>) -> (vector<4x8xf32>) unroll schedule(linear) {
      scf.schedule.fence
      %row_base = index.mul %fragment, %c16 : index
      %active = index.cmp ult, %row_base, %live : index
      %old = vector.extract %tile[%fragment] : vector<4x8xf32> -> vector<8xf32>
      %new = scf.if %active -> (vector<8xf32>) {
        %row = index.add %row_base, %lane_row : index
        %q0 = vector.load %operand_view[%first_chunk, %row, 0] : view<8x65x8xf16> -> vector<8xf16>
        %q1 = vector.load %operand_view[%chunk1, %row, 0] : view<8x65x8xf16> -> vector<8xf16>
        %q2 = vector.load %operand_view[%chunk2, %row, 0] : view<8x65x8xf16> -> vector<8xf16>
        %q3 = vector.load %operand_view[%chunk3, %row, 0] : view<8x65x8xf16> -> vector<8xf16>
        %input0 = vector.concat<0> %q0, %q1 : vector<8xf16>, vector<8xf16> -> vector<16xf16>
        %input1 = vector.concat<0> %q2, %q3 : vector<8xf16>, vector<8xf16> -> vector<16xf16>
        %lhs0 = vector.fragment<lhs> %input0 shape [%c16, %c16] : vector<16xf16>
        %lhs1 = vector.fragment<lhs> %input1 shape [%c16, %c16] : vector<16xf16>
        %previous = vector.fragment<init> %old shape [%c16, %c16] : vector<8xf32>
        %dot0 = vector.mma %lhs0, %rhs0, %previous : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %dot = vector.mma %lhs1, %rhs1, %dot0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
        scf.yield %dot : vector<8xf32>
      } else {
        scf.yield %old : vector<8xf32>
      }
      %updated = vector.insert %new into %tile[%fragment] : vector<8xf32>, vector<4x8xf32>
      scf.yield %updated : vector<4x8xf32>
    }
    scf.yield %next : vector<4x8xf32>
  }
  func.return %result : vector<4x8xf32>
}

// Every workgroup consumes immutable records and preserves original route
// IDs. The output transpose reuses operand SRAM after the final operand read;
// only live rows publish 16-byte packets. The closing barrier protects that
// arena before this persistent worker begins its next record/channel tile.
func.def public inline @expert_block_gate(%q8: i1, %q5: i1, %input_arg: buffer, %tasks_arg: buffer, %gate_arg: buffer, %up_arg: buffer, %output_arg: buffer) {
  %input, %tasks, %gate, %up, %output = buffer.assume.noalias %input_arg, %tasks_arg, %gate_arg, %up_arg, %output_arg : buffer, buffer, buffer, buffer, buffer
  %capacity = config.get @flash_next.token_count : index
  %packed_shape = func.call pure @expert_gate_input_is_prepacked() : () -> (i1)
  %false = scalar.constant false : i1
  %prepacked = scf.select %q8, %false, %packed_shape : i1
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c10 = index.constant 10 : index
  %c16 = index.constant 16 : index
  %c20 = index.constant 20 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c64 = index.constant 64 : index
  %rows = index.constant 128 : index
  %threads = index.constant 256 : index
  %outputs = index.constant 640 : index
  %workers = index.constant 1280 : index
  %origin = index.constant 0 : offset
  %records_origin = index.constant 4 : offset
  %q4_row_bytes = index.constant 1440 : offset
  %q5_row_bytes = index.constant 1760 : offset
  %q8_row_bytes = index.constant 2720 : offset
  %qk_row_bytes = scf.select %q5, %q5_row_bytes, %q4_row_bytes : offset
  %row_bytes = scf.select %q8, %q8_row_bytes, %qk_row_bytes : offset
  %outer_blocks = scf.select %q8, %c20, %c10 : index
  %stages = scf.select %q8, %c2, %c4 : index
  %arena_bytes = index.constant 8448 : offset
  %arena = buffer.alloca<workgroup> align(16) %arena_bytes : buffer
  %route_capacity = index.mul %capacity, %c10 : index
  %record_capacity, %record_fields, %record_bytes = func.call pure @expert_record_extent(%capacity, %rows) : (index, index) -> (index, index, offset)
  %header = buffer.view %tasks[%origin] : buffer -> view<1xi32>
  %records = buffer.view %tasks[%records_origin] : buffer -> view<[%record_capacity]x130xi32>
  %count_word = view.load %header[0] : view<1xi32> -> i32
  %count_value = index.cast %count_word : i32 to index
  %count = index.assume %count_value [ge(%count_value, 0), le(%count_value, %record_capacity)] : index
  %work_count = index.mul %count, %c10 : index
  %worker = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %lane_column = index.rem %lane, %c16 : index
  %half = index.div %lane, %c16 : index
  %channel_in_wave = index.rem %lane_column, %c8 : index
  %gate_lane = index.cmp ult, %lane_column, %c8 : index
  %selected_weight = scf.select %gate_lane, %gate, %up : buffer
  %row_base = index.div %thread, %c8 : index
  %ids_seed = vector.splati 0 : vector<2xi32>
  %live_seed = vector.splati 0 : vector<2xi1>
  %accumulator_seed = vector.splatf 0.0 : vector<4x8xf32>
  %c63 = index.constant 63 : index
  %result_view = buffer.view %arena[%origin] : buffer -> view<64x66xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%route_capacity]x640xbf16>
  %c1_f32 = scalar.constant 1.0 : f32
  %xor_eight = scalar.constant 8 : i32
  %shuffle_width = scalar.constant 32 : i32
  scf.for %work = [%worker to %work_count step %workers] {
    %task_value = index.div %work, %c10 : index
    %task = index.assume %task_value [ge(%task_value, 0), lt(%task_value, %record_capacity)] : index
    %output_group = index.rem %work, %c10 : index
    %column_base = index.mul %output_group, %c64 : index
    %expert_word = view.load %records[%task, 0] : view<[%record_capacity]x130xi32> -> i32
    %expert_value = index.cast %expert_word : i32 to index
    %expert = index.assume %expert_value [range(%expert_value, 0, 511)] : index
    %live_word = view.load %records[%task, 1] : view<[%record_capacity]x130xi32> -> i32
    %live_value = index.cast %live_word : i32 to index
    %live = index.assume %live_value [range(%live_value, 1, 128)] : index
    %wave_column = index.madd %wave, %c8, %channel_in_wave : index
    %channel = index.add %column_base, %wave_column : index
    %weight_row = index.madd %expert, %outputs, %channel : index
    %weight_origin = index.scale %weight_row, %row_bytes : index, offset -> offset
    %passes_up = index.add %live, %c63 : index
    %passes = index.div %passes_up, %c64 : index
    scf.for %pass = [%c0 to %passes step %c1] {
      %row0 = index.mul %pass, %c64 : index
      %remaining = index.sub %live, %row0 : index
      %pass_full = index.cmp uge, %remaining, %c64 : index
      %pass_live = scf.select %pass_full, %c64, %remaining : index
      %ids, %masks = scf.for %round = [%c0 to %c2 step %c1](%id_values = %ids_seed : vector<2xi32>, %live_values = %live_seed : vector<2xi1>) -> (vector<2xi32>, vector<2xi1>) unroll schedule(linear) {
        %row = index.madd %round, %c32, %row_base : index
        %active = index.cmp ult, %row, %pass_live : index
        %global_row = index.add %row0, %row : index
        %field = index.add %global_row, %c2 : index
        %route_word = view.load %records[%task, %field] : view<[%record_capacity]x130xi32> -> i32
        %route_value = index.cast %route_word : i32 to index
        %safe_route = scf.select %active, %route_value, %c0 : index
        %route = index.assume %safe_route [ge(%safe_route, 0), lt(%safe_route, %route_capacity)] : index
        %token = index.div %route, %c10 : index
        %token_word = index.cast %token : index to i32
        %next_ids = vector.insert %token_word into %id_values[%round] : i32, vector<2xi32>
        %next_live = vector.insert %active into %live_values[%round] : i1, vector<2xi1>
        scf.yield %next_ids, %next_live : vector<2xi32>, vector<2xi1>
      }
      %first_enabled = scalar.constant true : i1
      %first_input = func.call @expert_block_input(%input, %ids, %masks, %c0, %thread, %first_enabled) : (buffer, vector<2xi32>, vector<2xi1>, index, index, i1) -> (vector<2x8xi16>)
      %result, %unused_queue = scf.for %block = [%c0 to %outer_blocks step %c1](%accumulators = %accumulator_seed : vector<4x8xf32>, %pending = %first_input : vector<2x8xi16>) -> (vector<4x8xf32>, vector<2x8xi16>) {
        %metadata, %high, %cache = func.call @expert_block_load(%q8, %q5, %selected_weight, %weight_origin, %block, %half) : (i1, i1, buffer, offset, index, index) -> (vector<4xi32>, vector<4xi32>, vector<4x4xi32>)
        %next, %next_queue = scf.for %stage = [%c0 to %stages step %c1](%stage_accumulator = %accumulators : vector<4x8xf32>, %queued = %pending : vector<2x8xi16>) -> (vector<4x8xf32>, vector<2x8xi16>) unroll schedule(linear) {
          func.call @expert_block_publish_input(%prepacked, %arena, %thread, %queued) : (i1, buffer, index, vector<2x8xi16>)
          kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
          %current = index.madd %block, %stages, %stage : index
          %following = index.add %current, %c1 : index
          %has_next = index.cmp ult, %following, %c40 : index
          %safe_group = scf.select %has_next, %following, %c0 : index
          %refill = func.call @expert_block_input(%input, %ids, %masks, %safe_group, %thread, %has_next) : (buffer, vector<2xi32>, vector<2xi1>, index, index, i1) -> (vector<2x8xi16>)
          %computed = func.call @expert_block_compute(%q8, %q5, %arena, %metadata, %high, %cache, %stage, %pass_live, %stage_accumulator) : (i1, i1, buffer, vector<4xi32>, vector<4xi32>, vector<4x4xi32>, index, index, vector<4x8xf32>) -> (vector<4x8xf32>)
          kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
          scf.yield %computed, %refill : vector<4x8xf32>, vector<2x8xi16>
        }
        scf.yield %next, %next_queue : vector<4x8xf32>, vector<2x8xi16>
      }
      scf.for %fragment = [%c0 to %c4 step %c1] unroll schedule(linear) {
        %projection = vector.extract %result[%fragment] : vector<4x8xf32> -> vector<8xf32>
        %fragment_row = index.mul %fragment, %c16 : index
        scf.for %element = [%c0 to %c8 step %c1] unroll schedule(linear) {
          %gate_value = vector.extract %projection[%element] : vector<8xf32> -> f32
          %up_value, %valid = kernel.subgroup.shuffle<xor> %gate_value, %xor_eight, %shuffle_width : f32, i32, i32
          %negative = scalar.negf %gate_value : f32
          %exponential = scalar.expf<afn> %negative : f32
          %denominator = scalar.addf %c1_f32, %exponential : f32
          %silu = scalar.divf %gate_value, %denominator : f32
          %product = scalar.mulf %silu, %up_value : f32
          %narrow = scalar.fptrunc %product : f32 to bf16
          %row_part = index.madd %element, %c2, %half : index
          %row = index.add %fragment_row, %row_part : index
          scf.if %gate_lane {
            view.store %narrow, %result_view[%row, %wave_column] : bf16, view<64x66xbf16>
          }
        }
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %publish_packets = index.constant 512 : index
      scf.for %packet = [%thread to %publish_packets step %threads] {
        %row = index.div %packet, %c8 : index
        %column_packet = index.rem %packet, %c8 : index
        %column = index.mul %column_packet, %c8 : index
        %active = index.cmp ult, %row, %pass_live : index
        scf.if %active {
          %global_row = index.add %row0, %row : index
          %field = index.add %global_row, %c2 : index
          %route_word = view.load %records[%task, %field] : view<[%record_capacity]x130xi32> -> i32
          %route_value = index.cast %route_word : i32 to index
          %route = index.assume %route_value [ge(%route_value, 0), lt(%route_value, %route_capacity)] : index
          %values = vector.load %result_view[%row, %column] : view<64x66xbf16> -> vector<8xbf16>
          %output_column = index.add %column_base, %column : index
          vector.store %values, %output_view[%route, %output_column] : vector<8xbf16>, view<[%route_capacity]x640xbf16>
        }
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    }
  }
  func.return
}

// Keep producer and consumer representation selection at the same specialization boundary.
func.def public pure inline @expert_gate_input_is_prepacked() -> (i1) {
  %capacity = config.get @flash_next.token_count : index
  %selected = index.constant 2048 : index
  %enabled = index.cmp eq, %capacity, %selected : index
  func.return %enabled : i1
}

amdgpu.target<gfx11-generic> @expert_operand_wave32 {subgroup_size = 32}

// Convert the reused live operand once. Epoch stays on the GPU; no host count.
kernel.def target(@expert_operand_wave32) @expert_input_half(%neural_enabled: i1) {
  %capacity = config.get @flash_next.token_count : index
  %features = index.constant 2560 : index
  %span = index.constant 2048 : index
  %threads = index.constant 256 : index
  %c1_index = index.constant 1 : index
  %elements = index.mul %capacity, %features : index
  %rounding = index.constant 2047 : index
  %rounded = index.add %elements, %rounding : index
  %groups = index.div %rounded, %span : index
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %groups, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1_index, %c1_index) workgroup_size(%threads, %c1_index, %c1_index) : index
} launch(%input_arg: buffer, %epoch_arg: buffer, %output_arg: buffer) {
  %input, %epoch, %output = buffer.assume.noalias %input_arg, %epoch_arg, %output_arg : buffer, buffer, buffer
  %capacity = config.get @flash_next.token_count : index
  %c8 = index.constant 8 : index
  %features = index.constant 2560 : index
  %span = index.constant 2048 : index
  %c0_offset = index.constant 0 : offset
  %live = func.call @flash_next_token_count(%epoch, %capacity) : (buffer, index) -> (index)
  %elements = index.mul %capacity, %features : index
  %live_elements = index.mul %live, %features : index
  %group = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %local = index.mul %thread, %c8 : index
  %base = index.madd %group, %span, %local : index
  %active = index.cmp ult, %base, %live_elements : index
  scf.if %active {
    %input_view = buffer.view %input[%c0_offset] : buffer -> view<[%elements]xbf16>
    %output_view = buffer.view %output[%c0_offset] : buffer -> view<[%elements]xf16>
    %packet = vector.load %input_view[%base] : view<[%elements]xbf16> -> vector<8xbf16>
    %wide = vector.extf %packet : vector<8xbf16> to vector<8xf32>
    %half = vector.fptrunc %wide : vector<8xf32> to vector<8xf16>
    vector.store %half, %output_view[%base] : vector<8xf16>, view<[%elements]xf16>
  }
  kernel.return
}

amdgpu.target<gfx11-generic> @flash_next_expert_bucket_wave32 {subgroup_size = 32}

func.decl @expert_swiglu(%gate: f32, %up: f32) -> (bf16)

func.decl @flash_next_q8_rows_partial(%width: index, %rows: vector<4xi32>, %live: index, %row: index, %lane: index, %stride: index, %input: buffer, %weight: buffer) -> (vector<4xf32>)

kernel.def target(@flash_next_expert_bucket_wave32) @expert_routes(%neural_enabled: i1) {
  %c1_index = index.constant 1 : index
  %threads = index.constant 512 : index
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %c1_index, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1_index, %c1_index) workgroup_size(%threads, %c1_index, %c1_index) : index
} launch(%record_rows_arg: index, %epoch_arg: buffer, %ids_arg: buffer, %ranks_arg: buffer, %tasks_arg: buffer) {
  %record_rows = index.assume %record_rows_arg [range(%record_rows_arg, 4, 256)] : index
  %epoch, %ids, %ranks, %tasks = buffer.assume.noalias %epoch_arg, %ids_arg, %ranks_arg, %tasks_arg : buffer, buffer, buffer, buffer
  %capacity = config.get @flash_next.token_count : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %record_capacity, %record_fields, %record_bytes = func.call pure @expert_record_extent(%capacity, %record_rows) : (index, index) -> (index, index, offset)
  %c10 = index.constant 10 : index
  %expert_count = index.constant 512 : index
  %last_expert = index.constant 511 : index
  %origin = index.constant 0 : offset
  %record_origin = index.constant 4 : offset
  %local_bytes = index.constant 2048 : offset
  %c0_word = scalar.constant 0 : i32
  %c1_word = scalar.constant 1 : i32
  %padding = index.sub %record_rows, %c1 : index
  %padding_word = index.cast %padding : index to i32
  %rows_word = index.cast %record_rows : index to i32
  %thread = kernel.workitem.id<x> : index
  %route_capacity = index.mul %capacity, %c10 : index
  %last_route = index.sub %route_capacity, %c1 : index
  %tokens = func.call @flash_next_token_count(%epoch, %capacity) : (buffer, index) -> (index)
  %routes = index.mul %tokens, %c10 : index
  %selections = buffer.view %ids[%origin] : buffer -> view<[%route_capacity]xi32>
  %rank_view = buffer.view %ranks[%origin] : buffer -> view<[%route_capacity]xi32>
  %records = buffer.view %tasks[%record_origin] : buffer -> view<[%record_capacity]x[%record_fields]xi32>
  %header = buffer.view %tasks[%origin] : buffer -> view<1xi32>
  %counter_storage = buffer.alloca<workgroup> align(16) %local_bytes : buffer
  %offset_storage = buffer.alloca<workgroup> align(16) %local_bytes : buffer
  %counters = buffer.view %counter_storage[%origin] : buffer -> view<512xi32>
  %offsets = buffer.view %offset_storage[%origin] : buffer -> view<512xi32>
  view.store %c0_word, %counters[%thread] : i32, view<512xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  // Rank tickets are private to the route that reserves them. Re-reading a
  // ticket in the same invocation requires no cross-thread global fence.
  scf.for %route = [%thread to %routes step %expert_count] {
    %expert_word = view.load %selections[%route] : view<[%route_capacity]xi32> -> i32
    %expert_value = index.cast %expert_word : i32 to index
    %expert = index.assume %expert_value [range(%expert_value, 0, 511)] : index
    %rank = view.atomic.rmw<addi> %c1_word, %counters[%expert] {ordering = relaxed, scope = workgroup} : i32, view<512xi32> -> i32
    view.store %rank, %rank_view[%route] : i32, view<[%route_capacity]xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %population_word = view.load %counters[%thread] : view<512xi32> -> i32
  %rounded = scalar.addi %population_word, %padding_word : i32
  %tile_word = scalar.divui %rounded, %rows_word : i32
  %first_word = kernel.workgroup.scan<addi> %tile_word {direction = forward, mode = exclusive} : i32
  view.store %first_word, %offsets[%thread] : i32, view<512xi32>
  %last = index.cmp eq, %thread, %last_expert : index
  scf.if %last {
    %total = scalar.addi %first_word, %tile_word : i32
    view.store %total, %header[0] : i32, view<1xi32>
  }
  %tiles = index.cast %tile_word : i32 to index
  %first = index.cast %first_word : i32 to index
  %population = index.cast %population_word : i32 to index
  %expert_word = index.cast %thread : index to i32
  scf.for %tile = [%c0 to %tiles step %c1] {
    %task_value = index.add %first, %tile : index
    %task = index.assume %task_value [ge(%task_value, 0), lt(%task_value, %record_capacity)] : index
    %consumed = index.mul %tile, %record_rows : index
    %remaining = index.sub %population, %consumed : index
    %partial = index.cmp ult, %remaining, %record_rows : index
    %live_value = scf.select %partial, %remaining, %record_rows : index
    %live = index.assume %live_value [range(%live_value, 1, %record_rows)] : index
    %live_word = index.cast %live : index to i32
    view.store %expert_word, %records[%task, 0] : i32, view<[%record_capacity]x[%record_fields]xi32>
    view.store %live_word, %records[%task, 1] : i32, view<[%record_capacity]x[%record_fields]xi32>
    // Only tail fields are initialized. Scatter owns the disjoint live fields.
    scf.for %ordinal = [%live to %record_rows step %c1] {
      %field = index.add %ordinal, %c2 : index
      view.store %c0_word, %records[%task, %field] : i32, view<[%record_capacity]x[%record_fields]xi32>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.for %route = [%thread to %routes step %expert_count] {
    %expert_word = view.load %selections[%route] : view<[%route_capacity]xi32> -> i32
    %expert_value = index.cast %expert_word : i32 to index
    %expert = index.assume %expert_value [range(%expert_value, 0, 511)] : index
    %rank_word = view.load %rank_view[%route] : view<[%route_capacity]xi32> -> i32
    %rank_value = index.cast %rank_word : i32 to index
    %rank = index.assume %rank_value [range(%rank_value, 0, %last_route)] : index
    %first_word = view.load %offsets[%expert] : view<512xi32> -> i32
    %first = index.cast %first_word : i32 to index
    %tile = index.div %rank, %record_rows : index
    %ordinal_value = index.rem %rank, %record_rows : index
    %ordinal = index.assume %ordinal_value [ge(%ordinal_value, 0), lt(%ordinal_value, %record_rows)] : index
    %field = index.add %ordinal, %c2 : index
    %task_value = index.add %first, %tile : index
    %task = index.assume %task_value [ge(%task_value, 0), lt(%task_value, %record_capacity)] : index
    %route_word = index.cast %route : index to i32
    view.store %route_word, %records[%task, %field] : i32, view<[%record_capacity]x[%record_fields]xi32>
  }
  kernel.return
}

// A finite pool walks the product of live records and output groups. Four
// waves own four output features; each wave reuses weights over four routes.
// Dispatch completion publishes the producer's entire table, and the owning
// command keeps it immutable through gate/up and down. The count is an extent,
// not a readiness flag for a concurrently running producer.
func.def inline @expert_bucket_gate_body(%q8: i1, %q5: i1, %input_arg: buffer, %tasks_arg: buffer, %gate_weight_arg: buffer, %up_weight_arg: buffer, %output_arg: buffer) {
  %input, %tasks, %gate_weight, %up_weight, %output = buffer.assume.noalias %input_arg, %tasks_arg, %gate_weight_arg, %up_weight_arg, %output_arg : buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %features = index.constant 640 : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c10 = index.constant 10 : index
  %workers = index.constant 1280 : index
  %width = index.constant 2560 : index
  %stride = index.constant 32 : index
  %origin = index.constant 0 : offset
  %record_origin = index.constant 4 : offset
  %route_capacity = index.mul %tokens, %c10 : index
  %last_route = index.sub %route_capacity, %c1 : index
  %record_capacity, %record_fields, %record_bytes = func.call pure @expert_record_extent(%tokens, %c4) : (index, index) -> (index, index, offset)
  %groups = index.div %features, %c4 : index
  %header = buffer.view %tasks[%origin] : buffer -> view<1xi32>
  %records = buffer.view %tasks[%record_origin] : buffer -> view<[%record_capacity]x6xi32>
  %result = buffer.view %output[%origin] : buffer -> view<[%route_capacity]x[%features]xbf16>
  %count_word = view.load %header[0] : view<1xi32> -> i32
  %count_value = index.cast %count_word : i32 to index
  %count = index.assume %count_value [range(%count_value, 0, %record_capacity)] : index
  %work_count = index.mul %count, %groups : index
  %worker = kernel.workgroup.id<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %leader = index.cmp eq, %lane, %c0 : index
  scf.for %work = [%worker to %work_count step %workers] {
    %task = index.div %work, %groups : index
    %group = index.rem %work, %groups : index
    %feature = index.madd %group, %c4, %wave : index
    %expert_word = view.load %records[%task, 0] : view<[%record_capacity]x6xi32> -> i32
    %expert_value = index.cast %expert_word : i32 to index
    %expert = index.assume %expert_value [range(%expert_value, 0, 511)] : index
    %live_word = view.load %records[%task, 1] : view<[%record_capacity]x6xi32> -> i32
    %live_value = index.cast %live_word : i32 to index
    %live = index.assume %live_value [range(%live_value, 1, 4)] : index
    %routes = vector.load %records[%task, 2] : view<[%record_capacity]x6xi32> -> vector<4xi32>
    %row = index.madd %expert, %features, %feature : index
    %slot_count = vector.splati 10 : vector<4xi32>
    %rows = vector.divui %routes, %slot_count : vector<4xi32>
    %gate_partial, %up_partial = scf.if %q8 -> (vector<4xf32>, vector<4xf32>) {
      %gate = func.call @flash_next_q8_rows_partial(%width, %rows, %live, %row, %lane, %stride, %input, %gate_weight) : (index, vector<4xi32>, index, index, index, index, buffer, buffer) -> (vector<4xf32>)
      %up = func.call @flash_next_q8_rows_partial(%width, %rows, %live, %row, %lane, %stride, %input, %up_weight) : (index, vector<4xi32>, index, index, index, index, buffer, buffer) -> (vector<4xf32>)
      scf.yield %gate, %up : vector<4xf32>, vector<4xf32>
    } else {
      %gate, %up = func.call @flash_next_qk_pair_rows_partial(%q5, %width, %rows, %live, %row, %lane, %stride, %input, %gate_weight, %up_weight) : (i1, index, vector<4xi32>, index, index, index, index, buffer, buffer, buffer) -> (vector<4xf32>, vector<4xf32>)
      scf.yield %gate, %up : vector<4xf32>, vector<4xf32>
    }
    %gate_sums = kernel.subgroup.reduce<addf> %gate_partial : vector<4xf32>
    %up_sums = kernel.subgroup.reduce<addf> %up_partial : vector<4xf32>
    scf.if %leader {
      scf.for %ordinal = [%c0 to %c4 step %c1] unroll schedule(linear) {
        %active = index.cmp ult, %ordinal, %live : index
        scf.if %active {
          %route_word = vector.extract %routes[%ordinal] : vector<4xi32> -> i32
          %route_value = index.cast %route_word : i32 to index
          %route = index.assume %route_value [range(%route_value, 0, %last_route)] : index
          %gate = vector.extract %gate_sums[%ordinal] : vector<4xf32> -> f32
          %up = vector.extract %up_sums[%ordinal] : vector<4xf32> -> f32
          %packed = func.call @expert_swiglu(%gate, %up) : (f32, f32) -> (bf16)
          view.store %packed, %result[%route, %feature] : bf16, view<[%route_capacity]x[%features]xbf16>
        }
      }
    }
  }
  func.return
}

kernel.def target(@flash_next_expert_bucket_wave32) @expert_bucket_gate_up_q4k(%neural_enabled: i1) {
  %workers = index.constant 1280 : index
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %workers, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input_arg: buffer, %tasks_arg: buffer, %gate_weight_arg: buffer, %up_weight_arg: buffer, %output_arg: buffer) {
  %q8 = scalar.constant false : i1
  %q5 = scalar.constant false : i1
  func.call @expert_bucket_gate_body(%q8, %q5, %input_arg, %tasks_arg, %gate_weight_arg, %up_weight_arg, %output_arg) : (i1, i1, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@flash_next_expert_bucket_wave32) @expert_bucket_gate_up_q5k(%neural_enabled: i1) {
  %workers = index.constant 1280 : index
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %workers, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input_arg: buffer, %tasks_arg: buffer, %gate_weight_arg: buffer, %up_weight_arg: buffer, %output_arg: buffer) {
  %q8 = scalar.constant false : i1
  %q5 = scalar.constant true : i1
  func.call @expert_bucket_gate_body(%q8, %q5, %input_arg, %tasks_arg, %gate_weight_arg, %up_weight_arg, %output_arg) : (i1, i1, buffer, buffer, buffer, buffer, buffer)
