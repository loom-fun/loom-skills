// The physical launch size is independent of the selected contraction.
kernel.def target(@flash_next_expert_matrix_wave32) @expert_matrix(%neural_enabled: i1) {
  %workers = index.constant 1280 : index
  %threads = index.constant 256 : index
  %c1 = index.constant 1 : index
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %workers, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%contraction: index, %format: index, %rows: index, %input: buffer, %tasks: buffer, %weight: buffer, %up_weight: buffer, %output: buffer) {
  template.apply<@flash_next.expert_schedule>(%contraction, %format, %rows, %input, %tasks, %weight, %up_weight, %output) : (index, index, index, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

// The shared expert uses contiguous 64-token by 64-feature tiles. Gate and up
// share activation panels and retain F32 through SiLU and multiplication;
// only the fused hidden result is published to global memory.
kernel.def target(@flash_next_expert_matrix_wave32) @shared_matrix(%neural_enabled: i1) {
  %capacity = config.get @flash_next.token_count : index
  %rows = index.constant 64 : index
  %rounding = index.constant 63 : index
  %columns = index.constant 10 : index
  %limit = index.constant 1280 : index
  %threads = index.constant 256 : index
  %c1 = index.constant 1 : index
  %rounded = index.add %capacity, %rounding : index
  %row_tiles = index.div %rounded, %rows : index
  %work = index.mul %row_tiles, %columns : index
  %small = index.cmp ult, %work, %limit : index
  %workers = scf.select %small, %work, %limit : index
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %workers, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span: buffer, %input: buffer, %weight: buffer, %up_weight: buffer, %output: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %rows = index.constant 64 : index
  %columns = index.constant 64 : index
  %wave_rows = index.constant 4 : index
  %wave_columns = index.constant 2 : index
  %depth = index.constant 2 : index
  template.apply<@flash_next.expert_tile>(%false, %false, %true, %false, %capacity, %rows, %columns, %wave_rows, %wave_columns, %depth, %input, %span, %weight, %up_weight, %output) : (i1, i1, i1, i1, index, index, index, index, index, index, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

