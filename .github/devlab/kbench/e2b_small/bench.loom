  scf.for %c = [%lane to %k4 step %c256] {
    %bc = index.assume %c [lt(%c, %k4)] : index
    %v = vector.load %x4_view[%row, %bc, %c0] : view<[%rows]x[%k4]x4xf32> -> vector<4xf32>
    %sv = vector.mulf %v, %scale4 : vector<4xf32>
    %hv = vector.fptrunc %sv : vector<4xf32> to vector<4xf16>
    vector.store %hv, %h4_view[%row, %bc, %c0] : vector<4xf16>, view<[%rows]x[%k4]x4xf16>
  }
  %first = index.cmp eq, %lane, %c0 : index
  scf.if %first {
    %s_view = buffer.view %scales[%zero] : buffer -> view<[%rows]x2xf32>
    view.store %scale, %s_view[%row, %c0] : f32, view<[%rows]x2xf32>
    view.store %inverse, %s_view[%row, %c1] : f32, view<[%rows]x2xf32>
  }
  kernel.return
}

check.case public @k_rs_wg64_case {
  %rows = check.literal value(2048) : index
  %k = check.literal value(1536) : index
  %seed0 = check.literal value(7) : i64
  %x = check.generate.random.uniform seed(%seed0) range(-1.0 to 1.0) : tensor<2048x1536xf32>
  %s = check.generate.fill value(0.0) : tensor<2048x2xf32>
  %x16 = check.generate.fill value(0.0) : tensor<2048x1536xf16>
  kernel.launch @k_rs_wg64[%rows](%rows, %k, %x, %s, %x16) : [index](index, index, tensor<2048x1536xf32>, tensor<2048x2xf32>, tensor<2048x1536xf16>)
  check.return
}
check.benchmark<@k_rs_wg64_case> @k_rs_wg64_bm
