      %ac3_0 = scf.for %mc_3_0 = [%c0 to %c16 step %c1](%acc3_0 = %os3 : vector<8xf32>) -> (vector<8xf32>) {
        %mci3_0 = index.cast %mc_3_0 : index to i32
