        %vs0_0 = vector.select %m0_0, %vl0_0, %zero16h : vector<8xf16>
        %vm0_0 = vector.fragment<lhs> %vs0_0 shape [%c16, %c16] : vector<8xf16>
        %rm0_0 = vector.mma %vm0_0, %pt0, %os0 : vector<8xf16>, vector<8xf16>, vector<8xf32>
        %acn0_0 = scf.select %isc0_0, %rm0_0, %acc0_0 : vector<8xf32>
        scf.yield %acn0_0 : vector<8xf32>
      }
      %ac1_0 = scf.for %mc_1_0 = [%c0 to %c16 step %c1](%acc1_0 = %os1 : vector<8xf32>) -> (vector<8xf32>) {
