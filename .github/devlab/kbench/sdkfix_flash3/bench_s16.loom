amdgpu.target<gfx12-generic> @rdna4 {subgroup_size = 32}

func.def inline @g_kv_offset(%origins: buffer, %row: index, %position: index, %blocks: index, %plane: index, %pool: index) -> (offset) {
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %record_stride = index.constant 40 : offset
  %position_bytes = index.constant 4096 : offset
  %bounded_row = index.assume %row [range(%row, 0, 2147483646)] : index
  %bounded_position = index.assume %position [range(%position, 0, 262143)] : index
  %record_offset = index.scale %bounded_row, %record_stride : index, offset -> offset
  %records = buffer.view %origins[%record_offset] : buffer -> view<5xi64>
  %map64 = view.load %records[4] : view<5xi64> -> i64
  %map_bound = scalar.assume %map64 [range(%map64, 0, 9223372036854775807)] : i64
  %map_origin = index.cast %map_bound : i64 to offset
  %page_value = index.div %bounded_position, %c16 : index
  %last = index.sub %blocks, %c1 : index
  %page = index.assume %page_value [range(%page_value, 0, %last), lt(%page_value, %blocks)] : index
  %map = buffer.view %origins[%map_origin] : buffer -> view<[%blocks]xi32>
  %physical32 = view.load %map[%page] : view<[%blocks]xi32> -> i32
  %bounded_physical = scalar.assume %physical32 [range(%physical32, 0, 134217727)] : i32
  %physical = index.cast %bounded_physical : i32 to index
  %page_base = index.mul %physical, %c16 : index
  %within = index.rem %bounded_position, %c16 : index
  %slot = index.add %page_base, %within : index
  %plane_slot = index.madd %plane, %pool, %slot : index
  %bytes = index.scale %plane_slot, %position_bytes : index, offset -> offset
  func.return %bytes : offset
}


kernel.def target(@rdna4) export("k_fa2k") @k_fa2k(%tokens: index) {
  %c1 = index.constant 1 : index
  %ckv = index.constant 8 : index
  %c16 = index.constant 16 : index
  %clanes = index.constant 128 : index
  %tiles = index.div %tokens, %c16 : index
  kernel.launch.config workgroups(%tiles, %ckv, %c1) workgroup_size(%clanes, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %sliding: i32, %context_arg: index, %pool_arg: index, %q: buffer, %gate: buffer, %info: buffer, %tiles: buffer, %origins: buffer, %arena: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 16, 8192), multiple_of(%tokens_arg, 16)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 47)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 262144)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 2147483584)] : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c0_i32 = scalar.constant 0 : i32
  %e0 = index.constant 0 : index
  %e1 = index.constant 1 : index
  %e2 = index.constant 2 : index
  %e3 = index.constant 3 : index
  %e4 = index.constant 4 : index
  %e5 = index.constant 5 : index
  %e6 = index.constant 6 : index
  %e7 = index.constant 7 : index
  %kb0_row = index.constant 0 : index
  %kbo0 = scalar.constant 0 : i32
  %c15_i32m = scalar.constant 15 : i32
  %c1_i32m = scalar.constant 1 : i32
  %far_below = scalar.constant -1000000 : i32
  %tile_count = index.div %tokens, %c16 : index
  %tile_id = kernel.workgroup.id<x> : index
  %tile = index.assume %tile_id [lt(%tile_id, %tile_count)] : index
  %kv_id = kernel.workgroup.id<y> : index
  %kv = index.assume %kv_id [range(%kv_id, 0, 7)] : index
  %tiles_view = buffer.view %tiles[%origin] : buffer -> view<[%tokens]xi32>
  %listed_count32 = view.load %tiles_view[%c0] : view<[%tokens]xi32> -> i32
  %listed_count = index.cast %listed_count32 : i32 to index
  %listed = index.cmp ult, %tile, %listed_count : index
  %entry_slot_value = index.add %tile, %c1 : index
  %entry_slot = index.assume %entry_slot_value [lt(%entry_slot_value, %tokens)] : index
  %entry32 = view.load %tiles_view[%entry_slot] : view<[%tokens]xi32> -> i32
  %entry = index.cast %entry32 : i32 to index
  %first_token = index.assume %entry [range(%entry, 0, 8191), lt(%entry, %tokens)] : index
  %info_view = buffer.view %info[%origin] : buffer -> view<[%tokens]x4xi32>
  %row32 = view.load %info_view[%first_token, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0_32 = view.load %info_view[%first_token, %c1] : view<[%tokens]x4xi32> -> i32
  scf.if %listed {
  %workitem_id = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem_id [range(%workitem_id, 0, 127)] : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 3)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %lane_col = index.rem %lane, %c16 : index
  %lane_half = index.div %lane, %c16 : index
  %r4_c8 = index.constant 8 : index
  %lane_h8_v = index.mul %lane_half, %r4_c8 : index
  %lane_h8 = index.assume %lane_h8_v [range(%lane_h8_v, 0, 8)] : index
  %hi_half = index.cmp ne, %lane_half, %c0 : index
  %head_in_group = index.div %wave, %c2 : index
  %dim_half = index.rem %wave, %c2 : index
  %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
  %row = index.cast %row_bound : i32 to index
  %pos0_bound = scalar.assume %pos0_32 [range(%pos0_32, 0, 262128)] : i32
  %pos0 = index.cast %pos0_bound : i32 to index
  %pos_last = index.add %pos0, %c15 : index
  %padded = index.add %context, %c15 : index
  %blocks = index.div %padded, %c16 : index
  %k_plane = index.mul %layer, %c2 : index
  %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
  %window = index.constant 1024 : index
  %window_less = index.constant 1023 : index
  %far = index.cmp uge, %pos0, %window : index
  %use_window = scalar.andi %is_sliding, %far : i1
  %window_start = index.sub %pos0, %window_less : index
  %key_low_raw = scf.select %use_window, %window_start, %c0 : index
  // Key tiles start on a 16-key page boundary (one page lookup covers 16 consecutive keys).
  %key_low_page = index.div %key_low_raw, %c16 : index
  %key_low = index.mul %key_low_page, %c16 : index
  %key_span = index.sub %pos_last, %key_low : index
  %key_count_value = index.add %key_span, %c1 : index
  %key_count = index.assume %key_count_value [range(%key_count_value, 1, 262144)] : index
  %ckt_less = index.constant 15 : index
  %ckt = index.constant 16 : index
  %key_tiles_round = index.add %key_count, %ckt_less : index
  %key_tiles = index.div %key_tiles_round, %ckt : index
  %cg = index.constant 2 : index
  %head_value = index.madd %kv, %cg, %head_in_group : index
  %head = index.assume %head_value [range(%head_value, 0, 15)] : index
  %chalf = index.constant 128 : index
  %dim_base = index.mul %dim_half, %chalf : index

  %k_bytes = index.constant 8448 : offset
  %k_tile = buffer.alloca<workgroup> align(16) %k_bytes : buffer
  %k_view = buffer.view %k_tile[%origin] : buffer -> view<16x264xf16>
  %vt_bytes = index.constant 12288 : offset
  %vt_tile = buffer.alloca<workgroup> align(16) %vt_bytes : buffer
  %vt_view = buffer.view %vt_tile[%origin] : buffer -> view<256x24xf16>
  // S^T partials: [wave][key block][16 keys x 16 tokens] f32.
  %s_bytes = index.constant 4096 : offset
  %s_tile = buffer.alloca<workgroup> align(16) %s_bytes : buffer
  %s_view = buffer.view %s_tile[%origin] : buffer -> view<64x16xf32>

  // This wave's half of Q^T as MMA rhs, held for the whole key loop: lane column = token, 16 dims each.
  %q_view = buffer.view %q[%origin] : buffer -> view<[%tokens]x16x256xf32>
  %q_token_value = index.add %first_token, %lane_col : index
  %q_token = index.assume %q_token_value [lt(%q_token_value, %tokens)] : index
  %qd0_o = index.constant 0 : index
  %qd0_v = index.add %dim_base, %qd0_o : index
  %qd0 = index.assume %qd0_v [range(%qd0_v, 0, 240)] : index
  %qdh0_v = index.add %qd0, %lane_h8 : index
  %qdh0 = index.assume %qdh0_v [range(%qdh0_v, 0, 8191)] : index
  %qraw0 = vector.load %q_view[%q_token, %head, %qdh0] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh0 = vector.fptrunc %qraw0 : vector<8xf32> to vector<8xf16>
  %qf0 = vector.fragment<rhs> %qh0 shape [%c16, %c16] : vector<8xf16>
  %qd1_o = index.constant 16 : index
  %qd1_v = index.add %dim_base, %qd1_o : index
  %qd1 = index.assume %qd1_v [range(%qd1_v, 0, 240)] : index
  %qdh1_v = index.add %qd1, %lane_h8 : index
  %qdh1 = index.assume %qdh1_v [range(%qdh1_v, 0, 8191)] : index
  %qraw1 = vector.load %q_view[%q_token, %head, %qdh1] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh1 = vector.fptrunc %qraw1 : vector<8xf32> to vector<8xf16>
  %qf1 = vector.fragment<rhs> %qh1 shape [%c16, %c16] : vector<8xf16>
  %qd2_o = index.constant 32 : index
  %qd2_v = index.add %dim_base, %qd2_o : index
  %qd2 = index.assume %qd2_v [range(%qd2_v, 0, 240)] : index
  %qdh2_v = index.add %qd2, %lane_h8 : index
  %qdh2 = index.assume %qdh2_v [range(%qdh2_v, 0, 8191)] : index
  %qraw2 = vector.load %q_view[%q_token, %head, %qdh2] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh2 = vector.fptrunc %qraw2 : vector<8xf32> to vector<8xf16>
  %qf2 = vector.fragment<rhs> %qh2 shape [%c16, %c16] : vector<8xf16>
  %qd3_o = index.constant 48 : index
  %qd3_v = index.add %dim_base, %qd3_o : index
  %qd3 = index.assume %qd3_v [range(%qd3_v, 0, 240)] : index
  %qdh3_v = index.add %qd3, %lane_h8 : index
  %qdh3 = index.assume %qdh3_v [range(%qdh3_v, 0, 8191)] : index
  %qraw3 = vector.load %q_view[%q_token, %head, %qdh3] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh3 = vector.fptrunc %qraw3 : vector<8xf32> to vector<8xf16>
  %qf3 = vector.fragment<rhs> %qh3 shape [%c16, %c16] : vector<8xf16>
  %qd4_o = index.constant 64 : index
  %qd4_v = index.add %dim_base, %qd4_o : index
  %qd4 = index.assume %qd4_v [range(%qd4_v, 0, 240)] : index
  %qdh4_v = index.add %qd4, %lane_h8 : index
  %qdh4 = index.assume %qdh4_v [range(%qdh4_v, 0, 8191)] : index
  %qraw4 = vector.load %q_view[%q_token, %head, %qdh4] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh4 = vector.fptrunc %qraw4 : vector<8xf32> to vector<8xf16>
  %qf4 = vector.fragment<rhs> %qh4 shape [%c16, %c16] : vector<8xf16>
  %qd5_o = index.constant 80 : index
  %qd5_v = index.add %dim_base, %qd5_o : index
  %qd5 = index.assume %qd5_v [range(%qd5_v, 0, 240)] : index
  %qdh5_v = index.add %qd5, %lane_h8 : index
  %qdh5 = index.assume %qdh5_v [range(%qdh5_v, 0, 8191)] : index
  %qraw5 = vector.load %q_view[%q_token, %head, %qdh5] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh5 = vector.fptrunc %qraw5 : vector<8xf32> to vector<8xf16>
  %qf5 = vector.fragment<rhs> %qh5 shape [%c16, %c16] : vector<8xf16>
  %qd6_o = index.constant 96 : index
  %qd6_v = index.add %dim_base, %qd6_o : index
  %qd6 = index.assume %qd6_v [range(%qd6_v, 0, 240)] : index
  %qdh6_v = index.add %qd6, %lane_h8 : index
  %qdh6 = index.assume %qdh6_v [range(%qdh6_v, 0, 8191)] : index
  %qraw6 = vector.load %q_view[%q_token, %head, %qdh6] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh6 = vector.fptrunc %qraw6 : vector<8xf32> to vector<8xf16>
  %qf6 = vector.fragment<rhs> %qh6 shape [%c16, %c16] : vector<8xf16>
  %qd7_o = index.constant 112 : index
  %qd7_v = index.add %dim_base, %qd7_o : index
  %qd7 = index.assume %qd7_v [range(%qd7_v, 0, 240)] : index
  %qdh7_v = index.add %qd7, %lane_h8 : index
  %qdh7 = index.assume %qdh7_v [range(%qdh7_v, 0, 8191)] : index
  %qraw7 = vector.load %q_view[%q_token, %head, %qdh7] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh7 = vector.fptrunc %qraw7 : vector<8xf32> to vector<8xf16>
  %qf7 = vector.fragment<rhs> %qh7 shape [%c16, %c16] : vector<8xf16>
  %zero8 = vector.splatf 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zero8 shape [%c16, %c16] : vector<8xf32>
  %zero_f = scalar.constant 0.0 : f32
  %neg_big = scalar.constant -3.0e38 : f32
  %scale = scalar.constant 1.0 : f32
  %scale_v = vector.splat %scale : vector<8xf32>
  %neg_v = vector.splat %neg_big : vector<8xf32>
  %exchange = scalar.constant 16 : i32
  %width = scalar.constant 32 : i32
  %two_i32 = scalar.constant 2 : i32
  %cwin_i32 = scalar.constant 1023 : i32
  %true_const = scalar.constant true : i1
  %not_sliding = scalar.xori %is_sliding, %true_const : i1
  %ns_v = vector.splat %not_sliding : vector<8xi1>
  %query_pos = index.add %pos0, %lane_col : index
  %qp32 = index.cast %query_pos : index to i32
  %qp_v = vector.splat %qp32 : vector<8xi32>
  %low32 = scalar.subi %qp32, %cwin_i32 : i32
  %low_v = vector.splat %low32 : vector<8xi32>
  %half32 = index.cast %lane_half : index to i32
  %lane_h8_i32 = index.cast %lane_h8 : index to i32
  %one_row_i32 = scalar.constant 1 : i32
  %row_off = vector.iota %lane_h8_i32 step %one_row_i32 : vector<8xi32>

  // Staging slots: key = workitem % 32, dim segment = workitem / 32 (8 segments of 32 dims).
  %st_key = index.rem %workitem, %c16 : index
  %st_seg_value = index.div %workitem, %c16 : index
  %cseg_n = index.constant 8 : index
  %st_live = index.cmp ult, %st_seg_value, %cseg_n : index
  %cseg_last = index.constant 7 : index
  %st_seg = index.min %st_seg_value, %cseg_last : index
  %cseg_w = index.constant 32 : index
  %st_dim_value = index.mul %st_seg, %cseg_w : index
  %st_dim = index.assume %st_dim_value [range(%st_dim_value, 0, 224)] : index
  %kz = vector.splatf 0.0 : vector<32xf16>
  %plane_bytes_i = index.mul %pool, %c1 : index
  %pos_bytes = index.constant 4096 : offset
  %v_plane_delta = index.scale %plane_bytes_i, %pos_bytes : index, offset -> offset
  // S exchange slots: mine and my partner's (wave ^ 1).
  %my_s = index.mul %wave, %c16 : index
  %partner_odd = index.cmp eq, %dim_half, %c0 : index
  %partner_add = scf.select %partner_odd, %c1, %c0 : index
  %partner_id_value = index.madd %head_in_group, %c2, %partner_add : index
  %partner_id = index.assume %partner_id_value [range(%partner_id_value, 0, 3)] : index
  %their_s = index.mul %partner_id, %c16 : index
  %kb1 = index.constant 16 : index
  %my_s1 = index.add %my_s, %kb1 : index
  %their_s1 = index.add %their_s, %kb1 : index

  %kt_hot = index.sub %key_tiles, %c1 : index
  %m_hot, %l_hot, %o0_hot, %o1_hot, %o2_hot, %o3_hot, %o4_hot, %o5_hot, %o6_hot, %o7_hot = scf.for %kt = [%c0 to %kt_hot step %c1](%m = %neg_big : f32, %l = %zero_f : f32, %a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>, %a4 = %init : vector<8xf32>, %a5 = %init : vector<8xf32>, %a6 = %init : vector<8xf32>, %a7 = %init : vector<8xf32>) -> (f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %tile_first = index.madd %kt, %ckt, %key_low : index
    scf.if %st_live {
      %key_pos = index.add %tile_first, %st_key : index
      %key_valid = index.cmp ule, %key_pos, %pos_last : index
      %kvals, %vvals = scf.if %key_valid -> (vector<32xf16>, vector<32xf16>) {
        %kp = index.assume %key_pos [range(%key_pos, 0, 262143)] : index
        %k_offset = func.call @g_kv_offset(%origins, %row, %kp, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
        %v_offset = index.add %k_offset, %v_plane_delta : offset
        %k_cache = buffer.view %arena[%k_offset] : buffer -> view<8x256xf16>
        %v_cache = buffer.view %arena[%v_offset] : buffer -> view<8x256xf16>
        %kh = vector.load %k_cache[%kv, %st_dim] : view<8x256xf16> -> vector<32xf16>
        %vh = vector.load %v_cache[%kv, %st_dim] : view<8x256xf16> -> vector<32xf16>
        scf.yield %kh, %vh : vector<32xf16>, vector<32xf16>
      } else {
        scf.yield %kz, %kz : vector<32xf16>, vector<32xf16>
      }
      vector.store %kvals, %k_view[%st_key, %st_dim] : vector<32xf16>, view<16x264xf16>
      scf.for %j = [%c0 to %cseg_w step %c1] unroll {
        %vj = vector.extract %vvals[%j] : vector<32xf16> -> f16
        %vt_row_value = index.add %st_dim, %j : index
        %vt_row = index.assume %vt_row_value [range(%vt_row_value, 0, 255)] : index
        view.store %vj, %vt_view[%vt_row, %st_key] : f16, view<256x24xf16>
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %tf32 = index.cast %tile_first : index to i32
    %kc0_0 = index.add %dim_base, %qd0_o : index
    %kl0_0 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_0] shape [%c16, %c16] : view<16x264xf16> -> vector<8xf16>
    %s0_0 = vector.mma %kl0_0, %qf0, %init : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %kc0_1 = index.add %dim_base, %qd1_o : index
    %kl0_1 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_1] shape [%c16, %c16] : view<16x264xf16> -> vector<8xf16>
    %s0_1 = vector.mma %kl0_1, %qf1, %s0_0 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %kc0_2 = index.add %dim_base, %qd2_o : index
    %kl0_2 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_2] shape [%c16, %c16] : view<16x264xf16> -> vector<8xf16>
    %s0_2 = vector.mma %kl0_2, %qf2, %s0_1 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %kc0_3 = index.add %dim_base, %qd3_o : index
    %kl0_3 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_3] shape [%c16, %c16] : view<16x264xf16> -> vector<8xf16>
    %s0_3 = vector.mma %kl0_3, %qf3, %s0_2 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %kc0_4 = index.add %dim_base, %qd4_o : index
    %kl0_4 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_4] shape [%c16, %c16] : view<16x264xf16> -> vector<8xf16>
    %s0_4 = vector.mma %kl0_4, %qf4, %s0_3 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %kc0_5 = index.add %dim_base, %qd5_o : index
    %kl0_5 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_5] shape [%c16, %c16] : view<16x264xf16> -> vector<8xf16>
    %s0_5 = vector.mma %kl0_5, %qf5, %s0_4 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %kc0_6 = index.add %dim_base, %qd6_o : index
    %kl0_6 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_6] shape [%c16, %c16] : view<16x264xf16> -> vector<8xf16>
    %s0_6 = vector.mma %kl0_6, %qf6, %s0_5 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %kc0_7 = index.add %dim_base, %qd7_o : index
    %kl0_7 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_7] shape [%c16, %c16] : view<16x264xf16> -> vector<8xf16>
    %s0_7 = vector.mma %kl0_7, %qf7, %s0_6 : vector<8xf16>, vector<8xf16>, vector<8xf32>
