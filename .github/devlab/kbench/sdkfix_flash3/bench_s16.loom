        %isc2_0 = scalar.cmpi eq, %lane_col32m, %mci2_0 : i32
        %vl2_0 = vector.fragment.load<lhs> %vt_view[%vr2, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
        %vs2_0 = vector.select %m2_0, %vl2_0, %zero16h : vector<8xf16>
