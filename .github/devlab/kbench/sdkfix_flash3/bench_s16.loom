        %vm1_0 = vector.fragment<lhs> %vs1_0 shape [%c16, %c16] : vector<8xf16>
        %rm1_0 = vector.mma %vm1_0, %pt0, %os1 : vector<8xf16>, vector<8xf16>, vector<8xf32>
        %acn1_0 = scf.select %isc1_0, %rm1_0, %acc1_0 : vector<8xf32>
