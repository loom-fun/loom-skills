    %nb_live0 = scalar.xori %nb_dead0, %true_const : i1
    %nb_diag_live0 = scalar.andi %nb_diag0, %nb_live0 : i1
    %nb_edge0 = scalar.andi %nb_wins0, %nb_live0 : i1
    %need0 = scalar.constant false : i1
    %on0, %on1, %on2, %on3, %on4, %on5, %on6, %on7 = scf.if %need0 -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
      %ac0_0 = scf.for %mc_0_0 = [%c0 to %c16 step %c1](%acc0_0 = %os0 : vector<8xf32>) -> (vector<8xf32>) {
        %mci0_0 = index.cast %mc_0_0 : index to i32
