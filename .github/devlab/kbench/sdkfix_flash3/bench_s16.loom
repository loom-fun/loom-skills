        %vl5_0_pt = vector.fragment.load<lhs> %vt_view[%vr5_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
        %vs5_0_pt = vector.select %m5_0_pt, %vl5_0_pt, %zero16h_pt : vector<8xf16>
        %vm5_0_pt = vector.fragment<lhs> %vs5_0_pt shape [%c16, %c16] : vector<8xf16>
        %rm5_0_pt = vector.mma %vm5_0_pt, %pt0_pt, %os5_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
        %acn5_0_pt = scf.select %isc5_0_pt, %rm5_0_pt, %acc5_0_pt : vector<8xf32>
        scf.yield %acn5_0_pt : vector<8xf32>
      }
      %ac6_0_pt = scf.for %mc_6_0_pt = [%c0 to %c16 step %c1](%acc6_0_pt = %os6_pt : vector<8xf32>) -> (vector<8xf32>) {
        %mci6_0_pt = index.cast %mc_6_0_pt : index to i32
        %qc6_0_pt = scalar.addi %pos0_i32_pt, %mci6_0_pt : i32
        %thr6_0_pt = scalar.subi %qc6_0_pt, %base0_pt : i32
        %thr_v6_0_pt = vector.splat %thr6_0_pt : vector<8xi32>
        %mhi6_0_pt = vector.cmpi sle, %iota16_pt, %thr_v6_0_pt : vector<8xi32> -> vector<8xi1>
        %lo6_0_pt = scalar.subi %thr6_0_pt, %cwin_i32 : i32
        %loe6_0_pt = scf.select %is_sliding, %lo6_0_pt, %far_below : i32
        %lo_v6_0_pt = vector.splat %loe6_0_pt : vector<8xi32>
        %mlo6_0_pt = vector.cmpi sge, %iota16_pt, %lo_v6_0_pt : vector<8xi32> -> vector<8xi1>
        %m6_0_pt = vector.andi %mhi6_0_pt, %mlo6_0_pt : vector<8xi1>
        %isc6_0_pt = scalar.cmpi eq, %lane_col32m_pt, %mci6_0_pt : i32
        %vl6_0_pt = vector.fragment.load<lhs> %vt_view[%vr6_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
        %vs6_0_pt = vector.select %m6_0_pt, %vl6_0_pt, %zero16h_pt : vector<8xf16>
        %vm6_0_pt = vector.fragment<lhs> %vs6_0_pt shape [%c16, %c16] : vector<8xf16>
        %rm6_0_pt = vector.mma %vm6_0_pt, %pt0_pt, %os6_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
        %acn6_0_pt = scf.select %isc6_0_pt, %rm6_0_pt, %acc6_0_pt : vector<8xf32>
        scf.yield %acn6_0_pt : vector<8xf32>
      }
      %ac7_0_pt = scf.for %mc_7_0_pt = [%c0 to %c16 step %c1](%acc7_0_pt = %os7_pt : vector<8xf32>) -> (vector<8xf32>) {
        %mci7_0_pt = index.cast %mc_7_0_pt : index to i32
        %qc7_0_pt = scalar.addi %pos0_i32_pt, %mci7_0_pt : i32
        %thr7_0_pt = scalar.subi %qc7_0_pt, %base0_pt : i32
        %thr_v7_0_pt = vector.splat %thr7_0_pt : vector<8xi32>
        %mhi7_0_pt = vector.cmpi sle, %iota16_pt, %thr_v7_0_pt : vector<8xi32> -> vector<8xi1>
        %lo7_0_pt = scalar.subi %thr7_0_pt, %cwin_i32 : i32
        %loe7_0_pt = scf.select %is_sliding, %lo7_0_pt, %far_below : i32
        %lo_v7_0_pt = vector.splat %loe7_0_pt : vector<8xi32>
        %mlo7_0_pt = vector.cmpi sge, %iota16_pt, %lo_v7_0_pt : vector<8xi32> -> vector<8xi1>
        %m7_0_pt = vector.andi %mhi7_0_pt, %mlo7_0_pt : vector<8xi1>
        %isc7_0_pt = scalar.cmpi eq, %lane_col32m_pt, %mci7_0_pt : i32
        %vl7_0_pt = vector.fragment.load<lhs> %vt_view[%vr7_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
        %vs7_0_pt = vector.select %m7_0_pt, %vl7_0_pt, %zero16h_pt : vector<8xf16>
        %vm7_0_pt = vector.fragment<lhs> %vs7_0_pt shape [%c16, %c16] : vector<8xf16>
        %rm7_0_pt = vector.mma %vm7_0_pt, %pt0_pt, %os7_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
        %acn7_0_pt = scf.select %isc7_0_pt, %rm7_0_pt, %acc7_0_pt : vector<8xf32>
        scf.yield %acn7_0_pt : vector<8xf32>
      }
      scf.yield %ac0_0_pt, %ac1_0_pt, %ac2_0_pt, %ac3_0_pt, %ac4_0_pt, %ac5_0_pt, %ac6_0_pt, %ac7_0_pt : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    } else {
      %vl0_0_pt = vector.fragment.load<lhs> %vt_view[%vr0_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
      %pl0_0_pt = vector.mma %vl0_0_pt, %pt0_pt, %os0_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
      %vl1_0_pt = vector.fragment.load<lhs> %vt_view[%vr1_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
      %pl1_0_pt = vector.mma %vl1_0_pt, %pt0_pt, %os1_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
      %vl2_0_pt = vector.fragment.load<lhs> %vt_view[%vr2_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
      %pl2_0_pt = vector.mma %vl2_0_pt, %pt0_pt, %os2_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
      %vl3_0_pt = vector.fragment.load<lhs> %vt_view[%vr3_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
      %pl3_0_pt = vector.mma %vl3_0_pt, %pt0_pt, %os3_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
      %vl4_0_pt = vector.fragment.load<lhs> %vt_view[%vr4_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
      %pl4_0_pt = vector.mma %vl4_0_pt, %pt0_pt, %os4_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
      %vl5_0_pt = vector.fragment.load<lhs> %vt_view[%vr5_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
      %pl5_0_pt = vector.mma %vl5_0_pt, %pt0_pt, %os5_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
      %vl6_0_pt = vector.fragment.load<lhs> %vt_view[%vr6_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
      %pl6_0_pt = vector.mma %vl6_0_pt, %pt0_pt, %os6_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
      %vl7_0_pt = vector.fragment.load<lhs> %vt_view[%vr7_pt, %kb0_row] shape [%c16, %c16] : view<256x24xf16> -> vector<8xf16>
      %pl7_0_pt = vector.mma %vl7_0_pt, %pt0_pt, %os7_pt : vector<8xf16>, vector<8xf16>, vector<8xf32>
      scf.yield %pl0_0_pt, %pl1_0_pt, %pl2_0_pt, %pl3_0_pt, %pl4_0_pt, %pl5_0_pt, %pl6_0_pt, %pl7_0_pt : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // O^T / l, gate, store through a transposed strided view: (dim row, token col) -> out[token, head*D + dim].
  %one_f = scalar.constant 1.0 : f32
  %inv_l = scalar.divf %one_f, %l_new_pt : f32
  %inv_v = vector.splat %inv_l : vector<8xf32>
  %cqd = index.constant 4096 : index
  %out_layout = encoding.layout.strided [%c1, %cqd] : encoding<layout>
  %out_first_a = index.mul %first_token, %cqd : index
  %cdim = index.constant 256 : index
  %head_col = index.mul %head, %cdim : index
  %head_half = index.add %head_col, %dim_base : index
  %out_first = index.add %out_first_a, %head_half : index
  %four = index.constant 4 : offset
  %out_offset = index.scale %out_first, %four : index, offset -> offset
  %out_view = buffer.view %out[%out_offset] : buffer -> view<128x16xf32, %out_layout>
  %ou0 = vector.mulf %on0_pt, %inv_v : vector<8xf32>
  %of0 = vector.addf %ou0, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of0, %out_view[%qd0_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou1 = vector.mulf %on1_pt, %inv_v : vector<8xf32>
  %of1 = vector.addf %ou1, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of1, %out_view[%qd1_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou2 = vector.mulf %on2_pt, %inv_v : vector<8xf32>
  %of2 = vector.addf %ou2, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of2, %out_view[%qd2_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou3 = vector.mulf %on3_pt, %inv_v : vector<8xf32>
  %of3 = vector.addf %ou3, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of3, %out_view[%qd3_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou4 = vector.mulf %on4_pt, %inv_v : vector<8xf32>
  %of4 = vector.addf %ou4, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of4, %out_view[%qd4_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou5 = vector.mulf %on5_pt, %inv_v : vector<8xf32>
  %of5 = vector.addf %ou5, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of5, %out_view[%qd5_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou6 = vector.mulf %on6_pt, %inv_v : vector<8xf32>
  %of6 = vector.addf %ou6, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of6, %out_view[%qd6_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou7 = vector.mulf %on7_pt, %inv_v : vector<8xf32>
  %of7 = vector.addf %ou7, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of7, %out_view[%qd7_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  }
  kernel.return
}

check.case public @k_fa2k_case {
  %t = check.literal value(1024) : index
  %layer = check.literal value(0) : index
  %sliding = check.literal value(1) : i32
  %ctx = check.literal value(2048) : index
  %pool = check.literal value(2048) : index
  %q = check.generate.fill value(0.02) : tensor<1024x4096xf32>
  %g = check.generate.fill value(4.0) : tensor<1024x4096xf32>
  %info = check.file.read.npy path("f2k_info.npy") : tensor<1024x4xi32>
  %tiles = check.file.read.npy path("f2k_tiles.npy") : tensor<1024xi32>
  %orig = check.file.read.npy path("f2k_orig.npy") : tensor<138xi32>
  %arena = check.generate.fill value(0.01) : tensor<8388608xf16>
  %o = check.generate.fill value(0.0) : tensor<1024x4096xf32>
  kernel.launch @k_fa2k[%t](%t, %layer, %sliding, %ctx, %pool, %q, %g, %info, %tiles, %orig, %arena, %o) : [index](index, index, i32, index, index, tensor<1024x4096xf32>, tensor<1024x4096xf32>, tensor<1024x4xi32>, tensor<1024xi32>, tensor<138xi32>, tensor<8388608xf16>, tensor<1024x4096xf32>)
  check.return
}
check.benchmark<@k_fa2k_case> @k_fa2k_bm

kernel.def target(@rdna4) export("k_fa8k") @k_fa8k(%tokens: index) {
  %c1 = index.constant 1 : index
  %ckv = index.constant 8 : index
  %c16 = index.constant 16 : index
  %clanes = index.constant 128 : index
  %tiles = index.div %tokens, %c16 : index
  kernel.launch.config workgroups(%tiles, %ckv, %c1) workgroup_size(%clanes, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %sliding: i32, %context_arg: index, %pool_arg: index, %q: buffer, %gate: buffer, %info: buffer, %tiles: buffer, %origins: buffer, %arena: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 16, 8192), multiple_of(%tokens_arg, 16)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 47)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 262144)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 2147483584)] : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c0_i32 = scalar.constant 0 : i32
  %e0 = index.constant 0 : index
  %e1 = index.constant 1 : index
  %e2 = index.constant 2 : index
  %e3 = index.constant 3 : index
  %e4 = index.constant 4 : index
  %e5 = index.constant 5 : index
  %e6 = index.constant 6 : index
  %e7 = index.constant 7 : index
  %kb0_row = index.constant 0 : index
  %kbo0 = scalar.constant 0 : i32
  %c15_i32m = scalar.constant 15 : i32
  %c1_i32m = scalar.constant 1 : i32
  %far_below = scalar.constant -1000000 : i32
  %tile_count = index.div %tokens, %c16 : index
  %tile_id = kernel.workgroup.id<x> : index
  %tile = index.assume %tile_id [lt(%tile_id, %tile_count)] : index
  %kv_id = kernel.workgroup.id<y> : index
  %kv = index.assume %kv_id [range(%kv_id, 0, 7)] : index
  %tiles_view = buffer.view %tiles[%origin] : buffer -> view<[%tokens]xi32>
  %listed_count32 = view.load %tiles_view[%c0] : view<[%tokens]xi32> -> i32
  %listed_count = index.cast %listed_count32 : i32 to index
  %listed = index.cmp ult, %tile, %listed_count : index
  %entry_slot_value = index.add %tile, %c1 : index
  %entry_slot = index.assume %entry_slot_value [lt(%entry_slot_value, %tokens)] : index
  %entry32 = view.load %tiles_view[%entry_slot] : view<[%tokens]xi32> -> i32
  %entry = index.cast %entry32 : i32 to index
  %first_token = index.assume %entry [range(%entry, 0, 8191), lt(%entry, %tokens)] : index
  %info_view = buffer.view %info[%origin] : buffer -> view<[%tokens]x4xi32>
  %row32 = view.load %info_view[%first_token, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0_32 = view.load %info_view[%first_token, %c1] : view<[%tokens]x4xi32> -> i32
  scf.if %listed {
  %workitem_id = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem_id [range(%workitem_id, 0, 127)] : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 3)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %lane_col = index.rem %lane, %c16 : index
  %lane_half = index.div %lane, %c16 : index
  %r4_c8 = index.constant 8 : index
  %lane_h8_v = index.mul %lane_half, %r4_c8 : index
  %lane_h8 = index.assume %lane_h8_v [range(%lane_h8_v, 0, 8)] : index
  %hi_half = index.cmp ne, %lane_half, %c0 : index
  %head_in_group = index.div %wave, %c2 : index
  %dim_half = index.rem %wave, %c2 : index
  %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
  %row = index.cast %row_bound : i32 to index
  %pos0_bound = scalar.assume %pos0_32 [range(%pos0_32, 0, 262128)] : i32
  %pos0 = index.cast %pos0_bound : i32 to index
  %pos_last = index.add %pos0, %c15 : index
  %padded = index.add %context, %c15 : index
  %blocks = index.div %padded, %c16 : index
  %k_plane = index.mul %layer, %c2 : index
  %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
  %window = index.constant 1024 : index
  %window_less = index.constant 1023 : index
  %far = index.cmp uge, %pos0, %window : index
  %use_window = scalar.andi %is_sliding, %far : i1
  %window_start = index.sub %pos0, %window_less : index
  %key_low_raw = scf.select %use_window, %window_start, %c0 : index
  // Key tiles start on a 16-key page boundary (one page lookup covers 16 consecutive keys).
  %key_low_page = index.div %key_low_raw, %c16 : index
  %key_low = index.mul %key_low_page, %c16 : index
  %key_span = index.sub %pos_last, %key_low : index
  %key_count_value = index.add %key_span, %c1 : index
  %key_count = index.assume %key_count_value [range(%key_count_value, 1, 262144)] : index
  %ckt_less = index.constant 15 : index
  %ckt = index.constant 16 : index
  %key_tiles_round = index.add %key_count, %ckt_less : index
  %key_tiles = index.div %key_tiles_round, %ckt : index
  %cg = index.constant 2 : index
  %head_value = index.madd %kv, %cg, %head_in_group : index
  %head = index.assume %head_value [range(%head_value, 0, 15)] : index
  %chalf = index.constant 128 : index
  %dim_base = index.mul %dim_half, %chalf : index

  %k_bytes = index.constant 8448 : offset
  %k_tile = buffer.alloca<workgroup> align(16) %k_bytes : buffer
  %k_view = buffer.view %k_tile[%origin] : buffer -> view<16x264xf16>
  %vt_bytes = index.constant 12288 : offset
  %vt_tile = buffer.alloca<workgroup> align(16) %vt_bytes : buffer
  %vt_view = buffer.view %vt_tile[%origin] : buffer -> view<256x24xf16>
  // S^T partials: [wave][key block][16 keys x 16 tokens] f32.
  %s_bytes = index.constant 4096 : offset
  %s_tile = buffer.alloca<workgroup> align(16) %s_bytes : buffer
  %s_view = buffer.view %s_tile[%origin] : buffer -> view<64x16xf32>

  // This wave's half of Q^T as MMA rhs, held for the whole key loop: lane column = token, 16 dims each.
  %q_view = buffer.view %q[%origin] : buffer -> view<[%tokens]x16x256xf32>
  %q_token_value = index.add %first_token, %lane_col : index
  %q_token = index.assume %q_token_value [lt(%q_token_value, %tokens)] : index
  %qd0_o = index.constant 0 : index
  %qd0_v = index.add %dim_base, %qd0_o : index
  %qd0 = index.assume %qd0_v [range(%qd0_v, 0, 240)] : index
  %qdh0_v = index.add %qd0, %lane_h8 : index
  %qdh0 = index.assume %qdh0_v [range(%qdh0_v, 0, 8191)] : index
  %qraw0 = vector.load %q_view[%q_token, %head, %qdh0] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh0 = vector.fptrunc %qraw0 : vector<8xf32> to vector<8xf16>
  %qf0 = vector.fragment<rhs> %qh0 shape [%c16, %c16] : vector<8xf16>
  %qd1_o = index.constant 16 : index
  %qd1_v = index.add %dim_base, %qd1_o : index
  %qd1 = index.assume %qd1_v [range(%qd1_v, 0, 240)] : index
  %qdh1_v = index.add %qd1, %lane_h8 : index
  %qdh1 = index.assume %qdh1_v [range(%qdh1_v, 0, 8191)] : index
  %qraw1 = vector.load %q_view[%q_token, %head, %qdh1] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh1 = vector.fptrunc %qraw1 : vector<8xf32> to vector<8xf16>
  %qf1 = vector.fragment<rhs> %qh1 shape [%c16, %c16] : vector<8xf16>
  %qd2_o = index.constant 32 : index
  %qd2_v = index.add %dim_base, %qd2_o : index
  %qd2 = index.assume %qd2_v [range(%qd2_v, 0, 240)] : index
  %qdh2_v = index.add %qd2, %lane_h8 : index
  %qdh2 = index.assume %qdh2_v [range(%qdh2_v, 0, 8191)] : index
  %qraw2 = vector.load %q_view[%q_token, %head, %qdh2] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh2 = vector.fptrunc %qraw2 : vector<8xf32> to vector<8xf16>
  %qf2 = vector.fragment<rhs> %qh2 shape [%c16, %c16] : vector<8xf16>
  %qd3_o = index.constant 48 : index
  %qd3_v = index.add %dim_base, %qd3_o : index
  %qd3 = index.assume %qd3_v [range(%qd3_v, 0, 240)] : index
  %qdh3_v = index.add %qd3, %lane_h8 : index
  %qdh3 = index.assume %qdh3_v [range(%qdh3_v, 0, 8191)] : index
  %qraw3 = vector.load %q_view[%q_token, %head, %qdh3] : view<[%tokens]x16x256xf32> -> vector<8xf32>
  %qh3 = vector.fptrunc %qraw3 : vector<8xf32> to vector<8xf16>
  %qf3 = vector.fragment<rhs> %qh3 shape [%c16, %c16] : vector<8xf16>
  %qd4_o = index.constant 64 : index
