        %lo_v4_0_pt = vector.splat %loe4_0_pt : vector<16xi32>
        %mlo4_0_pt = vector.cmpi sge, %iota16_pt, %lo_v4_0_pt : vector<16xi32> -> vector<16xi1>
        %m4_0_pt = vector.andi %mhi4_0_pt, %mlo4_0_pt : vector<16xi1>
        %isc4_0_pt = scalar.cmpi eq, %lane_col32m_pt, %mci4_0_pt : i32
        %vl4_0_pt = vector.fragment.load<lhs> %vt_view[%vr4_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
        %vs4_0_pt = vector.select %m4_0_pt, %vl4_0_pt, %zero16h_pt : vector<16xf16>
        %vm4_0_pt = vector.fragment<lhs> %vs4_0_pt shape [%c16, %c16] : vector<16xf16>
        %rm4_0_pt = vector.mma %vm4_0_pt, %pt0_pt, %os4_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %acn4_0_pt = scf.select %isc4_0_pt, %rm4_0_pt, %acc4_0_pt : vector<8xf32>
        scf.yield %acn4_0_pt : vector<8xf32>
      }
      %ac5_0_pt = scf.for %mc_5_0_pt = [%c0 to %c16 step %c1](%acc5_0_pt = %os5_pt : vector<8xf32>) -> (vector<8xf32>) {
        %mci5_0_pt = index.cast %mc_5_0_pt : index to i32
        %qc5_0_pt = scalar.addi %pos0_i32_pt, %mci5_0_pt : i32
        %thr5_0_pt = scalar.subi %qc5_0_pt, %base0_pt : i32
        %thr_v5_0_pt = vector.splat %thr5_0_pt : vector<16xi32>
        %mhi5_0_pt = vector.cmpi sle, %iota16_pt, %thr_v5_0_pt : vector<16xi32> -> vector<16xi1>
        %lo5_0_pt = scalar.subi %thr5_0_pt, %cwin_i32 : i32
        %loe5_0_pt = scf.select %is_sliding, %lo5_0_pt, %far_below : i32
        %lo_v5_0_pt = vector.splat %loe5_0_pt : vector<16xi32>
        %mlo5_0_pt = vector.cmpi sge, %iota16_pt, %lo_v5_0_pt : vector<16xi32> -> vector<16xi1>
        %m5_0_pt = vector.andi %mhi5_0_pt, %mlo5_0_pt : vector<16xi1>
        %isc5_0_pt = scalar.cmpi eq, %lane_col32m_pt, %mci5_0_pt : i32
        %vl5_0_pt = vector.fragment.load<lhs> %vt_view[%vr5_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
        %vs5_0_pt = vector.select %m5_0_pt, %vl5_0_pt, %zero16h_pt : vector<16xf16>
        %vm5_0_pt = vector.fragment<lhs> %vs5_0_pt shape [%c16, %c16] : vector<16xf16>
        %rm5_0_pt = vector.mma %vm5_0_pt, %pt0_pt, %os5_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %acn5_0_pt = scf.select %isc5_0_pt, %rm5_0_pt, %acc5_0_pt : vector<8xf32>
        scf.yield %acn5_0_pt : vector<8xf32>
      }
      %ac6_0_pt = scf.for %mc_6_0_pt = [%c0 to %c16 step %c1](%acc6_0_pt = %os6_pt : vector<8xf32>) -> (vector<8xf32>) {
        %mci6_0_pt = index.cast %mc_6_0_pt : index to i32
        %qc6_0_pt = scalar.addi %pos0_i32_pt, %mci6_0_pt : i32
        %thr6_0_pt = scalar.subi %qc6_0_pt, %base0_pt : i32
        %thr_v6_0_pt = vector.splat %thr6_0_pt : vector<16xi32>
        %mhi6_0_pt = vector.cmpi sle, %iota16_pt, %thr_v6_0_pt : vector<16xi32> -> vector<16xi1>
        %lo6_0_pt = scalar.subi %thr6_0_pt, %cwin_i32 : i32
        %loe6_0_pt = scf.select %is_sliding, %lo6_0_pt, %far_below : i32
        %lo_v6_0_pt = vector.splat %loe6_0_pt : vector<16xi32>
        %mlo6_0_pt = vector.cmpi sge, %iota16_pt, %lo_v6_0_pt : vector<16xi32> -> vector<16xi1>
        %m6_0_pt = vector.andi %mhi6_0_pt, %mlo6_0_pt : vector<16xi1>
        %isc6_0_pt = scalar.cmpi eq, %lane_col32m_pt, %mci6_0_pt : i32
        %vl6_0_pt = vector.fragment.load<lhs> %vt_view[%vr6_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
        %vs6_0_pt = vector.select %m6_0_pt, %vl6_0_pt, %zero16h_pt : vector<16xf16>
        %vm6_0_pt = vector.fragment<lhs> %vs6_0_pt shape [%c16, %c16] : vector<16xf16>
        %rm6_0_pt = vector.mma %vm6_0_pt, %pt0_pt, %os6_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %acn6_0_pt = scf.select %isc6_0_pt, %rm6_0_pt, %acc6_0_pt : vector<8xf32>
        scf.yield %acn6_0_pt : vector<8xf32>
      }
      %ac7_0_pt = scf.for %mc_7_0_pt = [%c0 to %c16 step %c1](%acc7_0_pt = %os7_pt : vector<8xf32>) -> (vector<8xf32>) {
        %mci7_0_pt = index.cast %mc_7_0_pt : index to i32
        %qc7_0_pt = scalar.addi %pos0_i32_pt, %mci7_0_pt : i32
        %thr7_0_pt = scalar.subi %qc7_0_pt, %base0_pt : i32
        %thr_v7_0_pt = vector.splat %thr7_0_pt : vector<16xi32>
        %mhi7_0_pt = vector.cmpi sle, %iota16_pt, %thr_v7_0_pt : vector<16xi32> -> vector<16xi1>
        %lo7_0_pt = scalar.subi %thr7_0_pt, %cwin_i32 : i32
        %loe7_0_pt = scf.select %is_sliding, %lo7_0_pt, %far_below : i32
        %lo_v7_0_pt = vector.splat %loe7_0_pt : vector<16xi32>
        %mlo7_0_pt = vector.cmpi sge, %iota16_pt, %lo_v7_0_pt : vector<16xi32> -> vector<16xi1>
        %m7_0_pt = vector.andi %mhi7_0_pt, %mlo7_0_pt : vector<16xi1>
        %isc7_0_pt = scalar.cmpi eq, %lane_col32m_pt, %mci7_0_pt : i32
        %vl7_0_pt = vector.fragment.load<lhs> %vt_view[%vr7_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
        %vs7_0_pt = vector.select %m7_0_pt, %vl7_0_pt, %zero16h_pt : vector<16xf16>
        %vm7_0_pt = vector.fragment<lhs> %vs7_0_pt shape [%c16, %c16] : vector<16xf16>
        %rm7_0_pt = vector.mma %vm7_0_pt, %pt0_pt, %os7_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %acn7_0_pt = scf.select %isc7_0_pt, %rm7_0_pt, %acc7_0_pt : vector<8xf32>
        scf.yield %acn7_0_pt : vector<8xf32>
      }
      scf.yield %ac0_0_pt, %ac1_0_pt, %ac2_0_pt, %ac3_0_pt, %ac4_0_pt, %ac5_0_pt, %ac6_0_pt, %ac7_0_pt : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    } else {
      %vl0_0_pt = vector.fragment.load<lhs> %vt_view[%vr0_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
      %pl0_0_pt = vector.mma %vl0_0_pt, %pt0_pt, %os0_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl1_0_pt = vector.fragment.load<lhs> %vt_view[%vr1_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
      %pl1_0_pt = vector.mma %vl1_0_pt, %pt0_pt, %os1_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl2_0_pt = vector.fragment.load<lhs> %vt_view[%vr2_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
      %pl2_0_pt = vector.mma %vl2_0_pt, %pt0_pt, %os2_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl3_0_pt = vector.fragment.load<lhs> %vt_view[%vr3_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
      %pl3_0_pt = vector.mma %vl3_0_pt, %pt0_pt, %os3_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl4_0_pt = vector.fragment.load<lhs> %vt_view[%vr4_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
      %pl4_0_pt = vector.mma %vl4_0_pt, %pt0_pt, %os4_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl5_0_pt = vector.fragment.load<lhs> %vt_view[%vr5_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
      %pl5_0_pt = vector.mma %vl5_0_pt, %pt0_pt, %os5_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl6_0_pt = vector.fragment.load<lhs> %vt_view[%vr6_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
      %pl6_0_pt = vector.mma %vl6_0_pt, %pt0_pt, %os6_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %vl7_0_pt = vector.fragment.load<lhs> %vt_view[%vr7_pt, %kb0_row] shape [%c16, %c16] : view<512x24xf16> -> vector<16xf16>
      %pl7_0_pt = vector.mma %vl7_0_pt, %pt0_pt, %os7_pt : vector<16xf16>, vector<16xf16>, vector<8xf32>
      scf.yield %pl0_0_pt, %pl1_0_pt, %pl2_0_pt, %pl3_0_pt, %pl4_0_pt, %pl5_0_pt, %pl6_0_pt, %pl7_0_pt : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // O^T / l, gate, store through a transposed strided view: (dim row, token col) -> out[token, head*D + dim].
  %one_f = scalar.constant 1.0 : f32
  %inv_l = scalar.divf %one_f, %l_new_pt : f32
  %inv_v = vector.splat %inv_l : vector<8xf32>
  %cqd = index.constant 18432 : index
  %out_layout = encoding.layout.strided [%c1, %cqd] : encoding<layout>
  %out_first_a = index.mul %first_token, %cqd : index
  %cdim = index.constant 576 : index
  %head_col = index.mul %head, %cdim : index
  %head_half = index.add %head_col, %dim_base : index
  %out_first = index.add %out_first_a, %head_half : index
  %four = index.constant 4 : offset
  %out_offset = index.scale %out_first, %four : index, offset -> offset
  %out_view = buffer.view %out[%out_offset] : buffer -> view<128x16xf32, %out_layout>
  %ou0 = vector.mulf %on0_pt, %inv_v : vector<8xf32>
  %of0 = vector.addf %ou0, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of0, %out_view[%qd0_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou1 = vector.mulf %on1_pt, %inv_v : vector<8xf32>
  %of1 = vector.addf %ou1, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of1, %out_view[%qd1_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou2 = vector.mulf %on2_pt, %inv_v : vector<8xf32>
  %of2 = vector.addf %ou2, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of2, %out_view[%qd2_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou3 = vector.mulf %on3_pt, %inv_v : vector<8xf32>
  %of3 = vector.addf %ou3, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of3, %out_view[%qd3_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou4 = vector.mulf %on4_pt, %inv_v : vector<8xf32>
  %of4 = vector.addf %ou4, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of4, %out_view[%qd4_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou5 = vector.mulf %on5_pt, %inv_v : vector<8xf32>
  %of5 = vector.addf %ou5, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of5, %out_view[%qd5_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou6 = vector.mulf %on6_pt, %inv_v : vector<8xf32>
  %of6 = vector.addf %ou6, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of6, %out_view[%qd6_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  %ou7 = vector.mulf %on7_pt, %inv_v : vector<8xf32>
  %of7 = vector.addf %ou7, %zero8 : vector<8xf32>
  vector.fragment.store<result> %of7, %out_view[%qd7_o, %c0] shape [%c16, %c16] : vector<8xf32>, view<128x16xf32, %out_layout>
  }
  kernel.return
}

