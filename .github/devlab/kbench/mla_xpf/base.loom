    %old = view.load %y_view[%bounded_token, %bounded_row] : view<[%tokens]x[%n]xf32> -> f32
    %sum = scalar.addf %old, %value : f32
    scf.yield %sum : f32
  } else {
    scf.yield %value : f32
  }
  view.store %result, %y_view[%bounded_token, %bounded_row] : f32, view<[%tokens]x[%n]xf32>
  func.return
}

