  %groups = index.constant 16 : index
  %tj0c = index.constant 0 : index
  %tj0a = index.add %t0, %tj0c : index
  %tj0b = index.add %tj0a, %col : index
  %tok0 = index.assume %tj0b [lt(%tj0b, %tokens)] : index
  %tj1c = index.constant 16 : index
  %tj1a = index.add %t0, %tj1c : index
  %tj1b = index.add %tj1a, %col : index
  %tok1 = index.assume %tj1b [lt(%tj1b, %tokens)] : index
  %tj2c = index.constant 32 : index
  %tj2a = index.add %t0, %tj2c : index
  %tj2b = index.add %tj2a, %col : index
  %tok2 = index.assume %tj2b [lt(%tj2b, %tokens)] : index
  %tj3c = index.constant 48 : index
  %tj3a = index.add %t0, %tj3c : index
  %tj3b = index.add %tj3a, %col : index
  %tok3 = index.assume %tj3b [lt(%tj3b, %tokens)] : index
  %o0, %o1, %o2, %o3 = scf.for %g = [%c0 to %groups step %c1](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %gb = index.assume %g [range(%g, 0, 15)] : index
    %blk = index.div %gb, %cgpb : index
    %within = index.rem %gb, %cgpb : index
    %ba = index.scale %blk, %block_bytes : index, offset -> offset
    %origin = index.add %ro, %ba : offset
    %wv = func.call @g_iq4_xs_values(%w, %origin, %within) : (buffer, offset, index) -> (vector<32xf32>)
    %wlo = vector.slice %wv[0] : vector<32xf32> -> vector<16xf32>
    %whi = vector.slice %wv[16] : vector<32xf32> -> vector<16xf32>
    %wlo_h = vector.fptrunc %wlo : vector<16xf32> to vector<16xf16>
    %whi_h = vector.fptrunc %whi : vector<16xf32> to vector<16xf16>
    %b0 = vector.fragment<rhs> %wlo_h shape [%c16, %c16] : vector<16xf16>
    %b1 = vector.fragment<rhs> %whi_h shape [%c16, %c16] : vector<16xf16>
    %k0 = index.mul %gb, %c2 : index
    %k1 = index.add %k0, %c1 : index
    %x0_0 = vector.load %x_view[%tok0, %head, %k0, %c0] : view<[%tokens]x32x36x16xf32> -> vector<16xf32>
    %xh0_0 = vector.fptrunc %x0_0 : vector<16xf32> to vector<16xf16>
    %af0_0 = vector.fragment<lhs> %xh0_0 shape [%c16, %c16] : vector<16xf16>
    %x0_1 = vector.load %x_view[%tok0, %head, %k1, %c0] : view<[%tokens]x32x36x16xf32> -> vector<16xf32>
    %xh0_1 = vector.fptrunc %x0_1 : vector<16xf32> to vector<16xf16>
    %af0_1 = vector.fragment<lhs> %xh0_1 shape [%c16, %c16] : vector<16xf16>
    %m0_0 = vector.mma %af0_0, %b0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %m0_1 = vector.mma %af0_1, %b1, %m0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %x1_0 = vector.load %x_view[%tok1, %head, %k0, %c0] : view<[%tokens]x32x36x16xf32> -> vector<16xf32>
    %xh1_0 = vector.fptrunc %x1_0 : vector<16xf32> to vector<16xf16>
    %af1_0 = vector.fragment<lhs> %xh1_0 shape [%c16, %c16] : vector<16xf16>
    %x1_1 = vector.load %x_view[%tok1, %head, %k1, %c0] : view<[%tokens]x32x36x16xf32> -> vector<16xf32>
    %xh1_1 = vector.fptrunc %x1_1 : vector<16xf32> to vector<16xf16>
    %af1_1 = vector.fragment<lhs> %xh1_1 shape [%c16, %c16] : vector<16xf16>
    %m1_0 = vector.mma %af1_0, %b0, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %m1_1 = vector.mma %af1_1, %b1, %m1_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %x2_0 = vector.load %x_view[%tok2, %head, %k0, %c0] : view<[%tokens]x32x36x16xf32> -> vector<16xf32>
    %xh2_0 = vector.fptrunc %x2_0 : vector<16xf32> to vector<16xf16>
    %af2_0 = vector.fragment<lhs> %xh2_0 shape [%c16, %c16] : vector<16xf16>
    %x2_1 = vector.load %x_view[%tok2, %head, %k1, %c0] : view<[%tokens]x32x36x16xf32> -> vector<16xf32>
    %xh2_1 = vector.fptrunc %x2_1 : vector<16xf32> to vector<16xf16>
    %af2_1 = vector.fragment<lhs> %xh2_1 shape [%c16, %c16] : vector<16xf16>
    %m2_0 = vector.mma %af2_0, %b0, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %m2_1 = vector.mma %af2_1, %b1, %m2_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %x3_0 = vector.load %x_view[%tok3, %head, %k0, %c0] : view<[%tokens]x32x36x16xf32> -> vector<16xf32>
    %xh3_0 = vector.fptrunc %x3_0 : vector<16xf32> to vector<16xf16>
    %af3_0 = vector.fragment<lhs> %xh3_0 shape [%c16, %c16] : vector<16xf16>
    %x3_1 = vector.load %x_view[%tok3, %head, %k1, %c0] : view<[%tokens]x32x36x16xf32> -> vector<16xf32>
    %xh3_1 = vector.fptrunc %x3_1 : vector<16xf32> to vector<16xf16>
    %af3_1 = vector.fragment<lhs> %xh3_1 shape [%c16, %c16] : vector<16xf16>
    %m3_0 = vector.mma %af3_0, %b0, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %m3_1 = vector.mma %af3_1, %b1, %m3_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %m0_1, %m1_1, %m2_1, %m3_1 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %cyt = index.constant 4096 : index
  %y_layout = encoding.layout.strided [%cyt, %c1] : encoding<layout>
  %cyh = index.constant 128 : index
  %four = index.constant 4 : offset
  %hcol = index.mul %head, %cyh : index
  %hr0 = index.add %hcol, %r0 : index
  %yt0 = index.mul %tj0a, %cyt : index
  %ye0 = index.add %yt0, %hr0 : index
  %yo0 = index.scale %ye0, %four : index, offset -> offset
  %yv0 = buffer.view %y[%yo0] : buffer -> view<16x16xf32, %y_layout>
  vector.fragment.store<result> %o0, %yv0[%c0, %c0] shape [%c16, %c16] : vector<8xf32>, view<16x16xf32, %y_layout>
  %yt1 = index.mul %tj1a, %cyt : index
  %ye1 = index.add %yt1, %hr0 : index
  %yo1 = index.scale %ye1, %four : index, offset -> offset
  %yv1 = buffer.view %y[%yo1] : buffer -> view<16x16xf32, %y_layout>
  vector.fragment.store<result> %o1, %yv1[%c0, %c0] shape [%c16, %c16] : vector<8xf32>, view<16x16xf32, %y_layout>
  %yt2 = index.mul %tj2a, %cyt : index
  %ye2 = index.add %yt2, %hr0 : index
  %yo2 = index.scale %ye2, %four : index, offset -> offset
  %yv2 = buffer.view %y[%yo2] : buffer -> view<16x16xf32, %y_layout>
  vector.fragment.store<result> %o2, %yv2[%c0, %c0] shape [%c16, %c16] : vector<8xf32>, view<16x16xf32, %y_layout>
  %yt3 = index.mul %tj3a, %cyt : index
  %ye3 = index.add %yt3, %hr0 : index
  %yo3 = index.scale %ye3, %four : index, offset -> offset
  %yv3 = buffer.view %y[%yo3] : buffer -> view<16x16xf32, %y_layout>
  vector.fragment.store<result> %o3, %yv3[%c0, %c0] shape [%c16, %c16] : vector<8xf32>, view<16x16xf32, %y_layout>
  kernel.return
}


// Whether a 16-token tile is uniform (live, one row, consecutive positions): flash2 handles those.
func.def inline @g_tile_uniform(%info: buffer, %tokens: index, %first: index) -> (i1, i32, i32) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c0_i32 = scalar.constant 0 : i32
  %true = scalar.constant true : i1
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %bfirst = index.assume %first [lt(%first, %tokens)] : index
  %row0 = view.load %info_view[%bfirst, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%bfirst, %c1] : view<[%tokens]x4xi32> -> i32
  %ok = scf.for %i = [%c0 to %c16 step %c1](%acc = %true : i1) -> (i1) {
    %t_value = index.add %first, %i : index
    %in_range = index.cmp ult, %t_value, %tokens : index
    %t_clamped = scf.select %in_range, %t_value, %bfirst : index
    %t = index.assume %t_clamped [lt(%t_clamped, %tokens)] : index
    %row = view.load %info_view[%t, %c0] : view<[%tokens]x4xi32> -> i32
    %pos = view.load %info_view[%t, %c1] : view<[%tokens]x4xi32> -> i32
    %c2 = index.constant 2 : index
    %live = view.load %info_view[%t, %c2] : view<[%tokens]x4xi32> -> i32
    %i32v = index.cast %i : index to i32
    %expected = scalar.addi %pos0, %i32v : i32
    %same_row = scalar.cmpi eq, %row, %row0 : i32
    %consecutive = scalar.cmpi eq, %pos, %expected : i32
    %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
    %a = scalar.andi %same_row, %consecutive : i1
    %b = scalar.andi %a, %is_live : i1
    %c = scalar.andi %b, %in_range : i1
    %next = scalar.andi %acc, %c : i1
    scf.yield %next : i1
  }
  func.return %ok, %row0, %pos0 : i1, i32, i32
}

// Whether the 16-token tile after (BACK false) or before (BACK true) the uniform tile at FIRST is uniform too and
// continues it: the same row, positions 16 higher / lower.
func.def inline @g_tile_adjacent(%info: buffer, %tokens: index, %first: index, %back: i1) -> (i1) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c16_i32 = scalar.constant 16 : i32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %bfirst = index.assume %first [range(%first, 0, 8191), lt(%first, %tokens)] : index
  %row0 = view.load %info_view[%bfirst, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%bfirst, %c1] : view<[%tokens]x4xi32> -> i32
  %room = index.cmp uge, %first, %c16 : index
  %back_step = scf.select %room, %c16, %c0 : index
  %prev = index.sub %first, %back_step : index
  %next = index.add %first, %c16 : index
  %other = scf.select %back, %prev, %next : index
  %in_range = index.cmp ult, %other, %tokens : index
  %other_clamped = scf.select %in_range, %other, %bfirst : index
  %other_bound = index.assume %other_clamped [range(%other_clamped, 0, 8191), lt(%other_clamped, %tokens)] : index
  %uniform, %row, %pos = func.call @g_tile_uniform(%info, %tokens, %other_bound) : (buffer, index, index) -> (i1, i32, i32)
  %pos_before = scalar.subi %pos0, %c16_i32 : i32
  %pos_after = scalar.addi %pos0, %c16_i32 : i32
  %pos_want = scf.select %back, %pos_before, %pos_after : i32
  %same_row = scalar.cmpi eq, %row, %row0 : i32
  %next_pos = scalar.cmpi eq, %pos, %pos_want : i32
  %a = scalar.andi %uniform, %in_range : i1
  %b = scalar.andi %a, %same_row : i1
  %ok = scalar.andi %b, %next_pos : i1
  func.return %ok : i1
}

// Whether the uniform tile at TOKEN starts at a position multiple of 16 (flash2 computes those; see
// g_attention_fallback_list).
func.def inline @g_tile_starts(%info: buffer, %tokens: index, %token: index) -> (i1) {
  %zero = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c15_i32 = scalar.constant 15 : i32
  %false = scalar.constant false : i1
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %bounded = index.assume %token [range(%token, 0, 8191), lt(%token, %tokens)] : index
  %pos = view.load %info_view[%bounded, %c1] : view<[%tokens]x4xi32> -> i32
  %skew = scalar.andi %pos, %c15_i32 : i32
  %aligned = scalar.cmpi eq, %skew, %c0_i32 : i32
  %starts = scf.if %aligned -> (i1) {
    %uniform, %row, %pos0 = func.call @g_tile_uniform(%info, %tokens, %bounded) : (buffer, index, index) -> (i1, i32, i32)
    scf.yield %uniform : i1
  } else {
    scf.yield %false : i1
  }
  func.return %starts : i1
}

// Whether TOKEN belongs to a run of at least 9 tokens (one row, consecutive positions, live): the tokens of a prefill
// span, however it was cut. Decode and verify spans are at most 8 tokens (draft depth <= 7) and stay on the split-K
// fallback, so a token's attention path depends on its run, never on where the epoch or the scheduler cut it.
func.def inline @g_run_qualifies(%info: buffer, %tokens: index, %token: index) -> (i1) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c9 = index.constant 9 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c9_i32 = scalar.constant 9 : i32
  %true = scalar.constant true : i1
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %btoken = index.assume %token [lt(%token, %tokens)] : index
  %row0 = view.load %info_view[%btoken, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%btoken, %c1] : view<[%tokens]x4xi32> -> i32
  %live0 = view.load %info_view[%btoken, %c2] : view<[%tokens]x4xi32> -> i32
  %is_live0 = scalar.cmpi ne, %live0, %c0_i32 : i32
  %alive_l, %left = scf.for %k = [%c1 to %c9 step %c1](%alive = %is_live0 : i1, %n = %c0_i32 : i32) -> (i1, i32) {
    %room = index.cmp ule, %k, %token : index
    %back = index.sub %token, %k : index
    %at_value = scf.select %room, %back, %btoken : index
    %at = index.assume %at_value [lt(%at_value, %tokens)] : index
    %row = view.load %info_view[%at, %c0] : view<[%tokens]x4xi32> -> i32
    %pos = view.load %info_view[%at, %c1] : view<[%tokens]x4xi32> -> i32
    %live = view.load %info_view[%at, %c2] : view<[%tokens]x4xi32> -> i32
    %k32 = index.cast %k : index to i32
    %want = scalar.subi %pos0, %k32 : i32
    %same_row = scalar.cmpi eq, %row, %row0 : i32
    %at_pos = scalar.cmpi eq, %pos, %want : i32
    %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
    %a = scalar.andi %same_row, %at_pos : i1
    %b = scalar.andi %a, %is_live : i1
    %c = scalar.andi %b, %room : i1
    %next_alive = scalar.andi %alive, %c : i1
    %step = scf.select %next_alive, %c1_i32, %c0_i32 : i32
    %n_next = scalar.addi %n, %step : i32
    scf.yield %next_alive, %n_next : i1, i32
  }
  %alive_r, %right = scf.for %k = [%c1 to %c9 step %c1](%alive = %is_live0 : i1, %n = %c0_i32 : i32) -> (i1, i32) {
    %ahead = index.add %token, %k : index
    %room = index.cmp ult, %ahead, %tokens : index
    %at_value = scf.select %room, %ahead, %btoken : index
    %at = index.assume %at_value [lt(%at_value, %tokens)] : index
    %row = view.load %info_view[%at, %c0] : view<[%tokens]x4xi32> -> i32
    %pos = view.load %info_view[%at, %c1] : view<[%tokens]x4xi32> -> i32
    %live = view.load %info_view[%at, %c2] : view<[%tokens]x4xi32> -> i32
    %k32 = index.cast %k : index to i32
    %want = scalar.addi %pos0, %k32 : i32
    %same_row = scalar.cmpi eq, %row, %row0 : i32
    %at_pos = scalar.cmpi eq, %pos, %want : i32
    %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
    %a = scalar.andi %same_row, %at_pos : i1
    %b = scalar.andi %a, %is_live : i1
    %c = scalar.andi %b, %room : i1
    %next_alive = scalar.andi %alive, %c : i1
    %step = scf.select %next_alive, %c1_i32, %c0_i32 : i32
    %n_next = scalar.addi %n, %step : i32
    scf.yield %next_alive, %n_next : i1, i32
  }
  %lr = scalar.addi %left, %right : i32
  %run = scalar.addi %lr, %c1_i32 : i32
  %long = scalar.cmpi sge, %run, %c9_i32 : i32
  %ok = scalar.andi %long, %is_live0 : i1
  func.return %ok : i1
}

// Whether TOKEN is the first token of its 16-position block within its run: its position is a multiple of 16, or the
// token before it does not continue the run. The partial tiles (blocks the run covers only in part) are listed by it.
func.def inline @g_block_starts(%info: buffer, %tokens: index, %token: index) -> (i1) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c15_i32 = scalar.constant 15 : i32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %btoken = index.assume %token [lt(%token, %tokens)] : index
  %row0 = view.load %info_view[%btoken, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%btoken, %c1] : view<[%tokens]x4xi32> -> i32
  %skew = scalar.andi %pos0, %c15_i32 : i32
  %aligned = scalar.cmpi eq, %skew, %c0_i32 : i32
  %room = index.cmp uge, %token, %c1 : index
  %back = index.sub %token, %c1 : index
  %at_value = scf.select %room, %back, %btoken : index
  %at = index.assume %at_value [lt(%at_value, %tokens)] : index
  %row = view.load %info_view[%at, %c0] : view<[%tokens]x4xi32> -> i32
  %pos = view.load %info_view[%at, %c1] : view<[%tokens]x4xi32> -> i32
  %live = view.load %info_view[%at, %c2] : view<[%tokens]x4xi32> -> i32
  %want = scalar.subi %pos0, %c1_i32 : i32
  %same_row = scalar.cmpi eq, %row, %row0 : i32
  %at_pos = scalar.cmpi eq, %pos, %want : i32
  %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
  %a = scalar.andi %same_row, %at_pos : i1
  %b = scalar.andi %a, %is_live : i1
  %continues = scalar.andi %b, %room : i1
  %true = scalar.constant true : i1
  %starts_run = scalar.xori %continues, %true : i1
  %starts = scalar.ori %aligned, %starts_run : i1
  func.return %starts : i1
}

kernel.def export("g_attention_flash2") @g_attention_flash2(%tokens: index) {
  %c1 = index.constant 1 : index
  %ckv = index.constant 8 : index
  %c16 = index.constant 16 : index
  %clanes = index.constant 512 : index
  %tiles = index.div %tokens, %c16 : index
  kernel.launch.config workgroups(%tiles, %ckv, %c1) workgroup_size(%clanes, %c1, %c1) : index
} launch(%tokens_arg: index, %layer_arg: index, %sliding: i32, %context_arg: index, %pool_arg: index, %q: buffer, %gate: buffer, %info: buffer, %tiles: buffer, %origins: buffer, %arena: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 16, 8192), multiple_of(%tokens_arg, 16)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 39)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 262144)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 2147483584)] : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c0_i32 = scalar.constant 0 : i32
  %e0 = index.constant 0 : index
  %e1 = index.constant 1 : index
  %e2 = index.constant 2 : index
  %e3 = index.constant 3 : index
  %e4 = index.constant 4 : index
  %e5 = index.constant 5 : index
  %e6 = index.constant 6 : index
  %e7 = index.constant 7 : index
  %kb0_row = index.constant 0 : index
  %kbo0 = scalar.constant 0 : i32
  %c15_i32m = scalar.constant 15 : i32
  %c1_i32m = scalar.constant 1 : i32
  %far_below = scalar.constant -1000000 : i32
  %c4 = index.constant 4 : index
  %tile_count = index.div %tokens, %c16 : index
  %tile_id = kernel.workgroup.id<x> : index
  %tile = index.assume %tile_id [lt(%tile_id, %tile_count)] : index
  %kv_id = kernel.workgroup.id<y> : index
  %cng = index.constant 8 : index
  %kv_value = index.div %kv_id, %cng : index
  %kv = index.assume %kv_value [range(%kv_value, 0, 0)] : index
  %hgroup = index.rem %kv_id, %cng : index
  %tiles_view = buffer.view %tiles[%origin] : buffer -> view<[%tokens]xi32>
  %listed_count32 = view.load %tiles_view[%c0] : view<[%tokens]xi32> -> i32
  %listed_count = index.cast %listed_count32 : i32 to index
  %listed = index.cmp ult, %tile, %listed_count : index
  %entry_slot_value = index.add %tile, %c1 : index
  %entry_slot = index.assume %entry_slot_value [lt(%entry_slot_value, %tokens)] : index
  %entry32 = view.load %tiles_view[%entry_slot] : view<[%tokens]xi32> -> i32
  %entry = index.cast %entry32 : i32 to index
  %first_token = index.assume %entry [range(%entry, 0, 8191), lt(%entry, %tokens)] : index
  %info_view = buffer.view %info[%origin] : buffer -> view<[%tokens]x4xi32>
  %row32 = view.load %info_view[%first_token, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0_32 = view.load %info_view[%first_token, %c1] : view<[%tokens]x4xi32> -> i32
  scf.if %listed {
  %workitem_id = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem_id [range(%workitem_id, 0, 511)] : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 15)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %lane_col = index.rem %lane, %c16 : index
  %lane_half = index.div %lane, %c16 : index
  %hi_half = index.cmp ne, %lane_half, %c0 : index
  %head_in_group = index.div %wave, %c4 : index
  %dim_half = index.rem %wave, %c4 : index
  %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
  %row = index.cast %row_bound : i32 to index
  %pos0_bound = scalar.assume %pos0_32 [range(%pos0_32, 0, 262128)] : i32
  %pos0 = index.cast %pos0_bound : i32 to index
  %pos_last = index.add %pos0, %c15 : index
  %padded = index.add %context, %c15 : index
  %blocks = index.div %padded, %c16 : index
  %k_plane = index.add %layer, %c0 : index
  %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
  %window = index.constant 262144 : index
  %window_less = index.constant 262143 : index
  %far = index.cmp uge, %pos0, %window : index
  %use_window = scalar.andi %is_sliding, %far : i1
  %window_start = index.sub %pos0, %window_less : index
  %key_low_raw = scf.select %use_window, %window_start, %c0 : index
  // Key tiles start on a 16-key page boundary (one page lookup covers 16 consecutive keys).
  %key_low_page = index.div %key_low_raw, %c16 : index
  %key_low = index.mul %key_low_page, %c16 : index
  %key_span = index.sub %pos_last, %key_low : index
  %key_count_value = index.add %key_span, %c1 : index
  %key_count = index.assume %key_count_value [range(%key_count_value, 1, 262144)] : index
  %ckt_less = index.constant 15 : index
  %ckt = index.constant 16 : index
  %key_tiles_round = index.add %key_count, %ckt_less : index
  %key_tiles = index.div %key_tiles_round, %ckt : index
  %cg = index.constant 32 : index
  %cgw = index.constant 4 : index
  %head_first = index.madd %kv, %cg, %head_in_group : index
  %head_value = index.madd %hgroup, %cgw, %head_first : index
  %head = index.assume %head_value [range(%head_value, 0, 31)] : index
  %chalf = index.constant 128 : index
  %dim_base = index.mul %dim_half, %chalf : index

  %k_bytes = index.constant 18688 : offset
  %k_tile = buffer.alloca<workgroup> align(16) %k_bytes : buffer
  %k_view = buffer.view %k_tile[%origin] : buffer -> view<16x584xf16>
  %vt_bytes = index.constant 24576 : offset
  %vt_tile = buffer.alloca<workgroup> align(16) %vt_bytes : buffer
  %vt_view = buffer.view %vt_tile[%origin] : buffer -> view<512x24xf16>
  // S^T partials: [wave][key block][16 keys x 16 tokens] f32.
  %s_bytes = index.constant 16384 : offset
  %s_tile = buffer.alloca<workgroup> align(16) %s_bytes : buffer
  %s_view = buffer.view %s_tile[%origin] : buffer -> view<256x16xf32>

  // This wave's half of Q^T as MMA rhs, held for the whole key loop: lane column = token, 16 dims each.
  %q_view = buffer.view %q[%origin] : buffer -> view<[%tokens]x32x576xf32>
  %cskd = index.constant 144 : index
  %kdim_base = index.mul %dim_half, %cskd : index
  %q_token_value = index.add %first_token, %lane_col : index
  %q_token = index.assume %q_token_value [lt(%q_token_value, %tokens)] : index
  %qd0_o = index.constant 0 : index
  %qd1_o = index.constant 16 : index
  %qd2_o = index.constant 32 : index
  %qd3_o = index.constant 48 : index
  %qd4_o = index.constant 64 : index
  %qd5_o = index.constant 80 : index
  %qd6_o = index.constant 96 : index
  %qd7_o = index.constant 112 : index
  %qd8_o = index.constant 128 : index
  %qd0_v = index.add %kdim_base, %qd0_o : index
  %qd0 = index.assume %qd0_v [range(%qd0_v, 0, 560)] : index
  %qraw0 = vector.load %q_view[%q_token, %head, %qd0] : view<[%tokens]x32x576xf32> -> vector<16xf32>
  %qh0 = vector.fptrunc %qraw0 : vector<16xf32> to vector<16xf16>
  %qf0 = vector.fragment<rhs> %qh0 shape [%c16, %c16] : vector<16xf16>
  %qd1_v = index.add %kdim_base, %qd1_o : index
  %qd1 = index.assume %qd1_v [range(%qd1_v, 0, 560)] : index
  %qraw1 = vector.load %q_view[%q_token, %head, %qd1] : view<[%tokens]x32x576xf32> -> vector<16xf32>
  %qh1 = vector.fptrunc %qraw1 : vector<16xf32> to vector<16xf16>
  %qf1 = vector.fragment<rhs> %qh1 shape [%c16, %c16] : vector<16xf16>
  %qd2_v = index.add %kdim_base, %qd2_o : index
  %qd2 = index.assume %qd2_v [range(%qd2_v, 0, 560)] : index
  %qraw2 = vector.load %q_view[%q_token, %head, %qd2] : view<[%tokens]x32x576xf32> -> vector<16xf32>
  %qh2 = vector.fptrunc %qraw2 : vector<16xf32> to vector<16xf16>
  %qf2 = vector.fragment<rhs> %qh2 shape [%c16, %c16] : vector<16xf16>
  %qd3_v = index.add %kdim_base, %qd3_o : index
  %qd3 = index.assume %qd3_v [range(%qd3_v, 0, 560)] : index
  %qraw3 = vector.load %q_view[%q_token, %head, %qd3] : view<[%tokens]x32x576xf32> -> vector<16xf32>
  %qh3 = vector.fptrunc %qraw3 : vector<16xf32> to vector<16xf16>
  %qf3 = vector.fragment<rhs> %qh3 shape [%c16, %c16] : vector<16xf16>
  %qd4_v = index.add %kdim_base, %qd4_o : index
  %qd4 = index.assume %qd4_v [range(%qd4_v, 0, 560)] : index
  %qraw4 = vector.load %q_view[%q_token, %head, %qd4] : view<[%tokens]x32x576xf32> -> vector<16xf32>
  %qh4 = vector.fptrunc %qraw4 : vector<16xf32> to vector<16xf16>
  %qf4 = vector.fragment<rhs> %qh4 shape [%c16, %c16] : vector<16xf16>
  %qd5_v = index.add %kdim_base, %qd5_o : index
  %qd5 = index.assume %qd5_v [range(%qd5_v, 0, 560)] : index
  %qraw5 = vector.load %q_view[%q_token, %head, %qd5] : view<[%tokens]x32x576xf32> -> vector<16xf32>
  %qh5 = vector.fptrunc %qraw5 : vector<16xf32> to vector<16xf16>
  %qf5 = vector.fragment<rhs> %qh5 shape [%c16, %c16] : vector<16xf16>
  %qd6_v = index.add %kdim_base, %qd6_o : index
  %qd6 = index.assume %qd6_v [range(%qd6_v, 0, 560)] : index
  %qraw6 = vector.load %q_view[%q_token, %head, %qd6] : view<[%tokens]x32x576xf32> -> vector<16xf32>
  %qh6 = vector.fptrunc %qraw6 : vector<16xf32> to vector<16xf16>
  %qf6 = vector.fragment<rhs> %qh6 shape [%c16, %c16] : vector<16xf16>
  %qd7_v = index.add %kdim_base, %qd7_o : index
  %qd7 = index.assume %qd7_v [range(%qd7_v, 0, 560)] : index
  %qraw7 = vector.load %q_view[%q_token, %head, %qd7] : view<[%tokens]x32x576xf32> -> vector<16xf32>
  %qh7 = vector.fptrunc %qraw7 : vector<16xf32> to vector<16xf16>
  %qf7 = vector.fragment<rhs> %qh7 shape [%c16, %c16] : vector<16xf16>
  %qd8_v = index.add %kdim_base, %qd8_o : index
  %qd8 = index.assume %qd8_v [range(%qd8_v, 0, 560)] : index
  %qraw8 = vector.load %q_view[%q_token, %head, %qd8] : view<[%tokens]x32x576xf32> -> vector<16xf32>
  %qh8 = vector.fptrunc %qraw8 : vector<16xf32> to vector<16xf16>
  %qf8 = vector.fragment<rhs> %qh8 shape [%c16, %c16] : vector<16xf16>
  %zero8 = vector.splatf 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zero8 shape [%c16, %c16] : vector<8xf32>
  %zero_f = scalar.constant 0.0 : f32
  %neg_big = scalar.constant -3.0e38 : f32
  %scale = scalar.constant 0.07216878364870323 : f32
  %scale_v = vector.splat %scale : vector<8xf32>
  %neg_v = vector.splat %neg_big : vector<8xf32>
  %exchange = scalar.constant 16 : i32
  %width = scalar.constant 32 : i32
  %two_i32 = scalar.constant 2 : i32
  %cwin_i32 = scalar.constant 262143 : i32
  %true_const = scalar.constant true : i1
  %not_sliding = scalar.xori %is_sliding, %true_const : i1
  %ns_v = vector.splat %not_sliding : vector<8xi1>
  %query_pos = index.add %pos0, %lane_col : index
  %qp32 = index.cast %query_pos : index to i32
  %qp_v = vector.splat %qp32 : vector<8xi32>
  %low32 = scalar.subi %qp32, %cwin_i32 : i32
  %low_v = vector.splat %low32 : vector<8xi32>
  %half32 = index.cast %lane_half : index to i32
  %row_off = vector.iota %half32 step %two_i32 : vector<8xi32>

  // Staging slots: key = workitem % 32, dim segment = workitem / 32 (32 segments of 18 dims).
  %st_key = index.rem %workitem, %c16 : index
  %st_seg_value = index.div %workitem, %c16 : index
  %cseg_n = index.constant 32 : index
  %st_live = index.cmp ult, %st_seg_value, %cseg_n : index
  %cseg_last = index.constant 31 : index
  %st_seg = index.min %st_seg_value, %cseg_last : index
  %cseg_w = index.constant 18 : index
  %st_dim_value = index.mul %st_seg, %cseg_w : index
  %st_dim = index.assume %st_dim_value [range(%st_dim_value, 0, 558)] : index
  %kz = vector.splatf 0.0 : vector<18xf16>
  %cvd = index.constant 512 : index
  %plane_bytes_i = index.mul %pool, %c1 : index
  %pos_bytes = index.constant 1152 : offset
  %v_plane_delta = index.constant 0 : offset
  // S exchange slots: mine, and those of every wave of my head.
  %my_s = index.mul %wave, %c16 : index
  %cparts = index.constant 64 : index
  %head_s = index.mul %head_in_group, %cparts : index
  %part0_o = index.constant 0 : index
  %part0_s = index.add %head_s, %part0_o : index
  %part1_o = index.constant 16 : index
  %part1_s = index.add %head_s, %part1_o : index
  %part2_o = index.constant 32 : index
  %part2_s = index.add %head_s, %part2_o : index
  %part3_o = index.constant 48 : index
  %part3_s = index.add %head_s, %part3_o : index

  %kt_hot = index.sub %key_tiles, %c1 : index
  %m_hot, %l_hot, %o0_hot, %o1_hot, %o2_hot, %o3_hot, %o4_hot, %o5_hot, %o6_hot, %o7_hot = scf.for %kt = [%c0 to %kt_hot step %c1](%m = %neg_big : f32, %l = %zero_f : f32, %a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>, %a4 = %init : vector<8xf32>, %a5 = %init : vector<8xf32>, %a6 = %init : vector<8xf32>, %a7 = %init : vector<8xf32>) -> (f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %tile_first = index.madd %kt, %ckt, %key_low : index
    scf.if %st_live {
      %key_pos = index.add %tile_first, %st_key : index
      %key_valid = index.cmp ule, %key_pos, %pos_last : index
      %kvals, %vvals = scf.if %key_valid -> (vector<18xf16>, vector<18xf16>) {
        %kp = index.assume %key_pos [range(%key_pos, 0, 262143)] : index
        %k_offset = func.call @g_kv_offset(%origins, %row, %kp, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
        %v_offset = index.add %k_offset, %v_plane_delta : offset
        %k_cache = buffer.view %arena[%k_offset] : buffer -> view<1x576xf16>
        %v_cache = buffer.view %arena[%v_offset] : buffer -> view<1x576xf16>
        %kh = vector.load %k_cache[%kv, %st_dim] : view<1x576xf16> -> vector<18xf16>
        %vh = scf.select %true_const, %kh, %kh : vector<18xf16>
        scf.yield %kh, %vh : vector<18xf16>, vector<18xf16>
      } else {
        scf.yield %kz, %kz : vector<18xf16>, vector<18xf16>
      }
      vector.store %kvals, %k_view[%st_key, %st_dim] : vector<18xf16>, view<16x584xf16>
      scf.for %j = [%c0 to %cseg_w step %c1] unroll {
        %vj = vector.extract %vvals[%j] : vector<18xf16> -> f16
        %vt_row_value = index.add %st_dim, %j : index
        %vt_in = index.cmp ult, %vt_row_value, %cvd : index
        scf.if %vt_in {
        %vt_row = index.assume %vt_row_value [range(%vt_row_value, 0, 511)] : index
        view.store %vj, %vt_view[%vt_row, %st_key] : f16, view<512x24xf16>
        }
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %tf32 = index.cast %tile_first : index to i32
    %kc0_0 = index.add %kdim_base, %qd0_o : index
    %kl0_0 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_0] shape [%c16, %c16] : view<16x584xf16> -> vector<16xf16>
    %s0_0 = vector.mma %kl0_0, %qf0, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_1 = index.add %kdim_base, %qd1_o : index
    %kl0_1 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_1] shape [%c16, %c16] : view<16x584xf16> -> vector<16xf16>
    %s0_1 = vector.mma %kl0_1, %qf1, %s0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_2 = index.add %kdim_base, %qd2_o : index
    %kl0_2 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_2] shape [%c16, %c16] : view<16x584xf16> -> vector<16xf16>
    %s0_2 = vector.mma %kl0_2, %qf2, %s0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_3 = index.add %kdim_base, %qd3_o : index
    %kl0_3 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_3] shape [%c16, %c16] : view<16x584xf16> -> vector<16xf16>
    %s0_3 = vector.mma %kl0_3, %qf3, %s0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_4 = index.add %kdim_base, %qd4_o : index
    %kl0_4 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_4] shape [%c16, %c16] : view<16x584xf16> -> vector<16xf16>
    %s0_4 = vector.mma %kl0_4, %qf4, %s0_3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_5 = index.add %kdim_base, %qd5_o : index
    %kl0_5 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_5] shape [%c16, %c16] : view<16x584xf16> -> vector<16xf16>
    %s0_5 = vector.mma %kl0_5, %qf5, %s0_4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_6 = index.add %kdim_base, %qd6_o : index
    %kl0_6 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_6] shape [%c16, %c16] : view<16x584xf16> -> vector<16xf16>
    %s0_6 = vector.mma %kl0_6, %qf6, %s0_5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_7 = index.add %kdim_base, %qd7_o : index
    %kl0_7 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_7] shape [%c16, %c16] : view<16x584xf16> -> vector<16xf16>
    %s0_7 = vector.mma %kl0_7, %qf7, %s0_6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kc0_8 = index.add %kdim_base, %qd8_o : index
    %kl0_8 = vector.fragment.load<lhs> %k_view[%kb0_row, %kc0_8] shape [%c16, %c16] : view<16x584xf16> -> vector<16xf16>
    %s0_8 = vector.mma %kl0_8, %qf8, %s0_7 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    vector.fragment.store<result> %s0_8, %s_view[%my_s, %c0] shape [%c16, %c16] : vector<8xf32>, view<256x16xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %sp0_0 = vector.fragment.load<result> %s_view[%part0_s, %c0] shape [%c16, %c16] : view<256x16xf32> -> vector<8xf32>
    %sp0_1 = vector.fragment.load<result> %s_view[%part1_s, %c0] shape [%c16, %c16] : view<256x16xf32> -> vector<8xf32>
    %sp0_2 = vector.fragment.load<result> %s_view[%part2_s, %c0] shape [%c16, %c16] : view<256x16xf32> -> vector<8xf32>
    %sp0_3 = vector.fragment.load<result> %s_view[%part3_s, %c0] shape [%c16, %c16] : view<256x16xf32> -> vector<8xf32>
    %st0_1 = vector.addf %sp0_0, %sp0_1 : vector<8xf32>
    %st0_2 = vector.addf %st0_1, %sp0_2 : vector<8xf32>
    %st0 = vector.addf %st0_2, %sp0_3 : vector<8xf32>
    %sc0 = vector.mulf %st0, %scale_v : vector<8xf32>
    %base0 = scalar.addi %tf32, %kbo0 : i32
    %base0_v = vector.splat %base0 : vector<8xi32>
    %kpos0 = vector.addi %base0_v, %row_off : vector<8xi32>
    %causal0 = vector.cmpi sle, %kpos0, %qp_v : vector<8xi32> -> vector<8xi1>
    %inwin0 = vector.cmpi sge, %kpos0, %low_v : vector<8xi32> -> vector<8xi1>
    %winok0 = vector.ori %inwin0, %ns_v : vector<8xi1>
    %valid0 = vector.andi %causal0, %winok0 : vector<8xi1>
    %masked0 = vector.select %valid0, %sc0, %neg_v : vector<8xf32>
    %lmax0 = vector.reduce<maxnumf> %masked0, %neg_big : vector<8xf32>, f32
    %lmax = scalar.maxnumf %lmax0, %lmax0 : f32
    %omax, %omax_u = kernel.subgroup.shuffle<xor> %lmax, %exchange, %width : f32, i32, i32
    %tmax = scalar.maxnumf %lmax, %omax : f32
    %m_new = scalar.maxnumf %m, %tmax : f32
    %m_shift = scalar.subf %m, %m_new : f32
    %alpha = scalar.expf<afn> %m_shift : f32
    %m_new_v = vector.splat %m_new : vector<8xf32>
    %sh0 = vector.subf %masked0, %m_new_v : vector<8xf32>
    %pe0 = vector.expf<afn> %sh0 : vector<8xf32>
    %p0 = vector.select %valid0, %pe0, %zero8 : vector<8xf32>
    %ls0 = vector.reduce<addf> %p0, %zero_f : vector<8xf32>, f32
    %pi0_0 = vector.extract %p0[%e0] : vector<8xf32> -> f32
    %po0_0, %pu0_0 = kernel.subgroup.shuffle<xor> %pi0_0, %exchange, %width : f32, i32, i32
    %pi0_1 = vector.extract %p0[%e1] : vector<8xf32> -> f32
    %po0_1, %pu0_1 = kernel.subgroup.shuffle<xor> %pi0_1, %exchange, %width : f32, i32, i32
    %pi0_2 = vector.extract %p0[%e2] : vector<8xf32> -> f32
    %po0_2, %pu0_2 = kernel.subgroup.shuffle<xor> %pi0_2, %exchange, %width : f32, i32, i32
    %pi0_3 = vector.extract %p0[%e3] : vector<8xf32> -> f32
    %po0_3, %pu0_3 = kernel.subgroup.shuffle<xor> %pi0_3, %exchange, %width : f32, i32, i32
    %pi0_4 = vector.extract %p0[%e4] : vector<8xf32> -> f32
    %po0_4, %pu0_4 = kernel.subgroup.shuffle<xor> %pi0_4, %exchange, %width : f32, i32, i32
    %pi0_5 = vector.extract %p0[%e5] : vector<8xf32> -> f32
    %po0_5, %pu0_5 = kernel.subgroup.shuffle<xor> %pi0_5, %exchange, %width : f32, i32, i32
    %pi0_6 = vector.extract %p0[%e6] : vector<8xf32> -> f32
    %po0_6, %pu0_6 = kernel.subgroup.shuffle<xor> %pi0_6, %exchange, %width : f32, i32, i32
