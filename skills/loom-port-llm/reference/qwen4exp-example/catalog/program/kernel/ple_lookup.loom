// IQ4_NL lookup for checkpoint n-gram features. Shared GGML carriers decode
// the original packed table into BF16 rows selected by the checkpoint hash
// IDs.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

func.decl @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index)

func.decl @ggml_iq4_nl_block(%weight: buffer, %block_origin: offset) -> (vector<32xi8>, f32)

// Each head selects one original 90-byte IQ4_NL row. The source hash owns
// valid row IDs; offset arithmetic preserves addresses throughout the table.
// Only selected activations expand, with F32 scale application and BF16 output.
kernel.def @flash_next_ple_lookup_iq4() {
  %tokens = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %ids_arg: buffer, %weight_arg: buffer, %output_arg: buffer) {
  %span, %ids, %weight, %output = buffer.assume.noalias %span_arg, %ids_arg, %weight_arg, %output_arg : buffer, buffer, buffer, buffer
  %capacity = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%span, %capacity) : (buffer, index) -> (index)
  %token = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %blocks = index.constant 80 : index
  %before_end = index.cmp ult, %token, %end : index
  %is_block = index.cmp ult, %thread, %blocks : index
  %active = scalar.andi %before_end, %is_block : i1
  scf.if %active {
    %c5 = index.constant 5 : index
    %width = index.constant 32 : index
    %head = index.div %thread, %c5 : index
    %block = index.rem %thread, %c5 : index
    %channel = index.mul %block, %width : index
    %origin = index.constant 0 : offset
    %row_bytes = index.constant 90 : offset
    %block_bytes = index.constant 18 : offset
    %id_view = buffer.view %ids[%origin] : buffer -> view<[%capacity]x16xi32>
    %output_view = buffer.view %output[%origin] : buffer -> view<[%capacity]x16x160xbf16>
    %id_i32 = view.load %id_view[%token, %head] : view<[%capacity]x16xi32> -> i32
    %id_index = index.cast %id_i32 : i32 to index
    %id = index.assume %id_index [range(%id_index, 0, 320001535)] : index
    %row_origin = index.scale %id, %row_bytes : index, offset -> offset
    %block_delta = index.scale %block, %block_bytes : index, offset -> offset
    %block_origin = index.add %row_origin, %block_delta : offset
    %integer_codes, %scale = func.call @ggml_iq4_nl_block(%weight, %block_origin) : (buffer, offset) -> (vector<32xi8>, f32)
    %exact_values = vector.sitofp %integer_codes : vector<32xi8> to vector<32xf32>
    %codes = vector.fptrunc %exact_values : vector<32xf32> to vector<32xbf16>
    %values = vector.extf %codes : vector<32xbf16> to vector<32xf32>
    %scales = vector.splat %scale : vector<32xf32>
    %scaled = vector.mulf %values, %scales : vector<32xf32>
    %packed = vector.fptrunc %scaled : vector<32xf32> to vector<32xbf16>
    vector.store %packed, %output_view[%token, %head, %channel] : vector<32xbf16>, view<[%capacity]x16x160xbf16>
  }
  kernel.return
}

// On-demand variant. The control VM gathers each selected 90-byte IQ4_NL row
// from the checkpoint into a compact staging region that follows the activation
// rows of the caller's residual buffer: row (token, head) lives at
// token_count * 20480 + (token * 16 + head) * 90. Dequantization is identical
// to flash_next_ple_lookup_iq4.
kernel.def @flash_next_ple_gather_lookup_iq4() {
  %tokens = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %staging_arg: buffer, %output_arg: buffer) {
  %span, %staging, %output = buffer.assume.noalias %span_arg, %staging_arg, %output_arg : buffer, buffer, buffer
  %capacity = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%span, %capacity) : (buffer, index) -> (index)
  %token = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %blocks = index.constant 80 : index
  %before_end = index.cmp ult, %token, %end : index
  %is_block = index.cmp ult, %thread, %blocks : index
  %active = scalar.andi %before_end, %is_block : i1
  scf.if %active {
    %c5 = index.constant 5 : index
    %c16 = index.constant 16 : index
    %width = index.constant 32 : index
    %head = index.div %thread, %c5 : index
    %block = index.rem %thread, %c5 : index
    %channel = index.mul %block, %width : index
    %origin = index.constant 0 : offset
    %activation_row_bytes = index.constant 20480 : offset
    %row_bytes = index.constant 90 : offset
    %block_bytes = index.constant 18 : offset
    %output_view = buffer.view %output[%origin] : buffer -> view<[%capacity]x16x160xbf16>
    %staging_base = index.scale %capacity, %activation_row_bytes : index, offset -> offset
    %slot = index.madd %token, %c16, %head : index
    %row_delta = index.scale %slot, %row_bytes : index, offset -> offset
    %row_origin = index.add %staging_base, %row_delta : offset
    %block_delta = index.scale %block, %block_bytes : index, offset -> offset
    %block_origin = index.add %row_origin, %block_delta : offset
    %integer_codes, %scale = func.call @ggml_iq4_nl_block(%staging, %block_origin) : (buffer, offset) -> (vector<32xi8>, f32)
    %exact_values = vector.sitofp %integer_codes : vector<32xi8> to vector<32xf32>
    %codes = vector.fptrunc %exact_values : vector<32xf32> to vector<32xbf16>
    %values = vector.extf %codes : vector<32xbf16> to vector<32xf32>
    %scales = vector.splat %scale : vector<32xf32>
    %scaled = vector.mulf %values, %scales : vector<32xf32>
    %packed = vector.fptrunc %scaled : vector<32xf32> to vector<32xbf16>
    vector.store %packed, %output_view[%token, %head, %channel] : vector<32xbf16>, view<[%capacity]x16x160xbf16>
  }
  kernel.return
}

// Descriptor producer for parameters.gather. For every live token and hash head
// it emits {entry byte offset, residual destination offset, length}; inactive
// slots carry zero length. Descriptors follow the staging rows:
// token_count * (20480 + 1440).
kernel.def @flash_next_ple_descriptors() {
  %tokens = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %threads = index.constant 16 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %ids_arg: buffer, %arena_arg: buffer) {
  %span, %ids, %arena = buffer.assume.noalias %span_arg, %ids_arg, %arena_arg : buffer, buffer, buffer
  %capacity = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%span, %capacity) : (buffer, index) -> (index)
  %token = kernel.workgroup.id<x> : index
  %head = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %c16 = index.constant 16 : index
  %activation_row_bytes = index.constant 20480 : offset
  %staged_row_bytes = index.constant 21920 : offset
  %row_bytes = index.constant 90 : offset
  %descriptor_origin = index.scale %capacity, %staged_row_bytes : index, offset -> offset
  %staging_base = index.scale %capacity, %activation_row_bytes : index, offset -> offset
  %descriptors = buffer.view %arena[%descriptor_origin] : buffer -> view<[%capacity]x16x3xi64>
  %live = index.cmp ult, %token, %end : index
  %zero = scalar.constant 0 : i64
  %id_view = buffer.view %ids[%origin] : buffer -> view<[%capacity]x16xi32>
  %id_i32 = scf.if %live -> (i32) {
    %loaded = view.load %id_view[%token, %head] : view<[%capacity]x16xi32> -> i32
    scf.yield %loaded : i32
  } else {
    %none = scalar.constant 0 : i32
    scf.yield %none : i32
  }
  %id64 = scalar.extui %id_i32 : i32 to i64
  %row_size = scalar.constant 90 : i64
  %source = scalar.muli %id64, %row_size : i64
  %slot = index.madd %token, %c16, %head : index
  %row_delta = index.scale %slot, %row_bytes : index, offset -> offset
  %destination_offset = index.add %staging_base, %row_delta : offset
  %destination = index.cast %destination_offset : offset to i64
  %length = scf.select %live, %row_size, %zero : i64
  %source_out = scf.select %live, %source, %zero : i64
  %destination_out = scf.select %live, %destination, %zero : i64
  view.store %source_out, %descriptors[%token, %head, 0] : i64, view<[%capacity]x16x3xi64>
  view.store %destination_out, %descriptors[%token, %head, 1] : i64, view<[%capacity]x16x3xi64>
  view.store %length, %descriptors[%token, %head, 2] : i64, view<[%capacity]x16x3xi64>
  kernel.return
}
