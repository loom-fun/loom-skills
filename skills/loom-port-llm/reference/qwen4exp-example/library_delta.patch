+func.def @qwen38.epoch_transfers(%state: buffer, %capacity: index, %first_count: i32, %next_count: i32, %first_outputs: i32, %next_outputs: i32, %first_tokens: i32, %next_tokens: i32, %first_packet_capacity: i32, %tokens: buffer, %mixed: i1) {
