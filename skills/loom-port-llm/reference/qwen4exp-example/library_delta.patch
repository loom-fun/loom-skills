index 0000000..245a915
--- /dev/null
+++ b/model/Qwen/Qwen3.8-Flash-Next/test/ple_gather_test.loom
@@ -0,0 +1,266 @@
+kernel.decl @flash_next_ple_gather_lookup_iq4() launch(%epoch: buffer, %staging: buffer, %output: buffer)
+
+kernel.decl @flash_next_ple_descriptors() launch(%epoch: buffer, %ids: buffer, %arena: buffer)
+
+kernel.decl @flash_next_ple_claim() launch(%epoch: buffer, %ids: buffer, %arena: buffer)
+
+kernel.decl @flash_next_ple_clear() launch(%arena: buffer)
+
+kernel.decl @flash_next_ple_cache_claim() launch(%arena: buffer)
+
+kernel.decl @flash_next_ple_cache_insert() launch(%arena: buffer)
+
+// token_count = 8: staging starts after 8 * 20480 activation bytes; gather
+// descriptors follow 8 * 16 * 90 staged bytes.
+// Arena = 8 * (20480 + 1440 + 384 + 64 + 256) bytes: activations, staging,
+// descriptors, source map (offset 8 * 22304), claim table (offset 8 * 22368).
+
+// Row ids index a 37-row table (90 B rows). The reference decoder is the
+// original resident kernel; staging holds exactly what parameters.gather
+// delivers: bytes [id * 90, id * 90 + 90) at slot token * 16 + head.
+func.def @fixture(%trial: index, %epoch: buffer, %ids: buffer, %weight: buffer, %arena: buffer) {
+  %origin = index.constant 0 : offset
+  %c0 = index.constant 0 : index
+  %c1 = index.constant 1 : index
+  %c8 = index.constant 8 : index
+  %c16 = index.constant 16 : index
+  %c90 = index.constant 90 : index
+  %blocks = index.constant 185 : index
+  %block_bytes = index.constant 18 : offset
+  %period = index.constant 17 : index
+  %center = scalar.constant 8 : i32
+  %scale_factor = scalar.constant 0.001953125 : f32
+  %full = index.cmp eq, %trial, %c1 : index
+  %empty = index.cmp eq, %trial, %c0 : index
+  %c0_i32 = scalar.constant 0 : i32
+  %c8_i32 = scalar.constant 8 : i32
+  %c3_i32 = scalar.constant 3 : i32
+  %nonempty = scf.select %full, %c8_i32, %c3_i32 : i32
+  %count = scf.select %empty, %c0_i32, %nonempty : i32
+  %header = buffer.view %epoch[%origin] : buffer -> view<1xi32>
+  view.store %count, %header[0] : i32, view<1xi32>
+  scf.for %block = [%c0 to %blocks step %c1] {
+    %base = index.scale %block, %block_bytes : index, offset -> offset
+    %scale_view = buffer.view %weight[%base] : buffer -> view<1xf16>
+    %ordinal = index.rem %block, %period : index
+    %word = index.cast %ordinal : index to i32
+    %signed = scalar.subi %word, %center : i32
+    %value = scalar.sitofp %signed : i32 to f32
+    %scaled = scalar.mulf %value, %scale_factor : f32
+    %packed = scalar.fptrunc %scaled : f32 to f16
+    view.store %packed, %scale_view[0] : f16, view<1xf16>
+  }
+  // Emulate the gather: copy the selected row for every (token, head).
+  %rows = buffer.view %ids[%origin] : buffer -> view<8x16xi32>
+  %staging_base = index.constant 163840 : offset
+  %source_map_origin = index.constant 178432 : offset
+  %row_bytes = index.constant 90 : offset
+  scf.for %token = [%c0 to %c8 step %c1] {
+    scf.for %head = [%c0 to %c16 step %c1] {
+      %id_word = view.load %rows[%token, %head] : view<8x16xi32> -> i32
+      %id = index.cast %id_word : i32 to index
+      %source = index.scale %id, %row_bytes : index, offset -> offset
+      %slot = index.madd %token, %c16, %head : index
+      %relative = index.scale %slot, %row_bytes : index, offset -> offset
+      %destination = index.add %staging_base, %relative : offset
+      buffer.copy %weight[%source], %arena[%destination], %row_bytes
+    }
+  }
+  // Identity source map for the isolated lookup scenario.
+  %sources = buffer.view %arena[%source_map_origin] : buffer -> view<8x16xi32>
+  scf.for %token = [%c0 to %c8 step %c1] {
+    scf.for %head = [%c0 to %c16 step %c1] {
+      %slot_index = index.madd %token, %c16, %head : index
+      %slot_word = index.cast %slot_index : index to i32
+      view.store %slot_word, %sources[%token, %head] : i32, view<8x16xi32>
+    }
+  }
+  func.return
+}
+
+// Independent scalar nibble decoding and F64 scale application. The encoded
+// halves are sixteen channels apart, not alternating adjacent channels.
+func.def @staged_reference(%epoch: buffer, %staging: buffer, %output: buffer) {
+  %origin = index.constant 0 : offset
+  %header = buffer.view %epoch[%origin] : buffer -> view<1xi32>
+  %count_word = view.load %header[0] : view<1xi32> -> i32
+  %count_value = index.cast %count_word : i32 to index
+  %count = index.assume %count_value [range(%count_value, 0, 8)] : index
+  %result = buffer.view %output[%origin] : buffer -> view<8x16x160xbf16>
+  %c0 = index.constant 0 : index
+  %c1 = index.constant 1 : index
+  %c16 = index.constant 16 : index
+  %c32 = index.constant 32 : index
+  %c160 = index.constant 160 : index
+  %row_bytes = index.constant 90 : offset
+  %block_bytes = index.constant 18 : offset
+  %payload_bytes = index.constant 2 : offset
+  %mask = scalar.constant 15 : i8
+  %shift = scalar.constant 4 : i8
+  %codebook = vector.constanti [-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113] : vector<16xi32>
+  scf.for %token = [%c0 to %count step %c1] {
+    scf.for %head = [%c0 to %c16 step %c1] {
+      %slot = index.madd %token, %c16, %head : index
+      %slot_origin = index.scale %slot, %row_bytes : index, offset -> offset
+      %staging_base = index.constant 163840 : offset
+      %row_origin = index.add %staging_base, %slot_origin : offset
+      scf.for %channel = [%c0 to %c160 step %c1] {
+        %block = index.div %channel, %c32 : index
+        %relative = index.scale %block, %block_bytes : index, offset -> offset
+        %base = index.add %row_origin, %relative : offset
+        %payload = index.add %base, %payload_bytes : offset
+        %scale_view = buffer.view %staging[%base] : buffer -> view<1xf16>
+        %codes = buffer.view %staging[%payload] : buffer -> view<16xi8>
+        %byte_index = index.rem %channel, %c16 : index
+        %half_index = index.rem %channel, %c32 : index
+        %upper = index.cmp uge, %half_index, %c16 : index
+        %packed = view.load %codes[%byte_index] : view<16xi8> -> i8
+        %high = scalar.shrui %packed, %shift : i8
+        %chosen = scf.select %upper, %high, %packed : i8
+        %nibble = scalar.andi %chosen, %mask : i8
+        %lookup = index.cast %nibble : i8 to index
+        %code = vector.extract %codebook[%lookup] : vector<16xi32> -> i32
+        %value = scalar.sitofp %code : i32 to f64
+        %scale_packed = view.load %scale_view[0] : view<1xf16> -> f16
+        %scale = scalar.extf %scale_packed : f16 to f64
+        %scaled = scalar.mulf %value, %scale : f64
+        %expected = scalar.fptrunc %scaled : f64 to bf16
+        view.store %expected, %result[%token, %head, %channel] : bf16, view<8x16x160xbf16>
+      }
+    }
+  }
+  func.return
+}
+
+check.scenario public @ple_gather_lookup {
+  check.trial[3](%trial: index, %entropy: check.entropy) {
+    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
+    %epoch = check.generate.fill value(0) : tensor<3xi32>
+    %ids = check.generate.iota offset(0) step(1) period(37) : tensor<8x16xi32>
+    %weight = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<3330xi8>
+    %arena = check.generate.fill value(0) : tensor<187392xi8>
+    check.generate<@fixture>(%trial, %epoch, %ids, %weight, %arena) : (index, tensor<3xi32>, tensor<8x16xi32>, tensor<3330xi8>, tensor<187392xi8>) -> ()
+    %output = check.generate.fill value(-99.0) : tensor<8x16x160xbf16>
+    check.compare<@flash_next_ple_gather_lookup_iq4, @staged_reference>(%epoch, %arena, %output) : (tensor<3xi32>, tensor<187392xi8>, tensor<8x16x160xbf16>) -> () {
+      check.expect.bitwise actual(%output) expected(%output) : tensor<8x16x160xbf16>
+    }
+  }
+  check.return
+}
+
+// Test-only stand-in for parameters.gather: executes every non-empty
+// descriptor as a byte copy from the weight table into the arena.
+kernel.def @emulated_gather() {
+  %c8 = index.constant 8 : index
+  %c1 = index.constant 1 : index
+  %c16 = index.constant 16 : index
+  kernel.launch.config workgroups(%c8, %c1, %c1) workgroup_size(%c16, %c1, %c1) : index
+} launch(%weight_arg: buffer, %arena_arg: buffer) {
+  %weight, %arena = buffer.assume.noalias %weight_arg, %arena_arg : buffer, buffer
+  %token = kernel.workgroup.id<x> : index
+  %head = kernel.workitem.id<x> : index
+  %c0 = index.constant 0 : index
+  %c1 = index.constant 1 : index
+  %descriptor_origin = index.constant 175360 : offset
+  %descriptors = buffer.view %arena[%descriptor_origin] : buffer -> view<8x16x3xi64>
+  %source64 = view.load %descriptors[%token, %head, 0] : view<8x16x3xi64> -> i64
+  %destination64 = view.load %descriptors[%token, %head, 1] : view<8x16x3xi64> -> i64
+  %length64 = view.load %descriptors[%token, %head, 2] : view<8x16x3xi64> -> i64
+  %source_bounded = scalar.assume %source64 [range(%source64, 0, 1000000)] : i64
+  %destination_bounded = scalar.assume %destination64 [range(%destination64, 0, 1000000)] : i64
+  %length_bounded = scalar.assume %length64 [range(%length64, 0, 1000)] : i64
+  %source = index.cast %source_bounded : i64 to offset
+  %destination = index.cast %destination_bounded : i64 to offset
+  %length = index.cast %length_bounded : i64 to index
+  %bytes = index.constant 90 : offset
+  %nonempty = index.cmp ugt, %length, %c0 : index
+  scf.if %nonempty {
+    buffer.copy %weight[%source], %arena[%destination], %bytes
+  }
+  kernel.return
+}
+
+kernel.def @poison_staging() {
+  %c8 = index.constant 8 : index
+  %c1 = index.constant 1 : index
+  %c180 = index.constant 180 : index
+  kernel.launch.config workgroups(%c8, %c1, %c1) workgroup_size(%c180, %c1, %c1) : index
+} launch(%arena_arg: buffer) {
+  %arena = buffer.assume.noalias %arena_arg : buffer
+  %token = kernel.workgroup.id<x> : index
+  %lane = kernel.workitem.id<x> : index
+  %origin = index.constant 163840 : offset
+  %staging = buffer.view %arena[%origin] : buffer -> view<8x180xi64>
+  %poison = scalar.constant 9187201950435737471 : i64
+  view.store %poison, %staging[%token, %lane] : i64, view<8x180xi64>
+  kernel.return
+}
+
+// One epoch, ordered exactly like the stage (zero claims, claim, descriptors),
+// the gather, and the epoch body (lookup, then cache insertion).
+command.def @one_epoch() launch(%epoch: buffer, %ids: buffer, %weight: buffer, %arena: buffer, %output: buffer) {
+  kernel.launch @flash_next_ple_clear(%arena) : (buffer)
+  kernel.launch @flash_next_ple_claim(%epoch, %ids, %arena) : (buffer, buffer, buffer)
+  kernel.launch @flash_next_ple_descriptors(%epoch, %ids, %arena) : (buffer, buffer, buffer)
+  kernel.launch @emulated_gather(%weight, %arena) : (buffer, buffer)
+  kernel.launch @flash_next_ple_gather_lookup_iq4(%epoch, %arena, %output) : (buffer, buffer, buffer)
+  kernel.launch @flash_next_ple_cache_claim(%arena) : (buffer)
+  kernel.launch @flash_next_ple_cache_insert(%arena) : (buffer)
+  command.return
+}
+
+// Epoch one fills the cache; its staged rows are then destroyed, so epoch two
+// can only be right if cache hits return the exact raw rows.
+command.def @dedupe_pipeline() launch(%epoch: buffer, %ids: buffer, %weight: buffer, %arena: buffer, %output: buffer) {
+  command.launch @one_epoch(%epoch, %ids, %weight, %arena, %output) : (buffer, buffer, buffer, buffer, buffer)
+  kernel.launch @poison_staging(%arena) : (buffer)
+  command.launch @one_epoch(%epoch, %ids, %weight, %arena, %output) : (buffer, buffer, buffer, buffer, buffer)
+  command.return
+}
+
+// Reference: decode rows straight from the table by row id, no staging.
+func.def @pipeline_reference(%epoch: buffer, %ids: buffer, %weight: buffer, %arena: buffer, %output: buffer) {
+  %origin = index.constant 0 : offset
+  %row_bytes = index.constant 90 : offset
+  %rows = buffer.view %ids[%origin] : buffer -> view<8x16xi32>
+  %c0 = index.constant 0 : index
+  %c1 = index.constant 1 : index
+  %c8 = index.constant 8 : index
+  %c16 = index.constant 16 : index
+  %staging_base = index.constant 163840 : offset
+  %header = buffer.view %epoch[%origin] : buffer -> view<1xi32>
+  %count_word = view.load %header[0] : view<1xi32> -> i32
+  %count_value = index.cast %count_word : i32 to index
+  %count = index.assume %count_value [range(%count_value, 0, 8)] : index
+  // Lay out every (token, head) row in its own staging slot (no dedupe) and
+  // an identity source map, then reuse the scalar staged reference.
+  scf.for %token = [%c0 to %count step %c1] {
+    scf.for %head = [%c0 to %c16 step %c1] {
+      %id_word = view.load %rows[%token, %head] : view<8x16xi32> -> i32
+      %id = index.cast %id_word : i32 to index
+      %source = index.scale %id, %row_bytes : index, offset -> offset
+      %slot = index.madd %token, %c16, %head : index
+      %relative = index.scale %slot, %row_bytes : index, offset -> offset
+      %destination = index.add %staging_base, %relative : offset
+      buffer.copy %weight[%source], %arena[%destination], %row_bytes
+    }
+  }
+  func.call @staged_reference(%epoch, %arena, %output) : (buffer, buffer, buffer) -> ()
+  func.return
+}
+
+check.scenario public @ple_dedupe_pipeline {
+  check.trial[3](%trial: index, %entropy: check.entropy) {
+    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
+    %epoch = check.generate.fill value(0) : tensor<3xi32>
+    %ids = check.generate.iota offset(0) step(1) period(37) : tensor<8x16xi32>
+    %weight = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<3330xi8>
+    %arena = check.generate.fill value(0) : tensor<187392xi8>
+    check.generate<@fixture>(%trial, %epoch, %ids, %weight, %arena) : (index, tensor<3xi32>, tensor<8x16xi32>, tensor<3330xi8>, tensor<187392xi8>) -> ()
+    %output = check.generate.fill value(-99.0) : tensor<8x16x160xbf16>
+    check.compare<@dedupe_pipeline, @pipeline_reference>(%epoch, %ids, %weight, %arena, %output) : (tensor<3xi32>, tensor<8x16xi32>, tensor<3330xi8>, tensor<187392xi8>, tensor<8x16x160xbf16>) -> () {
+      check.expect.bitwise actual(%output) expected(%output) : tensor<8x16x160xbf16>
+    }
+  }
+  check.return
+}
