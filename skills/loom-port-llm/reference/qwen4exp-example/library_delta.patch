+        %tokens = buffer.view %ordinary[%origin] : buffer -> view<[%extent]xi32>
+        %slot = index.assume %ordinary_index [range(%ordinary_index, 0, 2147483647), lt(%ordinary_index, %extent)] : index
+        %token = view.load %tokens[%slot] : view<[%extent]xi32> -> i32
+        view.store %token, %published[%i, 5] : i32, view<[%extent]x21xi32>
+      }
+      scf.yield %length, %length, %selected_count, %zero32 : i32, i32, i32, i32
