+func.decl @qwen38.ple_load(%state: buffer, %slot: index) -> (i64)
+
+// PLE rows are read on demand: the PLE stage hashes token IDs into gather
+// descriptors, the checkpoint rows land in the residual buffer's staging
+// region, and the epoch stage that follows is ordered after the gather.
+func.def @flash_next.ple_gather_demand(%control_state: buffer, %mixed: i1, %verify: i1, %shape: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer) {
+  %c1 = index.constant 1 : index
+  %c2 = index.constant 2 : index
+  %c3 = index.constant 3 : index
+  %c4 = index.constant 4 : index
+  %c8 = index.constant 8 : index
+  %c0 = index.constant 0 : index
+  %source64 = func.call @qwen38.ple_load(%control_state, %c0) : (buffer, index) -> (i64)
+  %ordinary_target = func.call @qwen38.ple_load(%control_state, %c1) : (buffer, index) -> (i64)
+  %mixed_target = func.call @qwen38.ple_load(%control_state, %c2) : (buffer, index) -> (i64)
+  %ordinary_verify = func.call @qwen38.ple_load(%control_state, %c3) : (buffer, index) -> (i64)
+  %mixed_verify = func.call @qwen38.ple_load(%control_state, %c4) : (buffer, index) -> (i64)
+  %target_first = scf.select %mixed, %mixed_target, %ordinary_target : i64
+  %verify_first = scf.select %mixed, %mixed_verify, %ordinary_verify : i64
+  %first = scf.select %verify, %verify_first, %target_first : i64
+  %shape64 = scalar.extui %shape : i32 to i64
+  %stage64 = scalar.addi %first, %shape64 : i64
+  %stage = scalar.trunci %stage64 : i64 to i32
+  %shape_index = index.cast %shape : i32 to index
+  %capacity_slot = index.add %c8, %shape_index : index
+  %capacity = func.call @qwen38.ple_load(%control_state, %capacity_slot) : (buffer, index) -> (i64)
+  %source = scalar.trunci %source64 : i64 to i32
+  %producer = func.call @execute_5(%stage, %residual, %metadata, %origins, %state, %tokens) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
+  %produced = func.call @fence(%producer) : (i64) -> (hal.fence)
+  %staged_row = scalar.constant 21920 : i64
+  %heads = scalar.constant 16 : i64
+  %descriptor_origin = scalar.muli %capacity, %staged_row : i64
+  %count = scalar.muli %capacity, %heads : i64
+  %key = buffer.constant utf8("per_layer_token_embd.weight") : buffer
+  %gathered = func.call @gather(%source, %key, %produced, %residual, %descriptor_origin, %count, %residual) : (i32, buffer, hal.fence, hal.buffer, i64, i64, hal.buffer) -> (hal.fence)
+  func.call @join(%gathered) : (hal.fence)
+  func.return
+}
+
+// Resident mode (control-table slot 6 == 0) looks the rows up inside the epoch
+// and skips the gather entirely.
+func.def @flash_next.ple_gather(%control_state: buffer, %mixed: i1, %verify: i1, %shape: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer) {
+  %c6 = index.constant 6 : index
+  %mode = func.call @qwen38.ple_load(%control_state, %c6) : (buffer, index) -> (i64)
+  %zero = scalar.constant 0 : i64
+  %demand = scalar.cmpi ne, %mode, %zero : i64
+  scf.if %demand {
+    func.call @flash_next.ple_gather_demand(%control_state, %mixed, %verify, %shape, %residual, %metadata, %origins, %state, %tokens) : (buffer, i1, i1, i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer)
+  }
+  func.return
+}
+
+// Cold state supplies the first target shape, allowing models to omit
+// isolated stages. Optional proposal, catch-up, and verifier catalogs retain
+// their explicit origins. All sessions share these commands and one process;
+// descriptors and buffers carry their live state.
+// Feedback slot zero holds ordinary tokens; slots one/two hold separate
+// verification banks. Neither branch waits: the owner joins both timelines
+// before advancing host frontiers.
+func.def @epoch_once(%control_state: buffer, %mixed: i1, %shape: i32, %proposes: i32, %verifies: i32, %span_count: i32, %output_count: i32, %feedback_slot: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer, %outputs: hal.buffer, %carry: hal.buffer, %committed: hal.buffer, %results: hal.buffer, %draft_cache: hal.buffer, %draft_origins: hal.buffer) -> (i64) {
+  %origin = index.constant 0 : offset
+  %view = buffer.view %control_state[%origin] : buffer -> view<10xi32>
+  %shape_count = view.load %view[2] : view<10xi32> -> i32
+  %ordinary_draft_first = view.load %view[3] : view<10xi32> -> i32
+  %mixed_draft_first = view.load %view[7] : view<10xi32> -> i32
+  %draft_first = scf.select %mixed, %mixed_draft_first, %ordinary_draft_first : i32
+  %ordinary_warm_first = view.load %view[8] : view<10xi32> -> i32
+  %mixed_warm_first = view.load %view[9] : view<10xi32> -> i32
+  %warm_first = scf.select %mixed, %mixed_warm_first, %ordinary_warm_first : i32
+  %draft_kind = view.load %view[4] : view<10xi32> -> i32
+  %ordinary_target_first = view.load %view[5] : view<10xi32> -> i32
+  %mixed_target_first = view.load %view[6] : view<10xi32> -> i32
+  %target_first = scf.select %mixed, %mixed_target_first, %ordinary_target_first : i32
+  %c0 = scalar.constant 0 : i32
+  %c1 = scalar.constant 1 : i32
+  %c2 = scalar.constant 2 : i32
+  %c0_2 = scalar.constant 0 : i64
+  %propose = scalar.cmpi ne, %proposes, %c0 : i32
+  %verify = scalar.cmpi ne, %verifies, %c0 : i32
+  %dflash = scalar.cmpi ne, %draft_kind, %c0 : i32
+  scf.if %verify {
+    %started = func.call @timestamp(%results, %c0_2) : (hal.buffer, i64) -> (i64)
+  }
+  scf.if %propose {
+    // Live spans bound the proposing subset, including mixed prefill/decode.
+    // The final variant covers the largest cohort admitted by target shapes.
+    %variants = scalar.subi %warm_first, %draft_first : i32
+    %last = scalar.subi %variants, %c1 : i32
+    %level = func.call @qwen38.proposal_level(%span_count) : (i32) -> (i32)
+    %selected = scalar.minui %level, %last : i32
+    %draft_stage = scalar.addi %draft_first, %selected : i32
+    scf.if %dflash {
+      %proposal = func.call @execute_5(%draft_stage, %metadata, %tokens, %draft_origins, %draft_cache, %results) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
+    } else {
+      %proposal = func.call @execute_6(%draft_stage, %metadata, %tokens, %draft_origins, %draft_cache, %carry, %results) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
+    }
+  }
+  scf.if %verify {
+    %target_offset = scalar.constant 8 : i64
+    %target_started = func.call @timestamp(%results, %target_offset) : (hal.buffer, i64) -> (i64)
+  }
+  %warm_stage = scalar.addi %warm_first, %shape : i32
+  %target = scf.if %verify -> (i64) {
+    %is_verify = scalar.constant true : i1
+    func.call @flash_next.ple_gather(%control_state, %mixed, %is_verify, %shape, %residual, %metadata, %origins, %state, %tokens) : (buffer, i1, i1, i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer)
+    %verify_stage = scalar.addi %warm_stage, %shape_count : i32
+    %completion = func.call @execute_7(%verify_stage, %residual, %metadata, %origins, %state, %tokens, %committed, %results) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
+    %end_offset = scalar.constant 16 : i64
+    %measured = func.call @timestamp(%results, %end_offset) : (hal.buffer, i64) -> (i64)
+    %count = scalar.extui %span_count : i32 to i64
+    %record_bytes = scalar.constant 40 : i64
+    %record_payload = scalar.muli %count, %record_bytes : i64
+    %header_origin = func.call @qwen38_feedback_records_origin() : () -> (offset)
+    %header_bytes = index.cast %header_origin : offset to i64
+    %record_length = scalar.addi %record_payload, %header_bytes : i64
+    %tagged = scalar.cmpi eq, %feedback_slot, %c2 : i32
+    %length = scf.if %tagged -> (i64) {
+      %tagged_length = func.call @qwen38.tagged_feedback_bytes(%control_state) : (buffer) -> (i64)
+      scf.yield %tagged_length : i64
+    } else {
+      scf.yield %record_length : i64
+    }
+    %feedback = func.call @feedback(%feedback_slot, %results, %c0_2, %length) : (i32, hal.buffer, i64, i64) -> (i64)
+    scf.yield %measured : i64
+  } else {
+    %target_stage = scalar.addi %shape, %target_first : i32
+    %is_verify = scalar.constant false : i1
+    func.call @flash_next.ple_gather(%control_state, %mixed, %is_verify, %shape, %residual, %metadata, %origins, %state, %tokens) : (buffer, i1, i1, i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer)
+    %completion = func.call @execute_6(%target_stage, %residual, %metadata, %origins, %state, %tokens, %outputs) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
+    %has_output = scalar.cmpi ne, %output_count, %c0 : i32
+    scf.if %has_output {
+      %count = scalar.extui %output_count : i32 to i64
+      %token_bytes = scalar.constant 4 : i64
+      %length = scalar.muli %count, %token_bytes : i64
+      %feedback = func.call @feedback(%c0, %outputs, %c0_2, %length) : (i32, hal.buffer, i64, i64) -> (i64)
+    }
+    scf.yield %completion : i64
+  }
+  // Catch-up only mutates the private draft cache and committed carry. Target
+  // feedback stays immutable and can transfer concurrently with this command.
+  %draft_enabled = scalar.cmpi ne, %draft_first, %c0 : i32
+  %completion = scf.if %draft_enabled -> (i64) {
+    %accepted = scf.if %verify -> (hal.buffer) {
+      scf.yield %committed : hal.buffer
+    } else {
+      scf.yield %metadata : hal.buffer
+    }
+    %warm = scf.if %dflash -> (i64) {
+      %completion = func.call @execute_4(%warm_stage, %residual, %accepted, %draft_origins, %draft_cache) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
+      scf.yield %completion : i64
+    } else {
+      %completion = func.call @execute_6(%warm_stage, %residual, %accepted, %draft_origins, %draft_cache, %carry, %tokens) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
+      scf.yield %completion : i64
+    }
+    scf.yield %warm : i64
+  } else {
+    scf.yield %target : i64
+  }
+  func.return %completion : i64
+}
+
+// A bounded cohort reuses retained state on the work timeline, while each
+// feedback bank stays immutable on its independent transfer branch. Acceptance
+// produces the next input and position entirely on device; neither call waits.
+func.def public @text_epoch_v1(%control_state: buffer, %shape: i32, %proposes: i32, %verifies: i32, %span_count: i32, %output_count: i32, %epoch_count: i32, %continuation_shape: i32, %continuation_proposes: i32, %first_media_count: i32, %next_media_count: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer, %outputs: hal.buffer, %carry: hal.buffer, %committed: hal.buffer, %results: hal.buffer, %draft_cache: hal.buffer, %draft_origins: hal.buffer, %next_results: hal.buffer) -> (i64) {
+  %c0 = scalar.constant 0 : i32
+  %c1 = scalar.constant 1 : i32
+  %c2 = scalar.constant 2 : i32
+  %media_count = scalar.addi %first_media_count, %next_media_count : i32
+  %mixed = scalar.cmpi ne, %media_count, %c0 : i32
+  %first = func.call @epoch_once(%control_state, %mixed, %shape, %proposes, %verifies, %span_count, %output_count, %c1, %residual, %metadata, %origins, %state, %tokens, %outputs, %carry, %committed, %results, %draft_cache, %draft_origins) : (buffer, i1, i32, i32, i32, i32, i32, i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
+  %continues = scalar.cmpi eq, %epoch_count, %c2 : i32
+  %completion = scf.if %continues -> (i64) {
+    %origin = index.constant 0 : offset
+    %view = buffer.view %control_state[%origin] : buffer -> view<10xi32>
+    %shape_count = view.load %view[2] : view<10xi32> -> i32
+    %ordinary_warm = view.load %view[8] : view<10xi32> -> i32
+    %mixed_warm = view.load %view[9] : view<10xi32> -> i32
+    %warm = scf.select %mixed, %mixed_warm, %ordinary_warm : i32
+    %shapes = scalar.muli %shape_count, %c2 : i32
+    %continuation = scalar.addi %warm, %shapes : i32
+    %ready = func.call @execute_3(%continuation, %metadata, %tokens, %results) : (i32, hal.buffer, hal.buffer, hal.buffer) -> (i64)
+    %next = func.call @epoch_once(%control_state, %mixed, %continuation_shape, %continuation_proposes, %c1, %span_count, %c0, %c2, %residual, %metadata, %origins, %state, %tokens, %outputs, %carry, %committed, %next_results, %draft_cache, %draft_origins) : (buffer, i1, i32, i32, i32, i32, i32, i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
+    scf.yield %next : i64
+  } else {
