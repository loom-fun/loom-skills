+// Semantic progress is {consumed, known, outputs, verifications,
+// source_position, tokens[16]}. Only completed feedback enters this transform;
+// bank contents are immutable.
+func.def public @text_publish_epoch_v1(%control_state: buffer, %plan: buffer, %media_plan: buffer, %count: i32, %first_media_count: i32, %next_media_count: i32, %verified: i32, %continues: i32, %continuation_flags: buffer, %ordinary: buffer, %first_results: buffer, %next_results: buffer, %progress: buffer) {
+  %origin = index.constant 0 : offset
+  %c0 = index.constant 0 : index
+  %c1 = index.constant 1 : index
+  %c2 = index.constant 2 : index
+  %c4 = index.constant 4 : index
+  %zero32 = scalar.constant 0 : i32
+  %one32 = scalar.constant 1 : i32
+  %extent = index.cast %count : i32 to index
