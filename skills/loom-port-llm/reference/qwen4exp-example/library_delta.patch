+  // A queued continuation retains its first-plan policy index after compaction.
+  scf.for %i = [%c0 to %first step %c1] {
+    %row_word = view.load %requests[%i, 3] : view<[%first]x9xi32> -> i32
+    %row = index.cast %row_word : i32 to index
+    %source_relative = index.scale %row, %policy_stride : index, offset -> offset
+    %source_offset = index.add %policy_source, %source_relative : offset
+    %target_relative = index.scale %i, %policy_stride : index, offset -> offset
+    %target_offset = index.add %policy_target, %target_relative : offset
