+// Fourteen ordered, disjoint placements describe the live packet fields.
+// The retained table follows the 40-byte control header and resident sampling
+// directory. Empty placements carry zero length; they upload no bytes.
+func.def @qwen38.epoch_transfer(%state: buffer, %slot: index, %binding: i64, %begin: i64, %length: i64) {
+  %state_bytes = buffer.length %state
+  %table_bytes = index.constant 560 : offset
+  %origin = index.sub %state_bytes, %table_bytes : offset
+  %entry = index.assume %slot [range(%slot, 0, 13)] : index
+  %table = buffer.view %state[%origin] : buffer -> view<14x5xi64>
+  view.store %binding, %table[%entry, 0] : i64, view<14x5xi64>
+  view.store %begin, %table[%entry, 1] : i64, view<14x5xi64>
+  view.store %binding, %table[%entry, 2] : i64, view<14x5xi64>
+  view.store %begin, %table[%entry, 3] : i64, view<14x5xi64>
+  view.store %length, %table[%entry, 4] : i64, view<14x5xi64>
+  func.return
+}
