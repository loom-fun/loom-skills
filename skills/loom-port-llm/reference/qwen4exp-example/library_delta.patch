+  %c0 = index.constant 0 : index
+  %c1 = index.constant 1 : index
+  %zero32 = scalar.constant 0 : i32
+  %token_bytes = buffer.length %tokens
+  %metadata_bytes = buffer.length %metadata
+  %capacity = func.call @qwen38_packet_capacity(%metadata_bytes) : (offset) -> (index)
+  %policy_source = index.constant 40 : offset
+  %policy_target = func.call @qwen38_packet_policy_origin(%capacity) : (index) -> (offset)
+  %policy_stride = index.constant 24 : offset
+  %first_bounded = scalar.assume %first_count [range(%first_count, 1, 2147483647)] : i32
+  %first = index.cast %first_bounded : i32 to index
