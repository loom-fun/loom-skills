      %following = index.add %position, %step : offset
      scf.yield %following : offset
    }
    %start_text = index.cast %stop : offset to i64
    %marker = global.load @text_tool_marker : buffer
    %end = func.call @text_until(%response, %marker, %start_text, %phase) : (buffer, buffer, i64, i32) -> (i64)
    %has_text = scalar.cmpi ne, %end, %start_text : i64
    %next = scf.select %has_text, %c0_i64, %state : i64
    scf.yield %c1_i64, %start_text, %end, %next : i64, i64, i64, i64
  } else {
    %think_marker = global.load @text_think_end : buffer
    %tool_marker = global.load @text_tool_marker : buffer
    %marker = scf.select %thinking, %think_marker, %tool_marker : buffer
    %stop = func.call @text_until(%response, %marker, %previous, %phase) : (buffer, buffer, i64, i32) -> (i64)
    %at_marker = scalar.cmpi eq, %stop, %previous : i64
    %length_offset = buffer.length %response
    %length = index.cast %length_offset : offset to i64
    %remaining = scalar.subi %length, %stop : i64
    %marker_length_offset = buffer.length %marker
    %marker_length = index.cast %marker_length_offset : offset to i64
    %complete = scalar.cmpi uge, %remaining, %marker_length : i64
    %thinking_marker = scalar.andi %thinking, %at_marker : i1
    %consume = scalar.andi %thinking_marker, %complete : i1
    %after = scalar.addi %stop, %marker_length : i64
    %end = scf.select %consume, %after, %stop : i64
    %next = scf.select %consume, %c2_i64, %state : i64
    %channel = scf.select %thinking, %c2_i64, %c1_i64 : i64
    %kind = scf.select %consume, %c0_i64, %channel : i64
    scf.yield %kind, %previous, %end, %next : i64, i64, i64, i64
  }
  func.return %kind, %begin, %end, %next : i64, i64, i64, i64
}

// Canonical history of this turn, as chat_message would render it: prompt +
// [trimmed reasoning + think close] + content + [separator] + calls + suffix.
// Device state is reusable only when the generated part (without the suffix,
// which the next input appends) is byte-identical to the actual output and the
// response did not end inside reasoning. (Adapted from qwen3_8/chat.loom.)
func.def @generic_complete_text(%prompt: buffer, %response: buffer, %content: buffer, %reasoning: buffer, %tools: buffer, %initial_state: i64, %final_state: i64) -> (buffer, i32) {
  %c0 = index.constant 0 : offset
  %c1_i64 = scalar.constant 1 : i64
  %empty = global.load @empty : buffer
  %thinking = scalar.cmpi eq, %initial_state, %c1_i64 : i64
  %prefix = scf.if %thinking -> (buffer) {
    %thought = func.call @trim(%reasoning) : (buffer) -> (buffer)
    %close = global.load @think_close : buffer
    %value = func.call @join4(%prompt, %thought, %close, %empty) : (buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    scf.yield %prompt : buffer
  }
  %content_length = buffer.length %content
  %has_content = index.cmp ne, %content_length, %c0 : offset
  %tools_length = buffer.length %tools
  %has_calls = index.cmp ne, %tools_length, %c0 : offset
  %separate = scalar.andi %has_content, %has_calls : i1
  %separator_value = global.load @content_call_separator : buffer
  %separator = scf.select %separate, %separator_value, %empty : buffer
  %suffix = global.load @message_suffix : buffer
  %close_value = global.load @calls_close : buffer
  %close = scf.select %has_calls, %close_value, %empty : buffer
  %head = func.call @join4(%prefix, %content, %separator, %tools) : (buffer, buffer, buffer, buffer) -> (buffer)
  %answer = func.call @join(%head, %close) : (buffer, buffer) -> (buffer)
  %result = func.call @join(%answer, %suffix) : (buffer, buffer) -> (buffer)
  %closed = scalar.cmpi ne, %final_state, %c1_i64 : i64
  %prompt_length = buffer.length %prompt
  %answer_length = buffer.length %answer
  %generated_length = index.sub %answer_length, %prompt_length : offset
  %response_length = buffer.length %response
  %same_length = index.cmp eq, %generated_length, %response_length : offset
  %identical = scf.if %same_length -> (i1) {
    %zero32 = scalar.constant 0 : i32
    %order = buffer.compare %answer[%prompt_length], %response[%c0], %response_length
    %equal = scalar.cmpi eq, %order, %zero32 : i32
    scf.yield %equal : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  %compatible = scalar.andi %closed, %identical : i1
  %reusable = scalar.extui %compatible : i1 to i32
  func.return %result, %reusable : buffer, i32
}

func.def public @encode_state(%bindings: buffer, %count: i32, %origins: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded_count = scalar.assume %count [range(%count, 1, 2147483647)] : i32
  %length = index.cast %bounded_count : i32 to index
  %origin_length = buffer.length %origins
  %origin_length64 = index.cast %origin_length : offset to i64
  %stride = scalar.constant 40 : i64
  %capacity64 = scalar.divui %origin_length64, %stride : i64
  %bounded_capacity = scalar.assume %capacity64 [range(%capacity64, 1, 2147483647)] : i64
  %capacity = index.cast %bounded_capacity : i64 to index
  %records = buffer.view %bindings[%origin] : buffer -> view<[%length]x4xi64>
  %rows = buffer.view %origins[%origin] : buffer -> view<[%capacity]x5xi64>
  scf.for %i = [%c0 to %length step %c1] {
    %row64 = view.load %records[%i, 0] : view<[%length]x4xi64> -> i64
    %row_bound = scalar.assume %row64 [range(%row64, 0, 2147483646)] : i64
    %row_value = index.cast %row_bound : i64 to index
    %row = index.assume %row_value [lt(%row_value, %capacity)] : index
    %read = view.load %records[%i, 1] : view<[%length]x4xi64> -> i64
    %write = view.load %records[%i, 2] : view<[%length]x4xi64> -> i64
    %position = view.load %records[%i, 3] : view<[%length]x4xi64> -> i64
    view.store %read, %rows[%row, 0] : i64, view<[%capacity]x5xi64>
    view.store %write, %rows[%row, 1] : i64, view<[%capacity]x5xi64>
    view.store %position, %rows[%row, 3] : i64, view<[%capacity]x5xi64>
  }
  func.return
}

// Opaque output deliberately gathers the two halves of each retained hidden
// word in reverse order. Native serving preserves bytes, not tensor types.
func.def public @capture_epoch(%state: buffer, %shape: i32, %count: i32, %plan: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded = scalar.assume %count [range(%count, 1, 2147483647)] : i32
  %spans = index.cast %bounded : i32 to index
  %count64 = scalar.extui %bounded : i32 to i64
  %record_bytes = scalar.constant 48 : i64
  %bytes64 = scalar.muli %count64, %record_bytes : i64
  %bounded_bytes = scalar.assume %bytes64 [range(%bytes64, 48, 103079215056)] : i64
  %length = index.cast %bounded_bytes : i64 to offset
  %storage = buffer.alloca<private> align(8) %length : buffer
  %records = buffer.view %storage[%origin] : buffer -> view<[%spans]x2x3xi64>
  %half = scalar.constant 2 : i64
  %word = scalar.constant 4 : i64
  scf.for %i = [%c0 to %spans step %c1] {
    %span = index.cast %i : index to i64
    %low = scalar.muli %span, %word : i64
    %high = scalar.addi %low, %half : i64
    view.store %span, %records[%i, 0, 0] : i64, view<[%spans]x2x3xi64>
    view.store %high, %records[%i, 0, 1] : i64, view<[%spans]x2x3xi64>
    view.store %half, %records[%i, 0, 2] : i64, view<[%spans]x2x3xi64>
    view.store %span, %records[%i, 1, 0] : i64, view<[%spans]x2x3xi64>
    view.store %low, %records[%i, 1, 1] : i64, view<[%spans]x2x3xi64>
    view.store %half, %records[%i, 1, 2] : i64, view<[%spans]x2x3xi64>
  }
  func.return %storage : buffer
}

func.def @plan_capacity(%plan: buffer) -> (index) {
  %bytes = buffer.length %plan
  %bytes64 = index.cast %bytes : offset to i64
  %stride = scalar.constant 36 : i64
  %records = scalar.divui %bytes64, %stride : i64
  %bounded = scalar.assume %records [range(%records, 1, 2147483647)] : i64
  %capacity = index.cast %bounded : i64 to index
  func.return %capacity : index
}

func.def @encode_mixed_plan(%plan: buffer, %inputs: buffer, %record_begin: index, %span_count: i32, %input_count: i32, %packet_capacity: i32, %packet: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded_span_count = scalar.assume %span_count [range(%span_count, 0, 2147483647)] : i32
  %span_extent = index.cast %bounded_span_count : i32 to index
  %bounded_input_count = scalar.assume %input_count [range(%input_count, 1, 524288)] : i32
  %input_extent = index.cast %bounded_input_count : i32 to index
  %bounded_packet_capacity = scalar.assume %packet_capacity [range(%packet_capacity, 1, 524288)] : i32
  %packet_extent = index.cast %bounded_packet_capacity : i32 to index
  %plan_extent = func.call @plan_capacity(%plan) : (buffer) -> (index)
  %requests = buffer.view %plan[%origin] : buffer -> view<[%plan_extent]x9xi32>
  %ids = buffer.view %inputs[%origin] : buffer -> view<[%input_extent]xi32>
  %records = buffer.view %packet[%origin] : buffer -> view<[%packet_extent]x8xi32>
  scf.for %i = [%c0 to %span_extent step %c1] {
    %request_value = index.add %record_begin, %i : index
    %request = index.assume %request_value [range(%request_value, 0, 2147483646), lt(%request_value, %plan_extent)] : index
    %input_begin32 = view.load %requests[%request, 4] : view<[%plan_extent]x9xi32> -> i32
    %input_length32 = view.load %requests[%request, 5] : view<[%plan_extent]x9xi32> -> i32
    %bounded_begin = scalar.assume %input_begin32 [range(%input_begin32, 0, 524287)] : i32
    %bounded_length = scalar.assume %input_length32 [range(%input_length32, 0, 524288)] : i32
    %input_begin = index.cast %bounded_begin : i32 to index
    %input_length = index.cast %bounded_length : i32 to index
    scf.for %j = [%c0 to %input_length step %c1] {
      %position = index.add %input_begin, %j : index
      %input_position = index.assume %position [lt(%position, %input_extent)] : index
      %packet_position = index.assume %position [lt(%position, %packet_extent)] : index
      %token = view.load %ids[%input_position] : view<[%input_extent]xi32> -> i32
      view.store %token, %records[%packet_position, 0] : i32, view<[%packet_extent]x8xi32>
    }
  }
  func.return
}

func.def @encode_mixed_media(%plan: buffer, %media_plan: buffer, %media_count: i32, %packet_capacity: i32, %packet: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded_media_count = scalar.assume %media_count [range(%media_count, 1, 524288)] : i32
  %media_extent = index.cast %bounded_media_count : i32 to index
  %bounded_packet_capacity = scalar.assume %packet_capacity [range(%packet_capacity, 1, 524288)] : i32
  %packet_extent = index.cast %bounded_packet_capacity : i32 to index
  %plan_extent = func.call @plan_capacity(%plan) : (buffer) -> (index)
  %requests = buffer.view %plan[%origin] : buffer -> view<[%plan_extent]x9xi32>
  %media = buffer.view %media_plan[%origin] : buffer -> view<[%media_extent]x7xi32>
  %records = buffer.view %packet[%origin] : buffer -> view<[%packet_extent]x8xi32>
  scf.for %i = [%c0 to %media_extent step %c1] {
    %plan_index32 = view.load %media[%i, 0] : view<[%media_extent]x7xi32> -> i32
    %relative32 = view.load %media[%i, 1] : view<[%media_extent]x7xi32> -> i32
    %feature_offset = view.load %media[%i, 2] : view<[%media_extent]x7xi32> -> i32
    %feature_length = view.load %media[%i, 3] : view<[%media_extent]x7xi32> -> i32
    %feature_index = view.load %media[%i, 6] : view<[%media_extent]x7xi32> -> i32
    %plan_index_bound = scalar.assume %plan_index32 [range(%plan_index32, 0, 2147483646)] : i32
    %plan_index_value = index.cast %plan_index_bound : i32 to index
    %bounded_relative = scalar.assume %relative32 [range(%relative32, 0, 524287)] : i32
    %plan_index = index.assume %plan_index_value [lt(%plan_index_value, %plan_extent)] : index
    %relative = index.cast %bounded_relative : i32 to index
    %input_begin32 = view.load %requests[%plan_index, 4] : view<[%plan_extent]x9xi32> -> i32
    %bounded_begin = scalar.assume %input_begin32 [range(%input_begin32, 0, 524287)] : i32
    %input_begin = index.cast %bounded_begin : i32 to index
    %position = index.add %input_begin, %relative : index
    %packet_position = index.assume %position [lt(%position, %packet_extent)] : index
    view.store %feature_offset, %records[%packet_position, 1] : i32, view<[%packet_extent]x8xi32>
    view.store %feature_length, %records[%packet_position, 2] : i32, view<[%packet_extent]x8xi32>
    view.store %feature_index, %records[%packet_position, 3] : i32, view<[%packet_extent]x8xi32>
  }
  func.return
}

// Device packets retain the first cohort's nine-field plan records. Feedback
// slots are span-indexed, including unselected input-only spans.
func.def public @encode_epoch(%control_state: buffer, %plan: buffer, %inputs: buffer, %media_plan: buffer, %first_count: i32, %next_count: i32, %input_count: i32, %first_media_count: i32, %next_media_count: i32, %first_packet_capacity: i32, %next_packet_capacity: i32, %eos: i32, %metadata: buffer, %tokens: buffer) -> (i32, buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %header_bytes = index.constant 16 : offset
  %count64 = scalar.extui %first_count : i32 to i64
  %record_bytes = scalar.constant 36 : i64
  %plan_length = scalar.muli %count64, %record_bytes : i64
  %plan_bytes = index.cast %plan_length : i64 to offset
  %header = buffer.view %metadata[%origin] : buffer -> view<4xi32>
  %c0 = scalar.constant 0 : i32
  view.store %first_count, %header[0] : i32, view<4xi32>
  view.store %eos, %header[1] : i32, view<4xi32>
  view.store %c0, %header[2] : i32, view<4xi32>
  view.store %c0, %header[3] : i32, view<4xi32>
  buffer.copy %plan[%origin], %metadata[%header_bytes], %plan_bytes
  // Device copy only: span fields 2, 5, 7, 8 carry the row's sampling record
  // (temperature, top_p, top_k, seed); the kernels never read the originals.
  %state_length = buffer.length %control_state
  %sampling_header = index.constant 640 : offset
  %sampling_stride = index.constant 16 : offset
  %span_stride = index.constant 36 : offset
  %c0_span = index.constant 0 : index
  %c1_span = index.constant 1 : index
  %bounded_first = scalar.assume %first_count [range(%first_count, 0, 8192)] : i32
  %span_extent = index.cast %bounded_first : i32 to index
  scf.for %s = [%c0_span to %span_extent step %c1_span] {
    %span_at = index.scale %s, %span_stride : index, offset -> offset
    %row_at = index.constant 12 : offset
    %row_field = index.add %span_at, %row_at : offset
    %row_view = buffer.view %plan[%row_field] : buffer -> view<1xi32>
    %row32 = view.load %row_view[0] : view<1xi32> -> i32
    %row_bound = scalar.assume %row32 [range(%row32, 0, 1048575)] : i32
    %row_index = index.cast %row_bound : i32 to index
    %record_rel = index.scale %row_index, %sampling_stride : index, offset -> offset
    %record_at = index.add %sampling_header, %record_rel : offset
    %record_end = index.add %record_at, %sampling_stride : offset
    %has_record = index.cmp ule, %record_end, %state_length : offset
    %packet_at = index.add %header_bytes, %span_at : offset
    %packet = buffer.view %metadata[%packet_at] : buffer -> view<9xi32>
    scf.if %has_record {
      %record = buffer.view %control_state[%record_at] : buffer -> view<4xi32>
      %temperature = view.load %record[0] : view<4xi32> -> i32
      %top_p = view.load %record[1] : view<4xi32> -> i32
      %top_k = view.load %record[2] : view<4xi32> -> i32
      %seed = view.load %record[3] : view<4xi32> -> i32
      view.store %temperature, %packet[2] : i32, view<9xi32>
      view.store %top_p, %packet[5] : i32, view<9xi32>
      view.store %top_k, %packet[7] : i32, view<9xi32>
      view.store %seed, %packet[8] : i32, view<9xi32>
    } else {
      view.store %c0, %packet[2] : i32, view<9xi32>
    }
  }
  %media_count = scalar.addi %first_media_count, %next_media_count : i32
  %has_media = scalar.cmpi ne, %media_count, %c0 : i32
  %input_count64 = scalar.extui %input_count : i32 to i64
  %token_stride = scalar.constant 4 : i64
  %packet_stride = scalar.constant 32 : i64
  %stride = scf.select %has_media, %packet_stride, %token_stride : i64
  %input_length = scalar.muli %input_count64, %stride : i64
  %input_bytes = index.cast %input_length : i64 to offset
  scf.if %has_media {
    // Ordinary records need zero feature fields; inactive capacity is not read.
    buffer.fill %c0, %tokens[%origin], %input_bytes : i32
    %packet_capacity = scalar.addi %first_packet_capacity, %next_packet_capacity : i32
    %c0_index = index.constant 0 : index
    func.call @encode_mixed_plan(%plan, %inputs, %c0_index, %first_count, %input_count, %packet_capacity, %tokens) : (buffer, buffer, index, i32, i32, i32, buffer)
    %has_next = scalar.cmpi ne, %next_count, %c0 : i32
    scf.if %has_next {
      %bounded_first = scalar.assume %first_count [range(%first_count, 1, 2147483647)] : i32
      %next_begin = index.cast %bounded_first : i32 to index
      func.call @encode_mixed_plan(%plan, %inputs, %next_begin, %next_count, %input_count, %packet_capacity, %tokens) : (buffer, buffer, index, i32, i32, i32, buffer)
    }
    func.call @encode_mixed_media(%plan, %media_plan, %media_count, %packet_capacity, %tokens) : (buffer, buffer, i32, i32, buffer)
  } else {
    buffer.copy %inputs[%origin], %tokens[%origin], %input_bytes
  }
  %transfer_offset = index.constant 8 : offset
  %transfers = buffer.view %control_state[%transfer_offset] : buffer -> view<2x5xi64>
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %header_length = scalar.constant 16 : i64
  %metadata_length = scalar.addi %header_length, %plan_length : i64
  view.store %zero64, %transfers[0, 0] : i64, view<2x5xi64>
  view.store %zero64, %transfers[0, 1] : i64, view<2x5xi64>
  view.store %zero64, %transfers[0, 2] : i64, view<2x5xi64>
  view.store %zero64, %transfers[0, 3] : i64, view<2x5xi64>
  view.store %metadata_length, %transfers[0, 4] : i64, view<2x5xi64>
  view.store %one64, %transfers[1, 0] : i64, view<2x5xi64>
  view.store %zero64, %transfers[1, 1] : i64, view<2x5xi64>
  view.store %one64, %transfers[1, 2] : i64, view<2x5xi64>
  view.store %zero64, %transfers[1, 3] : i64, view<2x5xi64>
  view.store %input_length, %transfers[1, 4] : i64, view<2x5xi64>
  %transfer_begin = scalar.constant 8 : i64
  %transfer_length = scalar.constant 80 : i64
  func.return %first_count, %control_state, %transfer_begin, %transfer_length : i32, buffer, i64, i64
}

func.def public @publish_epoch(%plan: buffer, %media_plan: buffer, %count: i32, %first_media_count: i32, %next_media_count: i32, %verified: i32, %continues: i32, %next_speculative: buffer, %ordinary: buffer, %first_results: buffer, %next_results: buffer, %progress: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %progress_bytes = buffer.length %progress
  buffer.fill %c0_i32, %progress[%origin], %progress_bytes : i32
  %bounded_count = scalar.assume %count [range(%count, 1, 2147483647)] : i32
  %length = index.cast %bounded_count : i32 to index
  %plan_extent = func.call @plan_capacity(%plan) : (buffer) -> (index)
  %requests = buffer.view %plan[%origin] : buffer -> view<[%plan_extent]x9xi32>
  %outputs = buffer.view %ordinary[%origin] : buffer -> view<[%length]xi32>
  %published = buffer.view %progress[%origin] : buffer -> view<[%length]x21xi32>
  scf.for %i = [%c0 to %length step %c1] {
    %request = index.assume %i [lt(%i, %plan_extent)] : index
    %consumed = view.load %requests[%request, 0] : view<[%plan_extent]x9xi32> -> i32
    %source_position = view.load %requests[%request, 2] : view<[%plan_extent]x9xi32> -> i32
    %source_advance = scalar.muli %consumed, %c2_i32 : i32
    %next_source_position = scalar.addi %source_position, %source_advance : i32
    %flags = view.load %requests[%request, 6] : view<[%plan_extent]x9xi32> -> i32
    %bits = scalar.andi %flags, %c1_i32 : i32
    %selected = scalar.cmpi ne, %bits, %c0_i32 : i32
    %selected_count = scalar.extui %selected : i1 to i32
    view.store %consumed, %published[%i, 0] : i32, view<[%length]x21xi32>
    view.store %consumed, %published[%i, 1] : i32, view<[%length]x21xi32>
    view.store %selected_count, %published[%i, 2] : i32, view<[%length]x21xi32>
    view.store %next_source_position, %published[%i, 4] : i32, view<[%length]x21xi32>
    scf.if %selected {
      %token = view.load %outputs[%i] : view<[%length]xi32> -> i32
      view.store %token, %published[%i, 5] : i32, view<[%length]x21xi32>
    }
  }
  func.return
}

func.def public @step(%state: buffer, %initialize: i32, %source_position: i32, %input_count: i32, %residual: hal.buffer, %control: hal.buffer, %recurrent: hal.buffer, %attention: hal.buffer, %tokens: hal.buffer, %progress: hal.buffer) -> (i64, i32) {
  %c0 = scalar.constant 0 : i32
  %c2 = scalar.constant 2 : i32
  %c0_i64 = scalar.constant 0 : i64
  %source_advance = scalar.muli %input_count, %c2 : i32
  %next_source_position = scalar.addi %source_position, %source_advance : i32
