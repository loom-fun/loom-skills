      scf.yield %value : i1
    } else {
      scf.yield %false : i1
    }
    scf.condition %space, %position : i1, offset
  } do(%position: offset) {
    %next = index.add %position, %c1 : offset
    scf.yield %next : offset
  }
  func.return %result : offset
}

// End of trailing whitespace trimming: largest e in [begin, end] with text[e-1] not space.
func.def inline @trim_end(%text: buffer, %begin: offset, %end: offset) -> (offset) {
