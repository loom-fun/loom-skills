      scf.yield %value : i1
    } else {
      scf.yield %false : i1
    }
    scf.condition %space, %position : i1, offset
  } do(%position: offset) {
    %next = index.sub %position, %c1 : offset
    scf.yield %next : offset
  }
  func.return %result : offset
}

func.def inline @trim(%text: buffer) -> (buffer) {
  %c0 = index.constant 0 : offset
