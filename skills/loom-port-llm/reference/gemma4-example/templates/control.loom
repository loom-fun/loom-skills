  %c64 = index.constant 64 : offset
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %length = buffer.length %response
  %twice = index.add %length, %length : offset
  %scaled = index.add %twice, %length : offset
  %capacity = index.add %scaled, %c64 : offset
  %output = buffer.alloca<private> align(1) %capacity : buffer
  %call_open = global.load @call_open : buffer
  %call_close = global.load @call_close : buffer
  %key_open = global.load @key_open : buffer
  %key_close = global.load @key_close : buffer
  %value_open = global.load @value_open : buffer
  %value_close = global.load @value_close : buffer
  %xml_open = global.load @xml_call_open : buffer
  %tag_end = global.load @xml_tag_end : buffer
  %xml_key = global.load @xml_parameter_open : buffer
  %xml_value_close = global.load @xml_parameter_close : buffer
  %xml_close = global.load @xml_call_close : buffer
  %end, %written, %naming = scf.while(%position = %origin : offset, %out = %origin : offset, %open = %false : i1) -> (offset, offset, i1) {
    %more = index.cmp ult, %position, %length : offset
    scf.condition %more, %position, %out, %open : i1, offset, offset, i1
  } do(%position: offset, %out: offset, %open: i1) {
    %is_call_open = func.call @starts_at(%response, %position, %call_open) : (buffer, offset, buffer) -> (i1)
    %is_call_close = func.call @starts_at(%response, %position, %call_close) : (buffer, offset, buffer) -> (i1)
    %is_key_open = func.call @starts_at(%response, %position, %key_open) : (buffer, offset, buffer) -> (i1)
    %is_key_close = func.call @starts_at(%response, %position, %key_close) : (buffer, offset, buffer) -> (i1)
    %is_value_open = func.call @starts_at(%response, %position, %value_open) : (buffer, offset, buffer) -> (i1)
    %is_value_close = func.call @starts_at(%response, %position, %value_close) : (buffer, offset, buffer) -> (i1)
    // A function name is closed before its first parameter or the call end.
