// Sampling record (16 bytes): temperature f32, top_p f32, top_k i32, seed i32.
// temperature 0 is greedy (the default); top_k 0 means "up to 64 candidates".
global.rodata.def @temperature_key = bytes("74656d7065726174757265")

global.rodata.def @top_p_key = bytes("746f705f70")

global.rodata.def @top_k_key = bytes("746f705f6b")

global.rodata.def @seed_key = bytes("73656564")

func.def public @request_defaults(%options: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 16 : offset
  %record = buffer.alloca<private> align(4) %bytes : buffer
  %view = buffer.view %record[%origin] : buffer -> view<4xi32>
  %c0_i32 = scalar.constant 0 : i32
  %temperature = scalar.constant @@DEFAULT_TEMPERATURE@@ : f32
  %top_p = scalar.constant @@DEFAULT_TOP_P@@ : f32
  %top_k = scalar.constant @@DEFAULT_TOP_K@@ : i32
  %temperature_bits = scalar.bitcast %temperature : f32 to i32
  %top_p_bits = scalar.bitcast %top_p : f32 to i32
  view.store %temperature_bits, %view[0] : i32, view<4xi32>
  view.store %top_p_bits, %view[1] : i32, view<4xi32>
  view.store %top_k, %view[2] : i32, view<4xi32>
  view.store %c0_i32, %view[3] : i32, view<4xi32>
  func.return %record : buffer
}

// OpenAI-style temperature / top_p / top_k / seed (numbers; null keeps the default).
// Without a seed each request draws from its own nonce.
func.def public @request_options(%defaults: buffer, %request: buffer, %nonce: i64) -> (buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bytes = index.constant 16 : offset
  %record = buffer.alloca<private> align(4) %bytes : buffer
  buffer.copy %defaults[%origin], %record[%origin], %bytes
  %view = buffer.view %record[%origin] : buffer -> view<4xi32>
  %nonce32 = scalar.trunci %nonce : i64 to i32
  view.store %nonce32, %view[3] : i32, view<4xi32>
  %fields, %type, %count = func.call @members(%request) : (buffer) -> (buffer, i32, i64)
  %bounded_count = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded_count : i64 to index
  %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
  %number = scalar.constant 1 : i64
  %temperature_key = global.load @temperature_key : buffer
  %top_p_key = global.load @top_p_key : buffer
  %top_k_key = global.load @top_k_key : buffer
  %seed_key = global.load @seed_key : buffer
  scf.for %i = [%c0 to %extent step %c1] {
    %key_begin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
    %key_length = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
    %value_begin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
    %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
    %value_type = view.load %records[%i, 4] : view<[%extent]x5xi64> -> i64
    %is_number = scalar.cmpi eq, %value_type, %number : i64
    scf.if %is_number {
      %key = func.call @json_key(%request, %key_begin, %key_length) : (buffer, i64, i64) -> (buffer)
      %is_temperature = func.call @equal(%key, %temperature_key) : (buffer, buffer) -> (i1)
      %is_top_p = func.call @equal(%key, %top_p_key) : (buffer, buffer) -> (i1)
      %is_top_k = func.call @equal(%key, %top_k_key) : (buffer, buffer) -> (i1)
      %is_seed = func.call @equal(%key, %seed_key) : (buffer, buffer) -> (i1)
      %is_float = scalar.ori %is_temperature, %is_top_p : i1
      scf.if %is_float {
        %value64 = func.call @parse_f64(%request, %value_begin, %value_length) : (buffer, i64, i64) -> (f64)
        %value = scalar.fptrunc %value64 : f64 to f32
        %bits = scalar.bitcast %value : f32 to i32
        scf.if %is_temperature {
          view.store %bits, %view[0] : i32, view<4xi32>
        } else {
          view.store %bits, %view[1] : i32, view<4xi32>
        }
      }
      %is_integer = scalar.ori %is_top_k, %is_seed : i1
      scf.if %is_integer {
        %value64 = func.call @parse_i64(%request, %value_begin, %value_length) : (buffer, i64, i64) -> (i64)
        %value = scalar.trunci %value64 : i64 to i32
        scf.if %is_top_k {
          view.store %value, %view[2] : i32, view<4xi32>
        } else {
          view.store %value, %view[3] : i32, view<4xi32>
        }
      }
    }
  }
  func.return %record : buffer
}

// Sampling records follow the 640-byte control header, one per resident row.
func.def public @bind_request(%state: buffer, %row: i32, %options: buffer) {
  %origin = index.constant 0 : offset
  %header = index.constant 640 : offset
  %record_bytes = index.constant 16 : offset
  %bounded_row = scalar.assume %row [range(%row, 0, 1048575)] : i32
  %row_index = index.cast %bounded_row : i32 to index
  %relative = index.scale %row_index, %record_bytes : index, offset -> offset
  %at = index.add %header, %relative : offset
  %end = index.add %at, %record_bytes : offset
  %length = buffer.length %state
  %fits = index.cmp ule, %end, %length : offset
  %options_length = buffer.length %options
  %complete = index.cmp uge, %options_length, %record_bytes : offset
  %store = scalar.andi %fits, %complete : i1
  scf.if %store {
    buffer.copy %options[%origin], %state[%at], %record_bytes
  }
  func.return
}

// (reasoning supported, selectable efforts bitmap, default effort):
// efforts none=0 ... high=4; a toggleable thinking model offers none|high.
func.def public @chat_reasoning() -> (i32, i32, i32) {
  %supported = scalar.constant @@REASONING_SUPPORTED@@ : i32
  %efforts = scalar.constant @@REASONING_EFFORTS@@ : i32
  %default = scalar.constant @@REASONING_DEFAULT@@ : i32
  func.return %supported, %efforts, %default : i32, i32, i32
}

func.def public @chat_image_limits() -> (i64, i64, i64, i64, i64) {
  %maximum_count = scalar.constant 4 : i64
  %compressed_bytes = scalar.constant 1048576 : i64
  %width = scalar.constant 4096 : i64
  %height = scalar.constant 4096 : i64
  %pixels = scalar.constant 16777216 : i64
  func.return %maximum_count, %compressed_bytes, %width, %height, %pixels : i64, i64, i64, i64, i64
}

