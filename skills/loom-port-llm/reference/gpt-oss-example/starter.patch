+# ---- OpenAI harmony channel format (call_format "harmony", gpt-oss) ----------------------------
+# Template: the gpt-oss GGUF's chat template (unsloth/ggml-org/OpenAI). control.loom renders the whole
+# conversation in chat_begin (chat/harmony.loom): the developer block holds the first system message and
+# the tools as a TypeScript namespace, an assistant turn's rendering depends on later messages (the
+# analysis before a call is dropped once a later final answer exists), and a tool result is framed with
+# the name of the last call. reasoning_content plays the template's `thinking` (llama.cpp's gpt-oss
+# handler copies it there and drops the content of call turns). This model mirrors chat/harmony.loom.
+# Deliberate deviation: the system block's "Current date: <strftime_now>" line is never rendered (the
+# control program has no clock; verify() renders the template without it).
+# Tool schemas: properties of type string (enum, nullable), number/integer, boolean, a type list, arrays of
+# those, objects of those (one level), anything else "any"; descriptions and defaults as the template
+# prints them. Deeper schemas and oneOf render here (and in control.loom) as "any" / one level only.
+HARMONY_SYSTEM = ("You are ChatGPT, a large language model trained by OpenAI.\nKnowledge cutoff: 2024-06\n\n"
+                  "Reasoning: {effort}\n\n# Valid channels: analysis, commentary, final. Channel must be included for every message.")
+HARMONY_TOOLS_NOTE = "\nCalls to these tools must go to the commentary channel: 'functions'."
+HARMONY_GENERATION = "<|start|>assistant"
