+def verify(template_text, chat, bos="", eos=""):  # noqa: F811
+    if chat.get("call_format") != "harmony":
+        return _generic_verify(template_text, chat, bos, eos)
+    T = Template(template_text, bos, eos)
+    T.t.environment.globals["strftime_now"] = lambda fmt: "@@DATE@@"
+    results = []
+    for name, msgs, tools in CONVERSATIONS + HARMONY_CONVERSATIONS:
+        for effort in (None,) + tuple(e for e in HARMONY_EFFORTS if e != chat.get("reasoning_effort_default")):
+            label = name + (f" (reasoning_effort={effort})" if effort else "")
+            try:
+                kw = {"reasoning_effort": effort} if effort else {}
+                ref = T.render(_h_template_messages(msgs), tools=tools, gen=True, **kw).replace("Current date: @@DATE@@\n", "")
+            except ProbeError as e:
+                results.append((label, None, f"template refuses: {e}"))
+                continue
+            got = simulate(chat, msgs, tools, gen=True, reasoning_effort=effort)
+            if got == ref:
+                results.append((label, True, "exact (no 'Current date' line)"))
+            else:
+                k = next((i for i, (a, b) in enumerate(zip(got, ref)) if a != b), min(len(got), len(ref)))
+                results.append((label, False, f"differs at byte {k}: loom {got[max(0, k - 40):k + 60]!r} vs template {ref[max(0, k - 40):k + 60]!r}"))
+    return results
