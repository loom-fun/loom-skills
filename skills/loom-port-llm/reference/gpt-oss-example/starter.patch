+def _h_template_messages(msgs):
+    """The messages as llama.cpp's gpt-oss handler hands them to the template: reasoning_content -> thinking,
+    a call turn with reasoning loses its content; text parts joined (the template concatenates strings)."""
+    out = []
+    for m in msgs:
+        m = dict(m)
+        if isinstance(m.get("content"), list):
+            m["content"] = _h_text(m["content"])
+        if isinstance(m.get("reasoning_content"), str):
+            m["thinking"] = m.pop("reasoning_content")
+            if m.get("tool_calls"):
+                m.pop("content", None)
+        out.append(m)
+    return out
+
